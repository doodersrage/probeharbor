{
	"compatibility_date": "2026-04-28",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "garage-temp",
	"main": "./src/worker.ts",
	"workers_dev": false,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Static @astrojs/sitemap XML was 404ing from Assets; serve SSR routes instead.
		"run_worker_first": [
			"/sitemap-0.xml",
			"/sitemap-index.xml",
			"/robots.txt"
		]
	},
	"observability": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// Primary domain + legacy hostnames (middleware 301s legacy → apex).
	"routes": [
		{
			"pattern": "probeharbor.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.probeharbor.dev",
			"custom_domain": true
		},
		{
			"pattern": "thermaltrace.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.thermaltrace.dev",
			"custom_domain": true
		},
		{
			"pattern": "garage-temp.robmcd.name",
			"custom_domain": true
		},
		{
			"pattern": "thermaltrace.robmcd.name",
			"custom_domain": true
		}
	],
	"dev": {
		"ip": "0.0.0.0",
		"port": 8787
	},
	"send_email": [
		{
			"name": "MAILER"
			// Unrestricted: required for drip/trial/alert mail to arbitrary user addresses.
			// Requires Cloudflare Email Sending enabled for the SMTP_MAIL_FROM domain
			// (Dashboard → Email → Email Sending, or: wrangler email sending enable <domain>).
			// Contact form still sends to SMTP_MAIL_TO.
		}
	],
	"triggers": {
		"crons": ["0 * * * *", "15,30,45 * * * *"]
	},
	// es/fr/de/pt-br translation tables (workers/i18n), kept out of this
	// bundle for the 3 MB limit. See src/i18n/catalog.ts.
	"services": [
		{
			"binding": "I18N",
			"service": "probeharbor-i18n",
			"entrypoint": "I18n"
		}
	],
	// Postgres through Hyperdrive (Layerbase). Inert unless the runtime setting
	// DATABASE_DRIVER=hyperdrive (src/lib/db/client.ts); otherwise Neon over
	// DATABASE_URL. Config made by the owner in the dashboard (caching off).
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "9b5d0cb63a214ef4b899920f3e021f7b",
			// Local dev / CI preview need some value to start; it is only used with
			// DATABASE_DRIVER=hyperdrive. Override with
			// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
			"localConnectionString": "postgresql://unused:unused@127.0.0.1:5432/hyperdrive_unused"
		}
	],
	"r2_buckets": [
		{
			"binding": "HISTORY_ARCHIVE",
			"bucket_name": "thermaltrace-history"
		}
	],
	// Workers Rate Limiting (src/lib/edgeRateLimit.ts): counts per Cloudflare
	// location across isolates, approximate. namespace_id is ours to choose and
	// must be unique in the account. Same limits as the in-memory fallbacks.
	"ratelimits": [
		{
			"name": "INGEST_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "SHARE_READINGS_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"browser": {
		"binding": "BROWSER"
	}
}