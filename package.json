{
  "name": "probeharbor",
  "type": "module",
  "version": "0.0.1",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "deploy": "astro build && pnpm docs:build:site && node scripts/gen-i18n-catalog.mjs && wrangler deploy --config workers/i18n/wrangler.jsonc && wrangler deploy --config dist/server/wrangler.json",
    "i18n:catalog": "node scripts/gen-i18n-catalog.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:pending": "node scripts/db-migrate.mjs --check",
    "db:migrate": "node scripts/db-migrate.mjs",
    "secrets:push": "node scripts/push-worker-secrets.mjs",
    "secrets:push:dry": "node scripts/push-worker-secrets.mjs --dry-run",
    "operator:check": "node scripts/check-operator-secrets.mjs",
    "setup:github-secrets": "node scripts/setup-github-secrets.mjs",
    "setup:e2e-github-secrets": "node scripts/setup-e2e-github-secrets.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "ops:check": "node scripts/ops-check.mjs",
    "ops:smoke": "node scripts/ops-smoke-remote.mjs",
    "ops:dogfood": "node scripts/ops-dogfood.mjs",
    "ping:sitemaps": "node scripts/ping-sitemaps.mjs",
    "stripe:rename": "node --env-file=.env scripts/rename-stripe-products.mjs",
    "dev": "astro dev",
    "build": "astro sync && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node scripts/e2e-auth.mjs",
    "e2e:reset-password": "node scripts/e2e-reset-password.mjs",
    "typecheck": "astro sync && tsc --noEmit && astro check",
    "lint": "pnpm dlx @biomejs/biome@2.5.12 ci --formatter-enabled=false .",
    "lint:fix": "pnpm dlx @biomejs/biome@2.5.12 check --write .",
    "format": "pnpm dlx @biomejs/biome@2.5.12 format --write .",
    "audit:stripe": "node --env-file=.env scripts/audit-stripe-prices.mjs",
    "audit:billing": "node --env-file=.env scripts/audit-billing.mjs",
    "ops:funnel": "node --env-file=.env scripts/ops-funnel.mjs",
    "stripe:portal": "node --env-file=.env scripts/configure-stripe-portal.mjs",
    "smoke:portfolio-billing": "node --env-file=.env scripts/smoke-portfolio-billing.mjs",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "firmware:build": "node scripts/build-firmware.mjs",
    "firmware:keygen": "node scripts/firmware-ota.mjs keygen",
    "firmware:sign": "node scripts/firmware-ota.mjs sign",
    "firmware:roots": "node scripts/firmware-ca-roots.mjs",
    "brand:icons": "bash scripts/export-brand-icons.sh",
    "astro": "astro",
    "docs:dev": "pnpm --dir docs --ignore-workspace dev",
    "docs:build": "pnpm --dir docs --ignore-workspace build",
    "docs:build:site": "node scripts/build-docs-site.mjs",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/preact": "^6.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@better-auth/passkey": "1.7.18",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@lucide/astro": "~1.68.0",
    "@neondatabase/serverless": "1.2.0",
    "@sentry/astro": "^11.10.0",
    "@sentry/cloudflare": "^11.10.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.18",
    "esp-web-tools": "^10.4.0",
    "mimetext": "^3.0.28",
    "pdf-lib": "^1.17.1",
    "preact": "^11.1.1",
    "stripe": "^23.1.0",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4.3.4",
    "uqr": "^0.1.3",
    "wrangler": "^4.157.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "pg": "8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "vite": "^8"
  }
}
