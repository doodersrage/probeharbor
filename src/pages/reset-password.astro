---
import Layout from "../layouts/Layout.astro";
import { getAuthFromCookies, setAuthCookies } from "../lib/auth";
import { createAuthClient } from "../lib/supabase";
import { getLocale } from "../i18n";
import { authPasswordMessages } from "../i18n/messages/app/auth/password";

const t = authPasswordMessages(getLocale(Astro)).reset;

const code = Astro.url.searchParams.get("code");
const error = Astro.url.searchParams.get("error");

if (code) {
  // Fresh client -- never the shared `supabase` singleton, whose ambient
  // session is effectively shared mutable state across concurrent
  // requests under Cloudflare Workers (see its doc comment in
  // lib/supabase.ts). This result is turned straight into auth cookies
  // below, so a shared client here could hand this visitor's browser a
  // different signed-in user's session.
  const { data, error: exchangeError } = await createAuthClient().auth.exchangeCodeForSession(code);

  if (!exchangeError && data.session) {
    setAuthCookies(Astro.cookies, data.session.access_token, data.session.refresh_token);
    return Astro.redirect("/reset-password");
  }
}

const { session } = await getAuthFromCookies(Astro.cookies);
const errorMessage =
  error && Object.hasOwn(t.errors, error) ? t.errors[error as keyof typeof t.errors] : null;
---

<Layout
  title={t.title}
  description={t.description}
  noindex
>
  <div class="page-shell page-grid items-start">
    <section class="card animate-zoom-in">
      <h1 class="card-title">{t.heading}</h1>
      <p class="card-subtitle">
        {session ? t.withSession : t.withoutSession}
      </p>

      {!session ? (
        <div class="empty-state">
          <p class="m-0" set:html={t.needsLinkHtml} />
        </div>
      ) : (
        <form class="form-panel" action="/api/auth/update-password" method="post">
          {errorMessage && (
            <div class="alert-warning mb-4" role="alert">
              <p class="m-0">{errorMessage}</p>
            </div>
          )}
          <div class="form-field">
            <label class="form-label" for="password">{t.newPassword}</label>
            <input class="form-input" type="password" name="password" id="password" minlength="8" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="confirm">{t.confirmPassword}</label>
            <input class="form-input" type="password" name="confirm" id="confirm" minlength="8" required />
          </div>
          <button class="btn-primary" type="submit">{t.submit}</button>
        </form>
      )}
    </section>
  </div>
</Layout>
