---
import Layout from "../layouts/Layout.astro";
import { getAuthFromCookies } from "../lib/auth";
import { getLocale } from "../i18n";
import { authPasswordMessages } from "../i18n/messages/app/auth/password";
import { RESET_TOKEN_COOKIE } from "../lib/betterAuthPassword";

const t = authPasswordMessages(getLocale(Astro)).reset;

const error = Astro.url.searchParams.get("error");

const { session: signedIn } = await getAuthFromCookies(Astro.cookies);
// The emailed link leaves its token in an httpOnly cookie (checked again
// when the form is sent) instead of starting a session.
const session = signedIn ?? (Astro.cookies.get(RESET_TOKEN_COOKIE)?.value ? true : null);
const errorMessage =
  error && Object.hasOwn(t.errors, error) ? t.errors[error as keyof typeof t.errors] : null;
---

<Layout
  title={t.title}
  description={t.description}
  noindex
>
  <div class="page-shell page-grid items-start">
    <section class="card animate-zoom-in">
      <h1 class="card-title">{t.heading}</h1>
      <p class="card-subtitle">
        {session ? t.withSession : t.withoutSession}
      </p>

      {!session ? (
        <div class="empty-state">
          <p class="m-0" set:html={t.needsLinkHtml} />
        </div>
      ) : (
        <form class="form-panel" action="/api/auth/update-password" method="post">
          {errorMessage && (
            <div class="alert-warning mb-4" role="alert">
              <p class="m-0">{errorMessage}</p>
            </div>
          )}
          <div class="form-field">
            <label class="form-label" for="password">{t.newPassword}</label>
            <input class="form-input" type="password" name="password" id="password" minlength="8" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="confirm">{t.confirmPassword}</label>
            <input class="form-input" type="password" name="confirm" id="confirm" minlength="8" required />
          </div>
          <button class="btn-primary" type="submit">{t.submit}</button>
        </form>
      )}
    </section>
  </div>
</Layout>
