---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";

const m = accessoriesMessages(getLocale(Astro));
const c = m.common;
const t = m.alertBeacon;

const NEOPIXEL = BOM.adafruitNeopixelStick;
const ZERO = BOM.amazonRp2040Zero;
const PICO_W = BOM.adafruitPicoW;
const AMAZON_NEOPIXEL = BOM.amazonNeopixelStick;
---
<AccessoryProduct
  accessoryId="alert-beacon"
  faqKey="alertBeacon"
  title={t.title}
  description={t.description}
>
  <a slot="actions" class="btn-primary" href="/bay-buddy">{c.getBayBuddy}</a>
  <a slot="actions" class="btn-secondary" href="/claim-puck">{c.claimPuck}</a>
  <a slot="actions" class="btn-ghost" href="/docs/api#claim-puck">{t.moodApi}</a>

  <section class="card">
    <h2 class="card-title">{c.whatItIs}</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>{c.does}</strong> <Fragment set:html={t.doesHtml} />
      </li>
      <li>
        <strong>{c.doesNot}</strong> <Fragment set:html={t.doesNotHtml} />
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">{c.parts}</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.colPart}</th>
            <th scope="col">{c.colWhy}</th>
            <th scope="col">{c.colBuy}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{t.mcuPart}</th>
            <td>{t.mcuWhy}</td>
            <td>
              <a class="text-link" href={ZERO} target="_blank" rel={commerceLinkRel(ZERO)}>{t.zeroBuy}</a>
              ·
              <a class="text-link" href={PICO_W} target="_blank" rel={commerceLinkRel(PICO_W)}>{t.picoBuy}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.neopixelPart}</th>
            <td>{t.neopixelWhy}</td>
            <td>
              <a class="text-link" href={NEOPIXEL} target="_blank" rel={commerceLinkRel(NEOPIXEL)}>{t.stickBuy}</a>
              ·
              <a class="text-link" href={AMAZON_NEOPIXEL} target="_blank" rel={commerceLinkRel(AMAZON_NEOPIXEL)}>Amazon</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.powerPart}</th>
            <td>{t.powerWhy}</td>
            <td>{t.powerBuy}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">{c.setup}</h2>
    <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
      {t.stepsHtml.map((step) => <li set:html={step} />)}
    </ol>
  </section>
</AccessoryProduct>
