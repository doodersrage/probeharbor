---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getLocale } from "../i18n";
import { authErrorPagesMessages } from "../i18n/messages/app/auth/errorPages";

const t = authErrorPagesMessages(getLocale(Astro)).serverError;
---
<Layout title={t.title} description={t.description} noindex>
  <div class="page-shell page-stack">
    <section class="card">
      <h1 class="card-title">{t.heading}</h1>
      <p class="card-subtitle mb-4">
        {t.lede}
      </p>
      <p class="mb-0">
        <a class="btn-primary" href="/">{t.home}</a>
        {" "}
        <a class="text-link" href="/system-status">{t.status}</a>
      </p>
    </section>
  </div>
</Layout>
