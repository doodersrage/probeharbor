---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { fmt, getLocale } from "../../i18n";
import { integrationsMessages } from "../../i18n/messages/integrations";
import { getLocalizedIntegrationTaglines } from "../../i18n/content/integrations";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../../i18n/content/marketingFaqs";
import {
  SMARTTHINGS_INTEGRATION_PAGE,
  SMARTTHINGS_NAME,
} from "../../lib/smartThingsIntegration";
import { MATTER_INTEGRATION_PAGE, MATTER_REPO_URL } from "../../lib/matterIntegration";
import { INTEGRATIONS_HUB_PAGE } from "../../lib/homeAssistantIntegration";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, SMARTTHINGS_INTEGRATION_PAGE);
const locale = getLocale(Astro);
const m = integrationsMessages(locale);
const t = m.smartThings;
const taglines = getLocalizedIntegrationTaglines(locale);
const faqs = getLocalizedMarketingFaqs("smartThings", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: "/" },
    { name: m.breadcrumbIntegrations, path: INTEGRATIONS_HUB_PAGE },
    { name: "SmartThings", path: SMARTTHINGS_INTEGRATION_PAGE },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "smartThings", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={`${SMARTTHINGS_NAME}: ${taglines.smartThingsTagline}`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={taglines.smartThingsTagline}
    >
      <a slot="actions" class="btn-primary" href={MATTER_INTEGRATION_PAGE}>
        {t.matterGuide}
      </a>
      <a slot="actions" class="btn-secondary" href={MATTER_REPO_URL} target="_blank" rel="noreferrer">
        {m.pluginOnGithub}
      </a>
      <a slot="actions" class="btn-ghost" href={user ? "/dashboard/share/links" : "/register?next=/dashboard/share/links"}>
        {user ? t.shareLink : t.startFree}
      </a>
      <a slot="actions" class="btn-ghost" href="/compare/govee">{t.vsGovee}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.noC2cTitle}</h2>
      <p class="text-sm mb-0" set:html={t.noC2cCopyHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.setupTitle}</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
        <li set:html={t.setupStep1Html} />
        <li set:html={fmt(t.setupStep2Html, { href: MATTER_REPO_URL })} />
        <li>{t.setupStep3}</li>
        <li>{t.setupStep4}</li>
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">{t.aloneTitle}</h2>
      <p class="mb-0 text-sm" set:html={t.aloneCopyHtml} />
    </section>

    <FaqSection title={t.faqTitle} faqs={faqs} lede={t.faqLede} />
  </div>
</Layout>
