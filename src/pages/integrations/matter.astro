---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { getLocale } from "../../i18n";
import { integrationsMessages } from "../../i18n/messages/integrations";
import { getLocalizedIntegrationTaglines } from "../../i18n/content/integrations";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../../i18n/content/marketingFaqs";
import {
  MATTER_NAME,
  MATTER_REPO_URL,
  MATTER_INTEGRATION_PAGE,
} from "../../lib/matterIntegration";
import { INTEGRATIONS_HUB_PAGE } from "../../lib/homeAssistantIntegration";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, MATTER_INTEGRATION_PAGE);
const locale = getLocale(Astro);
const m = integrationsMessages(locale);
const t = m.matter;
const taglines = getLocalizedIntegrationTaglines(locale);
const matterFaqs = getLocalizedMarketingFaqs("matter", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: "/" },
    { name: m.breadcrumbIntegrations, path: INTEGRATIONS_HUB_PAGE },
    { name: t.breadcrumb, path: MATTER_INTEGRATION_PAGE },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "matter", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={taglines.matterTagline}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href={MATTER_REPO_URL} target="_blank" rel="noreferrer">
        {m.pluginOnGithub}
      </a>
      <a slot="actions" class="btn-secondary" href={user ? "/dashboard/share/links" : "/register?next=/dashboard/share/links"}>
        {user ? m.createShareLink : m.startFreeShareLink}
      </a>
      <a slot="actions" class="btn-ghost" href={INTEGRATIONS_HUB_PAGE}>{m.allIntegrations}</a>
      <a slot="actions" class="btn-ghost" href="/integrations/home-assistant">{t.vsHomeAssistant}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.whyTitle}</h2>
      <p class="text-sm mb-0" set:html={t.whyCopyHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.installTitle}</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li set:html={t.installStep1Html} />
        <li set:html={t.installStep2Html(MATTER_REPO_URL)} />
        <li set:html={t.installStep3Html} />
        <li>{t.installStep4}</li>
      </ol>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        {t.readmeLead}
        <a class="text-link" href={MATTER_REPO_URL} target="_blank" rel="noreferrer">probeharbor-matter ↗</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.mapTitle}</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">{t.mapCaption}</caption>
          <thead>
            <tr>
              <th scope="col">{t.mapKindHeader}</th>
              <th scope="col">{t.mapAccessoryHeader}</th>
            </tr>
          </thead>
          <tbody>
            {["temperature", "humidity", "flood", "door", "power", "motion"].map((kind, i) => (
              <tr><th scope="row">{kind}</th><td>{t.mapRows[i]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.mapFootHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.dualTitle}</h2>
      <p class="mb-0 text-sm" set:html={t.dualCopyHtml} />
    </section>

    <FaqSection
      title={t.faqTitle}
      faqs={matterFaqs}
      lede={t.faqLede}
    />
  </div>
</Layout>
