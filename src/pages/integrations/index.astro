---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import {
  DEV_DOCS_BASE,
  HACS_BADGE_URL,
  HACS_REPO_URL,
    INTEGRATIONS_HUB_PATH,
} from "../../lib/integrationsHub";
import { getAuthFromCookies } from "../../lib/auth";
import { getLocale } from "../../i18n";
import { integrationsMessages } from "../../i18n/messages/integrations";
import { getLocalizedIntegrationCards } from "../../i18n/content/integrations";

const { user } = await getAuthFromCookies(Astro.cookies);
const locale = getLocale(Astro);
const m = integrationsMessages(locale);
const t = m.hub;
const cards = getLocalizedIntegrationCards(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, INTEGRATIONS_HUB_PATH);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: "/" },
    { name: m.breadcrumbIntegrations, path: INTEGRATIONS_HUB_PATH },
  ]),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="/integrations/home-assistant">Home Assistant (HACS)</a>
      <a slot="actions" class="btn-secondary" href="/integrations/matter">Matter / Apple Home</a>
      <a slot="actions" class="btn-ghost" href="/integrations/node-red">Node-RED</a>
      <a slot="actions" class="btn-ghost" href={user ? "/dashboard/share" : "/register?next=/dashboard/share"}>
        {user ? t.dashboardShare : t.startFree}
      </a>
    </PageHeader>

    <section class="card">
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <a href={HACS_REPO_URL} target="_blank" rel="noreferrer">
          <img src={HACS_BADGE_URL} alt="HACS Custom" width="120" height="28" loading="lazy" />
        </a>
        <p class="text-sm text-[var(--color-text-muted)] mb-0">{t.hacsStatus}</p>
      </div>
      <p class="text-sm text-[var(--color-text-muted)] mb-0" set:html={t.devDocsHtml(DEV_DOCS_BASE)} />
    </section>

    <section class="grid gap-4 sm:grid-cols-2">
      {cards.map((card) => (
        <article class="card h-full flex flex-col">
          <h2 class="card-title">{card.title}</h2>
          {card.tier && (
            <p class="text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-2">{card.tier}</p>
          )}
          <p class="text-sm mb-3">{card.summary}</p>
          {card.bullets && card.bullets.length > 0 && (
            <ul class="text-sm space-y-1.5 mb-4 pl-4 list-disc text-[var(--color-text-muted)]">
              {card.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
          <div class="mt-auto flex flex-wrap gap-2">
            <a
              class="btn-secondary"
              href={card.href}
              {...(card.external ? { target: "_blank", rel: "noreferrer" } : {})}
            >
              {card.cta ?? t.learnMore}
              {card.external ? (
                <span class="sr-only">{t.opensDevDocs}</span>
              ) : null}
              {card.external ? " ↗" : ""}
            </a>
            {card.secondaryHref && (
              <a
                class="btn-ghost"
                href={card.secondaryHref}
                {...(card.secondaryExternal ? { target: "_blank", rel: "noreferrer" } : {})}
              >
                {card.secondaryLabel ?? t.more}
                {card.secondaryExternal ? " ↗" : ""}
              </a>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="card">
      <h2 class="card-title">{t.diyTitle}</h2>
      <p class="mb-4">
        {t.diyCopy}
        <a class="text-link" href="/compare/diy-mqtt">{t.compareDiy}</a>
        ·
        <a class="text-link" href="/guides">{t.guidesHub}</a>
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/integrations/home-assistant">{t.hacsInstallGuide}</a>
        <a class="btn-secondary" href="/about/ingest-and-webhooks">{t.ingestWebhooks}</a>
        <a class="btn-ghost" href="/freeze-map#embed">{t.freezeMapEmbed}</a>
      </div>
    </section>
  </div>
</Layout>
