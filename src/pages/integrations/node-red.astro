---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { fmt, getLocale } from "../../i18n";
import { integrationsMessages } from "../../i18n/messages/integrations";
import { getLocalizedIntegrationTaglines } from "../../i18n/content/integrations";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../../i18n/content/marketingFaqs";
import {
  NODERED_FLOW_URL,
  NODERED_INTEGRATION_PAGE,
  NODERED_NAME,
} from "../../lib/nodeRedIntegration";
import { INTEGRATIONS_HUB_PAGE } from "../../lib/homeAssistantIntegration";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, NODERED_INTEGRATION_PAGE);
const locale = getLocale(Astro);
const m = integrationsMessages(locale);
const t = m.nodeRed;
const taglines = getLocalizedIntegrationTaglines(locale);
const faqs = getLocalizedMarketingFaqs("nodeRed", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: "/" },
    { name: m.breadcrumbIntegrations, path: INTEGRATIONS_HUB_PAGE },
    { name: "Node-RED", path: NODERED_INTEGRATION_PAGE },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "nodeRed", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={`${NODERED_NAME}: ${taglines.nodeRedTagline}`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={taglines.nodeRedTagline}
    >
      <a slot="actions" class="btn-primary" href={NODERED_FLOW_URL} download>
        {t.downloadFlow}
      </a>
      <a slot="actions" class="btn-secondary" href={user ? "/dashboard/devices" : "/register?next=/dashboard/devices"}>
        {user ? t.createPushDevice : t.startFreeDevices}
      </a>
      <a slot="actions" class="btn-ghost" href={INTEGRATIONS_HUB_PAGE}>{m.allIntegrations}</a>
      <a slot="actions" class="btn-ghost" href="/about/mqtt-bridge">{t.mqttBridgeRecipe}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.installTitle}</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li set:html={t.step1Html} />
        <li set:html={fmt(t.step2Html, { href: NODERED_FLOW_URL })} />
        <li set:html={t.step3Html} />
        <li>{t.step4}</li>
      </ol>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.installFoot}</p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.postsTitle}</h2>
      <p class="text-sm mb-2" set:html={t.postsLedeHtml} />
      <pre class="text-xs overflow-x-auto mb-0"><code>{`{
  "topic": "home/garage/temp",
  "message": { "temp1": 42.5, "humidity": 55 }
}`}</code></pre>
    </section>

    <section class="card">
      <h2 class="card-title">{t.relatedTitle}</h2>
      <ul class="text-sm space-y-2 mb-0 pl-5 list-disc">
        {t.relatedItemsHtml.map((item) => <li set:html={item} />)}
      </ul>
    </section>

    <FaqSection title={t.faqTitle} faqs={faqs} lede={t.faqLede} />
  </div>
</Layout>
