---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { fmt, getLocale } from "../../i18n";
import { integrationsMessages } from "../../i18n/messages/integrations";
import { getLocalizedIntegrationTaglines } from "../../i18n/content/integrations";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../../i18n/content/marketingFaqs";
import {
  INFLUX_INTEGRATION_PAGE,
  INFLUX_NAME,
  TELEGRAF_CONFIG_URL,
} from "../../lib/influxIntegration";
import { INTEGRATIONS_HUB_PAGE } from "../../lib/homeAssistantIntegration";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, INFLUX_INTEGRATION_PAGE);
const locale = getLocale(Astro);
const m = integrationsMessages(locale);
const t = m.influx;
const taglines = getLocalizedIntegrationTaglines(locale);
const faqs = getLocalizedMarketingFaqs("influx", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: "/" },
    { name: m.breadcrumbIntegrations, path: INTEGRATIONS_HUB_PAGE },
    { name: t.breadcrumb, path: INFLUX_INTEGRATION_PAGE },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "influx", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={`${INFLUX_NAME}: ${taglines.influxTagline}`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={taglines.influxTagline}
    >
      <a slot="actions" class="btn-primary" href={TELEGRAF_CONFIG_URL} download>
        {t.downloadTelegraf}
      </a>
      <a slot="actions" class="btn-secondary" href={user ? "/dashboard/share" : "/register?next=/dashboard/share"}>
        {user ? t.createApiKey : t.startFreePro}
      </a>
      <a slot="actions" class="btn-ghost" href="/docs/api">{t.httpApi}</a>
      <a slot="actions" class="btn-ghost" href={INTEGRATIONS_HUB_PAGE}>{m.allIntegrations}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.howTitle}</h2>
      <p class="text-sm mb-0" set:html={t.howCopyHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.quickTitle}</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li set:html={t.quickStep1Html} />
        <li set:html={fmt(t.quickStep2Html, { href: TELEGRAF_CONFIG_URL })} />
        <li set:html={t.quickStep3Html} />
      </ol>
      <pre class="text-xs overflow-x-auto mb-0"><code>{`curl -sH "Authorization: Bearer $PROBEHARBOR_API_KEY" \\
  https://probeharbor.dev/api/v1/metrics | head`}</code></pre>
    </section>

    <section class="card">
      <h2 class="card-title">{t.shapeTitle}</h2>
      <p class="text-sm mb-2" set:html={t.shapeCopyHtml} />
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.shapeFoot}</p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.grafanaTitle}</h2>
      <p class="mb-0 text-sm" set:html={t.grafanaCopyHtml} />
    </section>

    <FaqSection title={t.faqTitle} faqs={faqs} lede={t.faqLede} />
  </div>
</Layout>
