---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { fmt, getLocale } from "../../i18n";
import { integrationsMessages } from "../../i18n/messages/integrations";
import { getLocalizedIntegrationTaglines } from "../../i18n/content/integrations";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../../i18n/content/marketingFaqs";
import {
  AUTOMATION_INTEGRATION_PAGE,
  AUTOMATION_NAME,
  N8N_ALERT_SHEETS_FLOW_URL,
} from "../../lib/automationIntegration";
import { INTEGRATIONS_HUB_PAGE } from "../../lib/homeAssistantIntegration";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, AUTOMATION_INTEGRATION_PAGE);
const locale = getLocale(Astro);
const m = integrationsMessages(locale);
const t = m.automation;
const taglines = getLocalizedIntegrationTaglines(locale);
const faqs = getLocalizedMarketingFaqs("automation", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: "/" },
    { name: m.breadcrumbIntegrations, path: INTEGRATIONS_HUB_PAGE },
    { name: t.breadcrumb, path: AUTOMATION_INTEGRATION_PAGE },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "automation", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={`${AUTOMATION_NAME}: ${taglines.automationTagline}`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={taglines.automationTagline}
    >
      <a slot="actions" class="btn-primary" href={user ? "/dashboard/alerts" : "/register?next=/dashboard/alerts"}>
        {user ? t.alertsWebhooks : t.startFreeTrial}
      </a>
      <a slot="actions" class="btn-secondary" href={N8N_ALERT_SHEETS_FLOW_URL} download>
        {t.downloadN8n}
      </a>
      <a slot="actions" class="btn-ghost" href="/about/zapier-make-recipes">{t.zapierMake}</a>
      <a slot="actions" class="btn-ghost" href={INTEGRATIONS_HUB_PAGE}>{m.allIntegrations}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">IFTTT</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
        {t.iftttStepsHtml.map((step) => <li set:html={step} />)}
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">n8n</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li set:html={fmt(t.n8nStep1Html, { href: N8N_ALERT_SHEETS_FLOW_URL })} />
        <li>{t.n8nStep2}</li>
        <li set:html={t.n8nStep3Html} />
      </ol>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.n8nFootHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.sheetsTitle}</h2>
      <p class="text-sm mb-2">{t.sheetsLede}</p>
      <ul class="text-sm space-y-2 mb-0 pl-5 list-disc">
        <li set:html={t.sheetsItemHtml} />
        <li set:html={t.notionItemHtml} />
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.inboundTitle}</h2>
      <p class="text-sm mb-2">{t.inboundLede}</p>
      <pre class="text-xs overflow-x-auto mb-2"><code>{`POST /api/inbound/gtw_…
Content-Type: application/json
X-ProbeHarbor-Signature: <hmac-sha256-hex>

{"action":"snooze","hours":24}`}</code></pre>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.inboundFootHtml} />
    </section>

    <FaqSection title={t.faqTitle} faqs={faqs} lede={t.faqLede} />
  </div>
</Layout>
