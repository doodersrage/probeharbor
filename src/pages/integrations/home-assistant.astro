---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { fmt, getLocale } from "../../i18n";
import { integrationsMessages } from "../../i18n/messages/integrations";
import { getLocalizedIntegrationTaglines } from "../../i18n/content/integrations";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../../i18n/content/marketingFaqs";
import {
  HACS_REPO_URL,
  HA_BLUEPRINT_URL,
  HA_DEV_DOCS_INGEST,
  HA_ENTITIES_YAML,
  INTEGRATIONS_HUB_PAGE,
} from "../../lib/homeAssistantIntegration";
import { HACS_BADGE_URL } from "../../lib/integrationsHub";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/integrations/home-assistant");
const locale = getLocale(Astro);
const m = integrationsMessages(locale);
const t = m.ha;
const taglines = getLocalizedIntegrationTaglines(locale);
const haFaqs = getLocalizedMarketingFaqs("homeAssistant", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: "/" },
    { name: "Home Assistant", path: "/integrations/home-assistant" },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "homeAssistant", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={taglines.haDescription}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href={HACS_REPO_URL} target="_blank" rel="noreferrer">
        {t.hacsRepo}
      </a>
      <a slot="actions" class="btn-secondary" href={user ? "/dashboard/share" : "/register?next=/dashboard/share"}>
        {user ? m.createShareLink : m.startFreeShareLink}
      </a>
      <a slot="actions" class="btn-ghost" href={INTEGRATIONS_HUB_PAGE}>{m.allIntegrations}</a>
      <a slot="actions" class="btn-ghost" href="/compare/diy-mqtt">{t.vsDiyMqtt}</a>
    </PageHeader>

    <section class="card">
      <div class="flex flex-wrap items-center gap-4 mb-0">
        <a href={HACS_REPO_URL} target="_blank" rel="noreferrer">
          <img src={HACS_BADGE_URL} alt="HACS Custom" width="120" height="28" loading="lazy" />
        </a>
        <p class="text-sm text-[var(--color-text-muted)] mb-0" set:html={t.statusHtml} />
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">{t.addsTitle}</h2>
      <ul class="text-sm space-y-2 mb-4">
        {t.addsItemsHtml.map((item) => <li set:html={item} />)}
      </ul>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.addsFootHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.installTitle}</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li set:html={t.installStep1Html} />
        <li set:html={fmt(t.installStep2Html, { repo: HACS_REPO_URL })} />
        <li set:html={t.installStep3Html} />
        <li set:html={t.installStep4Html} />
        <li set:html={t.installStep5Html} />
      </ol>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]" set:html={fmt(t.installFootHtml, { devDocsUrl: HA_DEV_DOCS_INGEST })} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.showsTitle}</h2>
      <ul class="text-sm space-y-2 mb-0">
        {t.showsItemsHtml.map((item) => <li set:html={item} />)}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.formatsTitle}</h2>
      <p class="card-subtitle mb-4">{t.formatsLede}</p>
      <ul class="text-sm space-y-2 mb-4">
        {t.formatsItemsHtml.map((item) => <li set:html={item} />)}
      </ul>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        {t.liveSamples}
        <a class="text-link" href="/api/feeds/example?format=homeassistant">{t.sampleHaRest}</a>
        ·
        <a class="text-link" href="/api/feeds/example?format=senml">{t.sampleSenml}</a>
        ·
        <a class="text-link" href="/about/ingest-and-webhooks">{t.ingestFormatsGuide}</a>
      </p>
    </section>

    <section class="card" id="indoor-temperature">
      <h2 class="card-title">{t.indoorTitle}</h2>
      <p class="card-subtitle mb-4">{t.indoorLede}</p>

      <h3 class="text-base font-semibold mt-2 mb-2">{t.nestTitle}</h3>
      <p class="text-sm mb-3" set:html={t.nestCopyHtml} />
      <ul class="text-sm space-y-2 mb-4">
        <li set:html={t.nestCompareHtml} />
        <li set:html={t.nestOperatorHtml} />
      </ul>

      <h3 class="text-base font-semibold mt-2 mb-2">{t.planBTitle}</h3>
      <p class="text-sm mb-3" set:html={t.planBCopyHtml} />
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        {t.planBStepsHtml.map((step) => <li set:html={step} />)}
      </ol>
      <pre class="text-xs overflow-x-auto mb-4"><code>{`automation:
  - alias: Push house temp to ProbeHarbor
    trigger:
      - platform: time_pattern
        minutes: "/15"
    action:
      - service: thermaltrace.push
        data:
          sensors:
            - key: house_indoor
              kind: temperature
              value: "{{ state_attr('climate.living_room', 'current_temperature') }}"
              unit: F`}</code></pre>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.planBFootHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.mqttTitle}</h2>
      <p class="card-subtitle mb-4">{t.mqttLede}</p>
      <ul class="text-sm space-y-2 mb-0">
        {t.mqttItemsHtml.map((item) => <li set:html={item} />)}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.alertsTitle}</h2>
      <p class="card-subtitle mb-4">{t.alertsLede}</p>
      <ul class="text-sm space-y-2 mb-4">
        <li>
          <a class="text-link" href={HA_BLUEPRINT_URL} download>{t.downloadBlueprint}</a>
        </li>
        <li set:html={fmt(t.entityYamlHtml, { href: HA_ENTITIES_YAML })} />
        <li set:html={t.productGuideHtml} />
        <li set:html={t.configureTokensHtml} />
      </ul>
      <p class="text-sm mb-0" set:html={t.verifyHtml} />
    </section>

    <section class="card">
      <h2 class="card-title">{t.exampleTitle}</h2>
      <p class="card-subtitle mb-4">{t.exampleLede}</p>
      <pre class="text-xs overflow-x-auto mb-0"><code>{`automation:
  - alias: Snooze ProbeHarbor while door open
    trigger:
      - platform: state
        entity_id: cover.garage_door
        to: "open"
    action:
      - service: thermaltrace.snooze
        data:
          hours: 4`}</code></pre>
    </section>

    <FaqSection faqs={haFaqs} lede={t.faqLede} />
  </div>
</Layout>
