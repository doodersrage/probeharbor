---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminNav from "../../components/dashboard/AdminNav.astro";
import { collectAllUsersFeedHealth } from "../../lib/collectHistory";
import { feedHealthMessage } from "../../lib/feedErrorText";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";
import { fmt, formatNumber, getLocale, LOCALE_META } from "../../i18n";
import { adminMessages } from "../../i18n/messages/app/admin";

const locale = getLocale(Astro);
const a = adminMessages(locale);
const t = a.feeds;
const intl = LOCALE_META[locale].intl;

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

// Gate before admin-only fetches -- DashboardLayout's own requireAdmin
// check runs too late to stop this page's frontmatter from already
// having queried every account's feed health (Astro.redirect() from a
// nested layout isn't a reliable way to abort a page's response; see
// ops.astro).
if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const { statuses, errors } = await collectAllUsersFeedHealth();
const failing = statuses.filter((status) => !status.ok);
const healthy = statuses.filter((status) => status.ok);
---

<DashboardLayout title={t.title} subtitle={t.subtitle} requireAdmin>
  <div class="space-y-6">
    <AdminNav />
    {errors.length > 0 && (
      <div class="alert-warning">
        {errors.map((message) => <p class="m-0">{message}</p>)}
      </div>
    )}
    <section class="card animate-slide-in-left">
      <h2 class="card-title">{fmt(t.failingTitle, { count: formatNumber(failing.length, locale) })}</h2>
      {failing.length === 0 ? (
        <p class="m-0 stat-detail">{t.allOk}</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">{a.common.user}</th>
                <th scope="col">{a.common.feed}</th>
                <th scope="col">{t.url}</th>
                <th scope="col">{a.common.status}</th>
              </tr>
            </thead>
            <tbody>
              {failing.map((status) => (
                <tr>
                  <td>{status.userEmail ?? status.userId}</td>
                  <td>{status.feedName}</td>
                  <td><code>{status.url}</code></td>
                  <td>{feedHealthMessage(status, locale)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">{fmt(t.healthyTitle, { count: formatNumber(healthy.length, locale) })}</h2>
      {healthy.length === 0 ? (
        <p class="m-0 stat-detail">{t.noHealthy}</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">{a.common.user}</th>
                <th scope="col">{a.common.feed}</th>
                <th scope="col">{t.probes}</th>
                <th scope="col">{t.checked}</th>
              </tr>
            </thead>
            <tbody>
              {healthy.map((status) => (
                <tr>
                  <td>{status.userEmail ?? status.userId}</td>
                  <td>{status.feedName}</td>
                  <td>{status.probeCount}</td>
                  <td>{new Date(status.checkedAt).toLocaleString(intl)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
