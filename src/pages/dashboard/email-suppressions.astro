---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminNav from "../../components/dashboard/AdminNav.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";
import { listEmailSuppressions } from "../../lib/emailSuppressions";
import { fmt, getLocale, LOCALE_META, plural } from "../../i18n";
import { adminMessages } from "../../i18n/messages/app/admin";

const locale = getLocale(Astro);
const a = adminMessages(locale);
const t = a.suppressions;
const intl = LOCALE_META[locale].intl;

const { session, user } = await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const removed = Astro.url.searchParams.get("removed") === "1";
const added = Astro.url.searchParams.get("added") === "1";
const formError = Astro.url.searchParams.get("error")?.trim() ?? "";
const { rows, error } = await listEmailSuppressions(200);
---
<DashboardLayout title={t.title} subtitle={t.subtitle} requireAdmin>
  <div class="space-y-6">
    <AdminNav />
    {(added || removed || formError) && (
      <div>
        {added && (
          <p class="alert-success mt-0 mb-0" role="status">{t.added}</p>
        )}
        {removed && (
          <p class="alert-success mt-0 mb-0" role="status">{t.removed}</p>
        )}
        {formError && (
          <p class="alert-warning mt-0 mb-0" role="alert">{fmt(t.updateError, { error: formError })}</p>
        )}
      </div>
    )}

    <section class="card">
      <h2 class="card-title">{t.addTitle}</h2>
      <p class="card-subtitle mb-4">
        {t.addSubtitle}
      </p>
      <form method="POST" action="/api/admin/email-suppressions/add" class="space-y-4">
        <div class="form-field">
          <label class="form-label" for="suppress-email">{a.common.email}</label>
          <input
            class="form-input"
            type="email"
            id="suppress-email"
            name="email"
            required
            autocomplete="off"
            placeholder="user@example.com"
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="suppress-reason">{t.reason}</label>
          <select class="form-input" id="suppress-reason" name="reason">
            <option value="manual">{t.reasons.manual}</option>
            <option value="bounce">{t.reasons.bounce}</option>
            <option value="invalid">{t.reasons.invalid}</option>
            <option value="noreply">{t.reasons.noreply}</option>
            <option value="complaint">{t.reasons.complaint}</option>
          </select>
        </div>
        <div class="form-field">
          <label class="form-label" for="suppress-note">{t.note}</label>
          <input
            class="form-input"
            type="text"
            id="suppress-note"
            name="note"
            maxlength="500"
            placeholder={t.notePlaceholder}
          />
        </div>
        <button class="btn-primary" type="submit">{t.submit}</button>
      </form>
    </section>

    <section class="card">
      {error ? (
        <p class="alert-warning mb-0">{fmt(t.loadError, { error })}</p>
      ) : rows.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.empty}</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>{a.common.email}</th>
                <th>{t.reason}</th>
                <th>{t.updated}</th>
                <th>{t.lastError}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td>
                    <code>{row.email}</code>
                  </td>
                  <td>{row.reason}</td>
                  <td>{new Date(row.updated_at).toLocaleString(intl)}</td>
                  <td class="contact-message-cell">
                    {row.last_error ? <code>{row.last_error}</code> : a.common.dash}
                  </td>
                  <td>
                    <form method="POST" action="/api/admin/email-suppressions/remove">
                      <input type="hidden" name="email" value={row.email} />
                      <button type="submit" class="btn-ghost text-sm">
                        {t.remove}
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
        {plural(t.showing, rows.length, locale)}
      </p>
    </section>
  </div>
</DashboardLayout>
