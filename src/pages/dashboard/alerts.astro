---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AlertSettings from "../../components/AlertSettings.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import ProductAnalyticsTracker from "../../components/ProductAnalyticsTracker.astro";
import ReferralCard from "../../components/ReferralCard.astro";
import FalseAlarmTipsCard from "../../components/dashboard/FalseAlarmTipsCard.astro";
import AlertActivityList from "../../components/dashboard/AlertActivityList.astro";
import DashboardTabNav from "../../components/dashboard/DashboardTabNav.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { resolveSiteUrl } from "../../lib/schemaMarkup";
import {
  ensureAlertDeliveryEvidence,
  getAlertSettingsForUser,
  isTwilioConfigured,
} from "../../lib/notify";
import { getRuntimeEnv } from "../../lib/runtimeEnv";
import { getUserEntitlements } from "../../lib/entitlements";
import { listRecentAlertEvents, listRecentAlertEventsFiltered } from "../../lib/alertEvents";
import { summarizeChannelDelivery } from "../../lib/channelDelivery";
import { formatAlertChannelsCsv } from "../../lib/alertChannelLabels";
import { formatRelativeAge } from "../../lib/relativeTime";
import {
  getOrCreateHouseholdForUser,
  getUserHouseholdRole,
  canEditHousehold,
} from "../../lib/households";
import { listHouseholdDevices } from "../../lib/devices";
import { getTenantNotifySettings } from "../../lib/tenantRelay";
import { listAlertSettingsHistory } from "../../lib/alertSettingsHistory";
import { fmt, formatDateTime, getLocale } from "../../i18n";
import { alertsMessages } from "../../i18n/messages/app/alerts";

const locale = getLocale(Astro);
const t = alertsMessages(locale);
/** Text for a single-quoted JS string inside an onsubmit attribute. */
const jsQuote = (text: string) => text.replace(/\\/g, "\\\\").replace(/'/g, "\\'");

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}
const unackedAlertCount = shell?.unackedAlerts ?? 0;
const activityPage = Math.max(1, Number(Astro.url.searchParams.get("activity_page") ?? "1") || 1);
const activityKind = Astro.url.searchParams.get("activity_kind")?.trim() ?? "";
const activityUnacked = Astro.url.searchParams.has("activity_unacked")
  ? Astro.url.searchParams.get("activity_unacked") === "1"
  : unackedAlertCount > 0;
const handleAlertsFirst = unackedAlertCount > 0 || activityUnacked;
const tabParam = Astro.url.searchParams.get("tab");
const alertsTab =
  tabParam === "settings" || tabParam === "activity"
    ? tabParam
    : handleAlertsFirst
      ? "activity"
      : "settings";
const activityQuery = (page: number) => {
  const params = new URLSearchParams();
  params.set("tab", "activity");
  if (activityKind) params.set("activity_kind", activityKind);
  if (activityUnacked) params.set("activity_unacked", "1");
  if (page > 1) params.set("activity_page", String(page));
  return `/dashboard/alerts?${params.toString()}#recent-alert-activity`;
};

const household = await getOrCreateHouseholdForUser(user.id, user.email);
const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canEdit = canEditHousehold(householdRole);

const activityPageSize = 20;
const activityOffset = (activityPage - 1) * activityPageSize;

const [
  alertSettingsLoaded,
  entitlements,
  activityPageResult,
  devicesResult,
  tenantNotify,
  deliveryEvents,
] =
  await Promise.all([
    getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
    shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
    listRecentAlertEventsFiltered(user.id, {
      limit: activityPageSize,
      offset: activityOffset,
      kind: activityKind || null,
      unackedOnly: activityUnacked,
    }),
    household.householdId
      ? listHouseholdDevices(household.householdId)
      : Promise.resolve({ devices: [] as Awaited<ReturnType<typeof listHouseholdDevices>>["devices"], error: null }),
    household.householdId
      ? getTenantNotifySettings(household.householdId)
      : Promise.resolve({ email: null, name: null }),
    listRecentAlertEvents(user.id, 100),
  ]);
const channelDelivery = summarizeChannelDelivery(deliveryEvents);

const recentEvents = activityPageResult.events;
const activityHasMore = activityPageResult.hasMore;

const { settings: alertSettings, hasDelivery } = await ensureAlertDeliveryEvidence(
  user.id,
  alertSettingsLoaded,
);

const hasTenantRelay = Boolean(tenantNotify.email);
const hasOutboundWebhook = Boolean(alertSettings.outboundWebhookUrl?.trim());

const deviceSpaces = [
  ...new Set(
    (devicesResult.devices ?? [])
      .map((device) => device.space?.trim())
      .filter((space): space is string => Boolean(space)),
  ),
].sort((a, b) => a.localeCompare(b));

const thresholdSensors = (devicesResult.devices ?? []).flatMap((device) =>
  device.sensors
    .filter((sensor) => sensor.kind === "temperature")
    .map((sensor) => ({
      id: sensor.id,
      label: sensor.label,
      deviceName: device.name,
      space: device.space ?? null,
    })),
);

const settingsHistory =
  alertsTab === "settings" && canEdit ? await listAlertSettingsHistory(user.id, 8).catch(() => []) : [];

const sentChannels = formatAlertChannelsCsv(Astro.url.searchParams.get("sent"), locale);
const skippedChannels = formatAlertChannelsCsv(Astro.url.searchParams.get("skipped"), locale);
const testReason = Astro.url.searchParams.get("test_reason");

const notices = t.notices;
const alertNotice = Astro.url.searchParams.get("alert_saved") === "restored"
  ? notices.restored
  : Astro.url.searchParams.get("alert_saved")
  ? Astro.url.searchParams.get("channels_incomplete")
    ? notices.savedIncomplete
    : notices.saved
  : Astro.url.searchParams.get("alert_error")
    ? Astro.url.searchParams.get("alert_error") === "invalid_webhook_url"
      ? notices.invalidWebhookUrl
      : Astro.url.searchParams.get("alert_error") === "weak_telegram_secret"
        ? notices.weakTelegramSecret
        : Astro.url.searchParams.get("alert_error") === "restore_failed"
          ? notices.restoreFailed
          : notices.saveFailed
    : Astro.url.searchParams.get("test_sent")
      ? skippedChannels
        ? fmt(notices.testSentSkipped, { sent: sentChannels, skipped: skippedChannels })
        : fmt(notices.testSentVia, { channels: sentChannels || notices.yourEnabledChannels })
      : Astro.url.searchParams.get("test_error")
        ? testReason === "incomplete"
          ? notices.testIncomplete
          : testReason === "none"
            ? notices.testNoChannels
            : notices.testFailed
        : Astro.url.searchParams.get("ack_ok")
          ? Astro.url.searchParams.get("ack_msg") ?? notices.ackOk
          : Astro.url.searchParams.get("ack_error")
            ? Astro.url.searchParams.get("ack_msg") ?? notices.ackError
            : null;

const alertNoticeIsError =
  Boolean(Astro.url.searchParams.get("alert_error")) ||
  Boolean(Astro.url.searchParams.get("test_error")) ||
  Boolean(Astro.url.searchParams.get("channels_incomplete"));

const needsPro =
  !entitlements.canUseSms ||
  !entitlements.canUsePush ||
  !entitlements.canUseOutboundWebhook;

const lastAlertCandidates = [
  alertSettings.lastAlertSentAt,
  alertSettings.lastOutageAlertAt,
  alertSettings.lastRateAlertAt,
  alertSettings.lastForecastAlertAt,
].filter(Boolean) as string[];
const lastAlertAt =
  lastAlertCandidates.sort((a, b) => Date.parse(b) - Date.parse(a))[0] ?? null;
const lastAlertAge = formatRelativeAge(lastAlertAt, undefined, locale);
// Test sends don't set cooldown timestamps; fall back to the alert log.
const hasSentAnyAlert =
  Boolean(
    alertSettings.lastAlertSentAt ||
      alertSettings.lastOutageAlertAt ||
      alertSettings.lastRateAlertAt,
  ) || hasDelivery;

const analyticsEvents = (() => {
  const events: Array<{
    name: import("../../lib/productAnalytics").ProductEvent;
    props?: Record<string, string | number | boolean>;
  }> = [];
  if (Astro.url.searchParams.get("test_sent")) {
    events.push({ name: "first_alert_test" });
  }
  if (Astro.url.searchParams.get("alert_saved")) {
    events.push({ name: "alert_essentials_saved" });
  }
  return events;
})();

const testSent = Boolean(Astro.url.searchParams.get("test_sent"));

const showReferralNudge =
  canEdit &&
  !testSent &&
  (recentEvents.length > 0 || Boolean(lastAlertAt));

const showReferralCard = (testSent && canEdit) || showReferralNudge;

const primaryUpgradeFeature = testSent
  ? needsPro
    ? ("sms_alerts" as const)
    : !entitlements.canUseClaimsPack
      ? ("claims_pack" as const)
      : null
  : !entitlements.canUseForecastAlerts
    ? ("cold_risk" as const)
    : needsPro
      ? ("sms_alerts" as const)
      : null;

const siteUrl = resolveSiteUrl(Astro.site);
const referralRewardDays = Number(
  (user.app_metadata as Record<string, unknown> | undefined)?.referral_reward_days ?? 0,
);
---
<DashboardLayout
  title={t.page.title}
  subtitle={t.page.subtitle}
>
  <ProductAnalyticsTracker events={analyticsEvents} />
  <div class="space-y-6">
    <DashboardTabNav
      tabs={[
        { id: "activity", label: unackedAlertCount > 0 ? fmt(t.page.tabActivityCount, { count: unackedAlertCount }) : t.page.tabActivity, href: "/dashboard/alerts?tab=activity" },
        { id: "settings", label: t.page.tabSettings, href: "/dashboard/alerts?tab=settings" },
      ]}
      activeId={alertsTab}
      ariaLabel={t.page.tabsLabel}
    />

    {alertNotice && (
      <p class:list={[alertNoticeIsError ? "alert-warning" : "alert-success", "mt-0 mb-0"]} role="status">
        {alertNotice}
      </p>
    )}

    {alertsTab === "activity" ? (
      <>
        <p class="mt-0 mb-0 text-sm text-[var(--color-text-muted)]">
          {t.status.label} <strong>{alertSettings.enabled ? t.status.on : t.status.off}</strong>
          {lastAlertAt ? (
            <>
              {" · "}{fmt(t.status.lastAlert, { age: lastAlertAge.label })}
              {lastAlertAge.absolute ? ` (${lastAlertAge.absolute})` : ""}
            </>
          ) : (
            <> · {t.status.noAlertsYet}</>
          )}
        </p>
        <section class="card">
          <h2 class="card-title">{t.activity.heading}</h2>
          <p class="card-subtitle mb-4">{t.activity.subtitle}</p>
          <form class="mb-4 flex flex-wrap items-end gap-3" method="get" action="/dashboard/alerts">
            <input type="hidden" name="tab" value="activity" />
            <div class="form-field mb-0">
              <label class="form-label" for="activity_kind">{t.activity.kindLabel}</label>
              <select class="form-input" id="activity_kind" name="activity_kind">
                <option value="" selected={!activityKind}>{t.activity.kinds.all}</option>
                <option value="freeze" selected={activityKind === "freeze"}>{t.activity.kinds.freeze}</option>
                <option value="flood" selected={activityKind === "flood"}>{t.activity.kinds.flood}</option>
                <option value="forecast" selected={activityKind === "forecast"}>{t.activity.kinds.forecast}</option>
                <option value="threshold" selected={activityKind === "threshold"}>{t.activity.kinds.threshold}</option>
                <option value="test" selected={activityKind === "test"}>{t.activity.kinds.test}</option>
              </select>
            </div>
            <label class="checkbox-row mb-0">
              <input type="checkbox" name="activity_unacked" value="1" checked={activityUnacked} />
              <span>{t.activity.unhandledOnly}</span>
            </label>
            <button type="submit" class="btn-secondary btn-sm">{t.activity.filter}</button>
            {(activityKind || activityUnacked || activityPage > 1) && (
              <a class="btn-ghost btn-sm" href="/dashboard/alerts?tab=activity#recent-alert-activity">{t.activity.clear}</a>
            )}
          </form>
          {canEdit && unackedAlertCount > 1 && (
            <form
              class="mb-4"
              action="/api/user/alert-events/ack"
              method="post"
              onsubmit={`return confirm('${jsQuote(fmt(t.activity.confirmAckAll, { count: unackedAlertCount }))}');`}
            >
              <input type="hidden" name="action" value="ack_all" />
              <input type="hidden" name="redirect" value="/dashboard/alerts?tab=activity" />
              <button type="submit" class="btn-secondary btn-sm">
                {fmt(t.activity.markAllHandled, { count: unackedAlertCount })}
              </button>
            </form>
          )}
          <div id="recent-alert-activity">
            <AlertActivityList
              events={recentEvents}
              canEdit={canEdit}
              hasTenantRelay={hasTenantRelay}
              hasOutboundWebhook={hasOutboundWebhook}
              canUseOutboundWebhook={entitlements.canUseOutboundWebhook}
            />
          </div>
          {(activityPage > 1 || activityHasMore) && (
            <div class="mt-4 flex flex-wrap gap-2">
              {activityPage > 1 && (
                <a class="btn-ghost btn-sm" href={activityQuery(activityPage - 1)}>{t.activity.newer}</a>
              )}
              {activityHasMore && (
                <a class="btn-secondary btn-sm" href={activityQuery(activityPage + 1)}>{t.activity.older}</a>
              )}
            </div>
          )}
        </section>
        {canEdit && recentEvents.length > 0 && (
          <FalseAlarmTipsCard />
        )}
        {recentEvents.some((event) =>
          ["threshold", "freeze", "forecast", "nws", "flood", "humidity"].some((kind) =>
            event.kind?.toLowerCase().includes(kind),
          ),
        ) && (
          <section class="card">
            <h2 class="card-title">{t.claims.heading}</h2>
            <p class="card-subtitle mb-4">
              {t.claims.body}
            </p>
            <a class="btn-secondary" href="/dashboard/history?tab=exports#claims-pack">
              {entitlements.canUseClaimsPack ? t.claims.open : t.claims.seePro}
            </a>
          </section>
        )}
      </>
    ) : (
      <>
        {testSent && (
          <section class="card alert-success">
            <h2 class="card-title">{t.testSent.heading}</h2>
            <p class="card-subtitle mb-4">
              {t.testSent.body}
            </p>
            <div class="flex flex-wrap gap-3 mb-0">
              {entitlements.canCreateShareLinks || entitlements.canCreateFamilyShareLink ? (
                <a class="btn-primary" href="/dashboard/share/links">{t.testSent.shareFamily}</a>
              ) : (
                <a class="btn-primary" href="/dashboard/share/links">{t.testSent.shareLinks}</a>
              )}
              <a class="btn-secondary" href="/dashboard/history?tab=exports#claims-pack">
                {entitlements.canUseClaimsPack ? t.testSent.downloadClaims : t.testSent.claimsEvidence}
              </a>
              {needsPro && (
                <a class="btn-ghost" href="/dashboard/plans">{t.testSent.comparePlans}</a>
              )}
            </div>
          </section>
        )}

        {primaryUpgradeFeature && (
          <UpgradeNudge feature={primaryUpgradeFeature} tier={entitlements.tier} compact />
        )}

        <AlertSettings
          channelDelivery={channelDelivery}
          userEmail={user.email ?? ""}
          settings={alertSettings}
          entitlements={entitlements}
          vapidPublicKey={getRuntimeEnv("VAPID_PUBLIC_KEY") ?? ""}
          twilioConfigured={isTwilioConfigured()}
          redirectTo="/dashboard/alerts?tab=settings"
          canEdit={canEdit}
          essentialsFirst={!hasSentAnyAlert}
          deviceSpaces={deviceSpaces}
          thresholdSensors={thresholdSensors}
        />

        {canEdit && (
          <section class="card" id="send-test-alert">
            <h2 class="card-title">{t.testCard.heading}</h2>
            <p class="card-subtitle mb-4">
              {lastAlertAt || testSent
                ? t.testCard.bodyRepeat
                : t.testCard.bodyFirst}
            </p>
            <form action="/api/user/alert-test" method="post">
              <input type="hidden" name="redirect" value="/dashboard/alerts?tab=settings" />
              <button
                class:list={lastAlertAt || testSent ? "btn-secondary" : "btn-primary"}
                type="submit"
              >
                {t.testCard.sendNow}
              </button>
            </form>
          </section>
        )}

        {settingsHistory.length > 0 && (
          <section class="card" id="alert-settings-history">
            <h2 class="card-title">{t.history.heading}</h2>
            <p class="card-subtitle mb-3">
              {t.history.body}
            </p>
            <ul class="alert-history-list">
              {settingsHistory.map((entry, index) => (
                <li class="alert-history-row">
                  <div>
                    <p class="m-0 text-sm font-medium">
                      {formatDateTime(entry.savedAt, locale, {
                        month: "short",
                        day: "numeric",
                        hour: "numeric",
                        minute: "2-digit",
                        timeZone: alertSettings.quietHoursTimezone || "UTC",
                      })}
                    </p>
                    <p class="m-0 text-sm text-[var(--color-text-muted)]">{entry.changes.join(" · ")}</p>
                  </div>
                  <form
                    action="/api/user/alert-settings-restore"
                    method="post"
                    onsubmit={`return confirm('${jsQuote(index === 0 ? t.history.confirmUndo : t.history.confirmRestore)}');`}
                  >
                    <input type="hidden" name="history_id" value={String(entry.id)} />
                    <input type="hidden" name="redirect" value="/dashboard/alerts?tab=settings" />
                    <button type="submit" class="btn-ghost btn-sm">
                      {index === 0 ? t.history.undo : t.history.restoreBefore}
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        )}

        {showReferralCard && (
          <ReferralCard siteUrl={siteUrl} rewardDays={referralRewardDays} />
        )}

      </>
    )}
  </div>
</DashboardLayout>

<style>
  .alert-history-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .alert-history-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--color-border);
  }
</style>

<script>
  const flashKeys = [
    "alert_saved",
    "alert_error",
    "channels_incomplete",
    "test_sent",
    "test_error",
    "test_reason",
    "sent",
    "skipped",
    "ack_ok",
    "ack_error",
    "ack_msg",
    "snooze",
    "snooze_cleared",
    "hours",
    "vacation",
    "vacation_cleared",
    "vacation_error",
    "days",
  ];
  const url = new URL(window.location.href);
  let changed = false;
  for (const key of flashKeys) {
    if (url.searchParams.has(key)) {
      url.searchParams.delete(key);
      changed = true;
    }
  }
  if (changed) {
    window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
  }
</script>
