---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import ReadingAgeBadge from "../../../components/dashboard/ReadingAgeBadge.astro";
import SensorReplaceCard from "../../../components/dashboard/SensorReplaceCard.astro";
import RevealIngestKeyButton from "../../../components/RevealIngestKeyButton";
import { getAuthFromCookies } from "../../../lib/auth";
import { listHouseholdDevices, SENSOR_KIND_LABELS } from "../../../lib/devices";
import {
  canEditHousehold,
  getOrCreateHouseholdForUser,
  getUserHouseholdRole,
  listUserHouseholds,
} from "../../../lib/households";
import { latestFromShell } from "../../../lib/dashboardShell";
import { fetchLatestSensorValues } from "../../../lib/sensorReadings";
import { findStuckSensors } from "../../../lib/stuckSensors";
import { formatBatteryEta, scoreDeviceHealth } from "../../../lib/deviceHealthScore";
import { formatSensorValue, spaceSuggestions } from "../../../lib/deviceList";
import { firmwareUpdateAvailable, LATEST_FIRMWARE_VERSION } from "../../../lib/firmwareVersion";
import { listIngestStatsForHousehold } from "../../../lib/ingestStats";
import { ingestKeyVaultConfigured } from "../../../lib/ingestKeyVault";
import { replacementErrorMessage } from "../../../lib/sensorReplacement";
import { formatRelativeAge } from "../../../lib/relativeTime";

/**
 * One device, everything about it: what it reads, its settings, how it
 * connects, maintenance, and (set apart at the bottom) rotate key and delete.
 */
const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell ? { session: shell.session, user: shell.user } : await getAuthFromCookies(Astro.cookies);
if (!session || !user) return Astro.redirect("/signin");

const household = await getOrCreateHouseholdForUser(user.id, user.email);
const householdId = household.householdId;
if (!householdId) return Astro.redirect("/dashboard/devices");

const [{ devices }, role, userHouseholds] = await Promise.all([
  listHouseholdDevices(householdId),
  getUserHouseholdRole(user.id, householdId),
  shell ? Promise.resolve({ households: shell.households }) : listUserHouseholds(user.id),
]);
const device = devices.find((d) => d.id === Astro.params.id);
if (!device) return Astro.redirect("/dashboard/devices?view=ops&error=device_not_found");

const canEdit = canEditHousehold(role);
const isPush = device.source === "push";
const now = Date.now();
const [latestAll, stuck, ingestStats] = await Promise.all([
  latestFromShell(shell, householdId) ?? fetchLatestSensorValues(householdId),
  findStuckSensors([device], now).catch(() => []),
  isPush ? listIngestStatsForHousehold(householdId, 7).catch(() => []) : Promise.resolve([]),
]);
const latestBySensor = new Map(latestAll.map((row) => [row.sensor.id, row]));
const health = scoreDeviceHealth(device, latestAll, now, -80, stuck);
const stuckById = new Map(stuck.map((s) => [s.sensorId, s]));
const deviceStats = ingestStats.filter((row) => row.device_id === device.id);
const accepted = deviceStats.reduce((sum, row) => sum + row.success_count, 0);
const rejected = deviceStats.reduce((sum, row) => sum + row.error_count, 0);
const seen = formatRelativeAge(device.last_seen_at, "never");
const firmware = typeof device.meta?.firmware_version === "string" ? device.meta.firmware_version : null;
const rssi = typeof device.meta?.rssi === "number" ? device.meta.rssi : null;
const recoverableKey = typeof device.meta?.ingest_key_enc === "string";
const transferTargets = userHouseholds.households.filter((h) => h.household_id !== householdId);
const self = `/dashboard/devices/${encodeURIComponent(device.id)}`;
const listHref = "/dashboard/devices?view=ops";
const spaces = spaceSuggestions(devices);
const healthLabel = { healthy: "Healthy", watch: "Watch", at_risk: "At risk", offline: "Offline" }[health.label];
const healthTone = {
  healthy: "text-[var(--color-success)]",
  watch: "text-[var(--color-warning)]",
  at_risk: "text-[var(--color-danger)]",
  offline: "text-[var(--color-text-muted)]",
}[health.label];

const params = Astro.url.searchParams;
const replaceError = params.get("replace_error");
const sensorReplaced = params.get("sensor_replaced");
const notice = params.get("device_saved")
  ? "Device saved."
  : params.get("sensor_updated")
    ? "Sensors saved."
    : params.get("sensor_deleted")
      ? "Sensor deleted."
      : params.get("sensor_added")
        ? "Sensor added."
        : sensorReplaced
          ? `Sensor replaced: ${Number(sensorReplaced).toLocaleString("en-US")} readings moved.`
          : replaceError
            ? replacementErrorMessage(replaceError)
            : params.get("error")
              ? "Couldn't save that. Check the form and try again."
              : null;
const noticeIsError = Boolean(replaceError || params.get("error"));
---
<DashboardLayout title={device.name} subtitle={device.space ? `${device.space} · ${isPush ? "Push device" : "Pull feed"}` : isPush ? "Push device" : "Pull feed"}>
  <div class="space-y-6 device-page">
    <a class="text-link text-sm" href={listHref}>← All devices</a>

    {notice && (
      <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0 mb-0"]} role={noticeIsError ? "alert" : "status"}>
        {notice}
      </p>
    )}

    <section class="card" aria-labelledby="device-status-title">
      <h2 class="card-title" id="device-status-title">Status</h2>
      <dl class="device-facts">
        <div>
          <dt>Health</dt>
          <dd>
            <span class:list={["font-semibold", healthTone]}>{healthLabel}</span>
            <span class="text-[var(--color-text-muted)]"> {health.score}/100</span>
            <span class="block text-xs text-[var(--color-text-muted)]">{health.detail}</span>
          </dd>
        </div>
        <div>
          <dt>Last seen</dt>
          <dd><ReadingAgeBadge iso={device.last_seen_at} emptyLabel="Never" /></dd>
        </div>
        {health.batteryPct != null && (
          <div>
            <dt>Battery</dt>
            <dd>
              {health.batteryPct}%
              {health.daysRemaining != null && (
                <span class="block text-xs text-[var(--color-text-muted)]">{formatBatteryEta(health.daysRemaining)}</span>
              )}
            </dd>
          </div>
        )}
        {rssi != null && (
          <div>
            <dt>Wi-Fi signal</dt>
            <dd>{rssi} dBm</dd>
          </div>
        )}
        {firmware && (
          <div>
            <dt>Firmware</dt>
            <dd>
              {firmware}
              {firmwareUpdateAvailable(firmware) && (
                <a class="text-link block text-xs" href="/flash">Update to {LATEST_FIRMWARE_VERSION}</a>
              )}
            </dd>
          </div>
        )}
        {!device.enabled && (
          <div>
            <dt>State</dt>
            <dd class="text-[var(--color-warning)]">Disabled: readings are ignored</dd>
          </div>
        )}
      </dl>
      {seen.label === "never" && isPush && (
        <p class="mt-4 mb-0 text-sm">
          No readings yet. Point the device at its ingest URL (see Connection below); sensors appear on the first upload.
        </p>
      )}
    </section>

    <section class="card" aria-labelledby="device-sensors-title" id="sensors">
      <h2 class="card-title" id="device-sensors-title">Sensors ({device.sensors.length})</h2>
      {device.sensors.length === 0 ? (
        <p class="card-subtitle mb-0">
          {isPush ? "None yet: they're added automatically from the first upload's JSON keys." : "None yet: they appear after the next feed fetch."}
        </p>
      ) : (
        <form action="/api/devices" method="post" class="device-sensors-form">
          <input type="hidden" name="action" value="update_sensors" />
          <input type="hidden" name="device_id" value={device.id} />
          <input type="hidden" name="redirect" value={`${self}#sensors`} />
          <p class="card-subtitle mb-3">Rename them to what they measure. One Save covers every sensor.</p>
          <ul class="device-sensor-list">
            {device.sensors.map((sensor) => {
              const reading = latestBySensor.get(sensor.id);
              const value = reading ? formatSensorValue(reading) : null;
              const stuckHit = stuckById.get(sensor.id);
              return (
                <li class="device-sensor-row">
                  <div class="device-sensor-main">
                    <div class="form-field mb-0">
                      <label class="form-label" for={`label-${sensor.id}`}>Name</label>
                      <input
                        class="form-input"
                        id={`label-${sensor.id}`}
                        name={`label:${sensor.id}`}
                        value={sensor.label}
                        required
                        disabled={!canEdit}
                      />
                    </div>
                    <div class="device-sensor-reading">
                      <span class="form-label">Latest</span>
                      <span class="font-semibold">{value ?? "—"}</span>
                      {reading && (
                        <span class="text-xs">
                          <ReadingAgeBadge iso={reading.recorded_at} />
                        </span>
                      )}
                      {stuckHit && <span class="block text-xs text-[var(--color-warning)]">{stuckHit.detail}</span>}
                    </div>
                    <div class="form-field mb-0">
                      <label class="form-label" for={`kind-${sensor.id}`}>Type</label>
                      <select class="form-input" id={`kind-${sensor.id}`} name={`kind:${sensor.id}`} disabled={!canEdit}>
                        {Object.entries(SENSOR_KIND_LABELS).map(([kind, label]) => (
                          <option value={kind} selected={sensor.kind === kind}>{label}</option>
                        ))}
                      </select>
                    </div>
                    <label class="checkbox-row mb-0 device-sensor-visible">
                      <input type="checkbox" name={`visible:${sensor.id}`} value="true" checked={sensor.visible} disabled={!canEdit} />
                      <span>Show on Home</span>
                    </label>
                  </div>
                  <details class="device-sensor-more">
                    <summary class="text-sm text-[var(--color-text-muted)] cursor-pointer">
                      More: JSON key <code>{sensor.key}</code>
                      {(sensor.offset_num ?? 0) !== 0 && ` · offset ${(sensor.offset_num ?? 0) > 0 ? "+" : ""}${sensor.offset_num}`}
                    </summary>
                    <div class="device-sensor-more-grid">
                      <div class="form-field mb-0">
                        <label class="form-label" for={`key-${sensor.id}`}>JSON key</label>
                        <input class="form-input font-mono" id={`key-${sensor.id}`} name={`key:${sensor.id}`} value={sensor.key} disabled={!canEdit} />
                      </div>
                      <div class="form-field mb-0">
                        <label class="form-label" for={`unit-${sensor.id}`}>Unit</label>
                        <input
                          class="form-input"
                          id={`unit-${sensor.id}`}
                          name={`unit:${sensor.id}`}
                          value={sensor.unit ?? ""}
                          placeholder="Type default"
                          disabled={!canEdit}
                        />
                      </div>
                      <div class="form-field mb-0">
                        <label class="form-label" for={`offset-${sensor.id}`}>Calibration offset</label>
                        <input
                          class="form-input"
                          id={`offset-${sensor.id}`}
                          name={`offset:${sensor.id}`}
                          type="number"
                          step="0.1"
                          min={sensor.kind === "humidity" ? -15 : -10}
                          max={sensor.kind === "humidity" ? 15 : 10}
                          value={sensor.offset_num ?? 0}
                          disabled={!canEdit}
                        />
                        <p class="form-hint mb-0">Added to every reading. Raw readings stay unchanged.</p>
                      </div>
                      {canEdit && (
                        <button
                          class="btn-ghost device-sensor-delete"
                          type="submit"
                          name="delete_sensor_id"
                          value={sensor.id}
                          formnovalidate
                          onclick={`return confirm(${JSON.stringify(`Delete sensor "${sensor.label}" and its history?`)});`}
                        >
                          Delete sensor
                        </button>
                      )}
                    </div>
                  </details>
                </li>
              );
            })}
          </ul>
          {canEdit && <button class="btn-primary mt-4" type="submit">Save sensors</button>}
        </form>
      )}
      {canEdit && isPush && (
        <details class="mt-4">
          <summary class="text-sm cursor-pointer">Add a sensor by hand</summary>
          <p class="form-hint mt-2">Only needed to set a name before the first upload; keys are added automatically otherwise.</p>
          <form action="/api/devices" method="post" class="device-add-sensor">
            <input type="hidden" name="action" value="add_sensor" />
            <input type="hidden" name="device_id" value={device.id} />
            <input type="hidden" name="redirect" value={`${self}#sensors`} />
            <div class="form-field mb-0">
              <label class="form-label" for="add-key">JSON key</label>
              <input class="form-input font-mono" id="add-key" name="key" required placeholder="temp1" />
            </div>
            <div class="form-field mb-0">
              <label class="form-label" for="add-label">Name</label>
              <input class="form-input" id="add-label" name="label" required placeholder="Garage pipe" />
            </div>
            <div class="form-field mb-0">
              <label class="form-label" for="add-kind">Type</label>
              <select class="form-input" id="add-kind" name="kind">
                {Object.entries(SENSOR_KIND_LABELS).map(([kind, label]) => <option value={kind}>{label}</option>)}
              </select>
            </div>
            <button class="btn-secondary" type="submit">Add sensor</button>
          </form>
        </details>
      )}
    </section>

    {canEdit && (
      <section class="card" aria-labelledby="device-settings-title" id="settings">
        <h2 class="card-title" id="device-settings-title">Settings</h2>
        <form action="/api/devices" method="post" class="device-settings-form">
          <input type="hidden" name="action" value="update_device" />
          <input type="hidden" name="device_id" value={device.id} />
          <input type="hidden" name="redirect" value={`${self}#settings`} />
          {isPush ? (
            <div class="form-field mb-0">
              <label class="form-label" for="device-name">Name</label>
              <input class="form-input" id="device-name" name="name" value={device.name} required maxlength="80" />
            </div>
          ) : (
            <p class="form-hint m-0">
              This feed's name and on/off live in <a class="text-link" href="/dashboard/devices?view=setup&tab=pull">Pull feeds</a>.
            </p>
          )}
          <div class="form-field mb-0">
            <label class="form-label" for="device-space">Space</label>
            <input
              class="form-input"
              id="device-space"
              name="space"
              value={device.space ?? ""}
              list="device-space-suggestions"
              placeholder="Garage, attic, crawlspace…"
              maxlength="60"
            />
            <p class="form-hint mb-0">Where it is. Used for protection coverage and alert wording.</p>
          </div>
          {isPush && (
            <label class="checkbox-row mb-0">
              <input type="checkbox" name="enabled" value="true" checked={device.enabled} />
              <span>Enabled (unticked: uploads are ignored and it won't raise alerts)</span>
            </label>
          )}
          <div>
            <button class="btn-primary" type="submit">Save</button>
          </div>
        </form>
        <datalist id="device-space-suggestions">
          {spaces.map((space) => <option value={space} />)}
        </datalist>
      </section>
    )}

    {isPush && (
      <section class="card" aria-labelledby="device-connection-title">
        <h2 class="card-title" id="device-connection-title">Connection</h2>
        <p class="card-subtitle mb-3">
          The device sends JSON to <code>{Astro.url.origin}/api/ingest/&lt;key&gt;</code>. Its key starts with
          <code>{device.ingest_key_prefix}</code>.
        </p>
        <div class="flex flex-wrap gap-3 items-center mb-3">
          {canEdit && ingestKeyVaultConfigured() && recoverableKey && (
            <RevealIngestKeyButton client:visible deviceId={device.id} deviceName={device.name} />
          )}
          <a class="btn-ghost" href="/payload-checker">Check a payload</a>
          <a class="btn-ghost" href="/flash">Browser flasher</a>
          <a class="btn-ghost" href="/about/ingest-and-webhooks">Ingest docs</a>
        </div>
        <p class="m-0 text-sm text-[var(--color-text-muted)]">
          {`Last 7 days: ${accepted.toLocaleString("en-US")} upload${accepted === 1 ? "" : "s"} accepted`}
          {rejected > 0 && <span class="text-[var(--color-warning)]">{`, ${rejected.toLocaleString("en-US")} rejected`}</span>}.
        </p>
      </section>
    )}

    <section class="card" aria-labelledby="device-maintenance-title">
      <h2 class="card-title" id="device-maintenance-title">Maintenance</h2>
      <div class="flex flex-wrap gap-3">
        <a class="btn-secondary" href={`/api/devices/diagnostics?device_id=${device.id}`} download>Download diagnostics</a>
        <a class="btn-ghost" href={`/dashboard/history?feed=${encodeURIComponent(device.name)}`}>History chart</a>
      </div>
      <p class="form-hint mt-2 mb-0">Diagnostics is a redacted JSON file you can attach to a bug report or support email.</p>
      {canEdit && isPush && transferTargets.length > 0 && (
        <form action="/api/devices" method="post" class="flex flex-wrap gap-2 items-end mt-4">
          <input type="hidden" name="action" value="transfer" />
          <input type="hidden" name="device_id" value={device.id} />
          <input type="hidden" name="redirect" value={listHref} />
          <div class="form-field mb-0">
            <label class="form-label" for="transfer-target">Move to another property</label>
            <select class="form-input" id="transfer-target" name="target_household_id" required>
              {transferTargets.map((h) => <option value={h.household_id}>{h.name ?? h.household_id}</option>)}
            </select>
          </div>
          <button class="btn-secondary" type="submit">Move device</button>
        </form>
      )}
      {canEdit && <SensorReplaceCard devices={devices} redirectTo={self} collapsed />}
    </section>


    {canEdit && isPush && (
      <section class="card device-danger" aria-labelledby="device-danger-title">
        <h2 class="card-title" id="device-danger-title">Key and removal</h2>
        <div class="device-danger-row">
          <div>
            <p class="m-0 font-medium">Rotate ingest key</p>
            <p class="m-0 text-sm text-[var(--color-text-muted)]">Issues a new key. The old one stops working at once; reflash or update the device.</p>
          </div>
          <form
            action="/api/devices"
            method="post"
            onsubmit="return confirm('Rotate this ingest key? The old key stops working immediately.');"
          >
            <input type="hidden" name="action" value="rotate_key" />
            <input type="hidden" name="device_id" value={device.id} />
            <input type="hidden" name="redirect" value={`/dashboard/devices?view=setup&tab=push&focus_device=${device.id}`} />
            <button class="btn-secondary" type="submit">Rotate key</button>
          </form>
        </div>
        <div class="device-danger-row">
          <div>
            <p class="m-0 font-medium">Delete device</p>
            <p class="m-0 text-sm text-[var(--color-text-muted)]">Removes it, its sensors, and their history. Can't be undone.</p>
          </div>
          <form
            action="/api/devices"
            method="post"
            onsubmit={`return confirm(${JSON.stringify(`Delete "${device.name}", its sensors, and their history?`)});`}
          >
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="device_id" value={device.id} />
            <input type="hidden" name="redirect" value={listHref} />
            <button class="btn-danger" type="submit">Delete device</button>
          </form>
        </div>
      </section>
    )}
  </div>
</DashboardLayout>

<script>
  // Drop one-time notice params so a refresh doesn't repeat "Device saved."
  const url = new URL(window.location.href);
  const keys = ["device_saved", "sensor_updated", "sensor_deleted", "sensor_added", "sensor_replaced", "replace_error", "error"];
  if (keys.some((key) => url.searchParams.has(key))) {
    for (const key of keys) url.searchParams.delete(key);
    window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
  }
</script>

<style>
  .device-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem;
    margin: 0;
  }
  .device-facts dt {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }
  .device-facts dd {
    margin: 0;
    font-size: 0.875rem;
  }
  .device-sensor-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .device-sensor-row {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 0.75rem;
  }
  .device-sensor-main {
    display: grid;
    gap: 0.75rem;
    align-items: end;
  }
  .device-sensor-reading {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.875rem;
  }
  .device-sensor-more {
    margin-top: 0.5rem;
  }
  .device-sensor-more-grid,
  .device-add-sensor,
  .device-settings-form {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .device-sensor-delete {
    justify-self: start;
  }
  .device-danger-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
  }
  .device-danger-row:first-of-type {
    border-top: 0;
  }
  @media (min-width: 768px) {
    .device-sensor-main {
      grid-template-columns: minmax(10rem, 2fr) minmax(7rem, 1fr) minmax(9rem, 1.2fr) auto;
    }
    .device-sensor-more-grid,
    .device-add-sensor {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
    }
    .device-settings-form {
      max-width: 32rem;
    }
  }
</style>
