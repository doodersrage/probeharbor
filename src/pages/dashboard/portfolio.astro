---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DashboardCard from "../../components/dashboard/DashboardCard.astro";
import ReadingAgeBadge from "../../components/dashboard/ReadingAgeBadge.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { fetchCrossPropertySnapshots } from "../../lib/crossProperty";
import { getUserEntitlements } from "../../lib/entitlements";
import { attachPropertyHealth } from "../../lib/portfolioHealth";
import {
  PORTFOLIO_SORT_OPTIONS,
  applyPortfolioListQuery,
  parsePortfolioListQuery,
  portfolioListQueryString,
} from "../../lib/portfolioList";
import { fmt, formatDateTime, formatNumber, getLocale, plural } from "../../i18n";
import { portfolioMessages } from "../../i18n/messages/app/portfolio";

const locale = getLocale(Astro);
const t = portfolioMessages(locale);
const temp1 = (value: number) =>
  formatNumber(value, locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const temp0 = (value: number) => formatNumber(value, locale, { maximumFractionDigits: 0 });
const pct = (score: number) => fmt(t.score, { score: formatNumber(score, locale) });
const roleLabel = (role: string) =>
  (t.roles as Record<string, string>)[role] ?? role.replace("_", " ");
const capitalizeFirst = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const entitlements = shell
  ? shell.entitlements
  : await getUserEntitlements(user.id);
const { properties, error } = entitlements.canUsePortfolio
  ? await fetchCrossPropertySnapshots(user.id)
  : { properties: [], error: null as string | null };
const withHealth = attachPropertyHealth(properties, Date.now(), locale);
const atRisk = withHealth.filter((p) => p.atRisk);
const floodWet = withHealth.filter((p) => p.floodWet);
const coldest = [...withHealth]
  .filter((p) => p.minTempF != null)
  .sort((a, b) => (a.minTempF ?? 999) - (b.minTempF ?? 999))
  .slice(0, 5);
const avgHealth =
  withHealth.length > 0
    ? Math.round(withHealth.reduce((sum, p) => sum + p.health.score, 0) / withHealth.length)
    : null;

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const listQuery = parsePortfolioListQuery(Astro.url.searchParams);
const queryString = (page?: number) =>
  portfolioListQueryString({ ...listQuery, page });
const listPath = `/dashboard/portfolio${queryString()}`;

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect(`/dashboard/portfolio${queryString(1)}`);
}

const listed = applyPortfolioListQuery(withHealth, listQuery, pageParam);
if (listed.totalPages > 0 && pageParam > listed.totalPages) {
  return Astro.redirect(`/dashboard/portfolio${queryString(listed.totalPages)}`);
}

const hasFilters = Boolean(
  listQuery.search || listQuery.status || listQuery.sort !== "name_asc",
);
const showingFrom =
  listed.totalCount === 0 ? 0 : (listed.page - 1) * listed.pageSize + 1;
const showingTo =
  listed.totalCount === 0
    ? 0
    : Math.min(listed.page * listed.pageSize, listed.totalCount);
const prevPage = listed.page > 1 ? listed.page - 1 : null;
const nextPage = listed.page < listed.totalPages ? listed.page + 1 : null;

const flash = Astro.url.searchParams;
const vacationFlash = flash.get("portfolio_vacation") === "1";
const vacationCleared = flash.get("portfolio_vacation_cleared") === "1";
const vacationDays = flash.get("days");
const vacationProperties = flash.get("properties");
const viewMode = Astro.url.searchParams.get("view") === "heatmap" ? "heatmap" : "list";
const vacationDaysLabel = vacationDays ?? "7";
const vacationCountVars = (raw: string) => ({ count: raw, days: vacationDaysLabel });
const vacationSetText =
  vacationProperties == null
    ? fmt(t.vacationSetAll, { days: vacationDaysLabel })
    : plural(t.vacationSet, Number(vacationProperties), locale, vacationCountVars(vacationProperties));
const vacationClearedText =
  vacationProperties == null
    ? t.vacationClearedAll
    : plural(t.vacationCleared, Number(vacationProperties), locale, vacationCountVars(vacationProperties));
const lastReadingFormat: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "numeric",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
  second: "2-digit",
};
---
<DashboardLayout title={t.title} subtitle={t.subtitle}>
  <div class="space-y-6">
    {!entitlements.canUsePortfolio ? (
      <UpgradeNudge feature="multi_property" tier={entitlements.tier} />
    ) : entitlements.tier === "pro" ? (
      <UpgradeNudge feature="portfolio_scale" tier={entitlements.tier} />
    ) : null}
    <section class="card">
      <h2 class="card-title">{t.allProperties}</h2>
      {/* The page subtitle already says what Portfolio is; only add plan context here. */}
      {!entitlements.canUsePortfolio ? (
        <p class="card-subtitle mb-0">{t.upgradeToPro}</p>
      ) : entitlements.tier === "pro" ? (
        <p class="card-subtitle mb-0">
          {t.portfolioUpsell}
        </p>
      ) : null}
      {error && <p class="alert-warning mt-3" role="alert">{error}</p>}
      {vacationFlash && (
        <p class="alert-success mt-3" role="status">
          {vacationSetText}
        </p>
      )}
      {vacationCleared && (
        <p class="alert-success mt-3" role="status">
          {vacationClearedText}
        </p>
      )}
      {entitlements.canUsePortfolio && withHealth.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          <a
            class:list={["btn-ghost btn-sm", viewMode === "list" && "font-semibold"]}
            href={`/dashboard/portfolio${portfolioListQueryString({ ...listQuery, page: 1 })}`}
          >
            {t.viewList}
          </a>
          <a
            class:list={["btn-ghost btn-sm", viewMode === "heatmap" && "font-semibold"]}
            href={`/dashboard/portfolio${(() => {
              const base = portfolioListQueryString({ ...listQuery, page: 1 });
              return base ? `${base}&view=heatmap` : "?view=heatmap";
            })()}`}
          >
            {t.viewHeatmap}
          </a>
        </div>
      )}
    </section>

    {entitlements.canUsePortfolio && withHealth.length > 0 && (
      <DashboardCard>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="card-title">{t.healthTitle}</h2>
            <p class="card-subtitle mb-0">
              {fmt(t.healthSummary, {
                score: formatNumber(avgHealth ?? 0, locale),
                atRisk: formatNumber(atRisk.length, locale),
                wet:
                  floodWet.length > 0
                    ? fmt(t.healthSummaryWet, { count: formatNumber(floodWet.length, locale) })
                    : "",
              })}
            </p>
          </div>
        </div>
        {coldest.length > 0 && (
          <ul class="m-0 mt-3 p-0 list-none space-y-1 text-sm">
            {coldest.map((p) => (
              <li>
                <strong>{p.name}</strong>
                {locale === "fr" ? " : " : ": "}
                {p.minTempF != null ? `${temp1(p.minTempF)}°F` : "—"}
                {" · "}
                <span class="text-[var(--color-text-muted)]">{p.health.detail}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-4 flex flex-wrap gap-2 items-end">
          <form action="/api/user/portfolio-vacation" method="post" class="flex flex-wrap gap-2 items-end">
            <input type="hidden" name="action" value="vacation" />
            <input type="hidden" name="redirect" value={listPath} />
            <div class="form-field mb-0">
              <label class="form-label" for="portfolio-vacation-days">{t.bulkVacationDays}</label>
              <input
                class="form-input w-24"
                id="portfolio-vacation-days"
                name="days"
                type="number"
                min="1"
                max="90"
                value="7"
              />
            </div>
            <div class="form-field mb-0">
              <label class="form-label" for="portfolio-vacation-until">{t.orUntilDate}</label>
              <input
                class="form-input"
                id="portfolio-vacation-until"
                name="until"
                type="date"
                min={new Date().toISOString().slice(0, 10)}
              />
            </div>
            <button class="btn-secondary" type="submit">{t.muteAll}</button>
          </form>
          <form action="/api/user/portfolio-vacation" method="post">
            <input type="hidden" name="action" value="clear_vacation" />
            <input type="hidden" name="redirect" value={listPath} />
            <button class="btn-ghost" type="submit">{t.clearVacation}</button>
          </form>
        </div>
        <p class="mt-2 mb-0 text-xs text-[var(--color-text-muted)]" set:html={t.bulkVacationHintHtml} />
      </DashboardCard>
    )}

    {atRisk.length > 0 && (
      <DashboardCard>
        <h2 class="card-title text-[var(--color-warning)]">
          {plural(t.atRiskTitle, atRisk.length, locale)}
        </h2>
        <p class="card-subtitle mb-3" set:html={t.atRiskHintHtml} />
        <ul class="m-0 p-0 list-none space-y-2">
          {atRisk.map((p) => (
            <li class="text-sm">
              <strong>{p.name}</strong>
              {p.floodWet
                ? t.atRiskWet
                : fmt(t.atRiskCold, {
                    temp: p.minTempF != null ? temp1(p.minTempF) : String(p.minTempF),
                    threshold: formatNumber(p.freezeThresholdF, locale),
                  })}
            </li>
          ))}
        </ul>
      </DashboardCard>
    )}

    <DashboardCard>
      {entitlements.canUsePortfolio ? (
      <>
      {properties.length <= 1 && (
        <div class="mb-4">
          <h3 class="card-title text-base">{t.addPropertyTitle}</h3>
          <p class="card-subtitle mb-3">
            {t.addPropertyBody}
          </p>
          <a class="btn-secondary" href="/dashboard/household">{t.addPropertyButton}</a>
        </div>
      )}
      {properties.length === 0 ? (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          {t.emptyPortfolio}
        </p>
      ) : (
      <>
      <form class="history-filters" method="get" action="/dashboard/portfolio">
        {viewMode === "heatmap" && <input type="hidden" name="view" value="heatmap" />}
        <div class="form-field mb-0">
          <label class="form-label" for="portfolio-search">{t.searchLabel}</label>
          <input
            class="form-input"
            type="search"
            id="portfolio-search"
            name="q"
            value={listQuery.search}
            placeholder={t.searchPlaceholder}
          />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="portfolio-status">{t.statusLabel}</label>
          <select class="form-input" id="portfolio-status" name="status">
            <option value="" selected={listQuery.status === ""}>{t.status.all}</option>
            <option value="at_risk" selected={listQuery.status === "at_risk"}>{t.status.at_risk}</option>
            <option value="wet" selected={listQuery.status === "wet"}>{t.status.wet}</option>
            <option value="watch" selected={listQuery.status === "watch"}>{t.status.watch}</option>
            <option value="healthy" selected={listQuery.status === "healthy"}>{t.status.healthy}</option>
            <option value="offline" selected={listQuery.status === "offline"}>{t.status.offline}</option>
          </select>
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="portfolio-sort">{t.sortLabel}</label>
          <select class="form-input" id="portfolio-sort" name="sort">
            {PORTFOLIO_SORT_OPTIONS.map((opt) => (
              <option value={opt.value} selected={listQuery.sort === opt.value}>
                {t.sorts[opt.value] ?? opt.label}
              </option>
            ))}
          </select>
        </div>
        <button type="submit" class="btn-secondary self-end">{t.apply}</button>
        {hasFilters && (
          <a class="btn-ghost self-end" href="/dashboard/portfolio">{t.clear}</a>
        )}
      </form>
      <p class="preference-hint mb-4">
        {t.filterHint}
      </p>
      {listed.rows.length === 0 ? (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          {hasFilters
            ? t.noMatches
            : t.noProperties}
        </p>
      ) : (
      <>
      {viewMode === "heatmap" && (
        <div class="portfolio-heatmap mb-4" role="list">
          {listed.rows.map((p) => {
            const tone =
              p.health.label === "healthy"
                ? "healthy"
                : p.health.label === "watch"
                  ? "watch"
                  : p.health.label === "offline"
                    ? "offline"
                    : "risk";
            return (
              <a
                class:list={["portfolio-heatmap-cell", `portfolio-heatmap-cell--${tone}`]}
                href={`/dashboard?household=${p.householdId}`}
                role="listitem"
                title={fmt(t.heatmapTitle, { name: p.name, score: formatNumber(p.health.score, locale), detail: p.health.detail })}
              >
                <span class="portfolio-heatmap-name">{p.name}</span>
                <span class="portfolio-heatmap-score">{pct(p.health.score)}</span>
                <span class="portfolio-heatmap-meta">
                  {p.minTempF != null ? `${temp0(p.minTempF)}°F` : "—"}
                  {p.floodWet ? t.wetSuffix : ""}
                </span>
              </a>
            );
          })}
        </div>
      )}
      <div class:list={["overflow-x-auto portfolio-list-desktop", viewMode === "heatmap" && "hidden"]}>
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th class="text-left py-2">{t.columns.property}</th>
              <th class="text-left py-2">{t.columns.role}</th>
              <th class="text-left py-2">{t.columns.health}</th>
              <th class="text-left py-2">{t.columns.minTemp}</th>
              <th class="text-left py-2">{t.columns.devices}</th>
              <th class="text-left py-2">{t.columns.lastReading}</th>
            </tr>
          </thead>
          <tbody>
            {listed.rows.map((p) => (
              <tr class="border-t border-[var(--color-border)]">
                <td class="py-2">
                  <form action="/api/household/switch" method="post" class="inline">
                    <input type="hidden" name="household_id" value={p.householdId} />
                    <input type="hidden" name="redirect" value="/dashboard" />
                    <button type="submit" class="text-link">{p.name}</button>
                  </form>
                  {p.atRisk && (
                    <span class="ml-2 text-xs text-[var(--color-warning)]">
                      {p.floodWet ? t.badgeWet : t.badgeAtRisk}
                    </span>
                  )}
                </td>
                <td class:list={["py-2", locale === "en" && "capitalize"]}>
                  {locale === "en" ? roleLabel(p.role) : capitalizeFirst(roleLabel(p.role))}
                </td>
                <td class="py-2">
                  <span
                    class:list={[
                      "font-medium",
                      p.health.label === "healthy" && "text-[var(--color-success)]",
                      p.health.label === "watch" && "text-[var(--color-warning)]",
                      (p.health.label === "at_risk" || p.health.label === "offline") &&
                        "text-[var(--color-danger)]",
                    ]}
                  >
                    {pct(p.health.score)}
                  </span>
                  <span class="block text-xs text-[var(--color-text-muted)]">{p.health.detail}</span>
                </td>
                <td class="py-2">
                  {p.minTempF != null ? `${temp1(p.minTempF)}°F` : "—"}
                </td>
                <td class="py-2">{formatNumber(p.deviceCount, locale)}</td>
                <td class="py-2">
                  <ReadingAgeBadge iso={p.lastReadingAt} emptyLabel="—" />
                  {p.lastReadingAt && (
                    <span class="block text-xs text-[var(--color-text-muted)] mt-1">
                      {formatDateTime(p.lastReadingAt, locale, lastReadingFormat)}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class:list={["portfolio-list-mobile space-y-3", viewMode === "heatmap" && "hidden"]}>
        {listed.rows.map((p) => (
          <article class="rounded-lg border border-[var(--color-border)] p-3 text-sm">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <form action="/api/household/switch" method="post" class="inline">
                <input type="hidden" name="household_id" value={p.householdId} />
                <input type="hidden" name="redirect" value="/dashboard" />
                <button type="submit" class="text-link font-semibold">{p.name}</button>
              </form>
              <span
                class:list={[
                  "font-medium",
                  p.health.label === "healthy" && "text-[var(--color-success)]",
                  p.health.label === "watch" && "text-[var(--color-warning)]",
                  (p.health.label === "at_risk" || p.health.label === "offline") &&
                    "text-[var(--color-danger)]",
                ]}
              >
                {pct(p.health.score)}
              </span>
            </div>
            <p class="m-0 mt-1 text-xs text-[var(--color-text-muted)]">
              {roleLabel(p.role)}
              {" · "}
              {p.minTempF != null ? `${temp1(p.minTempF)}°F` : t.noTemp}
              {" · "}
              {plural(t.deviceCount, p.deviceCount, locale)}
              {p.atRisk ? (p.floodWet ? t.wetSuffix : t.atRiskSuffix) : ""}
            </p>
            <p class="m-0 mt-2 text-xs text-[var(--color-text-muted)]">{p.health.detail}</p>
            <p class="m-0 mt-2">
              <ReadingAgeBadge iso={p.lastReadingAt} emptyLabel={t.noReadings} />
            </p>
          </article>
        ))}
      </div>
      <div class="pagination">
        <p class="pagination-summary">
          {fmt(t.showing, {
            from: formatNumber(showingFrom, locale),
            to: formatNumber(showingTo, locale),
            total: formatNumber(listed.totalCount, locale),
          })}
        </p>
        <div class="pagination-controls">
          {prevPage ? (
            <a class="btn-secondary" href={`/dashboard/portfolio${queryString(prevPage)}`}>{t.previous}</a>
          ) : (
            <span class="btn-secondary pagination-disabled">{t.previous}</span>
          )}
          <span class="pagination-current">
            {fmt(t.pageOf, {
              page: formatNumber(listed.page, locale),
              pages: formatNumber(Math.max(listed.totalPages, 1), locale),
            })}
          </span>
          {nextPage ? (
            <a class="btn-secondary" href={`/dashboard/portfolio${queryString(nextPage)}`}>{t.next}</a>
          ) : (
            <span class="btn-secondary pagination-disabled">{t.next}</span>
          )}
        </div>
      </div>
      </>
      )}
      </>
      )}
      </>
      ) : (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          {t.notAvailable}
        </p>
      )}
    </DashboardCard>
  </div>
</DashboardLayout>

<style>
  .portfolio-heatmap {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.5rem;
  }

  .portfolio-heatmap-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    min-height: 5.5rem;
  }

  .portfolio-heatmap-cell--healthy {
    background: color-mix(in srgb, var(--color-success) 18%, transparent);
  }

  .portfolio-heatmap-cell--watch {
    background: color-mix(in srgb, var(--color-warning) 22%, transparent);
  }

  .portfolio-heatmap-cell--risk {
    background: color-mix(in srgb, var(--color-danger) 22%, transparent);
  }

  .portfolio-heatmap-cell--offline {
    background: color-mix(in srgb, var(--color-text-muted) 14%, transparent);
  }

  .portfolio-heatmap-name {
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .portfolio-heatmap-score {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .portfolio-heatmap-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .portfolio-list-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .portfolio-list-mobile {
      display: none;
    }

    .portfolio-list-desktop {
      display: block;
    }
  }
</style>

<script>
  const flashKeys = [
    "portfolio_vacation",
    "portfolio_vacation_cleared",
    "days",
    "properties",
  ];
  const url = new URL(window.location.href);
  let changed = false;
  for (const key of flashKeys) {
    if (url.searchParams.has(key)) {
      url.searchParams.delete(key);
      changed = true;
    }
  }
  if (changed) {
    window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
  }
</script>
