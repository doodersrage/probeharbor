---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getAuthFromCookies } from "../../lib/auth";
import {
  countOwnedHouseholds,
  getOrCreateHouseholdForUser,
  getOwnedHouseholdId,
  listHouseholdMembers,
  listUserHouseholds,
  getUserHouseholdRole,
  canManageHousehold,
} from "../../lib/households";
import { listPendingInvites } from "../../lib/householdInvites";
import { consumeSecretFlash, FLASH_INVITE_LINK } from "../../lib/secretFlash";
import { getHouseholdErrorMessage } from "../../lib/householdErrors";
import { getUserEntitlements } from "../../lib/entitlements";
import { createAdminClient, createServerClient } from "../../lib/supabase";
import { listHouseholdActivity } from "../../lib/householdActivity";
import { formatHouseholdActivityAction } from "../../lib/householdActivityLabels";
import { householdRoleLabel } from "../../lib/householdRoleLabel";
import { uniqueWeatherCityPresets } from "../../lib/weatherCities";
import DashboardCard from "../../components/dashboard/DashboardCard.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import I18nJson from "../../components/I18nJson.astro";
import { fmt, formatDateTime, formatNumber, getLocale, plural } from "../../i18n";
import { householdMessages } from "../../i18n/messages/app/household";

const locale = getLocale(Astro);
const t = householdMessages(locale);
// Same fields as Date#toLocaleString(), so English output is unchanged.
const DATE_TIME: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "numeric",
  day: "numeric",
  hour: "numeric",
  minute: "numeric",
  second: "numeric",
};
const formatWhen = (value: string) => formatDateTime(value, locale, DATE_TIME);

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const active = await getOrCreateHouseholdForUser(user.id, user.email);
const ownedId = await getOwnedHouseholdId(user.id);
const manageId = ownedId ?? active.householdId;

const [membersResult, householdsResult, invitesResult, householdRow, entitlements, ownedCount] =
  await Promise.all([
    manageId ? listHouseholdMembers(manageId) : Promise.resolve({ members: [], error: null }),
    shell
      ? Promise.resolve({ households: shell.households, error: null as string | null })
      : listUserHouseholds(user.id),
    manageId ? listPendingInvites(manageId) : Promise.resolve({ invites: [], error: null }),
    manageId
      ? createServerClient()
          .from("households")
          .select(
            "name, freeze_map_opt_in, freeze_map_city_id, freeze_map_lat, freeze_map_lon, freeze_map_label",
          )
          .eq("id", manageId)
          .maybeSingle()
      : Promise.resolve({ data: null }),
    shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
    countOwnedHouseholds(user.id),
  ]);

const atPropertyLimit = ownedCount >= entitlements.maxOwnedHouseholds;
const canCreateProperty = !atPropertyLimit;
const canInvitePropertyManager =
  entitlements.tier === "portfolio" || entitlements.tier === "admin";

const admin = createAdminClient();
const membersWithEmail = await Promise.all(
  membersResult.members.map(async (member) => {
    const { data } = await admin.auth.admin.getUserById(member.user_id);
    return { ...member, email: data.user?.email ?? member.user_id };
  }),
);

const errorCode = Astro.url.searchParams.get("error");
const errorMessage = getHouseholdErrorMessage(errorCode, locale);
const NOTICE_PARAMS = [
  ["invited", t.notices.invited],
  ["removed", t.notices.removed],
  ["saved", t.notices.saved],
  ["switched", t.notices.switched],
  ["joined", t.notices.joined],
  ["invite_revoked", t.notices.inviteRevoked],
  ["invite_resent", t.notices.inviteResent],
  ["left", t.notices.left],
  ["property_created", t.notices.propertyCreated],
] as const;
const notice =
  NOTICE_PARAMS.find(([param]) => Astro.url.searchParams.get(param))?.[1] ?? null;

const isOwner = Boolean(ownedId && ownedId === manageId);
const manageRole = manageId
  ? await getUserHouseholdRole(user.id, manageId)
  : null;
const canManage = canManageHousehold(manageRole);
// Shown once: only the invite token's hash is stored.
const newInviteLink = canManage ? consumeSecretFlash(Astro.cookies, FLASH_INVITE_LINK) : null;
const activeMembership = householdsResult.households.find(
  (h) => h.household_id === active.householdId,
);
const canLeaveActive =
  Boolean(active.householdId) && activeMembership?.role === "member";
const householdActivity =
  manageId && canManage
    ? await listHouseholdActivity(manageId, 15)
    : [];
// Consecutive identical entries ("Alert settings saved: alerts on" ×15) show once with a count.
const activityGroups = householdActivity.reduce<Array<{ row: (typeof householdActivity)[number]; count: number; oldest: string }>>(
  (groups, row) => {
    const last = groups[groups.length - 1];
    if (last && last.row.action === row.action && (last.row.detail ?? "") === (row.detail ?? "")) {
      last.count += 1;
      last.oldest = row.created_at;
    } else {
      groups.push({ row, count: 1, oldest: row.created_at });
    }
    return groups;
  },
  [],
);
const myMembership = membersWithEmail.find((m) => m.user_id === user.id);
const digestOptInRow =
  active.householdId && active.householdId !== manageId
    ? await createServerClient()
        .from("household_members")
        .select("digest_opt_in")
        .eq("household_id", active.householdId)
        .eq("user_id", user.id)
        .maybeSingle()
    : Promise.resolve({ data: myMembership ? { digest_opt_in: myMembership.digest_opt_in } : null });
const digestOptInResult = await digestOptInRow;
const digestOptIn = Boolean(digestOptInResult.data?.digest_opt_in);
const digestSaved = Astro.url.searchParams.get("digest_saved");
const digestError = Astro.url.searchParams.get("digest_error");
---
<DashboardLayout
  title={t.title}
  subtitle={t.subtitle}
>
  <I18nJson id="household-i18n" data={t.client} />
  <div class="space-y-6">
    {/* People first (members, invites); property settings after; activity last. */}
    {(notice || errorMessage || digestSaved || digestError) && (
      <div class="dashboard-flash">
        {notice && <p class="alert-success mt-0 mb-0">{notice}</p>}
        {errorMessage && <p class="alert-warning mt-0 mb-0" role="alert">{errorMessage}</p>}
        {digestSaved && (
          <p class="alert-success mt-0 mb-0" role="status">{t.notices.digestSaved}</p>
        )}
        {digestError && (
          <p class="alert-warning mt-0 mb-0" role="alert">{t.notices.digestError}</p>
        )}
      </div>
    )}

    {householdsResult.households.length > 1 && (
      <DashboardCard>
        <h2 class="card-title">{t.active.heading}</h2>
        <p class="card-subtitle">{t.active.subtitle}</p>
        <ul class="space-y-3">
          {householdsResult.households.map((h) => (
            <li class="flex items-center justify-between gap-4">
              <div>
                <strong>{h.name}</strong>
                <span class="text-sm text-[var(--color-text-muted)]">
                  {" · "}
                  {householdRoleLabel(h.role, locale)}
                </span>
                {h.household_id === active.householdId && (
                  <span class="feed-health-ok ml-2">{t.active.badge}</span>
                )}
              </div>
              {h.household_id !== active.householdId && (
                <form action="/api/household" method="post">
                  <input type="hidden" name="action" value="switch" />
                  <input type="hidden" name="household_id" value={h.household_id} />
                  <input type="hidden" name="redirect" value="/dashboard/household" />
                  <button class="btn-secondary" type="submit">{t.active.switch}</button>
                </form>
              )}
            </li>
          ))}
        </ul>
      </DashboardCard>
    )}

    <DashboardCard>
      <h2 class="card-title">{t.members.heading}</h2>
      <ul class="space-y-3">
        {membersWithEmail.map((member) => (
          <li class="flex items-center justify-between gap-4">
            <div>
              <strong>{member.email}</strong>
              <span class="text-sm text-[var(--color-text-muted)]">
                {" · "}
                {householdRoleLabel(member.role, locale)}
              </span>
            </div>
            {member.role !== "owner" && ownedId === manageId && (
              <form
                action="/api/household"
                method="post"
                onsubmit={`return confirm(${JSON.stringify(t.members.confirmRemove)});`}
              >
                <input type="hidden" name="action" value="remove" />
                <input type="hidden" name="user_id" value={member.user_id} />
                <input type="hidden" name="redirect" value="/dashboard/household" />
                <button class="btn-ghost" type="submit">{t.members.remove}</button>
              </form>
            )}
          </li>
        ))}
      </ul>
      {canLeaveActive && active.householdId && (
        <form
          action="/api/household"
          method="post"
          class="mt-6 border-t border-[var(--color-border)] pt-4"
          onsubmit={`return confirm(${JSON.stringify(t.members.confirmLeave)});`}
        >
          <input type="hidden" name="action" value="leave" />
          <input type="hidden" name="household_id" value={active.householdId} />
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <p class="card-subtitle mb-3">
            {t.members.leaveBody}
          </p>
          <button class="btn-ghost" type="submit">{t.members.leave}</button>
        </form>
      )}
    </DashboardCard>

    {canManage ? (
      <DashboardCard>
        <form method="POST" id="household-invite-form" data-invite-form>
          <input type="hidden" name="action" value="invite" />
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <h2 class="card-title">{t.invite.heading}</h2>
          <p class="card-subtitle mb-4">
            {householdRow.data?.name
              ? fmt(t.invite.goesToNamed, { name: householdRow.data.name })
              : t.invite.goesTo}
          </p>
          <p class="alert-success mt-0 mb-4 hidden" id="invite-status" role="status"></p>
          <p class="alert-warning mt-0 mb-4 hidden" id="invite-error" role="alert"></p>
          <div class="form-field">
            <label class="form-label" for="email">{t.invite.emailLabel}</label>
            <input class="form-input" type="email" id="email" name="email" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="invite_role">{t.invite.roleLabel}</label>
            <select class="form-input" id="invite_role" name="role">
              <option value="member">{t.invite.roleMember}</option>
              {canInvitePropertyManager ? (
                <option value="property_manager">{t.invite.rolePropertyManager}</option>
              ) : null}
              <option value="viewer">{t.invite.roleViewer}</option>
              <option value="alert_only">{t.invite.roleAlertOnly}</option>
            </select>
            {!canInvitePropertyManager && (
              <p class="form-hint mb-0 mt-2" set:html={t.invite.portfolioHintHtml} />
            )}
          </div>
          <button class="btn-primary" type="submit" id="invite-submit">{t.invite.submit}</button>
        </form>
      </DashboardCard>
    ) : (
      <DashboardCard>
        <h2 class="card-title">{t.invite.invitesHeading}</h2>
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          {t.invite.ownerOnly}
        </p>
      </DashboardCard>
    )}

    {newInviteLink && (
      <DashboardCard>
        <h2 class="card-title">{t.newInviteLink.heading}</h2>
        <p class="text-sm mb-2">{t.newInviteLink.body}</p>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
          <code class="text-sm break-all">{newInviteLink}</code>
          <button
            type="button"
            class="btn-secondary shrink-0"
            data-copy={newInviteLink}
            data-copy-label={t.pending.copyLink}
          >
            {t.pending.copyLink}
          </button>
        </div>
      </DashboardCard>
    )}

    {canManage && (invitesResult.invites ?? []).length > 0 && (
      <DashboardCard>
        <h2 class="card-title">{t.pending.heading}</h2>
        <p class="text-sm text-[var(--color-text-muted)]">{t.pending.linkHidden}</p>
        <ul class="space-y-3">
          {invitesResult.invites.map((invite) => {
            return (
              <li class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <strong>{invite.email}</strong>
                  <p class="m-0 text-sm">{fmt(t.pending.expires, { time: formatWhen(invite.expires_at) })}</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <form
                    action="/api/household"
                    method="post"
                    onsubmit={`return confirm(${JSON.stringify(t.pending.confirmResend)});`}
                  >
                    <input type="hidden" name="action" value="resend_invite" />
                    <input type="hidden" name="invite_id" value={invite.id} />
                    <input type="hidden" name="redirect" value="/dashboard/household" />
                    <button class="btn-secondary" type="submit">{t.pending.resend}</button>
                  </form>
                  <form
                    action="/api/household"
                    method="post"
                    onsubmit={`return confirm(${JSON.stringify(t.pending.confirmCancel)});`}
                  >
                    <input type="hidden" name="action" value="revoke_invite" />
                    <input type="hidden" name="invite_id" value={invite.id} />
                    <input type="hidden" name="redirect" value="/dashboard/household" />
                    <button class="btn-ghost" type="submit">{t.pending.cancel}</button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
      </DashboardCard>
    )}

    {isOwner && (
      <DashboardCard>
        <form method="POST" data-rename-household-form>
          <input type="hidden" name="action" value="rename" />
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <h2 class="card-title">{t.rename.heading}</h2>
          <p class="alert-success mt-0 mb-3 hidden" data-form-status role="status"></p>
          <p class="alert-warning mt-0 mb-3 hidden" data-form-error role="alert"></p>
          <div class="form-field">
            <label class="form-label" for="household-name">{t.rename.label}</label>
            <input
              class="form-input"
              id="household-name"
              name="name"
              value={householdRow.data?.name ?? ""}
              required
            />
          </div>
          <button class="btn-secondary" type="submit" data-form-submit>{t.rename.submit}</button>
        </form>
      </DashboardCard>
    )}

    {active.householdId && (
      <DashboardCard>
        <h2 class="card-title">{t.digest.heading}</h2>
        <p class="card-subtitle mb-4">
          {t.digest.subtitle}
        </p>
        <form action="/api/user/digest-opt-in" method="post" class="flex flex-wrap items-center gap-3">
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <input type="hidden" name="digest_opt_in" value="0" />
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="digest_opt_in" value="1" checked={digestOptIn} />
            <span>{t.digest.checkbox}</span>
          </label>
          <button type="submit" class="btn-secondary btn-sm">{t.digest.save}</button>
        </form>
      </DashboardCard>
    )}

    {isOwner && (
      <DashboardCard id="freeze-map">
      <form method="POST" id="freeze-map-form" data-freeze-map-form>
        <input type="hidden" name="action" value="freeze_map" />
        <input type="hidden" name="redirect" value="/dashboard/household" />
        <p class="alert-success mt-0 mb-3 hidden" data-form-status role="status"></p>
        <p class="alert-warning mt-0 mb-3 hidden" data-form-error role="alert"></p>
        <input
          type="hidden"
          name="freeze_map_lat"
          id="freeze_map_lat"
          value={householdRow.data?.freeze_map_lat ?? ""}
        />
        <input
          type="hidden"
          name="freeze_map_lon"
          id="freeze_map_lon"
          value={householdRow.data?.freeze_map_lon ?? ""}
        />
        <input
          type="hidden"
          name="freeze_map_label"
          id="freeze_map_label"
          value={householdRow.data?.freeze_map_label ?? ""}
        />
        <h2 class="card-title">{t.freezeMap.heading}</h2>
        <p class="card-subtitle mb-4">
          {t.freezeMap.subtitle}
        </p>
        <label class="checkbox-row mb-3">
          <input
            type="checkbox"
            name="freeze_map_opt_in"
            value="true"
            checked={householdRow.data?.freeze_map_opt_in === true}
          />
          <span>{t.freezeMap.optIn}</span>
        </label>
        <div class="form-field">
          <label class="form-label" for="freeze_map_city_id">{t.freezeMap.presetLabel}</label>
          <select class="form-input" id="freeze_map_city_id" name="freeze_map_city_id">
            <option value="">{t.freezeMap.presetPlaceholder}</option>
            {uniqueWeatherCityPresets().map((city) => (
              <option
                value={city.id}
                selected={householdRow.data?.freeze_map_city_id === city.id}
              >
                {city.label}
              </option>
            ))}
          </select>
        </div>
        <div class="form-field">
          <label class="form-label" for="city-search">{t.freezeMap.searchLabel}</label>
          <input
            class="form-input"
            type="search"
            id="city-search"
            placeholder={t.freezeMap.searchPlaceholder}
            autocomplete="off"
          />
          <p class="form-hint mb-2" id="city-search-selected">
            {householdRow.data?.freeze_map_label
              ? fmt(t.freezeMap.selected, { label: householdRow.data.freeze_map_label })
              : t.freezeMap.searchHint}
          </p>
          <ul id="city-search-results" class="space-y-2 text-sm"></ul>
        </div>
        <button class="btn-secondary" type="submit" data-form-submit>{t.freezeMap.submit}</button>
        <p class="form-hint mt-2 mb-0" set:html={t.freezeMap.publicListHtml} />
      </form>
      <script is:inline>
        (() => {
          const input = document.getElementById("city-search");
          const results = document.getElementById("city-search-results");
          const latEl = document.getElementById("freeze_map_lat");
          const lonEl = document.getElementById("freeze_map_lon");
          const labelEl = document.getElementById("freeze_map_label");
          const preset = document.getElementById("freeze_map_city_id");
          const selected = document.getElementById("city-search-selected");
          if (!(input instanceof HTMLInputElement) || !results) return;
          let text = {};
          try {
            text = JSON.parse(document.getElementById("household-i18n")?.textContent || "{}");
          } catch {}
          const say = (key, fallback) => (typeof text[key] === "string" ? text[key] : fallback);
          const selectedText = (label) =>
            say("selected", "Selected: {label}").replace("{label}", () => label);
          let timer = null;

          preset?.addEventListener("change", () => {
            if (preset.value) {
              if (latEl) latEl.value = "";
              if (lonEl) lonEl.value = "";
              if (labelEl) labelEl.value = preset.options[preset.selectedIndex]?.text || "";
              if (selected) selected.textContent = say("usingPreset", "Using preset city.");
              results.innerHTML = "";
            }
          });

          input.addEventListener("input", () => {
            clearTimeout(timer);
            const q = input.value.trim();
            if (q.length < 2) {
              results.innerHTML = "";
              return;
            }
            timer = setTimeout(async () => {
              try {
                const res = await fetch("/api/weather/city-search?q=" + encodeURIComponent(q));
                const data = await res.json();
                results.innerHTML = "";
                (data.results || []).forEach((row) => {
                  const li = document.createElement("li");
                  const btn = document.createElement("button");
                  btn.type = "button";
                  btn.className = "btn-ghost text-left";
                  btn.textContent = row.label;
                  btn.addEventListener("click", () => {
                    if (latEl) latEl.value = String(row.lat);
                    if (lonEl) lonEl.value = String(row.lon);
                    if (labelEl) labelEl.value = row.label;
                    if (preset) preset.value = "";
                    if (selected) selected.textContent = selectedText(row.label);
                    results.innerHTML = "";
                    input.value = row.label;
                  });
                  li.appendChild(btn);
                  results.appendChild(li);
                });
              } catch {
                results.innerHTML = "";
                const li = document.createElement("li");
                li.textContent = say("searchFailed", "Search failed");
                results.appendChild(li);
              }
            }, 300);
          });
        })();
      </script>
      </DashboardCard>
    )}

    <DashboardCard>
    {canCreateProperty ? (
    <form action="/api/household" method="post">
      <input type="hidden" name="action" value="create_property" />
      <input type="hidden" name="redirect" value="/dashboard/household" />
      <h2 class="card-title">{t.property.heading}</h2>
      <p class="card-subtitle mb-4">
        {t.property.subtitle}
      </p>
      <div class="form-field">
        <label class="form-label" for="property-name">{t.property.nameLabel}</label>
        <input class="form-input" id="property-name" name="name" placeholder={t.property.namePlaceholder} required />
      </div>
      <button class="btn-secondary mt-2" type="submit">{t.property.submit}</button>
    </form>
    ) : (
      <>
        <h2 class="card-title">{t.property.heading}</h2>
        <p class="card-subtitle mb-4">
          {plural(t.property.limit, entitlements.maxOwnedHouseholds, locale, {
            inUse: formatNumber(ownedCount, locale),
          })}
        </p>
        <UpgradeNudge feature="multi_property" tier={entitlements.tier} />
      </>
    )}
    </DashboardCard>

    {canManage && (
      <DashboardCard>
        <h2 class="card-title">{t.activity.heading}</h2>
        <p class="card-subtitle mb-4">
          {t.activity.subtitle}
        </p>
        {householdActivity.length === 0 ? (
          <p class="text-sm text-[var(--color-text-muted)]">{t.activity.empty}</p>
        ) : (
          <ul class="space-y-2 text-sm">
            {activityGroups.map(({ row, count, oldest }) => (
              <li>
                <strong>{formatHouseholdActivityAction(row.action, locale)}</strong>
                {row.detail ? `: ${row.detail}` : ""}
                {count > 1 && <span> {fmt(t.activity.repeat, { count: formatNumber(count, locale) })}</span>}
                <span class="text-[var(--color-text-muted)]">
                  {" "}
                  · {formatWhen(row.created_at)}
                  {count > 1 && ` ${fmt(t.activity.backTo, { time: formatWhen(oldest) })}`}
                </span>
              </li>
            ))}
          </ul>
        )}
      </DashboardCard>
    )}
  </div>
</DashboardLayout>

<script>
  import { actions } from "astro:actions";
  import { readI18nJson } from "../../i18n/client";
  import en from "../../i18n/messages/app/household/en";

  const inviteForm = document.querySelector<HTMLFormElement>("[data-invite-form]");
  const inviteStatus = document.getElementById("invite-status");
  const inviteError = document.getElementById("invite-error");
  const inviteSubmit = document.getElementById("invite-submit");
  const text = readI18nJson("household-i18n", en.client);

  inviteForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(inviteForm instanceof HTMLFormElement)) return;

    inviteStatus?.classList.add("hidden");
    inviteError?.classList.add("hidden");
    if (inviteSubmit instanceof HTMLButtonElement) {
      inviteSubmit.disabled = true;
      inviteSubmit.textContent = text.sending;
    }

    const { data, error } = await actions.inviteHouseholdMember(new FormData(inviteForm));

    if (inviteSubmit instanceof HTMLButtonElement) {
      inviteSubmit.disabled = false;
      inviteSubmit.textContent = text.sendInvite;
    }

    if (error) {
      if (inviteError) {
        inviteError.textContent = error.message || text.inviteFailed;
        inviteError.classList.remove("hidden");
      }
      return;
    }

    if (inviteStatus) {
      inviteStatus.textContent = data?.message ?? text.inviteSent;
      inviteStatus.classList.remove("hidden");
    }
    inviteForm.reset();
    window.setTimeout(() => window.location.reload(), 800);
  });

  function wireStatusForm(
    selector: string,
    run: (formData: FormData) => Promise<{ data?: { message?: string } | null; error?: { message?: string } | null }>,
    idleLabel: string,
  ) {
    const form = document.querySelector<HTMLFormElement>(selector);
    if (!form) return;
    const statusEl = form.querySelector<HTMLElement>("[data-form-status]");
    const errorEl = form.querySelector<HTMLElement>("[data-form-error]");
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-form-submit]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      statusEl?.classList.add("hidden");
      errorEl?.classList.add("hidden");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = text.saving;
      }
      const formData = new FormData(form);
      if (!formData.has("freeze_map_opt_in")) formData.set("freeze_map_opt_in", "");
      const { data, error } = await run(formData);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = idleLabel;
      }
      if (error) {
        if (errorEl) {
          errorEl.textContent = error.message || text.saveFailed;
          errorEl.classList.remove("hidden");
        }
        return;
      }
      if (statusEl) {
        statusEl.textContent = data?.message ?? text.saved;
        statusEl.classList.remove("hidden");
      }
    });
  }

  wireStatusForm(
    "[data-rename-household-form]",
    (formData) => actions.renameHousehold(formData),
    text.saveName,
  );
  wireStatusForm(
    "[data-freeze-map-form]",
    (formData) => actions.updateFreezeMapSettings(formData),
    text.saveFreezeMap,
  );
</script>
