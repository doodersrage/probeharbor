---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import ShareNav from "../../../components/dashboard/ShareNav.astro";
import UpgradeNudge from "../../../components/UpgradeNudge.astro";
import ProductAnalyticsTracker from "../../../components/ProductAnalyticsTracker.astro";
import { loadShareDashboardContext } from "../../../lib/shareDashboardContext";
import { fmt, formatDateTime, getLocale } from "../../../i18n";
import { shareMessages, shareNotice } from "../../../i18n/messages/app/share";

const ctx = await loadShareDashboardContext(Astro.cookies, Astro.request, Astro.url);
if (ctx.redirect) return Astro.redirect(ctx.redirect);

const {
  entitlements,
  links,
  canManage,
  siteUrl,
  newToken,
  statusToken,
  newHref,
  noticeIsError,
  statusPages,
} = ctx;
const locale = getLocale(Astro);
const msgs = shareMessages(locale);
const t = msgs.links;
const notice = ctx.notice ? (shareNotice(Astro.url, msgs.notices) ?? ctx.notice) : null;
const formatDate = (iso: string) => formatDateTime(iso, locale, {});
const scopeName = (scope: string) => (msgs.scopes as Record<string, string>)[scope] ?? scope;
const confirmRevoke = `return confirm('${t.confirmRevoke.replace(/\\/g, "\\\\").replace(/'/g, "\\'")}');`;

const redirectTo = "/dashboard/share/links";
const analyticsEvents = Astro.url.searchParams.get("created")
  ? [{ name: "family_share_created" as const }]
  : [];
---
<DashboardLayout title={msgs.title} subtitle={t.subtitle}>
  <ProductAnalyticsTracker events={analyticsEvents} />
  <ShareNav active="links">
    <div class="space-y-6">
      {(notice || !canManage) && (
        <div class="dashboard-flash">
          {notice && (
            <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0 mb-0"]}>{notice}</p>
          )}
          {!canManage && (
            <p class="alert-warning mt-0 mb-0" role="status">
              {t.viewOnly}
            </p>
          )}
        </div>
      )}

      {newHref && (
        <section class="card ingest-key-callout" id="new-share-link">
          <h2 class="card-title">{t.newTitle}</h2>
          <p class="card-subtitle">{t.newSubtitle}</p>
          <p class="ingest-key-value break-all text-sm mb-4">
            <a href={newHref}>{newHref}</a>
          </p>
          <button
            type="button"
            class="btn-primary"
            data-copy={newHref}
            data-copy-label={t.copyLink}
            id="copy-new-share"
          >
            {t.copyLink}
          </button>
        </section>
      )}

      {newHref && entitlements.canCreateShareLinks && (
        <section class="card" id="ha-hacs-nudge">
          <h2 class="card-title">{t.haTitle}</h2>
          <p class="card-subtitle mb-4" set:html={t.haBodyHtml} />
          <div class="flex flex-wrap gap-3">
            <a class="btn-primary" href="/integrations/home-assistant">{t.haGuide}</a>
            <a class="btn-secondary" href="/integrations/matter">{t.matterGuide}</a>
            <a class="btn-ghost" href="https://github.com/doodersrage/probeharbor-home-assistant" target="_blank" rel="noreferrer">
              {t.hacsRepo}
            </a>
          </div>
        </section>
      )}

      {canManage && (entitlements.canCreateShareLinks || entitlements.canCreateFamilyShareLink) && (
        <>
          <form action="/api/share/manage" method="post" class="card">
            <input type="hidden" name="action" value="create" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <input type="hidden" name="family_quick" value="1" />
            <input type="hidden" name="scope" value="live" />
            <input type="hidden" name="expires_days" value="7" />
            <input type="hidden" name="label" value={t.familyDefaultLabel} />
            <h2 class="card-title">{t.familyTitle}</h2>
            <p class="card-subtitle mb-4">
              {t.familyBody}
              {!entitlements.canCreateShareLinks && (
                <> {t.familyFreeNote}</>
              )}
            </p>
            <button class="btn-primary" type="submit">{t.familySubmit}</button>
          </form>

          {entitlements.canCreateShareLinks && (
            <details class="card">
              <summary class="card-title cursor-pointer">{t.moreOptions}</summary>
              <form action="/api/share/manage" method="post" class="mt-4">
                <input type="hidden" name="action" value="create" />
                <input type="hidden" name="redirect" value={redirectTo} />
                <div class="config-row-grid">
                  <div class="form-field mb-0">
                    <label class="form-label" for="label">{t.label}</label>
                    <input class="form-input" id="label" name="label" placeholder={t.familyDefaultLabel} />
                  </div>
                  <div class="form-field mb-0">
                    <label class="form-label" for="scope">{t.scope}</label>
                    <select class="form-input" id="scope" name="scope">
                      <option value="live">{t.scopeLive}</option>
                      <option value="history">{t.scopeHistory}</option>
                      <option value="metrics">{t.scopeMetrics}</option>
                    </select>
                  </div>
                  <div class="form-field mb-0">
                    <label class="form-label" for="expires_days">{t.expires}</label>
                    <select class="form-input" id="expires_days" name="expires_days">
                      <option value="0">{t.expiresNever}</option>
                      <option value="2">{t.expires2}</option>
                      <option value="7" selected>{t.expires7}</option>
                      <option value="14">{t.expires14}</option>
                      <option value="30">{t.expires30}</option>
                    </select>
                  </div>
                </div>
                <button class="btn-secondary mt-4" type="submit">{t.create}</button>
              </form>
            </details>
          )}

          {!entitlements.canCreateShareLinks && (
            <UpgradeNudge feature="share_links" tier={entitlements.tier} compact />
          )}
        </>
      )}

      <section class="card">
        <h2 class="card-title">{t.yourLinks}</h2>
        {(links ?? []).length === 0 ? (
          <p class="mb-0">{t.noLinks}</p>
        ) : (
          <ul class="space-y-4">
            {(links ?? []).map((link) => {
              const preview =
                "token_preview" in link && link.token_preview
                  ? String(link.token_preview)
                  : link.token
                    ? link.token.slice(-4)
                    : "????";
              const href =
                canManage && link.token ? `${siteUrl}/share/${link.token}` : null;
              const maskedHref = `${siteUrl}/share/••••${preview}`;
              const isNew = Boolean(canManage && newToken && link.token === newToken);
              const expired =
                Boolean(link.expires_at) &&
                Date.parse(link.expires_at as string) <= Date.now();
              return (
                <li
                  class:list={[
                    "flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between rounded-xl p-3",
                    isNew && "share-link-new",
                    expired && "share-link-expired",
                  ]}
                  id={isNew ? "share-link-highlighted" : undefined}
                >
                  <div>
                    <strong>{link.label || scopeName(link.scope)}</strong>
                    {isNew && <span class="feed-health-ok ml-2">{t.badgeNew}</span>}
                    {expired && <span class="feed-health-error ml-2">{t.badgeExpired}</span>}
                    <p class="m-0 text-sm break-all">
                      {href ? (
                        expired ? (
                          <span class="text-[var(--color-text-muted)]">{href}</span>
                        ) : (
                          <a href={href}>{href}</a>
                        )
                      ) : (
                        <span class="text-[var(--color-text-muted)]">{maskedHref}</span>
                      )}
                    </p>
                    <p class="m-0 text-sm text-[var(--color-text-muted)]">
                      {fmt(t.scopeLine, { scope: scopeName(link.scope) })}
                      {link.expires_at
                        ? expired
                          ? fmt(t.expiredOn, { date: formatDate(link.expires_at) })
                          : fmt(t.expiresOn, { date: formatDate(link.expires_at) })
                        : t.noExpiry}
                    </p>
                    {canManage && link.token && link.scope === "live" && !expired && (
                      <p class="m-0 text-sm break-all text-[var(--color-text-muted)]">
                        {fmt(t.embed, { url: `${siteUrl}/embed/${link.token}` })}
                      </p>
                    )}
                    {canManage && link.token && link.scope === "metrics" && !expired && (
                      <p class="m-0 text-sm break-all text-[var(--color-text-muted)]">
                        {fmt(t.scrape, { url: `${siteUrl}/api/share/${link.token}/readings?format=prometheus` })}
                      </p>
                    )}
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {canManage && href && !expired && (
                      <button
                        type="button"
                        class="btn-secondary"
                        data-copy={href}
                        data-copy-label={t.copyLink}
                      >
                        {t.copyLink}
                      </button>
                    )}
                    {canManage && (
                      <form action="/api/share/manage" method="post">
                        <input type="hidden" name="action" value="revoke" />
                        <input type="hidden" name="id" value={link.id} />
                        <input type="hidden" name="redirect" value={redirectTo} />
                        <button class="btn-ghost" type="submit" onclick={confirmRevoke}>
                          {expired ? t.remove : t.revoke}
                        </button>
                      </form>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>

      {entitlements.canCreateShareLinks && canManage && (
        <section class="card">
          <h2 class="card-title">{t.statusTitle}</h2>
          <p class="card-subtitle mb-4" set:html={t.statusBodyHtml} />
          {statusToken && (
            <div class="ingest-key-callout mb-4">
              <p class="ingest-key-value break-all text-sm mb-2">{siteUrl}/status/{statusToken}</p>
              <button type="button" class="btn-primary" data-copy={`${siteUrl}/status/${statusToken}`} data-copy-label={t.copyLink}>
                {t.copyStatusUrl}
              </button>
            </div>
          )}
          <form action="/api/status/manage" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
            <input type="hidden" name="action" value="create" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <div class="form-field mb-0">
              <label class="form-label" for="status-label">{t.label}</label>
              <input class="form-input" id="status-label" name="label" value={t.statusDefaultLabel} />
            </div>
            <button class="btn-secondary" type="submit">{t.createStatus}</button>
          </form>
          {statusPages.length === 0 ? (
            <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.noStatusPages}</p>
          ) : (
            <ul class="space-y-3">
              {statusPages.map((page) => (
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <strong>{page.label}</strong>
                    <p class="m-0 text-sm break-all">
                      <a href={`${siteUrl}/status/${page.token}`}>{siteUrl}/status/{page.token}</a>
                    </p>
                    <p class="m-0 text-xs text-[var(--color-text-muted)] break-all">
                      {t.badgeLabel} <code>{siteUrl}/badge/status/{page.token}.svg</code>
                      {" · "}
                      <a class="text-link" href={`${siteUrl}/badge/status/${page.token}.svg`}>{t.preview}</a>
                    </p>
                  </div>
                  <form action="/api/status/manage" method="post">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="id" value={page.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-ghost" type="submit">{t.revoke}</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}
    </div>
  </ShareNav>
</DashboardLayout>

{newHref && (
  <script is:inline>
    (() => {
      const el = document.getElementById("new-share-link");
      el?.scrollIntoView({ behavior: "smooth", block: "start" });
    })();
  </script>
)}
