---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import ShareNav from "../../../components/dashboard/ShareNav.astro";
import UpgradeNudge from "../../../components/UpgradeNudge.astro";
import { loadShareDashboardContext } from "../../../lib/shareDashboardContext";
import { getLocale } from "../../../i18n";
import { shareMessages, shareNotice } from "../../../i18n/messages/app/share";

const ctx = await loadShareDashboardContext(Astro.cookies, Astro.request, Astro.url);
if (ctx.redirect) return Astro.redirect(ctx.redirect);

const {
  entitlements,
  apiKeys,
  inboundWebhooks,
  ingestStats,
  canManage,
  siteUrl,
  newApiKey,
  inboundToken,
  inboundSigningSecret,
  noticeIsError,
} = ctx;
const msgs = shareMessages(getLocale(Astro));
const t = msgs.api;
const notice = ctx.notice ? (shareNotice(Astro.url, msgs.notices) ?? ctx.notice) : null;

const redirectTo = "/dashboard/share/api";
const showWebhookNudge =
  !entitlements.canUseOutboundWebhook && !entitlements.canCreateShareLinks;
---
<DashboardLayout title={msgs.title} subtitle={t.subtitle}>
  <ShareNav active="api">
    <div class="space-y-6">
      {notice && (
        <div class="dashboard-flash">
          <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0 mb-0"]}>{notice}</p>
        </div>
      )}

      <section class="card">
        <h2 class="card-title">{t.firstTitle}</h2>
        <p class="card-subtitle mb-4">
          {t.firstBody}
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/dashboard/devices">{t.createPushDevice}</a>
          <a class="btn-secondary" href="/docs/api#ingest">{t.apiDocsIngest}</a>
          <a class="btn-ghost" href="/about/probe-demo">{t.copySample}</a>
        </div>
      </section>

      {showWebhookNudge && (
        <UpgradeNudge feature="webhooks" tier={entitlements.tier} />
      )}

      {entitlements.canCreateShareLinks && canManage && (
        <section class="card">
          <h2 class="card-title">{t.keysTitle}</h2>
          <p class="card-subtitle mb-4" set:html={t.keysBodyHtml} />
          {newApiKey && (
            <div class="ingest-key-callout mb-4">
              <p class="ingest-key-value break-all text-sm mb-2">{newApiKey}</p>
              <button type="button" class="btn-primary" data-copy={newApiKey} data-copy-label={t.copyKey}>
                {t.copyKey}
              </button>
            </div>
          )}
          <form action="/api/api-keys" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
            <input type="hidden" name="action" value="create" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <div class="form-field mb-0">
              <label class="form-label" for="api-key-name">{t.name}</label>
              <input class="form-input" id="api-key-name" name="name" value={t.keyDefaultName} />
            </div>
            <button class="btn-secondary" type="submit">{t.createKey}</button>
          </form>
          {apiKeys.length === 0 ? (
            <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.noKeys}</p>
          ) : (
            <ul class="space-y-3">
              {apiKeys.map((key) => (
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <strong>{key.name}</strong>
                    <span class="text-sm text-[var(--color-text-muted)]"> · {key.key_prefix}…</span>
                  </div>
                  <form action="/api/api-keys" method="post">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="id" value={key.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-ghost" type="submit">{t.revoke}</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
          <p class="mt-4 mb-0 text-sm">
            <a class="text-link" href="/grafana/probeharbor-dashboard.json" download>
              {t.downloadGrafana}
            </a>
          </p>
        </section>
      )}

      {!entitlements.canCreateShareLinks && (
        <UpgradeNudge feature="share_links" tier={entitlements.tier} />
      )}

      {entitlements.canUseOutboundWebhook && (
        <section class="card" id="inbound-webhooks">
          <h2 class="card-title">{t.inboundTitle}</h2>
          <p class="card-subtitle mb-4" set:html={t.inboundBodyHtml} />
          {!canManage && (
            <p class="alert-warning mb-4" role="status">{t.inboundViewOnly}</p>
          )}
          {inboundToken && (
            <div class="ingest-key-callout mb-4">
              <p class="text-sm mb-2">{t.newWebhookUrl}</p>
              <p class="ingest-key-value break-all text-sm mb-2">{siteUrl}/api/inbound/{inboundToken}</p>
              {inboundSigningSecret && (
                <>
                  <p class="text-sm mb-2">{t.signingSecret}</p>
                  <p class="ingest-key-value break-all text-sm mb-2">{inboundSigningSecret}</p>
                </>
              )}
              <button type="button" class="btn-primary" data-copy={`${siteUrl}/api/inbound/${inboundToken}`} data-copy-label={t.copyUrl}>
                {t.copyUrl}
              </button>
            </div>
          )}
          {canManage && (
            <form action="/api/inbound-webhooks" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
              <input type="hidden" name="action" value="create" />
              <input type="hidden" name="redirect" value={redirectTo} />
              <div class="form-field mb-0">
                <label class="form-label" for="inbound-name">{t.name}</label>
                <input class="form-input" id="inbound-name" name="name" value={t.inboundDefaultName} />
              </div>
              <button class="btn-secondary" type="submit">{t.createInbound}</button>
            </form>
          )}
          {inboundWebhooks.length === 0 ? (
            <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.noInbound}</p>
          ) : (
            <ul class="space-y-3">
              {inboundWebhooks.map((wh) => (
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <strong>{wh.name}</strong>
                    <span class="text-sm text-[var(--color-text-muted)]"> · {wh.token_prefix}…</span>
                  </div>
                  <form action="/api/inbound-webhooks" method="post">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="webhook_id" value={wh.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-ghost" type="submit">{t.revoke}</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}

      <section class="card">
        <h2 class="card-title">{t.statsTitle}</h2>
        <p class="card-subtitle mb-4">
          {t.statsBody}
          {ingestStats.length === 0 && ` ${t.statsEmpty}`}
        </p>
        {ingestStats.length > 0 && (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-[var(--color-text-muted)]">
                  <th class="py-2 pr-3">{t.colDevice}</th>
                  <th class="py-2 pr-3">{t.colDay}</th>
                  <th class="py-2 pr-3">{t.colOk}</th>
                  <th class="py-2">{t.colErrors}</th>
                </tr>
              </thead>
              <tbody>
                {ingestStats.slice(0, 20).map((row) => (
                  <tr class="border-t border-[var(--color-border)]">
                    <td class="py-2 pr-3">{row.device_name}</td>
                    <td class="py-2 pr-3">{row.day}</td>
                    <td class="py-2 pr-3">{row.success_count}</td>
                    <td class="py-2">{row.error_count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  </ShareNav>
</DashboardLayout>
