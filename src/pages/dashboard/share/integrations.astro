---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import ShareNav from "../../../components/dashboard/ShareNav.astro";
import { formatHouseholdActivityAction } from "../../../lib/householdActivityLabels";
import GrafanaWizard from "../../../components/GrafanaWizard.astro";
import WebhookDeliveryLog from "../../../components/WebhookDeliveryLog.astro";
import HaSetupCard from "../../../components/HaSetupCard.astro";
import HaDiagnosticsCard from "../../../components/HaDiagnosticsCard.astro";
import { listHouseholdDevices } from "../../../lib/devices";
import LanSensorSetupCard from "../../../components/LanSensorSetupCard.astro";
import NodeRedSetupCard from "../../../components/NodeRedSetupCard.astro";
import ZapierSetupCard from "../../../components/ZapierSetupCard.astro";
import { loadShareDashboardContext } from "../../../lib/shareDashboardContext";
import { formatDateTime, getLocale } from "../../../i18n";
import { shareMessages, shareNotice } from "../../../i18n/messages/app/share";

const ctx = await loadShareDashboardContext(Astro.cookies, Astro.request, Astro.url);
if (ctx.redirect) return Astro.redirect(ctx.redirect);

const {
  entitlements,
  apiKeys,
  inboundWebhooks,
  activity,
  siteUrl,
  webhookDeliveries,
  newApiKey,
  inboundToken,
  noticeIsError,
  household,
} = ctx;
const locale = getLocale(Astro);
const msgs = shareMessages(locale);
const t = msgs.integrations;
const notice = ctx.notice ? (shareNotice(Astro.url, msgs.notices) ?? ctx.notice) : null;
const dateTimeOptions: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "numeric",
  day: "numeric",
  hour: "numeric",
  minute: "numeric",
  second: "numeric",
};
const haDevices = household.householdId ? (await listHouseholdDevices(household.householdId)).devices : [];
---
<DashboardLayout title={msgs.title} subtitle={t.subtitle}>
  <ShareNav active="integrations">
    <div class="space-y-6">
      {notice && (
        <div class="dashboard-flash">
          <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0 mb-0"]}>{notice}</p>
        </div>
      )}

      <GrafanaWizard
        siteUrl={siteUrl}
        apiKeyPrefix={apiKeys[0]?.key_prefix ?? null}
        apiKey={newApiKey}
      />

      {entitlements.canUseOutboundWebhook && (
        <WebhookDeliveryLog deliveries={webhookDeliveries} />
      )}

      <ZapierSetupCard
        siteUrl={siteUrl}
        inboundWebhookUrl={
          inboundToken ? `${siteUrl}/api/inbound/${inboundToken}` : null
        }
        hasInboundWebhook={inboundWebhooks.length > 0 || Boolean(inboundToken)}
      />

      <HaSetupCard
        siteUrl={siteUrl}
        apiKey={newApiKey}
        inboundWebhookUrl={
          inboundToken ? `${siteUrl}/api/inbound/${inboundToken}` : null
        }
      />

      <HaDiagnosticsCard devices={haDevices} />

      <LanSensorSetupCard />

      <NodeRedSetupCard />

      <section class="card">
        <h2 class="card-title">{t.activityTitle}</h2>
        {activity.length === 0 ? (
          <p class="mb-0 text-sm text-[var(--color-text-muted)]">
            {t.activityEmpty}
          </p>
        ) : (
          <ul class="space-y-2 mb-0 text-sm">
            {activity.map((row) => (
              <li>
                <strong>{formatHouseholdActivityAction(row.action, locale)}</strong>
                {row.detail ? `: ${row.detail}` : ""}
                <span class="text-[var(--color-text-muted)]">
                  {" · "}
                  {formatDateTime(row.created_at, locale, dateTimeOptions)}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card">
        <h2 class="card-title">{t.exportTitle}</h2>
        <p class="card-subtitle mb-3">{t.exportBody}</p>
        <a class="btn-secondary" href="/api/user/export">{t.exportButton}</a>
      </section>
    </div>
  </ShareNav>
</DashboardLayout>
