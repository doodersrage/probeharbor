---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DeviceSetupWizard from "../../components/DeviceSetupWizard.astro";
import IngestFirmwarePanel from "../../components/dashboard/IngestFirmwarePanel.astro";
import DevicesFirstRunCard from "../../components/dashboard/DevicesFirstRunCard.astro";
import DeviceListCard from "../../components/dashboard/DeviceListCard.astro";
import ProtectionCoverageCard from "../../components/dashboard/ProtectionCoverageCard.astro";
import DashboardTabNav from "../../components/dashboard/DashboardTabNav.astro";
import PushDevicesPanel from "../../components/dashboard/PushDevicesPanel.astro";
import PullFeedsPanel from "../../components/dashboard/PullFeedsPanel.astro";
import DeviceIntegrationsStrip from "../../components/DeviceIntegrationsStrip.astro";
import FirstAlertSetupCard from "../../components/FirstAlertSetupCard.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getUserPreferences } from "../../lib/userPreferences";
import { checkFeedHealth } from "../../lib/collectHistory";
import { feedHealthMessage } from "../../lib/feedErrorText";
import { getUserDevicesAsTempConfig, listHouseholdDevices } from "../../lib/devices";
import { getOrCreateHouseholdForUser, listUserHouseholds, getUserHouseholdRole, canEditHousehold, canManageHousehold } from "../../lib/households";
import { listConnectionsForHousehold } from "../../lib/thermostatConnections";
import { getIndoorReferenceSensorId, listIndoorReferenceOptions } from "../../lib/indoorReference";
import { fetchThermostatContextWithStatus } from "../../lib/thermostatCorrelation";
import { listConfiguredThermostatProviders } from "../../lib/thermostatOAuth";
import { getUserEntitlements } from "../../lib/entitlements";
import { fetchLatestSensorValues } from "../../lib/sensorReadings";
import { findStuckSensors } from "../../lib/stuckSensors";
import { buildProtectionCoverage } from "../../lib/protectionCoverage";
import { replacementErrorMessage } from "../../lib/sensorReplacement";
import { latestFromShell } from "../../lib/dashboardShell";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import { renderIngestQrSvg } from "../../lib/qrSvg";
import {
  buildWaitingIngestCurl,
  buildWaitingIngestPayload,
} from "../../lib/waitingIngest";
import ProductAnalyticsTracker from "../../components/ProductAnalyticsTracker.astro";
import { FLASH_INGEST_KEY, peekSecretFlash } from "../../lib/secretFlash";
import { ingestKeyVaultConfigured } from "../../lib/ingestKeyVault";
import { getAlertSettingsForUser } from "../../lib/notify";
import { buildEspHomeHttpRequestSnippet } from "../../lib/waitingIngest";
import {
  buildHomeAssistantPushYaml,
  buildMqttBridgeCurl,
  parseSetupVia,
} from "../../lib/firstDevicePaths";
import I18nJson from "../../components/I18nJson.astro";
import { fmt, getLocale, LOCALE_META, plural } from "../../i18n";
import { devicesMessages } from "../../i18n/messages/app/devices";

const locale = getLocale(Astro);
const t = devicesMessages(locale);
const tn = t.notice;

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const [preferences, feedHealth, deviceConfig, entitlements, household, userHouseholds, alertSettings] = await Promise.all([
  getUserPreferences(user),
  checkFeedHealth(user.id),
  getUserDevicesAsTempConfig(user.id, user.email),
  shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
  getOrCreateHouseholdForUser(user.id, user.email),
  shell
    ? Promise.resolve({ households: shell.households, error: null as string | null })
    : listUserHouseholds(user.id),
  getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
]);

const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canEdit = canEditHousehold(householdRole);
const canManageThermostat = canManageHousehold(householdRole);
const transferTargets = userHouseholds.households.filter(
  (h) => h.household_id !== household.householdId,
);

const thermostatConnections =
  entitlements.canUseThermostatIntegration && household.householdId
    ? await listConnectionsForHousehold(household.householdId)
    : [];
const availableThermostatProviders = listConfiguredThermostatProviders();
const thermostatConnectionsWithSnapshots = await Promise.all(
  thermostatConnections.map(async (connection) => {
    const result =
      household.householdId
        ? await fetchThermostatContextWithStatus(household.householdId, connection.provider, locale)
        : { snapshot: null };
    return {
      provider: connection.provider,
      snapshot: result.snapshot,
      fetchError: "fetchError" in result ? result.fetchError : undefined,
      fetchHint: "fetchHint" in result ? result.fetchHint : undefined,
    };
  }),
);

const devices = household.householdId
  ? (await listHouseholdDevices(household.householdId)).devices
  : deviceConfig.devices;

const indoorReferenceSensorId = household.householdId
  ? await getIndoorReferenceSensorId(household.householdId)
  : null;
const indoorReferenceOptions = listIndoorReferenceOptions(devices);
const indoorRefSaved = Astro.url.searchParams.get("indoor_ref_saved") === "1";
const indoorRefErrorCode = Astro.url.searchParams.get("indoor_ref_error");
const indoorRefError =
  indoorRefErrorCode === "save_failed"
    ? t.indoorRefError.saveFailed
    : indoorRefErrorCode === "forbidden"
      ? t.indoorRefError.forbidden
      : indoorRefErrorCode === "no_household"
        ? t.indoorRefError.noHousehold
        : null;

const shellLatest = latestFromShell(shell, household.householdId);
const latest = shellLatest
  ? shellLatest
  : household.householdId
    ? await fetchLatestSensorValues(household.householdId)
    : [];
// Never let a slow or failed check hold up the Devices page.
const stuckSensors = await findStuckSensors(devices, Date.now(), locale).catch(() => []);

const ingestKey = peekSecretFlash(Astro.cookies, FLASH_INGEST_KEY);
const tabParam = Astro.url.searchParams.get("tab");
const activeTab: "push" | "pull" | "thermostat" =
  tabParam === "pull" ? "pull" : tabParam === "thermostat" ? "thermostat" : "push";
const focusDevice = Astro.url.searchParams.get("focus_device") ?? "";
const atDeviceLimit =
  devices.filter((d) => d.source === "push").length >= entitlements.maxDevices;

const noticeParam = Astro.url.searchParams.get("error");
const bulkDeleted = Astro.url.searchParams.get("bulk_deleted");
const bulkUpdated = Astro.url.searchParams.get("bulk_updated");
const sensorReplaced = Astro.url.searchParams.get("sensor_replaced");
const replaceError = Astro.url.searchParams.get("replace_error");
const deviceNotice =
  Astro.url.searchParams.get("device_transferred")
    ? tn.deviceTransferred
    : noticeParam === "device_not_found"
      ? tn.deviceNotFound
  : sensorReplaced
    ? plural(tn.sensorReplaced, Number(sensorReplaced), locale)
    : replaceError
      ? replacementErrorMessage(replaceError, locale)
  : Astro.url.searchParams.get("device_deleted")
    ? tn.deviceDeleted
    : bulkDeleted
      ? plural(tn.bulkDeleted, Number(bulkDeleted), locale, { count: bulkDeleted })
      : bulkUpdated
        ? plural(tn.bulkUpdated, Number(bulkUpdated), locale, { count: bulkUpdated })
        : Astro.url.searchParams.get("bulk_error")
          ? tn.bulkError
    : Astro.url.searchParams.get("device_renamed")
      ? tn.deviceRenamed
      : Astro.url.searchParams.get("sensor_added")
      ? tn.sensorAdded
      : Astro.url.searchParams.get("sensor_updated")
        ? tn.sensorUpdated
        : Astro.url.searchParams.get("sensor_deleted")
          ? tn.sensorDeleted
          : Astro.url.searchParams.get("feeds_saved") || Astro.url.searchParams.get("pull_saved")
            ? Astro.url.searchParams.get("probes_discovered")
              ? fmt(tn.pullSavedDiscovered, { count: Astro.url.searchParams.get("probes_discovered") ?? "" })
              : tn.pullSaved
            : Astro.url.searchParams.get("probes_saved")
              ? tn.probesSaved
              : Astro.url.searchParams.get("sensors_renamed")
                ? tn.sensorsRenamed
              : Astro.url.searchParams.get("feed_deleted")
                ? tn.feedDeleted
                : Astro.url.searchParams.get("probe_deleted")
                  ? tn.probeDeleted
                  : Astro.url.searchParams.get("feeds_error") ||
                      Astro.url.searchParams.get("probes_error")
                    ? tn.saveFailed
                    : noticeParam === "device_limit"
                      ? fmt(tn.deviceLimit, { max: entitlements.maxDevices })
                      : noticeParam === "viewer"
                        ? tn.viewer
                      : noticeParam === "1" || noticeParam === "true"
                        ? tn.deviceActionFailed
                        : noticeParam
                          ? fmt(tn.actionFailed, { code: noticeParam })
                          : null;

const noticeIsError =
  Astro.url.searchParams.has("error") ||
  Boolean(replaceError) ||
  Boolean(Astro.url.searchParams.get("feeds_error")) ||
  Boolean(Astro.url.searchParams.get("probes_error")) ||
  Boolean(Astro.url.searchParams.get("bulk_error"));

const keyCalloutTitle = Astro.url.searchParams.get("key_rotated")
  ? t.keyCallout.titleRotated
  : t.keyCallout.title;
const showAddSensorNudge = false;

const pushDevices = devices.filter((d) => d.source === "push");
const waitingPushDevices = pushDevices.filter(
  (d) => !d.last_seen_at && d.sensors.length > 0,
);
const waitingPushNoSensors = pushDevices.filter(
  (d) => !d.last_seen_at && d.sensors.length === 0,
);
const neverSeenWithSensors = waitingPushDevices.length > 0;
const showVerifyIngest =
  Boolean(Astro.url.searchParams.get("sensor_added")) ||
  neverSeenWithSensors ||
  waitingPushNoSensors.length > 0;

const waitingSensors = waitingPushDevices.flatMap((d) =>
  d.sensors.map((s) => ({ key: s.key, kind: s.kind, deviceName: d.name })),
);
const waitingPayload = buildWaitingIngestPayload(waitingSensors);
const waitingCurl = buildWaitingIngestCurl(
  Astro.url.origin,
  waitingSensors,
  ingestKey || "YOUR_KEY",
);
const waitingKeyList = [...new Set(waitingSensors.map((s) => s.key))];
const ingestOk = Astro.url.searchParams.get("ingest_ok") === "1";
const deviceCreated = Astro.url.searchParams.get("device_created") === "1";
const pullSaved = Astro.url.searchParams.get("pull_saved") === "1";
const demoPullStarted = Astro.url.searchParams.get("demo_pull") === "1";
const alertSaved = Astro.url.searchParams.get("alert_saved") === "1";
const testSent = Astro.url.searchParams.get("test_sent") === "1";
const testError = Astro.url.searchParams.get("test_error") === "1";
const analyticsEvents = [
  ...(ingestOk ? [{ name: "first_ingest" as const }] : []),
  ...(deviceCreated ? [{ name: "device_created" as const }] : []),
  ...(pullSaved ? [{ name: "pull_setup_saved" as const }] : []),
  ...(demoPullStarted ? [{ name: "demo_pull_started" as const }] : []),
  ...(alertSaved ? [{ name: "alert_essentials_saved" as const }] : []),
];

const ingestCurlExample = ingestKey
  ? waitingKeyList.length > 0
    ? waitingCurl
    : `curl -X POST "${Astro.url.origin}/api/ingest/${ingestKey}" \\\n  -H "Content-Type: application/json" \\\n  -d '{"door1": true, "temp1": 42.5}'`
  : "";
const ingestUrl = ingestKey
  ? `${Astro.url.origin}/api/ingest/${ingestKey}`
  : "";
const ingestQrSvg = ingestUrl ? renderIngestQrSvg(ingestUrl, 180) : "";
// Chosen on the first-run card: lead the key callout with that path's snippet.
const setupVia = parseSetupVia(Astro.url.searchParams.get("via"));
const viaSnippet =
  ingestUrl && ingestKey
    ? setupVia === "ha"
      ? {
          title: t.via.ha.title,
          hint: t.via.ha.hint,
          code: buildHomeAssistantPushYaml(ingestUrl),
          guide: { href: "/integrations/home-assistant", label: t.via.ha.guide },
        }
      : setupVia === "esphome"
        ? {
            title: t.via.esphome.title,
            hint: t.via.esphome.hint,
            code: buildEspHomeHttpRequestSnippet(ingestUrl),
            guide: { href: "/about/esphome-shelly-recipes", label: t.via.esphome.guide },
          }
        : setupVia === "mqtt"
          ? {
              title: t.via.mqtt.title,
              hint: t.via.mqtt.hint,
              code: buildMqttBridgeCurl(Astro.url.origin, ingestKey),
              guide: { href: "/nodered/mqtt-to-probeharbor.json", label: t.via.mqtt.guide },
            }
          : null
    : null;
const ingestKeyDeviceName =
  (focusDevice && devices.find((d) => d.id === focusDevice)?.name) ||
  pushDevices[0]?.name ||
  t.keyCallout.defaultDeviceName;
const printTitle = t.keyCallout.printTitle;
const waitingText = t.client;
const intlLocale = LOCALE_META[locale].intl;

const showAllDevices = Astro.url.searchParams.get("view") === "all";
// The device being set up has sent its first reading: setup steps can fold away.
const focusDeviceReporting =
  ingestOk || Boolean(focusDevice && pushDevices.some((d) => d.id === focusDevice && d.last_seen_at));
const hasLiveIngest =
  latest.length > 0 || pushDevices.some((d) => Boolean(d.last_seen_at));
const showDeviceWizard =
  canEdit &&
  !showAllDevices &&
  !hasLiveIngest &&
  (devices.length === 0 || pushDevices.length > 0);
const wizardStep =
  devices.length === 0
    ? 1
    : pushDevices.some((d) => !d.last_seen_at)
      ? 2
      : 2;
const ingestKeyVaultLive = ingestKeyVaultConfigured();
const pullFeedIds = preferences.tempFeeds.filter((f) => f.url).map((f) => f.id);
const showRenameBatch =
  Boolean(Astro.url.searchParams.get("rename_sensors")) ||
  Number(Astro.url.searchParams.get("sensors_created") ?? "0") > 0;
const alertsEssentialsDone =
  alertSettings.enabled &&
  alertSettings.channelEmail &&
  Boolean(alertSettings.email || user.email);
const postSetupFunnel = ingestOk && canEdit;
const showFirstAlertSetup =
  canEdit &&
  (ingestOk || hasLiveIngest) &&
  (!alertsEssentialsDone || alertSaved || testError);
const showPowerFeatures = hasLiveIngest || showAllDevices;
const firmwareSensors =
  waitingSensors.length > 0
    ? waitingSensors.map((s) => ({ key: s.key, kind: s.kind }))
    : [{ key: "temp1", kind: "temperature" }];
const viewParam = Astro.url.searchParams.get("view");
// An explicit tab (old links, form redirects) always opens that tab, not the Status view.
const devicesView =
  viewParam === "setup" || viewParam === "all" || (viewParam == null && tabParam != null)
    ? "setup"
    : viewParam === "ops"
      ? "ops"
      : hasLiveIngest && !showDeviceWizard && !neverSeenWithSensors
        ? "ops"
        : "setup";
const devicesSetupHref =
  activeTab === "push" ? "/dashboard/devices?view=setup" : `/dashboard/devices?view=setup&tab=${activeTab}`;
const redirectTo =
  devicesView === "ops" ? "/dashboard/devices?view=ops" : devicesSetupHref;
---
<DashboardLayout
  title={t.title}
  subtitle={
    devicesView === "ops"
      ? t.subtitle.ops
      : activeTab === "pull"
        ? t.subtitle.pull
        : activeTab === "thermostat"
          ? t.subtitle.thermostat
          : t.subtitle.push
  }
>
  <ProductAnalyticsTracker events={analyticsEvents} />
  <div class="space-y-6">
    {deviceNotice && (
      <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0 mb-0"]}>
        {deviceNotice}
        {noticeParam === "device_limit" && (
          <>
            {" "}
            <a class="text-link" href="/dashboard/plans">{tn.viewPlans}</a>
          </>
        )}
      </p>
    )}

    {/* One flat row: what each tab holds is in its name. */}
    <DashboardTabNav
      tabs={[
        { id: "ops", label: t.tabs.ops, href: "/dashboard/devices?view=ops" },
        { id: "push", label: t.tabs.push, href: "/dashboard/devices?view=setup&tab=push" },
        { id: "pull", label: t.tabs.pull, href: "/dashboard/devices?view=setup&tab=pull" },
        { id: "thermostat", label: t.tabs.thermostat, href: "/dashboard/devices?view=setup&tab=thermostat" },
      ]}
      activeId={devicesView === "ops" ? "ops" : activeTab}
      ariaLabel={t.tabs.ariaLabel}
    />

    {devicesView === "ops" && showPowerFeatures && !showDeviceWizard && (
      <DeviceListCard
        devices={devices}
        latest={latest}
        stuck={stuckSensors}
        feedStatuses={feedHealth.statuses.map((status) => ({ ...status, message: feedHealthMessage(status, locale) }))}
        canEdit={canEdit}
        redirectTo={redirectTo}
        addHref="/dashboard/devices?view=setup&tab=push"
      />
      <ProtectionCoverageCard coverage={buildProtectionCoverage(devices, latest, Date.now(), locale)} />
    )}


    {devicesView === "setup" && activeTab === "push" && devices.length === 0 && (
      <DevicesFirstRunCard
        canEdit={canEdit}
        atDeviceLimit={atDeviceLimit}
        redirectTo={redirectTo}
        nestEntitled={entitlements.canUseThermostatIntegration}
      />
    )}

    {devicesView === "setup" && (
      <DeviceSetupWizard show={postSetupFunnel} alertsDone={alertsEssentialsDone || alertSaved} />
    )}

    {devicesView === "setup" && (
    <FirstAlertSetupCard
      show={showFirstAlertSetup}
      freezeThresholdF={alertSettings.freezeThresholdF}
      email={alertSettings.email || user.email}
      alertSaved={alertSaved}
      testSent={testSent}
      testError={testError}
    />
    )}

    {(noticeParam === "device_limit" || atDeviceLimit) && (
      <UpgradeNudge feature="device_limit" tier={entitlements.tier} compact />
    )}

    {(devicesView === "setup" || Boolean(ingestKey)) && ingestKey && (
      <section class="card ingest-key-callout" id="ingest-key-callout">
        <h2 class="card-title">{keyCalloutTitle}</h2>
        <p class="card-subtitle">
          {focusDeviceReporting
            ? t.keyCallout.subtitleReporting
            : t.keyCallout.subtitle}
        </p>
        <details class="ingest-key-details" open={!focusDeviceReporting}>
        <summary class="cursor-pointer text-sm font-semibold mb-3">{focusDeviceReporting ? t.keyCallout.summaryReporting : t.keyCallout.summary}</summary>
        {viaSnippet && (
          <div class="mb-4" id="ingest-via-snippet">
            <h3 class="form-label mb-1">{viaSnippet.title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] mt-0 mb-2">{viaSnippet.hint}</p>
            <pre class="ingest-key-curl text-xs overflow-x-auto mb-2"><code>{viaSnippet.code}</code></pre>
            <div class="flex flex-wrap gap-3">
              <button type="button" class="btn-primary" data-copy={viaSnippet.code} data-copy-label={t.keyCallout.copySnippet}>
                {t.keyCallout.copySnippet}
              </button>
              <a class="btn-ghost" href={viaSnippet.guide.href}>{viaSnippet.guide.label}</a>
            </div>
          </div>
        )}
        <div class="flex flex-wrap gap-6 items-start mb-4">
          <div
            class="ingest-key-qr shrink-0 rounded-lg bg-white p-2"
            id="ingest-key-qr"
            aria-label={t.keyCallout.qrAria}
            set:html={ingestQrSvg}
          />
          <div class="min-w-0 flex-1">
            <p class="form-label mb-1">{t.keyCallout.ingestUrl}</p>
            <p class="ingest-key-value break-all font-mono text-sm mb-2" id="ingest-url-value">{ingestUrl}</p>
            <p class="ingest-key-value break-all font-mono text-sm mb-0" id="ingest-key-value">{ingestKey}</p>
            <p class="text-sm text-[var(--color-text-muted)] mt-2 mb-0">
              {t.keyCallout.postJsonTo} <code>/api/ingest/{ingestKey}</code>
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 mb-4">
          <button
            type="button"
            class="btn-primary"
            data-copy={ingestUrl}
            data-copy-label={t.keyCallout.copyUrl}
          >
            {t.keyCallout.copyUrl}
          </button>
          <button
            type="button"
            class="btn-secondary"
            data-copy={ingestKey}
            data-copy-label={t.keyCallout.copyKey}
          >
            {t.keyCallout.copyKey}
          </button>
          <a
            class="btn-secondary"
            id="ingest-qr-download"
            href="#"
            download="probeharbor-ingest-qr.svg"
          >
            {t.keyCallout.downloadSvg}
          </a>
          <button type="button" class="btn-secondary" id="ingest-qr-print">
            {t.keyCallout.printLabel}
          </button>
          <button type="button" class="btn-ghost" id="ingest-key-dismiss">
            {t.keyCallout.dismiss}
          </button>
        </div>
        <IngestFirmwarePanel
          ingestUrl={ingestUrl}
          ingestKey={ingestKey}
          origin={Astro.url.origin}
          sensors={firmwareSensors}
          presetsOpen={!viaSnippet}
        />
        </details>
      </section>
    )}

    {devicesView === "setup" && showVerifyIngest && (
      <section
        class="card ingest-waiting-callout"
        id="verify-ingest-step"
        data-waiting-ingest
        data-waiting={neverSeenWithSensors || waitingPushNoSensors.length > 0 ? "1" : "0"}
      >
        <h2 class="card-title">
          {neverSeenWithSensors
            ? t.waiting.titleWaiting
            : waitingPushNoSensors.length > 0
              ? t.waiting.titleWaiting
              : t.waiting.titleVerify}
        </h2>
        <p class="card-subtitle mb-4">
          {t.waiting.subtitle}
        </p>

        {ingestUrl && (
          <div class="flex flex-wrap gap-6 items-start mb-4">
            <div
              class="ingest-key-qr shrink-0 rounded-lg bg-white p-2"
              aria-label={t.keyCallout.qrAria}
              set:html={renderIngestQrSvg(ingestUrl, 140)}
            />
            <div class="min-w-0 flex-1">
              <p class="form-label mb-1">{t.keyCallout.ingestUrl}</p>
              <p class="break-all font-mono text-sm mb-3">{ingestUrl}</p>
              <button
                type="button"
                class="btn-primary"
                data-copy={ingestUrl}
                data-copy-label={t.keyCallout.copyUrl}
              >
                {t.keyCallout.copyUrl}
              </button>
            </div>
          </div>
        )}

        <ol class="waiting-ingest-checklist mb-4">
          <li class="waiting-ingest-done">{t.waiting.stepCreated}</li>
          <li
            class="waiting-ingest-pending"
            data-waiting-step="post"
          >
            {t.waiting.stepPost}
            <span class="waiting-ingest-status" data-waiting-status>
              {neverSeenWithSensors || waitingPushNoSensors.length > 0
                ? t.waiting.statusListening
                : t.waiting.statusSendTest}
            </span>
          </li>
        </ol>

        <details class="rounded-lg border border-[var(--color-border)] p-3 mb-4">
          <summary class="cursor-pointer font-medium text-sm">{t.waiting.sampleSummary}</summary>
          <div class="mt-3 space-y-3">
            {waitingKeyList.length > 0 ? (
              <>
                <pre class="ingest-key-curl text-xs overflow-x-auto mb-0"><code>{JSON.stringify(waitingPayload, null, 2)}</code></pre>
                <pre class="ingest-key-curl text-xs overflow-x-auto mb-0"><code>{waitingCurl}</code></pre>
              </>
            ) : (
              <pre class="ingest-key-curl text-xs overflow-x-auto mb-0"><code>{ingestCurlExample || waitingCurl}</code></pre>
            )}
          </div>
        </details>

        {ingestUrl && ingestKey && (
          <IngestFirmwarePanel
            ingestUrl={ingestUrl}
            ingestKey={ingestKey}
            origin={Astro.url.origin}
            sensors={firmwareSensors}
            presetsOpen={false}
          />
        )}

        <div class="flex flex-wrap gap-3 items-center mt-4">
          <a class="btn-secondary" href="/about/kit-qr-onboarding">{t.waiting.kitGuide}</a>
          <button type="button" class="btn-ghost" data-waiting-refresh>
            {t.waiting.checkNow}
          </button>
        </div>
        <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]" data-waiting-meta>
          {neverSeenWithSensors || waitingPushNoSensors.length > 0
            ? t.waiting.metaAuto
            : t.waiting.metaManual}
        </p>
      </section>
    )}

    {devicesView === "setup" && showDeviceWizard && activeTab === "push" && devices.length > 0 && (
      <section class="card" id="device-setup-wizard">
        <h2 class="card-title">{t.wizard.title}</h2>
        <p class="card-subtitle mb-4">
          {fmt(t.wizard.step, { step: wizardStep })}
        </p>
        <ol class="waiting-ingest-checklist mb-4">
          <li class:list={[wizardStep > 1 && "waiting-ingest-done"]}>{t.wizard.createStep}</li>
          <li class:list={[wizardStep >= 2 && "waiting-ingest-pending"]}>
            {t.wizard.postStep}
          </li>
        </ol>
        <a class="btn-ghost" href="/dashboard/devices?view=all&tab=push">{t.wizard.showAll}</a>
      </section>
    )}

    {devicesView === "setup" && (
    <PushDevicesPanel
      activeTab={activeTab}
      entitlements={entitlements}
      ingestKeyVaultLive={ingestKeyVaultLive}
      pushDevices={pushDevices}
      canEdit={canEdit}
      atDeviceLimit={atDeviceLimit}
      redirectTo={redirectTo}
      devices={devices}
      showRenameBatch={showRenameBatch}
      focusDevice={focusDevice}
      ingestKey={ingestKey}
      transferTargets={transferTargets}
    />
    )}

    {/* Other hardware paths, after the user's own devices rather than before them. */}
    {devicesView === "setup" && activeTab === "push" && devices.length > 0 && !focusDeviceReporting && (
      <DeviceIntegrationsStrip />
    )}

    {devicesView === "setup" && (
    <PullFeedsPanel
      activeTab={activeTab}
      showPowerFeatures={showPowerFeatures}
      canEdit={canEdit}
      canManageThermostat={canManageThermostat}
      entitlements={entitlements}
      availableThermostatProviders={availableThermostatProviders}
      thermostatConnectionsWithSnapshots={thermostatConnectionsWithSnapshots}
      indoorReferenceOptions={indoorReferenceOptions}
      indoorReferenceSensorId={indoorReferenceSensorId}
      indoorRefSaved={indoorRefSaved}
      indoorRefError={indoorRefError}
      preferences={preferences}
      pullFeedIds={pullFeedIds}
      redirectTo={redirectTo}
      demoPullStarted={demoPullStarted}
      pullSaved={pullSaved}
    />
    )}
  </div>
  <datalist id="space-suggestions">
    <option value="garage" />
    <option value="attic" />
    <option value="crawlspace" />
    <option value="greenhouse" />
    <option value="workshop" />
    <option value="shop" />
    <option value="basement" />
  </datalist>
  <I18nJson id="devices-page-i18n" data={{ couldNotSave: t.client.couldNotSave, saved: t.client.saved }} />
</DashboardLayout>

{ingestKey && (
  <script is:inline define:vars={{ ingestQrSvg, ingestUrl, ingestKeyDeviceName, focusDeviceReporting, printTitle }}>
    (() => {
      const dismiss = document.getElementById("ingest-key-dismiss");
      dismiss?.addEventListener("click", () => {
        void fetch("/api/devices/dismiss-ingest-key", {
          method: "POST",
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        });
        const url = new URL(window.location.href);
        url.searchParams.delete("device_created");
        url.searchParams.delete("key_rotated");
        window.history.replaceState({}, "", url.pathname + (url.search || ""));
        document.getElementById("ingest-key-callout")?.remove();
      });

      const download = document.getElementById("ingest-qr-download");
      download?.addEventListener("click", (event) => {
        event.preventDefault();
        const blob = new Blob([ingestQrSvg], { type: "image/svg+xml;charset=utf-8" });
        const href = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = href;
        a.download = "probeharbor-ingest-qr.svg";
        a.click();
        URL.revokeObjectURL(href);
      });

      // Print from a hidden frame in this page. A popup opened with "noopener"
      // hands back null, which left an empty window and nothing to print.
      document.getElementById("ingest-qr-print")?.addEventListener("click", () => {
        const escape = (value) =>
          String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        const frame = document.createElement("iframe");
        frame.setAttribute("aria-hidden", "true");
        frame.style.cssText = "position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden";
        frame.srcdoc = `<!doctype html><html><head><title>${escape(printTitle)}</title>
          <style>
            body { font-family: system-ui, sans-serif; padding: 1.5rem; text-align: center; }
            h1 { font-size: 1.1rem; margin: 0 0 1rem; }
            .qr { display: inline-block; margin: 0 auto 1rem; }
            .url { font-family: ui-monospace, monospace; font-size: 0.75rem; word-break: break-all; }
          </style></head><body>
          <h1>${escape(ingestKeyDeviceName)}</h1>
          <div class="qr">${ingestQrSvg}</div>
          <p class="url">${escape(ingestUrl)}</p>
          </body></html>`;
        frame.addEventListener("load", () => {
          const win = frame.contentWindow;
          if (!win) return;
          win.addEventListener("afterprint", () => setTimeout(() => frame.remove(), 0));
          win.focus();
          win.print();
          // Some browsers never fire afterprint; don't leave frames behind.
          setTimeout(() => frame.remove(), 60_000);
        });
        document.body.append(frame);
      });

      // Once the device reports, the success card at the top is the next step.
      if (!focusDeviceReporting) {
        document.getElementById("ingest-key-callout")?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    })();
  </script>
)}

{!ingestKey && (Astro.url.searchParams.get("sensor_added") || neverSeenWithSensors || waitingPushNoSensors.length > 0) && (
  <script is:inline>
    (() => {
      document.getElementById("verify-ingest-step")?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    })();
  </script>
)}

{(neverSeenWithSensors || waitingPushNoSensors.length > 0) && (
  <script is:inline define:vars={{ waitingText, intlLocale }}>
    (() => {
      const root = document.querySelector("[data-waiting-ingest]");
      if (!(root instanceof HTMLElement)) return;

      const statusEl = root.querySelector("[data-waiting-status]");
      const metaEl = root.querySelector("[data-waiting-meta]");
      const stepEl = root.querySelector('[data-waiting-step="post"]');
      const refreshBtn = root.querySelector("[data-waiting-refresh]");
      let timer = 0;
      let inFlight = false;

      async function checkOnce() {
        if (inFlight) return;
        inFlight = true;
        try {
          const response = await fetch("/api/devices/ingest-status", {
            credentials: "same-origin",
            headers: { Accept: "application/json" },
          });
          if (!response.ok) throw new Error("status " + response.status);
          const payload = await response.json();
          const checked = payload.checkedAt
            ? new Date(payload.checkedAt).toLocaleTimeString(intlLocale)
            : new Date().toLocaleTimeString(intlLocale);
          if (metaEl) {
            metaEl.textContent = payload.waiting
              ? waitingText.stillWaiting.replace("{time}", checked)
              : waitingText.lastCheck.replace("{time}", checked);
          }
          if (!payload.waiting && (payload.seenCount > 0 || payload.latestCount > 0)) {
            if (statusEl) statusEl.textContent = waitingText.received;
            if (stepEl) {
              stepEl.classList.remove("waiting-ingest-pending");
              stepEl.classList.add("waiting-ingest-done");
            }
            const url = new URL(window.location.href);
            url.searchParams.set("ingest_ok", "1");
            url.searchParams.set("rename_sensors", "1");
            url.searchParams.delete("sensor_added");
            window.location.replace(url.pathname + "?" + url.searchParams.toString());
            return;
          }
          if (statusEl) statusEl.textContent = waitingText.listening;
        } catch {
          if (metaEl) metaEl.textContent = waitingText.checkFailed;
        } finally {
          inFlight = false;
        }
      }

      refreshBtn?.addEventListener("click", () => {
        void checkOnce();
      });

      void checkOnce();
      timer = window.setInterval(() => {
        void checkOnce();
      }, 5000);

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          window.clearInterval(timer);
          timer = 0;
        } else if (!timer) {
          void checkOnce();
          timer = window.setInterval(() => {
            void checkOnce();
          }, 5000);
        }
      });
    })();
  </script>
)}

<script>
  import { actions } from "astro:actions";
  import { readI18nJson } from "../../i18n/client";
  import en from "../../i18n/messages/app/devices/en";

  const pageText = readI18nJson("devices-page-i18n", {
    couldNotSave: en.client.couldNotSave,
    saved: en.client.saved,
  });

  async function handleDeviceForm(
    form: HTMLFormElement,
    run: (formData: FormData) => Promise<{ data?: { message?: string } | null; error?: { message?: string } | null }>,
  ) {
    const statusEl = form.querySelector<HTMLElement>("[data-device-status]");
    const errorEl = form.querySelector<HTMLElement>("[data-device-error]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    statusEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    if (submitBtn) submitBtn.disabled = true;
    const { data, error } = await run(new FormData(form));
    if (submitBtn) submitBtn.disabled = false;
    if (error) {
      if (errorEl) {
        errorEl.textContent = error.message || pageText.couldNotSave;
        errorEl.classList.remove("hidden");
      }
      return;
    }
    if (statusEl) {
      statusEl.textContent = data?.message ?? pageText.saved;
      statusEl.classList.remove("hidden");
    }
  }

  document.querySelectorAll<HTMLFormElement>("[data-device-rename-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void handleDeviceForm(form, (formData) => actions.renameDevice(formData));
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-device-space-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void handleDeviceForm(form, (formData) => actions.updateDeviceSpaceAction(formData));
    });
  });

  async function handleSensorForm(
    form: HTMLFormElement,
    run: (formData: FormData) => Promise<{ data?: { message?: string } | null; error?: { message?: string } | null }>,
    reloadOnSuccess = false,
  ) {
    const statusEl = form.querySelector<HTMLElement>("[data-sensor-status]");
    const errorEl = form.querySelector<HTMLElement>("[data-sensor-error]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    statusEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    if (submitBtn) submitBtn.disabled = true;
    const { data, error } = await run(new FormData(form));
    if (submitBtn) submitBtn.disabled = false;
    if (error) {
      if (errorEl) {
        errorEl.textContent = error.message || pageText.couldNotSave;
        errorEl.classList.remove("hidden");
      }
      return;
    }
    if (reloadOnSuccess) {
      window.location.reload();
      return;
    }
    if (statusEl) {
      statusEl.textContent = data?.message ?? pageText.saved;
      statusEl.classList.remove("hidden");
    }
  }

  document.querySelectorAll<HTMLFormElement>("[data-sensor-add-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void handleSensorForm(form, (formData) => actions.addSensor(formData), true);
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-sensor-pair-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void handleSensorForm(form, (formData) => actions.addSensorPair(formData), true);
    });
  });

  const focusId = new URL(window.location.href).searchParams.get("focus_device");
  if (focusId) {
    const card = document.getElementById(`device-${focusId}`);
    if (card) {
      card.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  const flashKeys = [
    "device_deleted",
    "device_renamed",
    "device_created",
    "bulk_deleted",
    "bulk_updated",
    "bulk_error",
    "sensor_added",
    "sensor_updated",
    "sensor_deleted",
    "sensor_replaced",
    "replace_error",
    "device_transferred",
    "feeds_saved",
    "pull_saved",
    "probes_discovered",
    "probes_saved",
    "sensors_renamed",
    "feed_deleted",
    "probe_deleted",
    "feeds_error",
    "probes_error",
    "error",
    "alert_saved",
    "test_sent",
    "test_error",
  ];
  const url = new URL(window.location.href);
  let changed = false;
  for (const key of flashKeys) {
    if (url.searchParams.has(key)) {
      url.searchParams.delete(key);
      changed = true;
    }
  }
  if (changed) {
    // Keep focus_device / tab / rename_sensors for deep-links.
    window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
  }
</script>
