---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DisplayPreferences from "../../components/DisplayPreferences.astro";
import PwaInstallCard from "../../components/dashboard/PwaInstallCard.astro";
import DashboardComfortCard from "../../components/dashboard/DashboardComfortCard.astro";
import TenantRelayCard from "../../components/dashboard/TenantRelayCard.astro";
import AccountSecurity from "../../components/AccountSecurity.astro";
import AccountLifecycle from "../../components/AccountLifecycle.astro";
import DataExportCard from "../../components/dashboard/DataExportCard.astro";
import NotificationsLinksCard from "../../components/dashboard/NotificationsLinksCard.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getTotpState } from "../../lib/betterAuthMfa";
import { getUserPreferences } from "../../lib/userPreferences";
import { getUserEntitlements } from "../../lib/entitlements";
import { getAlertSettingsForUser } from "../../lib/notify";
import {
  canEditHousehold,
  getOrCreateHouseholdForUser,
  getUserHouseholdRole,
} from "../../lib/households";
import { getTenantNotifySettings } from "../../lib/tenantRelay";
import {
  getDashboardGrowthTipsDismissed,
  getDashboardQuietUntil,
  isDashboardQuietActive,
  shouldForceSimpleOverview,
} from "../../lib/dashboardComfort";
import { getLocale, LOCALE_META, LOCALES } from "../../i18n";
import { settingsMessages } from "../../i18n/messages/app/settings";

const locale = getLocale(Astro);
const t = settingsMessages(locale);

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const household = await getOrCreateHouseholdForUser(user.id, user.email);
const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canEdit = canEditHousehold(householdRole);

const [preferences, entitlements, alertSettings, tenantNotify, hasPassword] = await Promise.all([
  getUserPreferences(user),
  shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
  getAlertSettingsForUser(user.id, user.user_metadata),
  household.householdId
    ? getTenantNotifySettings(household.householdId)
    : Promise.resolve({ email: null, name: null }),
  // Same rule as /api/user/account/delete: password accounts confirm with the
  // password, Google/GitHub/Discord-only accounts with their email.
  // If the lookup fails, ask for the password; the route still checks.
  getTotpState(user.id).then((state) => state.hasPassword, () => true),
]);
const prefsSaved = Astro.url.searchParams.get("prefs_saved");
const prefsError = Astro.url.searchParams.get("prefs_error");
const passwordUpdated = Astro.url.searchParams.get("password") === "updated";
const signOutAllFailed = Astro.url.searchParams.get("signout_all") === "failed";
const deleteError = Astro.url.searchParams.get("delete_error");
const retentionSaved = Astro.url.searchParams.get("retention_saved");
const tenantSaved = Astro.url.searchParams.get("tenant_saved");
const tenantError = Astro.url.searchParams.get("tenant_error");
const pinnedSaved = Astro.url.searchParams.get("pinned_saved");
const pinnedError = Astro.url.searchParams.get("pinned_error");
const quietSaved = Astro.url.searchParams.get("quiet_saved");
const quietCleared = Astro.url.searchParams.get("quiet_cleared");
const tipsHidden = Astro.url.searchParams.get("tips_hidden");
const tipsReset = Astro.url.searchParams.get("tips_reset");
const onboardingDismissed =
  (user.user_metadata as Record<string, unknown> | undefined)?.onboarding_dismissed ===
  true;
const quietUntil = getDashboardQuietUntil(user);
const quietActive = isDashboardQuietActive(user);
const growthTipsDismissed = getDashboardGrowthTipsDismissed(user);
const forceSimpleNote = shouldForceSimpleOverview(householdRole);
const planLabel =
  entitlements.tier === "admin"
    ? "Admin"
    : entitlements.tier.charAt(0).toUpperCase() + entitlements.tier.slice(1);
---
<DashboardLayout
  title={t.title}
  subtitle={t.subtitle}
>
  <div class="space-y-6">
    {(passwordUpdated || signOutAllFailed || prefsSaved || prefsError || pinnedSaved || pinnedError || quietSaved || quietCleared || tipsHidden || tipsReset) && (
      <div class="dashboard-flash">
      {passwordUpdated && (
        <p class="alert-success mt-0 mb-0" role="status">{t.notices.passwordUpdated}</p>
      )}
      {signOutAllFailed && (
        <p class="alert-warning mt-0 mb-0" role="alert">
          {t.notices.signOutAllFailed}
        </p>
      )}
      {prefsSaved && (
        <p class="alert-success mt-0 mb-0" role="status">{t.notices.prefsSaved}</p>
      )}
      {prefsError && (
        <p class="alert-warning mt-0 mb-0" role="alert">{t.notices.prefsError}</p>
      )}
      {pinnedSaved && (
        <p class="alert-success mt-0 mb-0" role="status">{t.notices.pinnedSaved}</p>
      )}
      {pinnedError && (
        <p class="alert-warning mt-0 mb-0" role="alert">{t.notices.pinnedError}</p>
      )}
      {(quietSaved || quietCleared) && (
        <p class="alert-success mt-0 mb-0" role="status">
          {quietCleared ? t.notices.quietCleared : t.notices.quietSaved}
        </p>
      )}
      {(tipsHidden || tipsReset) && (
        <p class="alert-success mt-0 mb-0" role="status">
          {tipsReset ? t.notices.tipsReset : t.notices.tipsHidden}
        </p>
      )}
      </div>
    )}

    <DisplayPreferences preferences={preferences} redirectTo="/dashboard/settings" />

    <section class="card card-compact" id="language" aria-labelledby="language-heading">
      <form method="POST" action="/api/locale" data-locale-form>
        <input type="hidden" name="redirect" value="/dashboard/settings" />
        <h2 class="card-title" id="language-heading">{t.language.heading}</h2>
        <p class="card-subtitle mb-3">{t.language.subtitle}</p>
        <div class="flex flex-wrap items-end gap-3">
          <div class="form-field mb-0">
            <label class="form-label" for="settings-locale">{t.language.label}</label>
            <select class="form-input" id="settings-locale" name="locale">
              {LOCALES.map((l) => (
                <option value={l} lang={LOCALE_META[l].htmlLang} selected={l === locale}>
                  {LOCALE_META[l].label}
                </option>
              ))}
            </select>
          </div>
          <button type="submit" class="btn-secondary">{t.language.submit}</button>
        </div>
      </form>
    </section>

    <div id="dashboard-comfort">
      <DashboardComfortCard
        quietUntil={quietUntil}
        quietActive={quietActive}
        growthTipsDismissed={growthTipsDismissed}
        forceSimpleNote={forceSimpleNote}
        onboardingDismissed={onboardingDismissed}
      />
    </div>

    <NotificationsLinksCard />

    <DataExportCard
      dataRetentionDays={alertSettings.dataRetentionDays}
      historyDays={entitlements.historyDays}
      tierLabel={planLabel}
      canCustomizeRetention={entitlements.historyDays >= 90}
      retentionSaved={Boolean(retentionSaved)}
    />

    <PwaInstallCard />

    {/* Open when it has a result to show (its own flash or error), so it isn't hidden in a closed section. */}
    <details
      class="card"
      id="account-security"
      open={signOutAllFailed || Boolean(deleteError) || Boolean(tenantSaved) || Boolean(tenantError)}
    >
      <summary class="card-title cursor-pointer">{t.accountSecurity.summary}</summary>
      <p class="card-subtitle mb-4">
        {t.accountSecurity.subtitle}
      </p>

      <div class="space-y-6">
        <AccountSecurity />

        <AccountLifecycle
          userEmail={user.email ?? t.accountSecurity.yourAccount}
          hasPasswordAuth={hasPassword}
          deleteError={deleteError}
        />

        {tenantSaved && (
          <p class="alert-success" role="status">{t.notices.tenantSaved}</p>
        )}
        {tenantError && (
          <p class="alert-warning" role="alert">
            {tenantError === "1" ? t.notices.tenantError : decodeURIComponent(tenantError)}
          </p>
        )}

        {household.householdId && (
          <TenantRelayCard
            canEdit={canEdit}
            settings={tenantNotify}
            householdId={household.householdId}
          />
        )}
      </div>
    </details>
  </div>
</DashboardLayout>

<script>
  const localeForm = document.querySelector("[data-locale-form]") as HTMLFormElement | null;
  const localeSelect = localeForm?.querySelector("select[name=locale]") as HTMLSelectElement | null;
  localeSelect?.addEventListener("change", () => localeForm?.requestSubmit());
</script>
