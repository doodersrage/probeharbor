---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminNav from "../../components/dashboard/AdminNav.astro";
import { fetchCheckoutAnalyticsAdmin } from "../../lib/checkoutAnalytics";
import { fetchAppStatus } from "../../lib/appStatus";
import { fetchReferralAdminStats } from "../../lib/referrals";
import { listRecentServerErrors } from "../../lib/serverErrors";
import { auditStripeDisplayPrices } from "../../lib/stripePriceAudit";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";
import { isTwilioConfigured } from "../../lib/notify";
import { isVapidConfigured, countPushSubscriptions } from "../../lib/webPush";
import { getFcmConfigStatus } from "../../lib/fcm";
import { channelTestErrorMessage } from "../../lib/alertChannelLabels";
import { fmt, formatNumber, getLocale, LOCALE_META, plural } from "../../i18n";
import { adminMessages } from "../../i18n/messages/app/admin";

const locale = getLocale(Astro);
const a = adminMessages(locale);
const t = a.ops;
const intl = LOCALE_META[locale].intl;

const { session, user } = await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

// Gate before admin-only fetches — otherwise non-admins can hit a blank 200.
if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const emailTestOk = Astro.url.searchParams.get("email_test") === "1";
const channelTestOk = Astro.url.searchParams.get("channel_test") === "1";
const channelKind = Astro.url.searchParams.get("channel_kind");
const channelErrorCode = Astro.url.searchParams.get("channel_error");
const channelError = channelErrorCode
  ? (t.channelErrors[channelErrorCode] ?? channelTestErrorMessage(channelErrorCode, locale))
  : null;
const twilioConfigured = isTwilioConfigured();
const vapidConfigured = isVapidConfigured();
const fcmStatus = getFcmConfigStatus();
const pushSubscriptionCount = await countPushSubscriptions(user.id);

const [checkout, status, referrals, serverErrors, priceAudit] = await Promise.all([
  fetchCheckoutAnalyticsAdmin(30, 30),
  fetchAppStatus(),
  fetchReferralAdminStats(),
  listRecentServerErrors(15),
  auditStripeDisplayPrices(),
]);

function sourceLabel(source: string): string {
  if (source === "direct") return t.funnel.directPricing;
  if (source.startsWith("nudge_")) return source.replace("nudge_", "").replace(/_/g, " ");
  return source;
}

function formatUsd(amount: number | null): string {
  if (amount == null) return a.common.dash;
  return formatNumber(amount, locale, { style: "currency", currency: "USD" });
}

const priceMismatches = priceAudit.rows.filter((row) => row.match === false);
const opsDiscordConfigured = Boolean(
  import.meta.env.OPS_DISCORD_WEBHOOK_URL?.trim() ||
    import.meta.env.DISCORD_OPS_WEBHOOK_URL?.trim(),
);
---
<DashboardLayout title={t.title} subtitle={t.subtitle} requireAdmin>
  <div class="space-y-6">
    <AdminNav />
    <section class="card animate-slide-in-left">
      <h2 class="card-title">{t.heading}</h2>
      <p class="card-subtitle mb-0">{fmt(t.intro, { email: user.email ?? "" })}</p>
      {emailTestOk && (
        <p class="alert-success mt-4 mb-0" role="status">{fmt(t.emailTestSent, { email: user.email ?? "" })}</p>
      )}
      {channelTestOk && (
        <p class="alert-success mt-4 mb-0" role="status">
          {channelKind === "push"
            ? t.pushTestOk
            : channelKind === "sms"
              ? t.smsTestOk
              : t.channelTestOk}
        </p>
      )}
      {channelError && (
        <p class="alert-warning mt-4 mb-0" role="alert">
          {fmt(t.channelTestFailed, { error: channelError })}
          {channelErrorCode === "push_no_subscription" && (
            <>
              {" "}
              <Fragment set:html={t.pushNoSubscriptionHtml} />
            </>
          )}
        </p>
      )}
      {priceMismatches.length > 0 && (
        <p class="alert-warning mt-4 mb-0" role="alert">
          {fmt(t.priceMismatch, { count: formatNumber(priceMismatches.length, locale) })}
        </p>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">{t.checklist.title}</h2>
      <ol class="text-sm space-y-2 mb-0 list-decimal pl-5">
        <li set:html={t.checklist.scanHtml} />
        <li>{t.checklist.stripeAudit}</li>
        <li>{t.checklist.funnel}</li>
        <li>{t.checklist.drip}</li>
        <li>
          {t.checklist.verifySecrets}
          {twilioConfigured ? (
            <>{t.checklist.twilioConfigured}</>
          ) : (
            <>
              {" · "}
              <a class="text-link" href="https://console.twilio.com/" target="_blank" rel="noreferrer">
                {t.checklist.twilioAdd}
              </a>
              {t.checklist.thenWord}
              <code>pnpm secrets:push</code>
            </>
          )}
          {vapidConfigured ? t.checklist.vapidConfigured : t.checklist.vapidMissing}.
        </li>
        <li>
          {t.checklist.afterDeploy}<code>pnpm ops:smoke</code>{t.checklist.andSubmit}
          <a class="text-link" href="https://search.google.com/search-console" target="_blank" rel="noreferrer">
            {t.checklist.sitemap}
          </a>
          .
        </li>
        <li>
          {t.checklist.opsNotify}
          {opsDiscordConfigured ? t.checklist.discordConfigured : t.checklist.discordMissing}.
        </li>
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">{t.health.title}</h2>
      <div class="stat-grid mb-4">
        <article class="stat-item">
          <span class="stat-label">{t.health.status}</span>
          <p class:list={["stat-value text-base", status.healthy ? "text-[var(--color-success)]" : "text-[var(--color-danger)]"]}>
            {status.healthy ? t.health.healthy : t.health.degraded}
          </p>
        </article>
        <article class="stat-item">
          <span class="stat-label">{t.health.jobErrors}</span>
          <p class="stat-value">{status.recentJobErrors}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">{t.health.abuseFlags}</span>
          <p class="stat-value">{status.ingestAbuseCount}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">{t.health.pageErrors}</span>
          <p class="stat-value">{serverErrors.length}</p>
        </article>
      </div>
      <p class="mb-0 text-sm">
        <a class="text-link" href="/system-status">{t.health.statusPage}</a>
        {" · "}
        <a class="text-link" href="/dashboard/jobs">{t.health.jobHistory}</a>
      </p>
    </section>

    {serverErrors.length > 0 && (
      <section class="card">
        <h2 class="card-title">{t.errors.title}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">{a.common.when}</th>
                <th class="py-2 pr-3">{t.errors.path}</th>
                <th class="py-2">{t.errors.message}</th>
              </tr>
            </thead>
            <tbody>
              {serverErrors.map((row) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-2 pr-3 whitespace-nowrap">{new Date(row.created_at).toLocaleString(intl)}</td>
                  <td class="py-2 pr-3 font-mono text-xs">{row.method} {row.path}</td>
                  <td class="py-2" title={row.stack ?? undefined}>{row.message}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">{t.priceAudit.title}</h2>
      <p class="card-subtitle mb-4">{t.priceAudit.subtitle}</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-[var(--color-text-muted)]">
              <th class="py-2 pr-3">{a.common.plan}</th>
              <th class="py-2 pr-3">{a.common.interval}</th>
              <th class="py-2 pr-3">{t.priceAudit.displayEnv}</th>
              <th class="py-2 pr-3">{t.priceAudit.stripeApi}</th>
              <th class="py-2">{t.priceAudit.match}</th>
            </tr>
          </thead>
          <tbody>
            {priceAudit.rows.map((row) => (
              <tr class="border-t border-[var(--color-border)]">
                <td class="py-2 pr-3 capitalize">{row.plan}</td>
                <td class="py-2 pr-3">{row.interval}</td>
                <td class="py-2 pr-3">{formatUsd(row.displayAmountUsd)}</td>
                <td class="py-2 pr-3">{formatUsd(row.stripeAmountUsd)}</td>
                <td class="py-2">
                  {row.match == null ? a.common.dash : row.match ? "✓" : t.priceAudit.mismatch}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">{t.referrals.title}</h2>
      <div class="stat-grid mb-0">
        <article class="stat-item">
          <span class="stat-label">{a.common.totalSignups}</span>
          <p class="stat-value">{referrals.totalSignups}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">{t.referrals.rewards}</span>
          <p class="stat-value">{referrals.rewardedSignups}</p>
        </article>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">{t.emailTests.title}</h2>
      <p class="card-subtitle mb-4">{fmt(t.emailTests.subtitle, { email: user.email ?? "" })}</p>
      <div class="flex flex-wrap gap-2">
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="drip_day1" />
          <button class="btn-secondary" type="submit">{t.emailTests.drip1}</button>
        </form>
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="drip_day3" />
          <button class="btn-secondary" type="submit">{t.emailTests.drip3}</button>
        </form>
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="trial_3d" />
          <button class="btn-secondary" type="submit">{t.emailTests.trial}</button>
        </form>
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="weekly_digest" />
          <button class="btn-secondary" type="submit">{t.emailTests.digest}</button>
        </form>
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="monthly_report" />
          <button class="btn-secondary" type="submit">{t.emailTests.monthly}</button>
        </form>
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="freeze_drill" />
          <button class="btn-secondary" type="submit">{t.emailTests.freezeDrill}</button>
        </form>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">{t.channelTests.title}</h2>
      <p class="card-subtitle mb-4">
        {t.channelTests.intro}
        <strong>{twilioConfigured ? t.channelTests.configured : t.channelTests.notConfigured}</strong>
        {" · "}
        {t.channelTests.vapid}
        <strong>{vapidConfigured ? t.channelTests.configured : t.channelTests.notConfigured}</strong>
        {" · "}
        {t.channelTests.fcm}
        <strong>
          {fcmStatus === "configured"
            ? t.channelTests.configured
            : fcmStatus === "invalid"
              ? t.channelTests.invalidJson
              : t.channelTests.notConfigured}
        </strong>
        {fcmStatus === "invalid" && (
          <>
            {" "}
            <Fragment set:html={t.channelTests.fcmInvalidHtml} />
          </>
        )}
        .
      </p>
      <div class="flex flex-wrap gap-4 items-end">
        <form action="/api/admin/channel-test" method="post" class="flex flex-wrap gap-2 items-end">
          <input type="hidden" name="kind" value="sms" />
          <div class="form-field mb-0">
            <label class="form-label" for="channel-test-phone">{t.channelTests.smsPhone}</label>
            <input
              class="form-input"
              id="channel-test-phone"
              name="phone"
              type="tel"
              placeholder="+15551234567"
              disabled={!twilioConfigured}
            />
          </div>
          <button class="btn-secondary" type="submit" disabled={!twilioConfigured}>
            {t.channelTests.testSms}
          </button>
        </form>
        <form action="/api/admin/channel-test" method="post">
          <input type="hidden" name="kind" value="push" />
          <button class="btn-secondary" type="submit" disabled={!vapidConfigured}>
            {t.channelTests.testPush}
          </button>
        </form>
      </div>
      <p class="form-hint mt-3 mb-0">
        {t.channelTests.hintStart}
        {pushSubscriptionCount > 0
          ? plural(t.channelTests.subscriptions, pushSubscriptionCount, locale)
          : t.channelTests.notSubscribed}
        {" "}
        {t.channelTests.enableUnder}{" "}
        <a class="text-link" href="/dashboard/alerts?tab=settings#alert-section-channels">{t.channelTests.alertsPush}</a>
        {" "}
        {t.channelTests.hintEnd}
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.funnel.title}</h2>
      <p class="card-subtitle mb-4">{t.funnel.subtitle}</p>
      <div class="stat-grid mb-4">
        <article class="stat-item">
          <span class="stat-label">{t.funnel.started}</span>
          <p class="stat-value">{checkout.last30Days}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">{t.funnel.allTime}</span>
          <p class="stat-value">{checkout.totalCheckouts}</p>
        </article>
      </div>

      <div class="grid gap-6 lg:grid-cols-2 mb-4">
        <div>
          <h3 class="text-sm font-semibold mb-2">{t.funnel.bySource}</h3>
          {checkout.bySource.length === 0 ? (
            <p class="text-sm text-[var(--color-text-muted)] mb-0">{t.funnel.empty}</p>
          ) : (
            <ul class="text-sm space-y-1 mb-0">
              {checkout.bySource.map((row) => (
                <li class="flex justify-between gap-2">
                  <span>{sourceLabel(row.source)}</span>
                  <strong>{row.count}</strong>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div>
          <h3 class="text-sm font-semibold mb-2">{t.funnel.byPlan}</h3>
          {checkout.byPlan.length === 0 ? (
            <p class="text-sm text-[var(--color-text-muted)] mb-0">{t.funnel.empty}</p>
          ) : (
            <ul class="text-sm space-y-1 mb-0">
              {checkout.byPlan.map((row) => (
                <li class="flex justify-between gap-2">
                  <span class="capitalize">{row.plan}</span>
                  <strong>{row.count}</strong>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      {checkout.recent.length > 0 && (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">{a.common.when}</th>
                <th class="py-2 pr-3">{a.common.plan}</th>
                <th class="py-2 pr-3">{a.common.interval}</th>
                <th class="py-2">{a.common.source}</th>
              </tr>
            </thead>
            <tbody>
              {checkout.recent.map((row) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-2 pr-3 whitespace-nowrap">{new Date(row.createdAt).toLocaleString(intl)}</td>
                  <td class="py-2 pr-3 capitalize">{row.plan}</td>
                  <td class="py-2 pr-3">{row.interval}</td>
                  <td class="py-2">{row.source ? sourceLabel(row.source) : t.funnel.direct}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
