---
import { getDisplayPreferencesFromMetadata } from "../../lib/userPreferences";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import GarageTempHistory from "../../components/GarageTempHistory.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import HistorySubscription from "../../components/HistorySubscription.astro";
import ProductAnalyticsTracker from "../../components/ProductAnalyticsTracker.astro";
import DashboardTabNav from "../../components/dashboard/DashboardTabNav.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { canDownloadHistoryCsv } from "../../lib/adminAccess";
import {
  fetchGarageTempChartData,
  fetchGarageTempHistory,
  fetchHistoryFilterOptions,
  GARAGE_TEMPS_PAGE_SIZE,
  type PaginatedGarageTemps,
} from "../../lib/garageTempsHistory";
import { fetchPriorYearCompareBundle } from "../../lib/priorYearCompare";
import { detectTemperatureAnomalies } from "../../lib/anomalyDetection";
import { getUserSubscription } from "../../lib/stripeSubscriptions";
import {
  compareProbeAverages,
  compareSpaceAverages,
  compareYearOverYear,
  summarizeSeasonal,
} from "../../lib/seasonalInsights";
import { listHouseholdDevices } from "../../lib/devices";
import { fetchIndoorOutdoorDelta, buildIndoorOutdoorSeries } from "../../lib/indoorOutdoorDelta";
import { getIndoorReferenceSensorId, findReferenceSensorLabel } from "../../lib/indoorReference";
import { fetchHouseChartOverlay } from "../../lib/houseContext";
import { listConnectionsForHousehold } from "../../lib/thermostatConnections";
import { computeDailyFreezeHours, computeFreezeHours } from "../../lib/freezeHours";
import { buildColdSnapReplay } from "../../lib/coldSnapReplay";
import ColdSnapReplayCard from "../../components/dashboard/ColdSnapReplayCard.astro";
import FreezeHoursChart from "../../components/FreezeHoursChart";
import ProbeSpreadChart from "../../components/ProbeSpreadChart";
import { buildProbeSpreadSeries } from "../../lib/probeSpread";

import { buildColdestDayOverlay, shiftSeriesOntoCurrentWindow } from "../../lib/historyOverlay";
import IndoorOutdoorChart from "../../components/IndoorOutdoorChart.tsx";
import { clampIsoToHistoryWindow, historyCutoffIso } from "../../lib/retentionSchedule";
import { formatHistoryRetention, getUserEntitlements } from "../../lib/entitlements";
import { getAlertSettingsForUser } from "../../lib/notify";
import { listAlertEventsInRange } from "../../lib/alertEvents";
import { toChartAlertMarkers } from "../../lib/chartAlertMarkers";
import { listHistorySavedViews, searchParamsFromView } from "../../lib/historySavedViews";
import { fmt, formatDateTime, formatNumber, getLocale, LOCALE_META, plural } from "../../i18n";
import { appHistoryMessages } from "../../i18n/messages/app/history";
import { appHistoryChartsMessages } from "../../i18n/messages/app/history/charts";

const locale = getLocale(Astro);
const t = appHistoryMessages(locale);
const chartText = appHistoryChartsMessages(locale);
/** Intl tag for chart islands; omitted for English so they format exactly as before. */
const chartLocale = locale === "en" ? undefined : LOCALE_META[locale].intl;
/** `toFixed` in English; the locale's decimal separator otherwise. */
function num(value: number, digits: number): string {
  if (locale === "en") return value.toFixed(digits);
  return formatNumber(value, locale, { minimumFractionDigits: digits, maximumFractionDigits: digits, useGrouping: false });
}
/** A number as written before (no rounding) in English; locale separators otherwise. */
function plain(value: number): string {
  return locale === "en" ? String(value) : formatNumber(value, locale, { maximumFractionDigits: 2, useGrouping: false });
}

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

// Charts follow the °C display preference; readings stay in °F underneath.
const useCelsius = getDisplayPreferencesFromMetadata(user).useCelsius;

const defaultHistoryViewId =
  typeof user.user_metadata?.default_history_view_id === "string"
    ? user.user_metadata.default_history_view_id
    : null;

if (!Astro.url.search && defaultHistoryViewId) {
  const defaultViews = await listHistorySavedViews(user.id);
  const defaultView = defaultViews.find((view) => view.id === defaultHistoryViewId);
  if (defaultView) {
    const qs = searchParamsFromView(defaultView.params);
    if (qs) {
      return Astro.redirect(`/dashboard/history?${qs}`);
    }
  }
}

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const feedFilter = Astro.url.searchParams.get("feed")?.trim() ?? "";
const probeFilter = Astro.url.searchParams.get("probe")?.trim() ?? "";
const fromDateParam = Astro.url.searchParams.get("from")?.trim() ?? "";
const toDate = Astro.url.searchParams.get("to")?.trim() ?? "";
const daysParam = Number(Astro.url.searchParams.get("days") ?? "7");

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect("/dashboard/history?page=1");
}

const entitlements = shell?.entitlements ?? (await getUserEntitlements(user.id));
const historyDays = entitlements.historyDays;
const cutoffDate = historyCutoffIso(historyDays).slice(0, 10);
const fromDate =
  fromDateParam && fromDateParam < cutoffDate ? cutoffDate : fromDateParam;
const requestedDays = daysParam === 90 ? 90 : daysParam === 30 ? 30 : 7;
const chartDays = Math.min(requestedDays, historyDays);
const overlayColdest =
  Astro.url.searchParams.get("overlay") === "coldest" && historyDays >= 365;
const comparePreset = Astro.url.searchParams.get("compare_preset")?.trim() ?? "";
let compareFromParam = Astro.url.searchParams.get("compare_from")?.trim() ?? "";
let compareToParam = Astro.url.searchParams.get("compare_to")?.trim() ?? "";

function isoDay(d: Date): string {
  return d.toISOString().slice(0, 10);
}

if (comparePreset === "prior_week" || comparePreset === "prior_month") {
  const end = toDate
    ? new Date(`${toDate}T12:00:00.000Z`)
    : new Date();
  const spanDays =
    fromDate && toDate
      ? Math.max(
          1,
          Math.ceil(
            (Date.parse(`${toDate}T23:59:59`) - Date.parse(`${fromDate}T00:00:00`)) /
              (24 * 60 * 60 * 1000),
          ),
        )
      : chartDays;
  const shift = comparePreset === "prior_month" ? 30 : spanDays;
  const compareEnd = new Date(end.getTime() - shift * 24 * 60 * 60 * 1000);
  const compareStart = new Date(
    compareEnd.getTime() - (spanDays - 1) * 24 * 60 * 60 * 1000,
  );
  compareFromParam = isoDay(compareStart);
  compareToParam = isoDay(compareEnd);
}

const hasCustomCompare = Boolean(compareFromParam && compareToParam);
const compareYoy =
  !overlayColdest &&
  !hasCustomCompare &&
  Astro.url.searchParams.get("yoy") === "1" &&
  historyDays >= 365;
const needPriorYear = compareYoy || overlayColdest;

const filters = {
  feedName: feedFilter || undefined,
  probeKey: probeFilter || undefined,
  from: fromDate
    ? clampIsoToHistoryWindow(
        new Date(`${fromDate}T00:00:00`).toISOString(),
        historyDays,
      )
    : historyCutoffIso(historyDays),
  to: toDate ? new Date(`${toDate}T23:59:59`).toISOString() : undefined,
};

const chartFilters = {
  feedName: feedFilter || undefined,
  probeKey: probeFilter || undefined,
  from: fromDate
    ? clampIsoToHistoryWindow(
        new Date(`${fromDate}T00:00:00`).toISOString(),
        historyDays,
      )
    : undefined,
  to: toDate ? new Date(`${toDate}T23:59:59`).toISOString() : undefined,
};

const historyTabRaw = Astro.url.searchParams.get("tab")?.trim() ?? "chart";
const historyTab =
  historyTabRaw === "table" || historyTabRaw === "exports" ? historyTabRaw : "chart";
const loadTable = historyTab === "table";
const loadChart = historyTab === "chart" || historyTab === "exports";
const loadChartExtras = historyTab === "chart";
const loadExportsSummary = historyTab === "exports";
const loadFiltersUi = historyTab === "chart" || historyTab === "table";
const householdId = shell?.activeHouseholdId ?? null;

const emptyHistory: PaginatedGarageTemps = {
  readings: [],
  page: pageParam,
  pageSize: GARAGE_TEMPS_PAGE_SIZE,
  totalCount: 0,
  totalPages: 0,
  error: null,
};

const chartWindowDays =
  fromDate && toDate
    ? Math.min(
        historyDays,
        Math.max(
          1,
          Math.ceil(
            (Date.parse(`${toDate}T23:59:59`) - Date.parse(`${fromDate}T00:00:00`)) /
              (24 * 60 * 60 * 1000),
          ),
        ),
      )
    : chartDays;

const [
  history,
  chartData,
  filterOptions,
  canDownloadCsv,
  alertSettings,
  savedViews,
] = await Promise.all([
  loadTable ? fetchGarageTempHistory(user.id, pageParam, undefined, filters) : Promise.resolve(emptyHistory),
  loadChart
    ? fetchGarageTempChartData(user.id, chartWindowDays, chartFilters)
    : Promise.resolve({
        points: [] as Awaited<ReturnType<typeof fetchGarageTempChartData>>["points"],
        error: null as string | null,
      }),
  loadFiltersUi
    ? fetchHistoryFilterOptions(user.id)
    : Promise.resolve({ feeds: [] as string[], probes: [] as { key: string; label: string }[], error: null }),
  canDownloadHistoryCsv(user.id),
  getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
  loadFiltersUi ? listHistorySavedViews(user.id) : Promise.resolve([] as Awaited<ReturnType<typeof listHistorySavedViews>>),
]);

const historyEmpty =
  !feedFilter &&
  !probeFilter &&
  !fromDate &&
  !toDate &&
  (loadTable
    ? !history.error && history.totalCount === 0
    : !chartData.error && chartData.points.length === 0);

const loadPriorYear = loadChartExtras && !historyEmpty && needPriorYear;
const loadCustomCompare = loadChartExtras && !historyEmpty && hasCustomCompare;
const chartMarkerTimes = chartData.points
  .map((p) => Date.parse(p.timestamp))
  .filter((ts) => Number.isFinite(ts));

const [
  priorYearBundle,
  comparePeriodData,
  subscription,
  alertEvents,
  outdoorDelta,
  householdDevicesResult,
  indoorReferenceSensorId,
  thermostatConnections,
] = await Promise.all([
  loadPriorYear
    ? fetchPriorYearCompareBundle(
        user.id,
        overlayColdest ? Math.max(chartWindowDays, 30) : chartWindowDays,
        chartFilters,
        user,
      )
    : Promise.resolve({
        points: [],
        source: "none" as const,
        outdoorLocationLabel: null,
        earliestLocalReadingAt: null,
      }),
  loadCustomCompare
    ? fetchGarageTempChartData(user.id, historyDays, {
        feedName: feedFilter || undefined,
        probeKey: probeFilter || undefined,
        from: clampIsoToHistoryWindow(
          new Date(`${compareFromParam}T00:00:00`).toISOString(),
          historyDays,
        ),
        to: new Date(`${compareToParam}T23:59:59`).toISOString(),
      })
    : Promise.resolve({ points: [], error: null }),
  loadExportsSummary ? getUserSubscription(user.id) : Promise.resolve(null),
  loadChart && chartMarkerTimes.length > 0
    ? listAlertEventsInRange(
        user.id,
        new Date(Math.min(...chartMarkerTimes)).toISOString(),
        new Date(Math.max(...chartMarkerTimes)).toISOString(),
        200,
      )
    : Promise.resolve([] as Awaited<ReturnType<typeof listAlertEventsInRange>>),
  loadChartExtras && !historyEmpty
    ? fetchIndoorOutdoorDelta(chartData.points, null, user)
    : Promise.resolve(null),
  (loadChartExtras || loadExportsSummary) && !historyEmpty && householdId
    ? listHouseholdDevices(householdId)
    : Promise.resolve({ devices: [] as Awaited<ReturnType<typeof listHouseholdDevices>>["devices"] }),
  loadChartExtras && !historyEmpty && householdId
    ? getIndoorReferenceSensorId(householdId)
    : Promise.resolve(null),
  loadChartExtras && !historyEmpty && householdId && entitlements.canUseThermostatIntegration
    ? listConnectionsForHousehold(householdId)
    : Promise.resolve([] as Awaited<ReturnType<typeof listConnectionsForHousehold>>),
]);

const priorYearData = { points: priorYearBundle.points, error: null };

const chartAlertMarkers = toChartAlertMarkers(alertEvents);

const indoorOutdoorSeries = outdoorDelta
  ? buildIndoorOutdoorSeries(chartData.points, outdoorDelta.outdoorF)
  : [];
const freezeHours = computeFreezeHours(chartData.points, alertSettings.freezeThresholdF);
const coldSnapReplay =
  historyTab === "chart" ? buildColdSnapReplay(chartData.points, alertSettings.freezeThresholdF, alertEvents, locale) : null;
const dailyFreezeHours = computeDailyFreezeHours(
  chartData.points,
  alertSettings.freezeThresholdF,
);
const probeSpreadSeries = buildProbeSpreadSeries(chartData.points);
const showHistoryCompare =
  Boolean(outdoorDelta) ||
  probeSpreadSeries.length >= 2 ||
  chartData.points.length >= 2;

const coldestOverlay = overlayColdest
  ? buildColdestDayOverlay(priorYearData.points, chartData.points)
  : { overlay: [], coldestDay: null as string | null, minTempF: null as number | null };

const overlayPoints = overlayColdest
  ? coldestOverlay.overlay
  : hasCustomCompare
    ? shiftSeriesOntoCurrentWindow(comparePeriodData.points, chartData.points)
    : compareYoy
      ? shiftSeriesOntoCurrentWindow(priorYearData.points, chartData.points)
      : [];

const overlayLegend = overlayColdest
  ? coldestOverlay.coldestDay
    ? priorYearBundle.source === "outdoor_estimate"
      ? fmt(t.overlay.coldestOutdoorEstimated, { day: coldestOverlay.coldestDay })
      : coldestOverlay.minTempF != null
        ? fmt(t.overlay.coldestDayLow, { day: coldestOverlay.coldestDay, temp: num(coldestOverlay.minTempF, 1) })
        : fmt(t.overlay.coldestDay, { day: coldestOverlay.coldestDay })
    : priorYearBundle.earliestLocalReadingAt
      ? fmt(t.overlay.noPriorProbeData, {
          date:
            locale === "en"
              ? new Date(priorYearBundle.earliestLocalReadingAt).toLocaleDateString()
              : formatDateTime(priorYearBundle.earliestLocalReadingAt, locale, { dateStyle: "medium" }),
        })
      : t.overlay.coldestNoData
  : hasCustomCompare
    ? fmt(t.overlay.compareWindow, { from: compareFromParam, to: compareToParam })
    : compareYoy
      ? priorYearBundle.source === "outdoor_estimate"
        ? priorYearBundle.outdoorLocationLabel
          ? fmt(t.overlay.outdoorEstimateAt, { location: priorYearBundle.outdoorLocationLabel })
          : t.overlay.outdoorEstimate
        : t.overlay.sameWindow
      : null;

if (loadTable && history.totalPages > 0 && pageParam > history.totalPages) {
  return Astro.redirect(`/dashboard/history?page=${history.totalPages}`);
}

const subscriptionNotice = Astro.url.searchParams.get("subscription");
const anomalies = detectTemperatureAnomalies(chartData.points, undefined, undefined, undefined, locale);
const probeCompare = compareProbeAverages(chartData.points, locale);

const houseChartOverlay =
  loadChartExtras && !historyEmpty && householdId
    ? await fetchHouseChartOverlay({
        householdId,
        days: chartWindowDays,
        hasThermostatConnection: thermostatConnections.length > 0,
        referenceSensorId: indoorReferenceSensorId,
        filters: { from: chartFilters.from, to: chartFilters.to },
      }, locale)
    : { points: [], source: null as "thermostat" | "reference" | null };
const houseChartLegend =
  houseChartOverlay.source === "thermostat"
    ? t.overlay.houseThermostat
    : houseChartOverlay.source === "reference"
      ? fmt(t.overlay.houseReference, {
          label:
            findReferenceSensorLabel(householdDevicesResult.devices, indoorReferenceSensorId) ??
            t.overlay.houseReferenceFallback,
        })
      : null;
const probeToSpace = new Map<string, string>();
for (const device of householdDevicesResult.devices) {
  if (!device.space) continue;
  for (const sensor of device.sensors) {
    if (sensor.kind === "temperature") {
      probeToSpace.set(sensor.label, device.space);
    }
  }
}
const spaceCompare = compareSpaceAverages(chartData.points, probeToSpace, locale);

const insights = loadExportsSummary
  ? (() => {
      const rows = summarizeSeasonal(chartData.points, Math.min(30, historyDays), locale);
      const yoy = compareYearOverYear(chartData.points, priorYearBundle.points, locale);
      if (yoy) rows.push(yoy);
      return rows;
    })()
  : [];

const claimsFrom = fromDate || cutoffDate;
const claimsTo = toDate || new Date().toISOString().slice(0, 10);
const claimsPackQs = new URLSearchParams({
  from: claimsFrom,
  to: claimsTo,
}).toString();
const claimsPackHref = `/api/claims/pack?${claimsPackQs}`;

const claimsEmailed = Astro.url.searchParams.get("claims_emailed") === "1";
const alertParam = Number(Astro.url.searchParams.get("alert") ?? "");
const highlightAlertId =
  Number.isFinite(alertParam) && alertParam > 0 ? alertParam : null;
const claimsErrorCode = Astro.url.searchParams.get("claims_error");
const claimsErrors: Record<string, string> = t.exports.claimsErrors;
const claimsErrorMessage =
  claimsErrorCode && Object.hasOwn(claimsErrors, claimsErrorCode) ? claimsErrors[claimsErrorCode]! : null;

function historyTabHref(tab: string): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("tab", tab);
  if (tab !== "table") params.delete("page");
  return `/dashboard/history?${params.toString()}`;
}

const historyTabs = [
  { id: "chart", label: t.page.tabs.chart, href: historyTabHref("chart") },
  { id: "table", label: t.page.tabs.table, href: historyTabHref("table") },
  { id: "exports", label: t.page.tabs.exports, href: historyTabHref("exports") },
];

const historyUpgradeFeature =
  entitlements.historyDays < 90
    ? ("data_retention" as const)
    : !canDownloadCsv
      ? ("csv_export" as const)
      : !entitlements.canUseClaimsPack && historyTab === "exports"
        ? ("claims_pack" as const)
        : null;

/** Same wording as `formatHistoryRetention` (lib/entitlements), in the page language. */
function historyRetentionText(days: number): string {
  if (days >= 365) {
    const years = days / 365;
    const count = Number.isInteger(years) ? plain(years) : num(years, 1);
    return plural(t.page.retentionYears, years, locale, { count });
  }
  return plural(t.page.retentionDays, days, locale, { count: plain(days) });
}
const freezeTemp = plain(alertSettings.freezeThresholdF);
---
<DashboardLayout title={t.page.title} subtitle={t.page.subtitle}>
  {historyEmpty && (
    <section class="card mb-6" aria-labelledby="history-empty-title">
      <h2 class="card-title" id="history-empty-title">{t.page.empty.title}</h2>
      <p class="card-subtitle mb-4">
        {t.page.empty.body}
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/dashboard/live">{t.page.empty.openLive}</a>
        <a class="btn-secondary" href="/dashboard/devices">{t.page.empty.openDevices}</a>
        <a class="btn-ghost" href="/dashboard">{t.page.empty.overview}</a>
      </div>
    </section>
  )}

  {subscriptionNotice === "success" && (
    <ProductAnalyticsTracker
      events={[
        {
          name: "purchase",
          props: {
            currency: "USD",
            value: 0,
            transaction_id: "stripe_checkout",
          },
        },
      ]}
    />
  )}
  <div class="space-y-6">
    <section class="card">
      <p class="card-subtitle mb-4">
        {canDownloadCsv ? t.page.introCsv : t.page.introNoCsv}
      </p>
      <DashboardTabNav tabs={historyTabs} activeId={historyTab} ariaLabel={t.page.tabsAria} />
      <p
        class="mt-3 mb-0 text-xs text-[var(--color-text-muted)]"
        title={t.page.retentionTitle}
      >
        {fmt(t.page.retention, {
          plan: entitlements.tier === "admin" ? t.page.adminPlan : entitlements.tier,
          retention: locale === "en" ? formatHistoryRetention(historyDays) : historyRetentionText(historyDays),
          plus: entitlements.tier === "pro" || entitlements.tier === "admin" ? "+" : "",
        })}
      </p>
    </section>

    {historyUpgradeFeature && (
      <UpgradeNudge feature={historyUpgradeFeature} tier={entitlements.tier} />
    )}


    {(historyTab === "chart" || historyTab === "table") && (
      <>
        <GarageTempHistory
          useCelsius={useCelsius}
          history={history}
          chartPoints={chartData.points}
          priorYearPoints={overlayPoints}
          compareYoy={compareYoy}
          overlayColdest={overlayColdest}
          overlayLegend={overlayLegend}
          basePath="/dashboard/history"
          tab={historyTab}
          canDownloadCsv={canDownloadCsv}
          feedFilter={feedFilter}
          probeFilter={probeFilter}
          fromDate={fromDate}
          toDate={toDate}
          compareFrom={compareFromParam}
          compareTo={compareToParam}
          days={chartDays}
          maxHistoryDays={historyDays}
          canCompareYoy={historyDays >= 365}
          anomalies={anomalies}
          filterOptions={filterOptions}
          freezeThresholdF={alertSettings.freezeThresholdF}
          housePoints={houseChartOverlay.points}
          houseLegend={houseChartLegend}
          viewMode={historyTab === "chart" ? "chart" : "table"}
          hideTitle
          savedViews={savedViews}
          defaultViewId={defaultHistoryViewId}
          canShareChart={canDownloadCsv}
          alertMarkers={chartAlertMarkers}
          highlightAlertId={highlightAlertId}
          canUseClaimsPack={entitlements.canUseClaimsPack}
        />

        {coldSnapReplay && (
          <ColdSnapReplayCard
            replay={coldSnapReplay}
            thresholdF={alertSettings.freezeThresholdF}
            timeZone={alertSettings.quietHoursTimezone}
          />
        )}

        {historyTab === "chart" && showHistoryCompare && (
          <details class="card">
            <summary class="dashboard-recommendations-summary">{t.compare.summary}</summary>
            <div class="dashboard-recommendations-body">
              {outdoorDelta && (
                <section class="history-compare-section" aria-labelledby="history-compare-outdoor">
                  <h3 class="card-title" id="history-compare-outdoor">{t.compare.outdoorTitle}</h3>
                  <p class="card-subtitle">
                    {outdoorDelta.cityName
                      ? fmt(t.compare.outdoorSubtitleCity, { city: outdoorDelta.cityName })
                      : t.compare.outdoorSubtitle}
                  </p>
                  <div class="stat-grid">
                    <article class="stat-item">
                      <span class="stat-label">{t.compare.indoorAvg}</span>
                      <p class="stat-value">{num(outdoorDelta.indoorAvgF, 1)}°F</p>
                    </article>
                    <article class="stat-item">
                      <span class="stat-label">{t.compare.outdoorNow}</span>
                      <p class="stat-value">{num(outdoorDelta.outdoorF, 1)}°F</p>
                      <p class="stat-detail">{outdoorDelta.outdoorDescription}</p>
                    </article>
                    <article class="stat-item">
                      <span class="stat-label">{t.compare.delta}</span>
                      <p class="stat-value">
                        {outdoorDelta.deltaF > 0 ? "+" : ""}
                        {num(outdoorDelta.deltaF, 1)}°F
                      </p>
                    </article>
                  </div>
                  {indoorOutdoorSeries.length >= 2 && (
                    <div class="mt-4">
                      <IndoorOutdoorChart
                        client:visible
                        points={indoorOutdoorSeries}
                        text={chartText.indoorOutdoor}
                        locale={chartLocale}
                      />
                    </div>
                  )}
                </section>
              )}

              {probeSpreadSeries.length >= 2 && (
                <section class="history-compare-section" aria-labelledby="history-compare-spread">
                  <h3 class="card-title" id="history-compare-spread">{t.compare.spreadTitle}</h3>
                  <p class="card-subtitle mb-4">
                    {t.compare.spreadSubtitle}
                  </p>
                  <ProbeSpreadChart
                    client:visible
                    points={probeSpreadSeries}
                    text={chartText.probeSpread}
                    locale={chartLocale}
                  />
                </section>
              )}

              {chartData.points.length >= 2 && (
                <section class="history-compare-section" aria-labelledby="history-compare-freeze">
                  <h3 class="card-title" id="history-compare-freeze">{t.compare.freezeTitle}</h3>
                  <p class="card-subtitle mb-4">
                    {fmt(t.compare.freezeSubtitle, { temp: freezeTemp })}
                  </p>
                  <div class="stat-grid">
                    <article class="stat-item">
                      <span class="stat-label">{fmt(t.compare.hoursAtOrBelow, { temp: freezeTemp })}</span>
                      <p class="stat-value">{num(freezeHours.hoursBelow34, 1)}</p>
                    </article>
                    <article class="stat-item">
                      <span class="stat-label">{fmt(t.compare.readingsAtOrBelow, { temp: freezeTemp })}</span>
                      <p class="stat-value">{plain(freezeHours.readingsBelow34)}</p>
                    </article>
                    <article class="stat-item">
                      <span class="stat-label">{t.compare.coldest}</span>
                      <p class="stat-value">
                        {freezeHours.coldestF != null ? `${num(freezeHours.coldestF, 1)}°F` : "—"}
                      </p>
                    </article>
                  </div>
                  {dailyFreezeHours.length >= 2 && (
                    <div class="mt-4">
                      <FreezeHoursChart
                        client:visible
                        days={dailyFreezeHours}
                        thresholdF={alertSettings.freezeThresholdF}
                        text={chartText.freezeHours}
                        locale={chartLocale}
                      />
                    </div>
                  )}
                </section>
              )}
            </div>
          </details>
        )}
      </>
    )}

    {historyTab === "exports" && (
      <>
        <section class="card" id="season-summary">
          <h2 class="card-title">{t.exports.summaryTitle}</h2>
          <p class="card-subtitle">
            {fmt(t.exports.summarySubtitle, { from: claimsFrom, to: claimsTo })}
          </p>
          {chartData.points.length < 2 ? (
            <p class="mb-0 text-sm text-[var(--color-text-muted)]">
              {t.exports.notEnough}
            </p>
          ) : (
            <>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-4">
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">{t.exports.coldest}</p>
                  <p class="m-0 text-lg font-semibold">
                    {freezeHours.coldestF != null ? `${num(freezeHours.coldestF, 1)}°F` : "—"}
                  </p>
                </div>
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">
                    {fmt(t.exports.hoursAtOrBelow, { temp: freezeTemp })}
                  </p>
                  <p class="m-0 text-lg font-semibold">
                    {fmt(t.exports.hoursValue, { hours: num(freezeHours.hoursBelow34, 1) })}
                  </p>
                </div>
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">{t.exports.readings}</p>
                  <p class="m-0 text-lg font-semibold">{plain(freezeHours.totalReadings)}</p>
                </div>
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">{t.exports.criticalTicks}</p>
                  <p class="m-0 text-lg font-semibold">{plain(chartAlertMarkers.length)}</p>
                </div>
              </div>
              <p class="mb-3 text-sm">
                <a
                  class="text-link"
                  href={`/dashboard/history?from=${claimsFrom}&to=${claimsTo}&tab=chart`}
                >
                  {t.exports.openOnChart}
                </a>
                {entitlements.canUseClaimsPack && (
                  <>
                    {" · "}
                    <a class="text-link" href={claimsPackHref}>{t.exports.downloadClaimsPdf}</a>
                  </>
                )}
              </p>
              {insights.length > 0 && (
                <ul class="space-y-2 mb-0 text-sm">
                  {insights.slice(0, 4).map((insight) => (
                    <li>
                      <strong>{insight.title}:</strong> {insight.detail}
                    </li>
                  ))}
                </ul>
              )}
            </>
          )}
        </section>

        <section class="card" id="claims-pack">
      <h2 class="card-title">{t.exports.claimsTitle}</h2>
      <p class="card-subtitle" set:html={t.exports.claimsIntroHtml} />
      {claimsEmailed && <p class="alert-success mt-0 mb-4">{t.exports.claimsEmailed}</p>}
      {claimsErrorMessage && (
        <p class="alert-warning mt-0 mb-4" role="alert">{claimsErrorMessage}</p>
      )}
      {entitlements.canUseClaimsPack ? (
        <>
          <p class="mb-3 text-sm text-[var(--color-text-muted)]">
            {fmt(t.exports.claimsUsesFilters, { from: claimsFrom, to: claimsTo })}
          </p>
          <a class="btn-primary" href={claimsPackHref}>{t.exports.downloadClaimsPdf}</a>
          <a class="btn-ghost text-sm ml-2" href={`${claimsPackHref}?format=html`}>{t.exports.htmlVersion}</a>

          <form action="/api/claims/email" method="post" class="mt-4 flex flex-wrap items-end gap-3">
            <input type="hidden" name="from" value={claimsFrom} />
            <input type="hidden" name="to" value={claimsTo} />
            <input type="hidden" name="redirect" value="/dashboard/history" />
            <div class="form-field mb-0">
              <label class="form-label" for="adjuster_email">{t.exports.adjusterEmail}</label>
              <input
                class="form-input"
                type="email"
                id="adjuster_email"
                name="adjuster_email"
                placeholder={t.exports.adjusterPlaceholder}
                required
              />
            </div>
            <button type="submit" class="btn-secondary">{t.exports.sendClaims}</button>
          </form>
        </>
      ) : (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          {t.exports.claimsUpgrade}
        </p>
      )}
    </section>

    <section class="card" id="monitoring-certificate">
      <h2 class="card-title">{t.exports.certificateTitle}</h2>
      <p class="card-subtitle mb-3">
        {t.exports.certificateSubtitle}
      </p>
      <a class="btn-secondary" href="/api/monitoring/certificate">{t.exports.certificateDownload}</a>
      <a class="btn-ghost text-sm ml-2" href="/api/monitoring/certificate?format=html">{t.exports.htmlVersion}</a>
    </section>

    {insights.length > 0 && (
      <section class="card">
        <h2 class="card-title">{plural(t.exports.seasonalTitle, Math.min(30, historyDays), locale)}</h2>
        <ul class="space-y-2 mb-0">
          {insights.map((insight) => (
            <li>
              <strong>{insight.title}:</strong> {insight.detail}
            </li>
          ))}
        </ul>
        {probeCompare.length > 0 && (
          <p class="mt-4 mb-0 text-sm">{probeCompare[0]}</p>
        )}
        {spaceCompare.length > 0 && (
          <p class="mt-2 mb-0 text-sm">{spaceCompare[0]}</p>
        )}
      </section>
    )}

    <HistorySubscription
      canDownloadCsv={canDownloadCsv}
      subscription={subscription}
      subscriptionNotice={subscriptionNotice}
    />

    <p class="mb-0 text-sm">
      <a class="text-link" href="/api/ical/outlook">{t.exports.icalLink}</a>
    </p>
      </>
    )}
  </div>
</DashboardLayout>

<script>
  const flashKeys = [
    "claims_emailed",
    "claims_error",
    "subscription",
    "view_saved",
    "view_deleted",
    "view_default",
    "view_error",
  ];
  const url = new URL(window.location.href);
  let changed = false;
  for (const key of flashKeys) {
    if (url.searchParams.has(key)) {
      url.searchParams.delete(key);
      changed = true;
    }
  }
  if (changed) {
    window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
  }
</script>
