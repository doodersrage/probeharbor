---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import FreezeTimeCalculator from "../components/FreezeTimeCalculator";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale, localizePath, LOCALE_META } from "../i18n";
import { freezeTimeCalculatorMessages } from "../i18n/messages/freezeTimeCalculator";

const locale = getLocale(Astro);
const t = freezeTimeCalculatorMessages(locale);
const title = t.title;
const description = t.description;
const faqs = t.faqs;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/freeze-time-calculator", locale));
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: title, path: localizePath("/freeze-time-calculator", locale) },
  ]),
  getFaqPageSchema(pageUrl, faqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    description,
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">{t.startFree}</a>
      <a slot="actions" class="btn-secondary" href="/answers/how-long-for-pipes-to-freeze">{t.howLongLink}</a>
    </PageHeader>

    <FreezeTimeCalculator
      client:load
      text={t.calculator}
      locale={locale === "en" ? undefined : LOCALE_META[locale].intl}
    />

    <section class="card">
      <h2 class="card-title">{t.readingTitle}</h2>
      <p class="mb-3">{t.readingIntro}</p>
      <p class="mb-0" set:html={t.readingLinksHtml} />
    </section>

    <FaqSection faqs={faqs} />

    <section class="card">
      <h2 class="card-title">{t.sensorTitle}</h2>
      <p class="mb-4">{t.sensorBody}</p>
      <p class="mb-0">
        <a class="btn-primary" href="/register?next=/dashboard/devices">{t.startFree}</a>
        {" "}
        <a class="btn-secondary" href="/demo">{t.seeDemo}</a>
      </p>
    </section>
  </div>
</Layout>
