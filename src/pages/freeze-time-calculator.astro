---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import FreezeTimeCalculator from "../components/FreezeTimeCalculator";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

const title = "Pipe freeze time calculator";
const description =
  "Enter two temperature readings and a freeze threshold to estimate how many hours a garage, crawlspace, or cabin has before it gets cold enough to freeze pipes.";

const faqs = [
  {
    question: "How does the calculator work?",
    answer:
      "It takes the cooling rate between your two readings and extends it in a straight line to your threshold. If the space fell 2°F in the last hour and is 10°F above the threshold, the estimate is five hours.",
  },
  {
    question: "How accurate is the estimate?",
    answer:
      "It is a runway, not a stopwatch. A space cools more slowly as it nears the outdoor temperature and faster if the wind picks up or a door opens, so redo it with fresh readings every hour or so.",
  },
  {
    question: "What threshold should I use?",
    answer:
      "34–38°F measured at the pipe. Reaching the threshold does not mean the pipe has frozen; it means there is still time to restore heat, close a door, or open a faucet.",
  },
  {
    question: "Can this run automatically?",
    answer:
      "Yes. ProbeHarbor does the same calculation continuously from your sensor's readings on every plan and shows it as a time-to-freeze clock, with an alert when the space reaches your threshold.",
  },
];

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/freeze-time-calculator");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: title, path: "/freeze-time-calculator" },
  ]),
  getFaqPageSchema(pageUrl, faqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    description,
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Tool"
      title="How long until this space reaches freezing?"
      lede="Read a thermometer in the space now, compare it with a reading from earlier, and see roughly how many hours are left before it reaches your freeze threshold at the current cooling rate."
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">Start free</a>
      <a slot="actions" class="btn-secondary" href="/answers/how-long-for-pipes-to-freeze">How long pipes take to freeze</a>
    </PageHeader>

    <FreezeTimeCalculator client:load />

    <section class="card">
      <h2 class="card-title">Reading the result</h2>
      <p class="mb-3">
        The estimate assumes the space keeps cooling at the rate you measured. Use it to decide how urgent tonight is:
        an hour or two means act now, a day or more means check again later.
      </p>
      <p class="mb-0">
        Pipes on exterior walls and near doors run colder than the room, so measure as close to the pipe as you can.
        See <a class="text-link" href="/answers/garage-pipe-freeze-temperature">when garage pipes freeze</a>,
        <a class="text-link" href="/answers/freeze-alarm-temperature-setting">where to set a freeze alarm</a>, and
        <a class="text-link" href="/about/time-to-freeze">how the time-to-freeze clock works</a> in the dashboard.
      </p>
    </section>

    <FaqSection faqs={faqs} />

    <section class="card">
      <h2 class="card-title">Let a sensor do the arithmetic</h2>
      <p class="mb-4">
        A probe on the pipe reports every few minutes, so the estimate updates on its own and an alert reaches you
        before the threshold. The free plan includes email alerts; bring an ESP32 probe or connect Home Assistant.
      </p>
      <p class="mb-0">
        <a class="btn-primary" href="/register?next=/dashboard/devices">Start free</a>
        {" "}
        <a class="btn-secondary" href="/demo">See the live demo</a>
      </p>
    </section>
  </div>
</Layout>
