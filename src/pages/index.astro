---
import { Image } from "astro:assets";
import Layout from '../layouts/Layout.astro';
import DemoTempsPanel from '../components/DemoTempsPanel';
import WeatherPanel from '../components/WeatherPanel';
import FaqSection from '../components/FaqSection.astro';
import ProductScreenshot from '../components/ProductScreenshot.astro';
import { BRAND_DESCRIPTION, BRAND_POSITIONING } from '../lib/brand';
import BrandMark from '../components/BrandMark.astro';
import { getAuthFromCookies } from '../lib/auth';
import {
  getBrandDefinition,
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from '../lib/schemaMarkup';
import { getMarketingFaqs, getMarketingFaqSchema } from '../lib/marketingFaqs';
import { getMemberPriceDisplay, getProPriceDisplay } from '../lib/stripePricing';
import { getStory } from '../lib/stories';
import dashboardInsights from '../assets/marketing/probeharbor-dashboard-insights.jpg';

// Supabase's default confirmation link lands here as /?code=... after it has
// already confirmed the address. The PKCE code can't be exchanged (its
// verifier lived in the server client that called signUp), so send the user
// to sign in with a confirmation notice instead of a silent homepage.
if (Astro.url.searchParams.has("code")) {
  return Astro.redirect("/signin?confirmed=1");
}

const { user } = await getAuthFromCookies(Astro.cookies);
const isAuthenticated = !!user;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/");
const homeFaqs = getMarketingFaqs("home");
const schema = [
  getBreadcrumbSchema(siteUrl, [{ name: "Home", path: "/" }]),
  getMarketingFaqSchema(pageUrl, "home"),
].filter(Boolean) as Record<string, unknown>[];

const homeDescription = BRAND_DESCRIPTION;
const brandDefinition = getBrandDefinition();

const memberPrice = getMemberPriceDisplay().monthly;
const proPrice = getProPriceDisplay().monthly;
const featuredStory = getStory("pipe-near-miss")!;
const guideJobs = [
  {
    title: "Hardware setup",
    href: "/guides#hardware",
    links: [
      { href: "/about/esp32-freeze-kit", label: "ESP32 freeze kit" },
      { href: "/accessories", label: "Accessories" },
      { href: "/claim-puck", label: "Claim puck" },
    ],
  },
  {
    title: "Freeze alerts",
    href: "/guides#alerts",
    links: [
      { href: "/answers", label: "Freezing pipes, answered" },
      { href: "/pipe-freeze-forecast", label: "Will my pipes freeze tonight?" },
      { href: "/freeze-time-calculator", label: "Freeze time calculator" },
      { href: "/about/cold-snap-playbook", label: "Cold-snap playbook" },
    ],
  },
  {
    title: "Flood / leak alerts",
    href: "/guides#alerts",
    links: [
      { href: "/about/ingest-and-webhooks", label: "Flood / leak guide" },
      { href: "/leak-puck", label: "Leak contact puck" },
      { href: "/about/freeze-thaw-flood-playbook", label: "Freeze-thaw flood playbook" },
    ],
  },
  {
    title: "Sharing and API",
    href: "/guides#sharing",
    links: [
      { href: "/about/household-sharing-walkthrough", label: "Household sharing" },
      { href: "/about/install-pwa", label: "Install the phone app" },
      { href: "/docs/api", label: "HTTP API" },
    ],
  },
];
---

<Layout
  title="Garage freeze & flood monitoring"
  description={homeDescription}
  schema={schema}
  softwareApplication
  speakableSelectors={[".home-hero-brand", ".home-hero-promise", ".home-hero-lead", ".faq-answer"]}
  ogImage="/og-dashboard.jpg"
  ogImageAlt="ProbeHarbor live telemetry graph: probe curves with humidity, dew point, freeze alerts, and flood/wet contacts"
>
		<div class="home-marketing">
			<section class="home-hero home-hero--bleed">
				<div class="home-hero-inner home-hero-grid">
					<div class="home-hero-copy">
						<p class="home-hero-audience">{BRAND_POSITIONING}</p>
						<BrandMark as="p" class="home-hero-brand" mark />
						<h1 class="home-hero-promise">Know before your pipes freeze or your garage floods.</h1>
						<p class="home-hero-lead">{brandDefinition}</p>
						<div class="home-hero-actions">
							{isAuthenticated ? (
								<>
									<a class="btn-primary home-hero-cta-primary" href="/dashboard">Open dashboard</a>
									<a class="btn-secondary" href="/dashboard/live">Live readings</a>
								</>
							) : (
								<>
									<a class="btn-primary home-hero-cta-primary" href="/register?next=/dashboard/devices">Start free</a>
									<a class="btn-secondary" href="/demo">See the live demo</a>
								</>
							)}
						</div>
						{isAuthenticated ? (
							<p class="home-hero-nohw">
								Signed in — Overview for ops, Live for glanceable probes, or
								<a class="text-link" href="/dashboard/devices">Devices</a>
								to manage ingest.
							</p>
						) : (
							<p class="home-hero-nohw">
								No credit card. No hardware yet?
								<a class="text-link" href="/pipe-freeze-forecast">Get free freeze alerts for your ZIP</a>.
							</p>
						)}
						<p class="home-hero-plans">
							<a class="text-link" href="/pricing">
								Free forever · no credit card
								<span aria-hidden="true"> · </span>
								{memberPrice ? `Member ${memberPrice}/mo` : "Member"}
								<span aria-hidden="true"> · </span>
								{proPrice ? `Pro ${proPrice}/mo` : "Pro"}
							</a>
						</p>
					</div>
					<figure class="home-hero-visual">
						<Image
							src={dashboardInsights}
								alt="ProbeHarbor Insights: seven-day probe curves with the freeze line, flood/wet contacts, nights-at-risk forecast, and forecast-backed time-to-freeze clock"
							widths={[480, 720, 960, 1200]}
							sizes="(max-width: 959px) 100vw, 42vw"
							class="home-hero-visual-img home-hero-visual-img--dashboard"
							fetchpriority="high"
						/>
						<figcaption class="home-hero-visual-caption">
							Real ProbeHarbor dashboard: 30-day probe curves, freeze threshold, and week-over-year comparison, not a mockup.
						</figcaption>
					</figure>
				</div>
			</section>

			<div class="page-shell page-stack">

				<section class="home-live-block" id="home-live" aria-labelledby="home-live-title">
					<div class="home-live-intro">
						<h2 class="home-live-title" id="home-live-title">Two ways to try it (no account)</h2>
						<p class="home-live-lede">
							Open the garage door and trigger a cold snap in the simulator, or watch the real demo probes below.
						</p>
					</div>
					<p class="home-live-cta mb-4">
						<a class="btn-secondary" href="/about/probe-demo?preset=coldSnap">Try a cold snap</a>
						<a class="btn-ghost" href="/demo">Live demo feed</a>
					</p>
					<div class="home-live" aria-label="Live demo readings">
						<DemoTempsPanel client:visible />
						<WeatherPanel client:visible cityId={null} guest />
					</div>
				</section>

				<section class="home-steps" aria-labelledby="home-steps-title">
					<div class="home-steps-intro">
						<h2 class="home-steps-title" id="home-steps-title">How it works</h2>
						<p class="home-steps-lede">
							One recommended path: ESP32 + waterproof probe → ProbeHarbor → phone alert. Other boards and feeds stay supported after you are live.
						</p>
					</div>
					<ol class="home-steps-list">
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">1</span>
							<div>
								<h3 class="home-step-title">Build one probe</h3>
								<p class="home-step-copy">
									ESP32 + waterproof DS18B20 is the default kit (~$20–30 parts): three wires and one resistor. A DHT22 adds humidity on the same pin.
								</p>
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">2</span>
							<div>
								<h3 class="home-step-title">Install from your browser</h3>
								<p class="home-step-copy">
									Plug the ESP32 into USB, install the firmware from the <a class="text-link" href="/flash">web flasher</a> in Chrome or Edge, and send it your Wi‑Fi and device key over the same cable. No Arduino IDE, no code.
								</p>
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">3</span>
							<div>
								<h3 class="home-step-title">Get freeze alerts</h3>
								<p class="home-step-copy">
									Set freeze °F + email, send a test, then watch Live and Overview. Add a flood/leak contact when you are ready.
								</p>
							</div>
						</li>
					</ol>
					<p class="home-steps-parts">
						<strong>You need:</strong> a free account, an ESP32 board (about $8–15), a waterproof DS18B20 (about $2–5),
						your Wi‑Fi, and a USB cable with Chrome or Edge. Under about $25, no subscription to try freeze alerts.
					</p>
					<div class="home-steps-actions">
						<a class="btn-primary" href="/register?next=/dashboard/devices">Start free</a>
						<a class="btn-secondary" href="/about/esp32-freeze-kit">ESP32 parts list</a>
						<a class="btn-ghost" href="/about/adding-devices">Other boards and integrations</a>
					</div>
				</section>

				<section class="home-maker" aria-labelledby="home-maker-title">
					<h2 class="home-maker-title" id="home-maker-title">Love DIY? You don’t have to DIY everything.</h2>
					<p class="home-maker-lede">
						Keep your ESP32, Arduino, MQTT, or Home Assistant setup. ProbeHarbor adds hosted history plus household freeze and flood alerts without another server to babysit.
					</p>
					<p class="home-maker-tagline">Your sensor. Your data. Your alerts.</p>
					<ul class="home-compat-list">
						<li>ESP32</li>
						<li>Arduino</li>
						<li>HTTPS JSON</li>
						<li>MQTT bridge</li>
						<li><a class="text-link" href="/integrations/home-assistant">Home Assistant</a></li>
						<li><a class="text-link" href="/about/thermostat-oauth">Nest / Ecobee</a></li>
						<li><a class="text-link" href="/compare/diy-mqtt">vs DIY MQTT</a></li>
					</ul>
				</section>

				<section class="home-story" aria-labelledby="home-story-title">
					<p class="home-story-kicker">Scenario</p>
					<h2 class="home-story-title" id="home-story-title">34°F. That’s when the alert matters.</h2>
					<p class="home-story-copy">
						Picture an attached garage where one corner dips below 34°F every clear night.
						The alert says something is wrong; the history chart shows where, pointing at a drafty door seal before supply lines ice.
						That is exactly the kind of timeline a
						<a class="text-link" href="/claims-pack">claims evidence pack</a>
						would document if freeze damage ever became an insurance conversation.
					</p>
					<ProductScreenshot
						shot="history-chart"
						caption="The same freeze line households set in Alerts, visible on History curves."
					/>
					<p class="home-story-cta mb-0">
						<a class="text-link" href={featuredStory.path}>Read the scenario</a>
						<span aria-hidden="true"> · </span>
						<a class="text-link" href="/stories">More scenarios</a>
					</p>
				</section>

				<section class="home-features" aria-label="Product highlights">
					<article class="home-feature">
						<h2 class="home-feature-title">Protect vulnerable spaces</h2>
						<p class="home-feature-copy">
							Freeze and leak alerts on every plan, plus a time-to-freeze clock for this space so you know when pipes will hit freeze, not only after they do. Member adds outdoor forecast warnings; Pro adds official NWS alerts and SMS.
							<a class="text-link" href="/about/cold-snap-playbook">Cold-snap playbook</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Catch leaks before they spread</h2>
						<p class="home-feature-copy">
							Flood / leak contacts auto-alert when wet, even during snooze or vacation. Add a sump or tank
							<code>level</code>
							sensor if you want early-warning rules before water reaches the floor.
							<a class="text-link" href="/about/ingest-and-webhooks">Flood + level ingest guide</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Your sensors, your stack</h2>
						<p class="home-feature-copy">
							Temperature, humidity, air quality, doors, leaks, power, and motion on hardware you control.
							<a class="text-link" href="/about/ingest-and-webhooks">Ingest guide</a>
							·
							<a class="text-link" href="/docs/api">HTTP API</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title" id="use-cases">Households to portfolios</h2>
						<p class="home-feature-copy">
							Invite family and share a live link without handing out a password. Pro adds a
							<a class="text-link" href="/claims-pack">claims evidence pack</a>; Portfolio adds
							<a class="text-link" href="/property-management">property-manager logins</a> for rentals and multi-unit sites.
						</p>
					</article>
				</section>

				<section class="home-pricing-ladder" aria-labelledby="home-pricing-title">
					<h2 class="home-pricing-title" id="home-pricing-title">Free to start</h2>
					<p class="home-pricing-lede">
						Pick a rung by job, whether that is freeze nights, wet leak alerts, or portfolio monitoring. Full limits live on pricing.
					</p>
					<ul class="home-pricing-list">
						<li>
							<strong>Free</strong>
							<span>See if ProbeHarbor works for you</span>
						</li>
						<li>
							<strong>Member</strong>
							<span>Track a whole cold season{memberPrice ? ` · ${memberPrice}/mo` : ""}</span>
						</li>
						<li>
							<strong>Pro</strong>
							<span>Serious alerts and automation{proPrice ? ` · ${proPrice}/mo` : ""}</span>
						</li>
					</ul>
					<div class="home-pricing-actions">
						<a class="btn-primary" href="/register?next=/dashboard/devices">Start free</a>
						<a class="btn-secondary" href="/pricing">Compare plans</a>
					</div>
				</section>


				<nav class="home-guides-row" aria-label="Guides">
					<strong>Guides:</strong>
					{guideJobs.map((job, i) => (
						<>
							{i > 0 && <span aria-hidden="true"> · </span>}
							<a class="text-link" href={job.href}>{job.title}</a>
						</>
					))}
					<span aria-hidden="true"> · </span>
					<a class="text-link" href="/guides">Open the guides hub</a>
				</nav>

				<p class="home-oss mb-0">
					Open-source dashboard and sample sensor sketches.
					<a class="text-link" href="https://github.com/doodersrage/probeharbor" target="_blank" rel="noreferrer">View source on GitHub</a>.
				</p>

				<FaqSection
					faqs={homeFaqs}
					lede="Straight answers for homeowners wiring probes, wet contacts, and setting freeze or flood alerts."
				/>
			</div>
		</div>
</Layout>
