---
import { Image } from "astro:assets";
import Layout from '../layouts/Layout.astro';
import DemoTempsPanel from '../components/DemoTempsPanel';
import WeatherPanel from '../components/WeatherPanel';
import FaqSection from '../components/FaqSection.astro';
import ProductScreenshot from '../components/ProductScreenshot.astro';
import { getLocale, LOCALE_META, localizePath } from '../i18n';
import { brandMessages } from '../i18n/messages/brand';
import { homeMessages } from '../i18n/messages/home';
import { demoIslandMessages } from '../i18n/messages/demoIslands';
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from '../i18n/content/marketingFaqs';
import BrandMark from '../components/BrandMark.astro';
import { getAuthFromCookies } from '../lib/auth';
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from '../lib/schemaMarkup';
import { getMemberPriceDisplay, getProPriceDisplay } from '../lib/stripePricing';
import { getStory } from '../lib/stories';
import dashboardInsights from '../assets/marketing/probeharbor-dashboard-insights.jpg';

// Supabase's default confirmation link lands here as /?code=... after it has
// already confirmed the address. The PKCE code can't be exchanged (its
// verifier lived in the server client that called signUp), so send the user
// to sign in with a confirmation notice instead of a silent homepage.
if (Astro.url.searchParams.has("code")) {
  return Astro.redirect("/signin?confirmed=1");
}

const { user } = await getAuthFromCookies(Astro.cookies);
const isAuthenticated = !!user;

const locale = getLocale(Astro);
const t = homeMessages(locale);
const brand = brandMessages(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/", locale));
const homeFaqs = getLocalizedMarketingFaqs("home", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [{ name: t.breadcrumbHome, path: localizePath("/", locale) }]),
  getLocalizedMarketingFaqSchema(pageUrl, "home", locale),
].filter(Boolean) as Record<string, unknown>[];

const homeDescription = brand.description;
const brandDefinition = t.brandDefinition;

const memberPrice = getMemberPriceDisplay().monthly;
const proPrice = getProPriceDisplay().monthly;
const featuredStory = getStory("pipe-near-miss")!;
const guideJobs = [
  {
    title: t.guides.hardware,
    href: "/guides#hardware",
    links: [
      { href: "/about/esp32-freeze-kit", label: "ESP32 freeze kit" },
      { href: "/accessories", label: "Accessories" },
      { href: "/claim-puck", label: "Claim puck" },
    ],
  },
  {
    title: t.guides.freeze,
    href: "/guides#alerts",
    links: [
      { href: "/answers", label: "Freezing pipes, answered" },
      { href: "/pipe-freeze-forecast", label: "Will my pipes freeze tonight?" },
      { href: "/freeze-time-calculator", label: "Freeze time calculator" },
      { href: "/about/cold-snap-playbook", label: "Cold-snap playbook" },
    ],
  },
  {
    title: t.guides.flood,
    href: "/guides#alerts",
    links: [
      { href: "/about/ingest-and-webhooks", label: "Flood / leak guide" },
      { href: "/leak-puck", label: "Leak contact puck" },
      { href: "/about/freeze-thaw-flood-playbook", label: "Freeze-thaw flood playbook" },
    ],
  },
  {
    title: t.guides.sharing,
    href: "/guides#sharing",
    links: [
      { href: "/about/household-sharing-walkthrough", label: "Household sharing" },
      { href: "/about/install-pwa", label: "Install the phone app" },
      { href: "/docs/api", label: "HTTP API" },
    ],
  },
];
---

<Layout
  title={t.title}
  description={homeDescription}
  schema={schema}
  softwareApplication
  speakableSelectors={[".home-hero-brand", ".home-hero-promise", ".home-hero-lead", ".faq-answer"]}
  ogImage="/og-dashboard.jpg"
  ogImageAlt={t.ogImageAlt}
>
		<div class="home-marketing">
			<section class="home-hero home-hero--bleed">
				<div class="home-hero-inner home-hero-grid">
					<div class="home-hero-copy">
						<p class="home-hero-audience">{brand.positioning}</p>
						<BrandMark as="p" class="home-hero-brand" mark />
						<h1 class="home-hero-promise">{t.hero.promise}</h1>
						<p class="home-hero-lead">{brandDefinition}</p>
						<div class="home-hero-actions">
							{isAuthenticated ? (
								<>
									<a class="btn-primary home-hero-cta-primary" href="/dashboard">{t.hero.openDashboard}</a>
									<a class="btn-secondary" href="/dashboard/live">{t.hero.liveReadings}</a>
								</>
							) : (
								<>
									<a class="btn-primary home-hero-cta-primary" href="/register?next=/dashboard/devices">{t.hero.startFree}</a>
									<a class="btn-secondary" href="/demo">{t.hero.seeDemo}</a>
								</>
							)}
						</div>
						{isAuthenticated ? (
							<p class="home-hero-nohw" set:html={t.hero.signedInHtml} />
						) : (
							<p class="home-hero-nohw" set:html={t.hero.guestHtml} />
						)}
						<p class="home-hero-plans">
							<a class="text-link" href="/pricing">
								{t.hero.freeForever}
								<span aria-hidden="true"> · </span>
								{memberPrice ? t.hero.planPrice("Member", memberPrice) : "Member"}
								<span aria-hidden="true"> · </span>
								{proPrice ? t.hero.planPrice("Pro", proPrice) : "Pro"}
							</a>
						</p>
					</div>
					<figure class="home-hero-visual">
						<Image
							src={dashboardInsights}
								alt={t.hero.visualAlt}
							widths={[480, 720, 960, 1200]}
							sizes="(max-width: 959px) 100vw, 42vw"
							class="home-hero-visual-img home-hero-visual-img--dashboard"
							fetchpriority="high"
						/>
						<figcaption class="home-hero-visual-caption">
							{t.hero.visualCaption}
						</figcaption>
					</figure>
				</div>
			</section>

			<div class="page-shell page-stack">

				<section class="home-live-block" id="home-live" aria-labelledby="home-live-title">
					<div class="home-live-intro">
						<h2 class="home-live-title" id="home-live-title">{t.live.title}</h2>
						<p class="home-live-lede">{t.live.lede}</p>
					</div>
					<p class="home-live-cta mb-4">
						<a class="btn-secondary" href="/about/probe-demo?preset=coldSnap">{t.live.coldSnap}</a>
						<a class="btn-ghost" href="/demo">{t.live.demoFeed}</a>
					</p>
					<div class="home-live" aria-label={t.live.readingsLabel}>
						<DemoTempsPanel client:visible text={demoIslandMessages(locale).temps} locale={LOCALE_META[locale].intl} />
						<WeatherPanel client:visible cityId={null} guest text={demoIslandMessages(locale).weather} locale={LOCALE_META[locale].intl} />
					</div>
				</section>

				<section class="home-steps" aria-labelledby="home-steps-title">
					<div class="home-steps-intro">
						<h2 class="home-steps-title" id="home-steps-title">{t.steps.title}</h2>
						<p class="home-steps-lede">{t.steps.lede}</p>
					</div>
					<ol class="home-steps-list">
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">1</span>
							<div>
								<h3 class="home-step-title">{t.steps.buildTitle}</h3>
								<p class="home-step-copy">{t.steps.buildCopy}</p>
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">2</span>
							<div>
								<h3 class="home-step-title">{t.steps.installTitle}</h3>
								<p class="home-step-copy" set:html={t.steps.installCopyHtml} />
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">3</span>
							<div>
								<h3 class="home-step-title">{t.steps.alertsTitle}</h3>
								<p class="home-step-copy">{t.steps.alertsCopy}</p>
							</div>
						</li>
					</ol>
					<p class="home-steps-parts" set:html={t.steps.partsHtml} />
					<div class="home-steps-actions">
						<a class="btn-primary" href="/register?next=/dashboard/devices">{t.steps.startFree}</a>
						<a class="btn-secondary" href="/about/esp32-freeze-kit">{t.steps.partsList}</a>
						<a class="btn-ghost" href="/about/adding-devices">{t.steps.otherBoards}</a>
					</div>
				</section>

				<section class="home-maker" aria-labelledby="home-maker-title">
					<h2 class="home-maker-title" id="home-maker-title">{t.maker.title}</h2>
					<p class="home-maker-lede">{t.maker.lede}</p>
					<p class="home-maker-tagline">{t.maker.tagline}</p>
					<ul class="home-compat-list">
						<li>ESP32</li>
						<li>Arduino</li>
						<li>HTTPS JSON</li>
						<li>{t.maker.mqttBridge}</li>
						<li><a class="text-link" href="/integrations/home-assistant">Home Assistant</a></li>
						<li><a class="text-link" href="/about/thermostat-oauth">Nest / Ecobee</a></li>
						<li><a class="text-link" href="/compare/diy-mqtt">{t.maker.vsDiy}</a></li>
					</ul>
				</section>

				<section class="home-story" aria-labelledby="home-story-title">
					<p class="home-story-kicker">{t.story.kicker}</p>
					<h2 class="home-story-title" id="home-story-title">{t.story.title}</h2>
					<p class="home-story-copy" set:html={t.story.copyHtml} />
					<ProductScreenshot
						shot="history-chart"
						caption={t.story.shotCaption}
					/>
					<p class="home-story-cta mb-0">
						<a class="text-link" href={featuredStory.path}>{t.story.read}</a>
						<span aria-hidden="true"> · </span>
						<a class="text-link" href="/stories">{t.story.more}</a>
					</p>
				</section>

				<section class="home-features" aria-label={t.features.label}>
					<article class="home-feature">
						<h2 class="home-feature-title">{t.features.protectTitle}</h2>
						<p class="home-feature-copy" set:html={t.features.protectCopyHtml} />
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">{t.features.leaksTitle}</h2>
						<p class="home-feature-copy" set:html={t.features.leaksCopyHtml} />
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">{t.features.stackTitle}</h2>
						<p class="home-feature-copy" set:html={t.features.stackCopyHtml} />
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title" id="use-cases">{t.features.portfolioTitle}</h2>
						<p class="home-feature-copy" set:html={t.features.portfolioCopyHtml} />
					</article>
				</section>

				<section class="home-pricing-ladder" aria-labelledby="home-pricing-title">
					<h2 class="home-pricing-title" id="home-pricing-title">{t.pricing.title}</h2>
					<p class="home-pricing-lede">{t.pricing.lede}</p>
					<ul class="home-pricing-list">
						<li>
							<strong>Free</strong>
							<span>{t.pricing.free}</span>
						</li>
						<li>
							<strong>Member</strong>
							<span>{t.pricing.member}{memberPrice ? t.pricing.perMonth(memberPrice) : ""}</span>
						</li>
						<li>
							<strong>Pro</strong>
							<span>{t.pricing.pro}{proPrice ? t.pricing.perMonth(proPrice) : ""}</span>
						</li>
					</ul>
					<div class="home-pricing-actions">
						<a class="btn-primary" href="/register?next=/dashboard/devices">{t.pricing.startFree}</a>
						<a class="btn-secondary" href="/pricing">{t.pricing.compare}</a>
					</div>
				</section>


				<nav class="home-guides-row" aria-label={t.guides.label}>
					<strong>{t.guides.heading}</strong>
					{guideJobs.map((job, i) => (
						<>
							{i > 0 && <span aria-hidden="true"> · </span>}
							<a class="text-link" href={job.href}>{job.title}</a>
						</>
					))}
					<span aria-hidden="true"> · </span>
					<a class="text-link" href="/guides">{t.guides.hub}</a>
				</nav>

				<p class="home-oss mb-0" set:html={t.ossHtml} />

				<FaqSection
					faqs={homeFaqs}
					lede={t.faqLede}
				/>
			</div>
		</div>
</Layout>
