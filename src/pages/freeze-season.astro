---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  listLatestFreezeMapSnapshots,
} from "../lib/freezeMap";
import {
  FREEZE_MAP_SAMPLE_FLOOR,
  resolveFreezeMapDisplay,
} from "../lib/freezeMapSeed";
import { getAuthFromCookies } from "../lib/auth";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  getHowToSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { fmt, getLocale, localizePath } from "../i18n";
import { freezeMapTemp } from "../i18n/messages/freezeMap";
import { freezeSeasonMessages } from "../i18n/messages/freezeSeason";

const { user } = await getAuthFromCookies(Astro.cookies);
const locale = getLocale(Astro);
const t = freezeSeasonMessages(locale);
const resolved = resolveFreezeMapDisplay(
  await listLatestFreezeMapSnapshots(),
  new Map(),
);
const snapshots = resolved.snapshots;
const isSeed = resolved.isSeed;
const visible = snapshots.filter(
  (row) => row.sample_count >= FREEZE_MAP_SAMPLE_FLOOR,
);
const coldest = [...visible]
  .filter((row) => row.min_temp_f != null)
  .sort((a, b) => (a.min_temp_f ?? 999) - (b.min_temp_f ?? 999))
  .slice(0, 3);

const month = new Date().getUTCMonth(); // 0-11
const inFreezeSeason = month >= 10 || month <= 2; // Nov–Mar
const seasonLabel = inFreezeSeason ? t.seasonHere : t.seasonAhead;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/freeze-season", locale));
const description = t.description;

const freezeSeasonFaqs = t.faqs;

const freezeSeasonHowTo = getHowToSchema({
  name: t.howToName,
  description,
  pageUrl,
  totalTime: "PT30M",
  steps: [
    ...t.checklist.map((text, index) => ({
      name: fmt(t.howToStep, { step: index + 1 }),
      text,
    })),
    {
      name: t.howToMapName,
      text: t.howToMapText,
      url: `${siteUrl}${localizePath("/freeze-map", locale)}`,
    },
  ],
});

const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumb, path: localizePath("/freeze-season", locale) },
  ]),
  getFaqPageSchema(pageUrl, freezeSeasonFaqs),
  freezeSeasonHowTo,
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={seasonLabel}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href={user ? "/dashboard/alerts?tab=settings#alert-section-essentials" : "/register?next=/dashboard/devices"}>
        {user ? t.openAlerts : t.startFree}
      </a>
      <a slot="actions" class="btn-secondary" href="/freeze-map">{t.communityMap}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.checklistTitle}</h2>
      <ol class="text-sm space-y-2 mb-0">
        {t.checklist.map((item) => (
          <li>{item}</li>
        ))}
        <li set:html={t.checklistOptionalHtml} />
      </ol>
    </section>

    {coldest.length > 0 && (
      <section class="card">
        <h2 class="card-title">{isSeed ? t.sampleColdest : t.liveColdest}</h2>
        <p class="card-subtitle mb-4">
          {isSeed ? t.sampleNote : t.liveNote}
        </p>
        <ul class="text-sm space-y-2 mb-0">
          {coldest.map((row) => (
            <li>
              <strong>{row.city_label}</strong>: {row.min_temp_f != null ? fmt(t.minTemp, { temp: freezeMapTemp(row.min_temp_f, locale) }) : ""}
            </li>
          ))}
        </ul>
        <p class="mt-4 mb-0">
          <a class="btn-secondary" href="/freeze-map">{t.viewMap}</a>
        </p>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">{t.indoorTitle}</h2>
      <p class="mb-4 text-sm">{t.indoorBody}</p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/compare/tempest">{t.vsWeather}</a>
        <a class="btn-secondary" href="/about/esp32-freeze-kit">{t.partsList}</a>
        <a class="btn-ghost" href="/stories">{t.stories}</a>
        <a class="btn-ghost" href="/demo">{t.demo}</a>
      </div>
    </section>

    <FaqSection
      faqs={freezeSeasonFaqs}
      lede={t.faqLede}
    />
  </div>
</Layout>
