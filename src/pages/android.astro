---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { BRAND_NAME } from "../lib/brand";
import {
  getBreadcrumbSchema,
  getSoftwareApplicationSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale, localizePath } from "../i18n";
import { androidMessages } from "../i18n/messages/android";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";
import garageInstallLifestyle from "../assets/probeharbor-garage-install-lifestyle.jpg";

const locale = getLocale(Astro);
const t = androidMessages(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/android", locale));
const androidFaqs = getLocalizedMarketingFaqs("android", locale);

const ANDROID_REPO = "https://github.com/doodersrage/probeharbor-android";
const playStoreUrl = String(import.meta.env.PUBLIC_PLAY_STORE_URL ?? "").trim();
const playStoreLive = playStoreUrl.startsWith("https://play.google.com/");

const software = getSoftwareApplicationSchema(siteUrl);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbApps, path: localizePath("/apps", locale) },
    { name: t.breadcrumbAndroid, path: localizePath("/android", locale) },
  ]),
  {
    ...software,
    "@type": ["SoftwareApplication", "MobileApplication"],
    name: t.schemaName(BRAND_NAME),
    operatingSystem: "Android",
    applicationCategory: "UtilitiesApplication",
    url: pageUrl,
    downloadUrl: playStoreLive ? playStoreUrl : ANDROID_REPO,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: playStoreLive
        ? "https://schema.org/InStock"
        : "https://schema.org/PreOrder",
      url: playStoreLive ? playStoreUrl : pageUrl,
    },
  },
  getLocalizedMarketingFaqSchema(pageUrl, "android", locale),
].filter(Boolean) as Record<string, unknown>[];

const description = playStoreLive
  ? t.descriptionLive(BRAND_NAME)
  : t.descriptionPwa(BRAND_NAME);
---
<Layout
  title={t.title}
  description={description}
  schema={schema}
  ogImage="/og-android.jpg"
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={playStoreLive ? t.kickerLive : t.kickerPwa}
      title={t.heading}
      lede={playStoreLive ? t.ledeLive : t.ledePwa}
    >
      {playStoreLive ? (
        <a slot="actions" class="btn-primary" href={playStoreUrl} target="_blank" rel="noreferrer">
          {t.getOnPlay}
        </a>
      ) : (
        <a slot="actions" class="btn-primary" href="/about/install-pwa">
          {t.installPwa}
        </a>
      )}
      {!playStoreLive && (
        <a slot="actions" class="btn-secondary" href={ANDROID_REPO} target="_blank" rel="noreferrer">
          {t.githubSideload}
        </a>
      )}
      <a slot="actions" class="btn-ghost" href={playStoreLive ? ANDROID_REPO : "/contact?topic=android"}>
        {playStoreLive ? t.sourceOnGithub : t.requestLaunchNote}
      </a>
    </PageHeader>

    <figure class="card overflow-hidden p-0 mb-0">
      <Image
        src={garageInstallLifestyle}
        alt={t.imageAlt(BRAND_NAME)}
        widths={[640, 960, 1280]}
        sizes="(max-width: 960px) 100vw, 900px"
        class="w-full h-auto block"
      />
      <figcaption class="px-4 py-3 text-sm text-[var(--color-text-muted)]">
        {t.imageCaption}
      </figcaption>
    </figure>

    <section class="card">
      <h2 class="card-title">{t.phoneTitle}</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li set:html={t.doesHtml} />
        <li set:html={t.doesNotHtml} />
      </ul>
      <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.bayBuddyNoteHtml} />
    </section>

    {playStoreLive ? (
      <section class="card">
        <h2 class="card-title">{t.playTitle}</h2>
        <p class="card-subtitle mb-4">
          {t.playCopy}
        </p>
        <a class="btn-primary" href={playStoreUrl} target="_blank" rel="noreferrer">
          {t.openInPlay}
        </a>
      </section>
    ) : (
      <section class="card">
        <h2 class="card-title">{t.pwaTitle}</h2>
        <p class="card-subtitle mb-4">
          {t.pwaCopy}
        </p>
        <div class="flex flex-wrap gap-3 mb-4">
          <a class="btn-primary" href="/about/install-pwa">{t.pwaSteps}</a>
          <a class="btn-secondary" href={ANDROID_REPO} target="_blank" rel="noreferrer">
            {t.githubRepo}
          </a>
        </div>
        <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
          {t.pwaListHtml.map((item) => <li set:html={item} />)}
        </ol>
      </section>
    )}

    {!playStoreLive && (
    <section class="card">
      <h2 class="card-title">{t.pendingTitle}</h2>
      <p class="card-subtitle mb-4">
        {t.pendingCopy}
      </p>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        {t.pendingListHtml.map((item) => <li set:html={item} />)}
      </ol>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.deepLinksHtml} />
    </section>
    )}

    <section class="card">
      <h2 class="card-title">{t.ossTitle}</h2>
      <p class="card-subtitle mb-0" set:html={t.ossHtml(ANDROID_REPO)} />
    </section>

    <FaqSection
      faqs={androidFaqs}
      lede={t.faqLede}
    />

    <p class="mb-0 text-sm">
      <a class="text-link" href="/apps">{t.backToApps}</a>
    </p>
  </div>
</Layout>
