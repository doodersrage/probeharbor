---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { CLAIM_PUCK_REPO_URL } from "../lib/claimPuck";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";

const m = accessoriesMessages(getLocale(Astro));
const c = m.common;
const t = m.claimPuckCase;

const ZERO = BOM.amazonRp2040Zero;
const BUTTON = BOM.adafruitButton;
const DIFFUSER = BOM.adafruitDiffuser;
---
<AccessoryProduct
  accessoryId="claim-puck-case"
  faqKey="claimPuckCase"
  title={t.title}
  description={t.description}
  kicker={c.kitKicker}
>
  <a slot="actions" class="btn-primary" href="/claim-puck">{c.claimPuck}</a>
  <a slot="actions" class="btn-secondary" href={CLAIM_PUCK_REPO_URL} target="_blank" rel="noreferrer">
    {t.firmware}
  </a>
  <a slot="actions" class="btn-ghost" href="/alert-beacon">{c.alertBeacon}</a>

  <section class="card">
    <h2 class="card-title">{c.whatItIs}</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>{c.does}</strong> <Fragment set:html={t.doesHtml} />
      </li>
      <li>
        <strong>{c.doesNot}</strong> <Fragment set:html={t.doesNotHtml} />
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">{c.parts}</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.colPart}</th>
            <th scope="col">{c.colWhy}</th>
            <th scope="col">{c.colBuy}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Waveshare RP2040-Zero</th>
            <td>{t.zeroWhy}</td>
            <td>
              <a class="text-link" href={ZERO} target="_blank" rel={commerceLinkRel(ZERO)}>Amazon</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{c.momentaryButton}</th>
            <td>{c.buttonWhy}</td>
            <td>
              <a class="text-link" href={BUTTON} target="_blank" rel={commerceLinkRel(BUTTON)}>{c.adafruitButton}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.casePart}</th>
            <td>{t.caseWhy}</td>
            <td>{t.caseBuy}</td>
          </tr>
          <tr>
            <th scope="row">{t.diffuserPart}</th>
            <td>{t.diffuserWhy}</td>
            <td>
              <a class="text-link" href={DIFFUSER} target="_blank" rel={commerceLinkRel(DIFFUSER)}>{t.diffuserBuy}</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">{t.buildNotes}</h2>
    <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
      {t.notesHtml.map((note) => <li set:html={note} />)}
    </ol>
  </section>
</AccessoryProduct>
