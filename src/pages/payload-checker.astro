---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getBreadcrumbSchema, resolvePageUrl, resolveSiteUrl } from "../lib/schemaMarkup";
import { getLocale, localizePath } from "../i18n";
import { payloadCheckerMessages } from "../i18n/messages/payloadChecker";

const locale = getLocale(Astro);
const t = payloadCheckerMessages(locale);
const title = t.title;
const description = t.description;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/payload-checker", locale));
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: title, path: localizePath("/payload-checker", locale) },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    description,
    url: pageUrl,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
].filter(Boolean) as Record<string, unknown>[];

const examples = [
  { id: "flat", label: t.examples.flat, json: { temp1: 42.5, humidity1: 61, door1: false, battery: 87, rssi: -62 } },
  { id: "classic", label: t.examples.classic, json: { temp: { probe1: { c: 5.8, f: 42.4, h: 61 } } } },
  {
    id: "typed",
    label: t.examples.typed,
    json: { sensors: [{ key: "pipe", kind: "temperature", value: 38.2, label: "Garage pipe" }, { key: "leak1", kind: "flood", bool: false }] },
  },
];
---
<Layout title={title} description={description} schema={schema}>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-secondary" href="/docs/api">{t.apiDocs}</a>
      <a slot="actions" class="btn-ghost" href="/hardware">{t.whichHardware}</a>
    </PageHeader>

    <section class="card" aria-labelledby="payload-input-title">
      <h2 class="card-title" id="payload-input-title">{t.inputTitle}</h2>
      <p class="form-hint mb-3">
        {t.tryExample}
        {examples.map((example) => (
          <button type="button" class="btn-ghost text-sm" data-example={JSON.stringify(example.json, null, 2)}>
            {example.label}
          </button>
        ))}
      </p>
      <form id="payload-form">
        <label class="form-label" for="payload-input">{t.jsonBody}</label>
        <textarea
          id="payload-input"
          class="form-input font-mono text-sm"
          rows="10"
          spellcheck="false"
          autocomplete="off"
        >{JSON.stringify(examples[0]!.json, null, 2)}</textarea>
        <p class="mt-3 mb-0">
          <button type="submit" class="btn-primary">{t.check}</button>
        </p>
      </form>
    </section>

    <section class="card" aria-live="polite" aria-labelledby="payload-result-title" id="payload-result" data-text={JSON.stringify(t.script)} hidden>
      <h2 class="card-title" id="payload-result-title">{t.resultTitle}</h2>
      <p id="payload-verdict" class="mb-3"></p>
      <ul id="payload-warnings" class="mb-3 space-y-2"></ul>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="payload-table">
          <caption class="sr-only">{t.tableCaption}</caption>
          <thead>
            <tr class="text-left">
              <th scope="col" class="py-2 pr-3">{t.colKey}</th>
              <th scope="col" class="py-2 pr-3">{t.colStoredAs}</th>
              <th scope="col" class="py-2 pr-3">{t.colType}</th>
              <th scope="col" class="py-2 pr-3">{t.colValue}</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <p id="payload-device" class="form-hint mt-3 mb-0"></p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.nextTitle}</h2>
      <p class="mb-0" set:html={t.nextHtml} />
    </section>
  </div>
</Layout>

<script>
  type Reading = {
    key: string;
    label: string;
    kind: string;
    unit: string | null;
    value_num: number | null;
    value_bool: boolean | null;
    value_text: string | null;
  };
  type CheckResult = {
    accepted: boolean;
    readings: Reading[];
    device: { batteryPct: number | null; rssi: number | null; firmwareVersion: string | null };
    warnings: string[];
    ignoredKeys: string[];
  };

  const form = document.getElementById("payload-form") as HTMLFormElement | null;
  const input = document.getElementById("payload-input") as HTMLTextAreaElement | null;
  const panel = document.getElementById("payload-result");
  const verdict = document.getElementById("payload-verdict");
  const warningList = document.getElementById("payload-warnings");
  const tbody = document.querySelector("#payload-table tbody");
  const table = document.getElementById("payload-table");
  const deviceLine = document.getElementById("payload-device");
  const msg = JSON.parse(panel?.dataset.text ?? "{}") as Record<string, string>;
  const fill = (template: string | undefined, value: string | number) =>
    (template ?? "").replace("{value}", String(value)).replace("{n}", String(value));

  function cell(row: HTMLTableRowElement, text: string) {
    const td = document.createElement("td");
    td.className = "py-2 pr-3";
    td.textContent = text;
    row.appendChild(td);
  }

  function formatValue(reading: Reading): string {
    if (reading.value_bool != null) return String(reading.value_bool);
    if (reading.value_num != null) return `${reading.value_num}${reading.unit ? ` ${reading.unit}` : ""}`;
    return reading.value_text ?? "—";
  }

  function show(message: string, warnings: string[], result?: CheckResult) {
    if (!panel || !verdict || !warningList || !tbody || !table || !deviceLine) return;
    panel.hidden = false;
    verdict.textContent = message;
    warningList.replaceChildren(
      ...warnings.map((text) => {
        const li = document.createElement("li");
        li.textContent = `⚠ ${text}`;
        return li;
      }),
    );
    tbody.replaceChildren();
    table.hidden = !result || result.readings.length === 0;
    for (const reading of result?.readings ?? []) {
      const row = document.createElement("tr");
      cell(row, reading.key);
      cell(row, reading.label);
      cell(row, reading.kind);
      cell(row, formatValue(reading));
      tbody.appendChild(row);
    }
    const parts: string[] = [];
    if (result?.device.batteryPct != null) parts.push(fill(msg.battery, result.device.batteryPct));
    if (result?.device.rssi != null) parts.push(fill(msg.signal, result.device.rssi));
    if (result?.device.firmwareVersion) parts.push(fill(msg.firmware, result.device.firmwareVersion));
    if (result && result.ignoredKeys.length > 0) parts.push(fill(msg.ignored, result.ignoredKeys.join(", ")));
    deviceLine.textContent = parts.length > 0 ? fill(msg.deviceFields, parts.join(" · ")) : "";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-example]").forEach((button) => {
    button.addEventListener("click", () => {
      if (input) input.value = button.dataset.example ?? "";
      form?.requestSubmit();
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const text = input?.value ?? "";
    try {
      JSON.parse(text);
    } catch (error) {
      show(msg.invalidJson ?? "", [error instanceof Error ? error.message : (msg.invalidJsonHint ?? "")]);
      return;
    }
    try {
      const response = await fetch("/api/payload-check", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: text,
      });
      const body = (await response.json()) as { error?: string } & Partial<CheckResult>;
      if (!response.ok) {
        show(msg.checkFailed ?? "", [body.error ?? `HTTP ${response.status}`]);
        return;
      }
      const result = body as CheckResult;
      const count = result.readings.length;
      show(
        result.accepted
          ? fill(
              result.warnings.length
                ? count === 1 ? msg.acceptedOneNotes : msg.acceptedManyNotes
                : count === 1 ? msg.acceptedOne : msg.acceptedMany,
              count,
            )
          : (msg.rejected ?? ""),
        result.warnings,
        result,
      );
    } catch {
      show(msg.unreachable ?? "", []);
    }
  });
</script>
