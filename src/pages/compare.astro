---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import EditorialPhotoStrip from "../components/EditorialPhotoStrip.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { compareHubPhotos } from "../lib/aboutPhotos";
import { getLocale } from "../i18n";
import { compareMessages } from "../i18n/messages/compare";
import { getLocalizedCompareGuides } from "../i18n/content/compareGuides";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

const locale = getLocale(Astro);
const t = compareMessages(locale);
const compareGuides = getLocalizedCompareGuides(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/compare");
const compareFaqs = getLocalizedMarketingFaqs("compare", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: "/" },
    { name: t.breadcrumbCompare, path: "/compare" },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "compare", locale),
].filter(Boolean) as Record<string, unknown>[];

const stripPhotoIds = compareHubPhotos.map((p) => p.id);
const stripLabels = compareHubPhotos.map((p) => t.photoLabels[p.id] ?? p.label);
const stripHrefs = compareHubPhotos.map((p) => p.href);
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.headerTitle}
      lede={t.headerLede}
    >
      <a slot="actions" class="btn-primary" href="/pricing">{t.seePlansPricing}</a>
      <a slot="actions" class="btn-secondary" href="/register?next=/dashboard/devices">{t.startFree}</a>
    </PageHeader>

    <EditorialPhotoStrip
      photoIds={stripPhotoIds}
      labels={stripLabels}
      hrefs={stripHrefs}
    />

    <section class="card">
      <h2 class="card-title">{t.guides.title}</h2>
      <p class="card-subtitle mb-4">
        {t.guides.subtitle}
      </p>
      <ul class="space-y-4 mb-4">
        {compareGuides.map((guide) => (
          <li>
            <a class="text-link font-semibold" href={guide.path}>{guide.title}</a>
            <p class="text-sm text-[var(--color-text-muted)] mt-1 mb-0">{guide.summary}</p>
          </li>
        ))}
      </ul>
      <p class="text-sm text-[var(--color-text-muted)] mb-4" set:html={t.guides.smartThingsHtml} />
      <div class="border border-[var(--color-border)] rounded-lg p-4">
        <p class="font-semibold mb-1">
          <a class="text-link" href="/integrations/home-assistant">{t.guides.haTitle}</a>
        </p>
        <p class="text-sm text-[var(--color-text-muted)] mb-0" set:html={t.guides.haCopyHtml} />
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">{t.table.title}</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">{t.table.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{t.table.capability}</th>
              <th scope="col">{t.table.probeharbor}</th>
              <th scope="col">{t.table.diy}</th>
              <th scope="col">{t.table.consumer}</th>
            </tr>
          </thead>
          <tbody>
            {t.table.rows.map((row) => (
              <tr>
                <th scope="row" set:html={row.capabilityHtml} />
                <td set:html={row.probeharborHtml} />
                <td set:html={row.diyHtml} />
                <td set:html={row.consumerHtml} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="product-shot-row">
      <ProductScreenshot
        shot="history-chart"
        caption={t.screenshotCaption}
      />
      <section class="card">
        <h2 class="card-title">{t.audience.title}</h2>
        <ul class="text-sm space-y-2 mb-4">
          {t.audience.itemsHtml.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/register?next=/dashboard/devices">{t.audience.startFree}</a>
          <a class="btn-secondary" href="/pricing">{t.audience.seePrices}</a>
          <a class="btn-ghost" href="/stories/garage-freeze-alert">{t.audience.readScenario}</a>
        </div>
      </section>
    </div>

    <section class="card">
      <h2 class="card-title">{t.limits.title}</h2>
      <p class="card-subtitle mb-4">
        {t.limits.subtitle}
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/pricing#plan-matrix">{t.limits.openComparison}</a>
        <a class="btn-secondary" href="/register?next=/dashboard/devices">{t.limits.createAccount}</a>
      </div>
    </section>

    <FaqSection faqs={compareFaqs} />
  </div>
</Layout>
