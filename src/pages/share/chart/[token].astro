---
import Layout from "../../../layouts/Layout.astro";
import { getChartShareByToken } from "../../../lib/chartShare";
import { fmt, getLocale, LOCALE_META } from "../../../i18n";
import { publicShareMessages } from "../../../i18n/messages/app/publicShare";

export const prerender = false;

const locale = getLocale(Astro);
const t = publicShareMessages(locale).chart;
const token = Astro.params.token?.trim() ?? "";
if (!token) {
  return new Response(t.notFound, { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
}

const share = await getChartShareByToken(token);
if (!share?.png) {
  return new Response(t.expired, { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
}

const format = Astro.url.searchParams.get("format");
if (format === "png") {
  return new Response(share.png, {
    status: 200,
    headers: {
      "Content-Type": "image/png",
      "Cache-Control": "public, max-age=3600",
    },
  });
}

const title = share.title?.trim() || t.defaultTitle;
// English keeps the server's default date format, as before.
const expires = new Date(share.expiresAt).toLocaleDateString(locale === "en" ? undefined : LOCALE_META[locale].intl);
---
<Layout title={title}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-2xl font-semibold mb-2">{title}</h1>
    <p class="text-sm text-[var(--color-text-muted)] mb-6">
      {fmt(t.snapshot, { date: expires })}
    </p>
    <img
      src={`/share/chart/${token}?format=png`}
      alt={title}
      class="w-full rounded border border-[var(--color-border)] bg-[var(--color-surface)]"
    />
    <p class="mt-6 text-sm">
      <a class="text-link" href="/">{t.home}</a>
      {" · "}
      <a class="text-link" href="/dashboard/history">{t.openHistory}</a>
    </p>
  </main>
</Layout>
