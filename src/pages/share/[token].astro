---
import Layout from "../../layouts/Layout.astro";
import I18nJson from "../../components/I18nJson.astro";
import { getLocale, LOCALE_META } from "../../i18n";
import { publicShareMessages } from "../../i18n/messages/app/publicShare";

const locale = getLocale(Astro);
const t = publicShareMessages(locale).share;
// English keeps the browser's default formatting, as before.
const intl = locale === "en" ? null : LOCALE_META[locale].intl;

const token = Astro.params.token;
if (!token) {
  return Astro.redirect("/");
}

const readingsUrl = `/api/share/${token}/readings`;
---
<Layout title={t.title} description={t.description} noindex>
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-semibold mb-2" id="share-title">{t.heading}</h1>
    <p class="text-[var(--color-text-muted)] mb-2" id="share-subtitle">{t.subtitleLive}</p>
    <p class="text-sm text-[var(--color-text-muted)] mb-8" id="share-meta"></p>
    <div id="share-root" class="space-y-4" data-url={readingsUrl}>
      <p>{t.loading}</p>
    </div>
    <p class="mt-10 text-sm text-[var(--color-text-muted)]">
      {t.cta}
      <a class="text-link" href="/register?next=/dashboard/devices">{t.ctaLink}</a>
    </p>
  </div>
  <I18nJson id="share-i18n" data={{ text: t.client, intl }} />
</Layout>

<script is:inline>
  (() => {
    const root = document.getElementById("share-root");
    const titleEl = document.getElementById("share-title");
    const subtitleEl = document.getElementById("share-subtitle");
    const metaEl = document.getElementById("share-meta");
    if (!root) return;
    let i18n = {};
    try {
      i18n = JSON.parse(document.getElementById("share-i18n")?.textContent || "{}");
    } catch {}
    const T = i18n.text || {};
    const intl = i18n.intl || undefined;
    const fill = (template, vars) =>
      String(template).replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
    const url = root.getAttribute("data-url");
    const STALE_MS = 2 * 60 * 60 * 1000;
    let pollTimer = null;

    function formatAge(iso) {
      if (!iso) return null;
      const ms = Date.now() - Date.parse(iso);
      if (Number.isNaN(ms) || ms < 0) return null;
      const minutes = Math.floor(ms / 60000);
      let label;
      if (minutes < 1) label = T.updatedJustNow;
      else if (minutes < 60) label = fill(T.updatedMinutes, { count: minutes });
      else {
        const hours = Math.floor(minutes / 60);
        label =
          hours < 48
            ? fill(T.updatedHours, { count: hours })
            : fill(T.updatedDays, { count: Math.floor(hours / 24) });
      }
      return { label, stale: ms >= STALE_MS };
    }

    function formatValue(r) {
      if (r.value_bool != null) {
        if (r.kind === "door") return r.value_bool ? T.open : T.closed;
        if (r.kind === "power") return r.value_bool ? T.on : T.off;
        if (r.kind === "flood") return r.value_bool ? T.wet : T.dry;
        if (r.kind === "motion") return r.value_bool ? T.detected : T.clear;
        return r.value_bool ? T.onOpen : T.offClosed;
      }
      if (r.value_num != null) {
        const num = intl
          ? Number(r.value_num).toLocaleString(intl, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
          : Number(r.value_num).toFixed(1);
        return num + (r.unit ? " " + r.unit : "");
      }
      return r.value_text || "—";
    }

    function kindLabel(kind) {
      return (T.kinds && T.kinds[kind]) || kind;
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function retryButtonHtml() {
      return '<p class="mt-4 mb-0"><button type="button" class="btn-secondary" id="share-retry">' + escapeHtml(T.retry) + "</button></p>";
    }

    function bindRetry() {
      document.getElementById("share-retry")?.addEventListener("click", () => {
        root.innerHTML = "<p>" + escapeHtml(T.loading) + "</p>";
        load();
      });
    }

    function render(data) {
      if (titleEl && data.label) titleEl.textContent = data.label;
      if (subtitleEl) {
        subtitleEl.textContent =
          data.scope === "history"
            ? T.subtitleHistory
            : data.scope === "metrics"
              ? T.subtitleMetrics
              : T.subtitleLive;
      }
      if (metaEl) {
        const parts = [];
        if (data.expires_at) {
          parts.push(fill(T.expires, { date: new Date(data.expires_at).toLocaleString(intl) }));
        } else {
          parts.push(T.noExpiry);
        }
        if (data.scope !== "history") {
          parts.push(T.updatesEvery);
        }
        metaEl.textContent = parts.join(" · ");
      }

      const history = data.history_points || [];
      let historyHtml = "";
      if (data.scope === "history" && history.length >= 2) {
        const temps = history.map((p) => p.tempf);
        const min = Math.min(...temps) - 2;
        const max = Math.max(...temps) + 2;
        const range = max - min || 1;
        const w = 320;
        const h = 120;
        const path = history
          .map((p, i) => {
            const x = (i / (history.length - 1)) * w;
            const y = h - ((p.tempf - min) / range) * h;
            return (i === 0 ? "M" : "L") + x.toFixed(1) + "," + y.toFixed(1);
          })
          .join(" ");
        historyHtml =
          '<div class="card mb-4"><p class="m-0 mb-2 text-sm text-[var(--color-text-muted)]">' +
          escapeHtml(T.trendTitle) +
          "</p>" +
          '<svg viewBox="0 0 ' +
          w +
          " " +
          h +
          '" width="100%" height="120" role="img" aria-label="' +
          escapeHtml(T.trendAria) +
          '">' +
          '<path d="' +
          path +
          '" fill="none" stroke="#22b8d4" stroke-width="2" /></svg></div>';
      }

      const readings = data.readings || [];
      if (readings.length === 0 && !historyHtml) {
        root.innerHTML =
          '<div class="empty-state">' +
          "<p>" +
          escapeHtml(T.emptyTitle) +
          "</p>" +
          '<p class="text-sm text-[var(--color-text-muted)] mb-0">' +
          escapeHtml(T.emptyNote) +
          "</p>" +
          retryButtonHtml() +
          "</div>";
        bindRetry();
        return;
      }

      root.innerHTML =
        historyHtml +
        readings
          .map((r) => {
            const age = formatAge(r.recorded_at);
            const staleClass = age && age.stale ? " stat-item-stale" : "";
            const ageHtml = age
              ? `<p class="m-0 mt-1 text-sm ${
                  age.stale ? "text-[var(--color-warning)]" : "text-[var(--color-text-muted)]"
                }">${escapeHtml(age.stale ? fill(T.stale, { age: age.label }) : age.label)}</p>`
              : "";
            return `<div class="card${staleClass}">
            <strong>${escapeHtml(r.label)}</strong>
            <p class="m-0 text-sm text-[var(--color-text-muted)]">${escapeHtml(r.device)} · ${escapeHtml(
              kindLabel(r.kind),
            )}</p>
            <p class="text-2xl m-0 mt-2">${escapeHtml(formatValue(r))}</p>
            ${ageHtml}
          </div>`;
          })
          .join("");
    }

    async function load() {
      try {
        const res = await fetch(url);
        const data = await res.json();
        if (!res.ok) {
          root.innerHTML =
            `<div class="empty-state"><p>${escapeHtml(
              data.error || T.loadError,
            )}</p>${retryButtonHtml()}</div>`;
          if (metaEl) metaEl.textContent = "";
          bindRetry();
          return;
        }
        render(data);
      } catch {
        root.innerHTML =
          '<div class="empty-state"><p>' +
          escapeHtml(T.fetchError) +
          "</p>" +
          retryButtonHtml() +
          "</div>";
        bindRetry();
      }
    }

    load();
    pollTimer = setInterval(load, 90000);
  })();
</script>
