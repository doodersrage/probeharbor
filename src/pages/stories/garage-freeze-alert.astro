---
export const prerender = false;

import StoryArticle from "../../components/StoryArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedStory } from "../../i18n/content/stories";
import { storiesMessages } from "../../i18n/messages/stories";
import freezeAlertLifestyle from "../../assets/probeharbor-freeze-alert-lifestyle.jpg";

const story = getLocalizedStory("garage-freeze-alert", getLocale(Astro));
if (!story) {
  return Astro.redirect("/stories");
}
---
<StoryArticle
  story={story}
  heroImage={freezeAlertLifestyle}
  heroCaption={storiesMessages(getLocale(Astro)).heroCaptions.garageFreezeAlert}
/>
