---
export const prerender = false;

import StoryArticle from "../../components/StoryArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedStory } from "../../i18n/content/stories";

const story = getLocalizedStory("pipe-near-miss", getLocale(Astro));
if (!story) {
  return Astro.redirect("/stories");
}
---
<StoryArticle story={story} />
