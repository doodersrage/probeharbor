---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { stories } from "../../lib/stories";
import EditorialPhotoStrip from "../../components/EditorialPhotoStrip.astro";
import { storiesHubPhotoIds } from "../../lib/aboutPhotos";
import {
  getBreadcrumbSchema,
  getItemListSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";

const title = "Freeze, leak, and heat scenarios";
const description =
  "Illustrative walkthroughs of ThermalTrace freeze, leak, and heat alerts in garages, crawlspaces, cabins, and closets: setup, timeline, and why each matters.";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/stories");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Scenarios", path: "/stories" },
  ]),
  getItemListSchema({
    pageUrl,
    name: "ThermalTrace scenarios",
    description,
    items: stories.map((story) => ({
      name: story.title,
      url: resolvePageUrl(siteUrl, story.path),
    })),
  }),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".card-title"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Scenarios"
      title="What an alert looks like when something fails"
      lede="Illustrative walkthroughs, not customer accounts: a heater trips, a vent sticks open, a pan goes wet. Each shows the probe setup, how the alerts play out, and why it matters."
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">Start free</a>
      <a slot="actions" class="btn-secondary" href="/pricing">See plans</a>
    </PageHeader>

    <EditorialPhotoStrip photoIds={storiesHubPhotoIds} />

    <div class="page-grid">
      {
        stories.map((story) => (
          <section class="card">
            <p class="text-sm text-[var(--color-text-muted)] mb-2">Scenario · {story.setting}</p>
            <h2 class="card-title">{story.title}</h2>
            <p class="card-subtitle">{story.description}</p>
            <p class="mb-0">
              <a class="btn-primary" href={story.path}>Read scenario</a>
            </p>
          </section>
        ))
      }
    </div>
  </div>
</Layout>
