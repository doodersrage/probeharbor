---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { fmt, getLocale, localizePath } from "../../i18n";
import { storiesMessages } from "../../i18n/messages/stories";
import { getLocalizedStories } from "../../i18n/content/stories";
import EditorialPhotoStrip from "../../components/EditorialPhotoStrip.astro";
import { storiesHubPhotoIds } from "../../lib/aboutPhotos";
import {
  getBreadcrumbSchema,
  getItemListSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";

const locale = getLocale(Astro);
const m = storiesMessages(locale);
const t = m.hub;
const stories = getLocalizedStories(locale);
const title = t.title;
const description = t.description;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/stories", locale));
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: localizePath("/", locale) },
    { name: m.breadcrumbScenarios, path: localizePath("/stories", locale) },
  ]),
  getItemListSchema({
    pageUrl,
    name: t.itemListName,
    description,
    items: stories.map((story) => ({
      name: story.title,
      url: resolvePageUrl(siteUrl, localizePath(story.path, locale)),
    })),
  }),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".card-title"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">{t.startFree}</a>
      <a slot="actions" class="btn-secondary" href="/pricing">{t.seePlans}</a>
    </PageHeader>

    <EditorialPhotoStrip photoIds={storiesHubPhotoIds} />

    <div class="page-grid">
      {
        stories.map((story) => (
          <section class="card">
            <p class="text-sm text-[var(--color-text-muted)] mb-2">{fmt(m.article.scenarioLabel, { setting: story.setting })}</p>
            <h2 class="card-title">{story.title}</h2>
            <p class="card-subtitle">{story.description}</p>
            <p class="mb-0">
              <a class="btn-secondary" href={story.path}>{t.readScenario}</a>
            </p>
          </section>
        ))
      }
    </div>
  </div>
</Layout>
