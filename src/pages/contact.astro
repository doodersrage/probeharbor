---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { fmt, getLocale, localizePath } from "../i18n";
import { contactMessages } from "../i18n/messages/contact";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

const locale = getLocale(Astro);
const t = contactMessages(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/contact", locale));
const contactFaqs = getLocalizedMarketingFaqs("contact", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.title, path: localizePath("/contact", locale) },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "contact", locale),
].filter(Boolean) as Record<string, unknown>[];

const githubIssues = "https://github.com/doodersrage/probeharbor/issues";
---

<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-secondary" href="/guides">{t.browseGuides}</a>
      <a slot="actions" class="btn-secondary" href={githubIssues} target="_blank" rel="noreferrer">{t.githubIssues}</a>
    </PageHeader>

    <div class="page-grid items-start">
      <div class="page-stack page-stack-tight">
        <section class="card">
          <h2 class="card-title">{t.formTitle}</h2>
          <p class="card-subtitle">{t.formCopy}</p>
          <ul class="grid gap-2 pl-5 leading-relaxed [list-style:disc] mb-0">
            {t.formTopics.map((topic) => <li>{topic}</li>)}
          </ul>
        </section>

        <section class="card">
          <h2 class="card-title">{t.issuesTitle}</h2>
          <p class="card-subtitle mb-0" set:html={fmt(t.issuesHtml, { url: githubIssues })} />
        </section>

        <section class="card">
          <h2 class="card-title">{t.beforeTitle}</h2>
          <p class="card-subtitle mb-0" set:html={t.beforeHtml} />
        </section>
      </div>

      <ContactForm client:visible text={t.form} localSuccessMessage={locale !== "en"} />
    </div>

    <FaqSection faqs={contactFaqs} />
  </div>
</Layout>
