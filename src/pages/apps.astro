---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { BRAND_NAME } from "../lib/brand";
import { COMPANION_APPS_HUB_PATH } from "../lib/companionApps";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale, localizePath } from "../i18n";
import { appsMessages } from "../i18n/messages/apps";
import { getLocalizedCompanionApps } from "../i18n/content/apps";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

const locale = getLocale(Astro);
const t = appsMessages(locale);
const apps = getLocalizedCompanionApps(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath(COMPANION_APPS_HUB_PATH, locale));
const faqs = getLocalizedMarketingFaqs("apps", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbApps, path: localizePath(COMPANION_APPS_HUB_PATH, locale) },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "apps", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={t.description(BRAND_NAME)}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.title}
      lede={t.lede(BRAND_NAME)}
    >
      <a slot="actions" class="btn-primary" href="/android">{t.android}</a>
      <a slot="actions" class="btn-secondary" href="/desktop">{t.desktop}</a>
      <a slot="actions" class="btn-ghost" href="/bay-buddy">Bay Buddy</a>
    </PageHeader>

    <section class="grid gap-4 sm:grid-cols-2">
      {apps.map((app) => (
        <article class="card h-full flex flex-col">
          <h2 class="card-title">{app.name}</h2>
          <p class="text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-2">
            {app.platform}
          </p>
          <p class="text-sm mb-4 flex-1">{app.summary}</p>
          <a class="btn-secondary self-start" href={app.path}>{app.cta}</a>
        </article>
      ))}
    </section>

    <section class="card">
      <h2 class="card-title">{t.hardwareTitle}</h2>
      <p class="mb-0 text-sm" set:html={t.hardwareHtml} />
    </section>

    <FaqSection
      title={t.faqTitle}
      faqs={faqs}
      lede={t.faqLede}
    />
  </div>
</Layout>
