---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { getLocale, LOCALE_META } from "../../i18n";
import { publicShareMessages } from "../../i18n/messages/app/publicShare";

const locale = getLocale(Astro);
const t = publicShareMessages(locale).embed;
const text = t.client;
// English keeps toFixed(1), as before.
const intl = locale === "en" ? null : LOCALE_META[locale].intl;

const token = Astro.params.token;
if (!token) {
  return Astro.redirect("/");
}
---
<Layout title={t.title} description={t.description} noindex>
  <div class="page-shell" style="max-width:420px;margin:0 auto;padding:1rem">
    <div id="embed-root" class="card">
      <p class="card-subtitle mb-2">{t.loading}</p>
    </div>
    <p class="text-center text-sm mt-2 mb-0">
      <a class="text-link" href={`/share/${token}`} target="_blank" rel="noreferrer">{t.openFull}</a>
    </p>
  </div>
</Layout>

<style is:global>
  html, body { background: #07111a; margin: 0; }
</style>

<script define:vars={{ token, text, intl }}>
  const root = document.getElementById("embed-root");
  const url = `/api/share/${encodeURIComponent(token)}/readings`;

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function num(value) {
    return intl
      ? value.toLocaleString(intl, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
      : value.toFixed(1);
  }

  function formatReading(r) {
    if (typeof r.tempf === "number" && Number.isFinite(r.tempf)) {
      return `${num(r.tempf)}°F`;
    }
    if (typeof r.value_num === "number" && Number.isFinite(r.value_num)) {
      return `${num(r.value_num)}${r.unit ? ` ${r.unit}` : ""}`;
    }
    if (r.value_bool != null) return r.value_bool ? text.open : text.closed;
    if (r.value_text) return String(r.value_text);
    if (r.value != null) return String(r.value);
    return "—";
  }

  async function render() {
    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error("Unavailable");
      const data = await res.json();
      const readings = data.readings ?? [];
      if (readings.length === 0) {
        root.innerHTML = `<p class="mb-0">${escapeHtml(text.empty)}</p>`;
        return;
      }
      root.innerHTML =
        `<h2 class="card-title" style="font-size:1.1rem">${escapeHtml(text.heading)}</h2>` +
        readings
          .slice(0, 8)
          .map((r) => {
            const label = escapeHtml(r.label ?? r.sensor ?? text.sensor);
            const value = escapeHtml(formatReading(r));
            return (
              `<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--color-border)">` +
              `<span>${label}</span>` +
              `<strong>${value}</strong></div>`
            );
          })
          .join("");
    } catch {
      root.innerHTML = `<p class="mb-0 text-[var(--color-text-muted)]">${escapeHtml(text.error)}</p>`;
    }
  }

  render();
  setInterval(render, 90000);
</script>
