---
export const prerender = false;

import {
  describeFreezeNight,
  HIGH_RISK_LOW_F,
  WINDY_MPH,
  type FreezeNight,
  type FreezeRisk,
} from "../../lib/pipeFreezeForecast";
import { formatTemp, formatWind, type TempUnit } from "../../lib/tempUnits";
import { fmt, getLocale, LOCALE_META } from "../../i18n";
import { publicShareMessages } from "../../i18n/messages/app/publicShare";
import { freezePipeForecastMessages } from "../../i18n/messages/freezePipeForecast";
import { fetchPipeFreezeForecast, parseCoordinates } from "../../lib/pipeFreezeForecastFetch";

/**
 * Embeddable pipe freeze outlook for other sites (plumbers, property
 * managers, HOAs): /embed/pipe-freeze?lat=..&lon=..&place=..
 * Server-rendered, no client JS; snippet lives on /pipe-freeze-forecast.
 */
const locale = getLocale(Astro);
const t = publicShareMessages(locale).pipeFreeze;
const tool = freezePipeForecastMessages(locale).tool;
const coords = parseCoordinates(Astro.url.searchParams.get("lat"), Astro.url.searchParams.get("lon"));
const place = Astro.url.searchParams.get("place")?.slice(0, 80) ?? null;
// ?unit=c for sites whose readers use Celsius; everything else is °F.
const unit: TempUnit = Astro.url.searchParams.get("unit")?.toLowerCase() === "c" ? "C" : "F";
const result = coords ? await fetchPipeFreezeForecast(coords.lat, coords.lon, 3) : null;
const forecast = result?.ok ? result.body : null;
const label =
  place || [forecast?.location.city, forecast?.location.state].filter(Boolean).join(", ") || t.thisArea;
const toolUrl = new URL("/pipe-freeze-forecast", Astro.url.origin);
if (unit === "C") toolUrl.searchParams.set("unit", "c");
if (coords) {
  toolUrl.searchParams.set("lat", coords.lat.toFixed(3));
  toolUrl.searchParams.set("lon", coords.lon.toFixed(3));
  if (place) toolUrl.searchParams.set("place", place);
}
// Same page, opened at the email signup for this place.
const alertsUrl = new URL(toolUrl);
if (coords) alertsUrl.searchParams.set("signup", "1");

const RISK_LABEL: Record<FreezeRisk, string> = { high: tool.riskHigh, watch: tool.riskWatch, low: tool.riskLow };
const nightName = (date: string, index: number) =>
  index === 0
    ? tool.tonight
    : new Date(`${date}T12:00:00`).toLocaleDateString(LOCALE_META[locale].intl, { weekday: "long" });
/** `describeFreezeNight` (English) from the forecast tool's translated templates. */
function describeNight(night: FreezeNight): string {
  if (locale === "en") return describeFreezeNight(night, unit);
  const low = formatTemp(night.lowF, unit);
  const parts: string[] = [];
  if (night.risk === "high") parts.push(fmt(tool.describeHigh, { low, mark: formatTemp(HIGH_RISK_LOW_F, unit) }));
  else if (night.risk === "watch") {
    const template = night.hoursAtOrBelow32 === 1 ? tool.describeWatchOne : tool.describeWatchMany;
    parts.push(fmt(template, { hours: night.hoursAtOrBelow32, low }));
  } else parts.push(fmt(tool.describeAbove, { low }));
  if (night.maxFreezingWindMph != null && night.maxFreezingWindMph >= WINDY_MPH) {
    parts.push(fmt(tool.describeWind, { wind: formatWind(night.maxFreezingWindMph, unit) }));
  }
  if (night.staysBelowFreezingNextDay) parts.push(tool.describeNextDay);
  return parts.join(" ");
}
const heading = fmt(t.heading, { place: label });
Astro.response.headers.set("Cache-Control", "public, max-age=900");
// The language follows the visitor's cookie / Accept-Language.
Astro.response.headers.set("Vary", "Accept-Language, Cookie");
---
<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{heading}</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        --bg: #ffffff; --text: #0b2433; --muted: #4a6070; --border: #d3e3ec; --card: #f3f8fb;
        --high: #c94a45; --watch: #a16207; --low: #3d8b62; --link: #08708a;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #07111a; --text: #e3edf3; --muted: #8aa0af; --border: #1e3a4d; --card: #0f1f2c;
          --high: #f87171; --watch: #fbbf24; --low: #22c55e; --link: #22b8d4;
        }
      }
      body { margin: 0; padding: 12px; background: var(--bg); color: var(--text); }
      h1 { font-size: 1rem; margin: 0 0 2px; }
      .sub { font-size: 0.75rem; color: var(--muted); margin: 0 0 10px; }
      .alerts { margin: 10px 0 0; font-size: 14px; font-weight: 600; }
      .alerts a { color: var(--link); }
      .nights { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
      .night { background: var(--card); border: 1px solid var(--border); border-left: 4px solid var(--low); border-radius: 8px; padding: 8px 10px; }
      .night.high { border-left-color: var(--high); }
      .night.watch { border-left-color: var(--watch); }
      .row { display: flex; justify-content: space-between; gap: 6px; font-size: 0.8rem; font-weight: 600; }
      .risk { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; }
      .high .risk { color: var(--high); } .watch .risk { color: var(--watch); } .low .risk { color: var(--low); }
      .low-temp { font-size: 1.4rem; font-weight: 700; margin: 4px 0 2px; font-variant-numeric: tabular-nums; }
      .detail { font-size: 0.72rem; color: var(--muted); margin: 0; }
      .credit { font-size: 0.72rem; color: var(--muted); margin: 10px 0 0; }
      a { color: var(--link); }
    </style>
  </head>
  <body>
    <h1>{heading}</h1>
    {forecast ? (
      <>
        <p class="sub">{t.source}</p>
        <div class="nights">
          {forecast.nights.map((night, index) => (
            <div class={`night ${night.risk}`} title={describeNight(night)}>
              <div class="row">
                <span>{nightName(night.date, index)}</span>
                <span class="risk">{RISK_LABEL[night.risk]}</span>
              </div>
              <p class="low-temp">{formatTemp(night.lowF, unit)}</p>
              <p class="detail">{fmt(t.hours, { hours: night.hoursAtOrBelow32, temp: formatTemp(32, unit) })}</p>
            </div>
          ))}
        </div>
      </>
    ) : (
      <p class="sub">
        {!coords
          ? t.needCoords
          : result && !result.ok && result.error === "us_only"
            ? t.usOnly
            : t.unavailable}
      </p>
    )}
    {coords && (
      <p class="alerts">
        <a href={alertsUrl.toString()} target="_blank" rel="noopener">{fmt(t.alerts, { place: label })}</a>
      </p>
    )}
    <p class="credit">
      <a href={toolUrl.toString()} target="_blank" rel="noopener">{t.fullForecast}</a>
      {" "}{t.by} <a href="https://probeharbor.dev/" target="_blank" rel="noopener">ProbeHarbor</a>
    </p>
  </body>
</html>
