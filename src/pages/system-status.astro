---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { fetchAppStatus } from "../lib/appStatus";
import {
  getBreadcrumbSchema,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { fmt, getLocale, localizePath, plural } from "../i18n";
import {
  formatLocalizedAge,
  formatStatusDateTime,
  systemStatusMessages,
} from "../i18n/messages/systemStatus";

const locale = getLocale(Astro);
const t = systemStatusMessages(locale);
const status = await fetchAppStatus();
const cronAge = { label: formatLocalizedAge(status.lastCronAt, locale) };
const historyPollAge = { label: formatLocalizedAge(status.lastHistoryPollAt, locale) };
const jobStatusLabel = (value: string) => t.jobStatus[value] ?? value;
const checkedAtLabel = formatStatusDateTime(status.checkedAt, locale);

const bannerTone = !status.healthy
  ? "danger"
  : status.ingestRateLimitElevated
    ? "warning"
    : "success";
const bannerTitle = !status.healthy
  ? t.banner.degraded
  : status.ingestRateLimitElevated
    ? t.banner.elevated
    : t.banner.operational;
const bannerDetail = !status.healthy
  ? [
      status.historyPollStale ? t.banner.pollOverdue : null,
      status.recentJobErrors > 0 ? plural(t.banner.jobErrors, status.recentJobErrors, locale) : null,
      status.lastCronStatus === "error" ? t.banner.latestFailed : null,
      !status.lastCronAt ? t.banner.noCron : null,
    ]
      .filter(Boolean)
      .join(" ")
  : t.banner.healthyDetail;

const siteUrl = resolveSiteUrl(Astro.site);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.title, path: localizePath("/system-status", locale) },
  ]),
];

const subscribed = Astro.url.searchParams.get("subscribed") === "1";
const confirmed = Astro.url.searchParams.get("confirmed") === "1";
const unsubscribed = Astro.url.searchParams.get("unsubscribed") === "1";
const statusError = Astro.url.searchParams.get("status_error");
const statusErrorMessage = statusError ? (t.notify.errors[statusError] ?? null) : null;
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.title}
      lede={t.lede}
    />

    <section class="card" aria-live="polite">
      <p
        class:list={[
          "text-lg font-semibold mb-2",
          bannerTone === "success" && "text-[var(--color-success-text)]",
          bannerTone === "warning" && "text-[var(--color-warning-text)]",
          bannerTone === "danger" && "text-[var(--color-danger)]",
        ]}
      >
        {bannerTitle}
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mb-4">{bannerDetail}</p>
      <dl class="text-sm space-y-2 mb-0">
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">{t.stats.lastPoll}</dt>
          <dd class:list={[status.historyPollStale && "text-[var(--color-danger)]"]}>
            {historyPollAge.label}
            {status.historyPollStale ? t.stats.overdue : ""}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">{t.stats.pollSchedule}</dt>
          <dd>{t.stats.pollScheduleValue}</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">{t.stats.lastCronJob}</dt>
          <dd>{status.lastCronJob ?? "—"} ({cronAge.label})</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">{t.stats.lastJobStatus}</dt>
          <dd
            class:list={[
              status.lastCronStatus === "error" && "text-[var(--color-danger)]",
              status.lastCronStatus === "success" && "text-[var(--color-success-text)]",
            ]}
          >
            {status.lastCronStatus ? jobStatusLabel(status.lastCronStatus) : "—"}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">{t.stats.jobErrors}</dt>
          <dd class:list={[status.recentJobErrors > 0 && "text-[var(--color-danger)]"]}>
            {status.recentJobErrors}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">{t.stats.rateLimitEvents}</dt>
          <dd class:list={[status.ingestRateLimitElevated && "text-[var(--color-warning-text)]"]}>
            {status.ingestAbuseCount}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">{t.stats.checkedAt}</dt>
          <dd>{checkedAtLabel}</dd>
        </div>
      </dl>
    </section>

    <section class="card">
      <h2 class="card-title">{t.incidents.title}</h2>
      <p class="card-subtitle mb-4">{t.incidents.lede}</p>
      {status.healthy ? (
        <p class="mb-0 text-sm">{t.incidents.none}</p>
      ) : (
        <div class="alert-warning mt-0 mb-0" role="status">
          <p class="m-0 font-semibold">{t.incidents.open}</p>
          <p class="m-0 text-sm mt-1">{bannerDetail}</p>
          <p class="m-0 text-sm mt-2 text-[var(--color-text-muted)]">{fmt(t.incidents.started, { when: checkedAtLabel })}</p>
        </div>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">{t.runs.title}</h2>
      <p class="card-subtitle mb-4">{t.runs.lede}</p>
      {status.recentJobRuns.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.runs.empty}</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">{t.runs.started}</th>
                <th class="py-2 pr-3">{t.runs.job}</th>
                <th class="py-2">{t.runs.status}</th>
              </tr>
            </thead>
            <tbody>
              {status.recentJobRuns.map((run) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-2 pr-3 whitespace-nowrap">{formatStatusDateTime(run.started_at, locale)}</td>
                  <td class="py-2 pr-3 font-mono text-xs">{run.job_name}</td>
                  <td class="py-2">
                    <span class:list={[run.status === "success" && "text-[var(--color-success)]", run.status === "error" && "text-[var(--color-danger)]"]}>
                      {jobStatusLabel(run.status)}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">{t.monitor.title}</h2>
      <ul class="text-sm space-y-2 mb-0">
        {t.monitor.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.hosting.title}</h2>
      <p class="mb-3 text-sm" set:html={t.hosting.bodyHtml} />
      <ul class="text-sm space-y-2 mb-0">
        <li>
          {t.hosting.stackNotes}
          <a class="text-link" href="/about/astro-applications">{t.hosting.astro}</a>
          ·
          <a class="text-link" href="/about/cloudflare-workers-deployment">{t.hosting.workers}</a>
        </li>
        <li>
          {t.hosting.cloudflareIncidents}
          <a class="text-link" href="https://www.cloudflarestatus.com/" target="_blank" rel="noreferrer">cloudflarestatus.com</a>
        </li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.notify.title}</h2>
      <p class="card-subtitle mb-4">{t.notify.lede}</p>
      {subscribed && (
        <div class="alert-success mt-0" role="status">
          <p class="m-0">{t.notify.subscribed}</p>
        </div>
      )}
      {confirmed && (
        <div class="alert-success mt-0" role="status">
          <p class="m-0">{t.notify.confirmed}</p>
        </div>
      )}
      {unsubscribed && (
        <div class="alert-success mt-0" role="status">
          <p class="m-0">{t.notify.unsubscribed}</p>
        </div>
      )}
      {statusErrorMessage && (
        <div class="alert-warning mt-0" role="alert">
          <p class="m-0">{statusErrorMessage}</p>
        </div>
      )}
      {!subscribed && !confirmed && (
        <form action="/api/status/subscribe" method="post" class="mt-4">
          <input type="hidden" name="locale" value={locale} />
          {/* Honeypot: visually hidden; bots that fill "company" are rejected server-side. */}
          <div class="sr-only" aria-hidden="true">
            <label for="status-subscribe-company">{t.notify.company}</label>
            <input type="text" id="status-subscribe-company" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-field">
            <label class="form-label" for="status-subscribe-email">{t.notify.email}</label>
            <input class="form-input" type="email" name="email" id="status-subscribe-email" required />
          </div>
          <div class="form-field">
            <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
          </div>
          <button class="btn-primary" type="submit">{t.notify.submit}</button>
        </form>
      )}
    </section>
  </div>
</Layout>
