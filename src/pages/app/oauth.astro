---
import Layout from "../../layouts/Layout.astro";
import {
  buildMobileOAuthCustomUrl,
  buildMobileOAuthIntentUrl,
} from "../../lib/mobileAuthRedirect";
import { resolveAndroidAppId } from "../../lib/mobileAuthExchange";
import {
  buildBayBuddyOAuthCustomUrl,
  buildDesktopOAuthCustomUrl,
  buildLoopbackOAuthUrl,
  consumeCompanionLoopbackCookie,
  getCompanionClientCookie,
  type CompanionClient,
} from "../../lib/companionAuth";
import { getLocale } from "../../i18n";
import { authHandoffMessages } from "../../i18n/messages/app/auth/handoff";

const exchange = Astro.url.searchParams.get("exchange")?.trim() ?? "";
const client = (Astro.url.searchParams.get("client")?.trim().toLowerCase() ||
  getCompanionClientCookie(Astro.cookies) ||
  "android") as CompanionClient;
const isBayBuddy = client === "baybuddy";
const isDesktop = client === "desktop";
const androidAppId = resolveAndroidAppId(Astro.url.searchParams.get("app"));

const loopback = exchange ? consumeCompanionLoopbackCookie(Astro.cookies) : null;
if (exchange && loopback) {
  return Astro.redirect(buildLoopbackOAuthUrl(loopback, exchange));
}

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const intentUrl =
  exchange && !isBayBuddy && !isDesktop ? buildMobileOAuthIntentUrl(exchange, androidAppId) : "";
const customUrl = exchange
  ? isBayBuddy
    ? buildBayBuddyOAuthCustomUrl(exchange)
    : isDesktop
      ? buildDesktopOAuthCustomUrl(exchange)
      : buildMobileOAuthCustomUrl(exchange, androidAppId)
  : "";
const openHref = intentUrl || customUrl;

const handoffText = authHandoffMessages(getLocale(Astro)).appOAuth;
const clientText = isBayBuddy
  ? handoffText.baybuddy
  : isDesktop
    ? handoffText.desktop
    : handoffText.android;
const title = clientText.title;
const description = clientText.description;
const openLabel = clientText.open;
const handoffHint = ` ${clientText.handoff}`;
const closeHint = clientText.close;
const missingHint = clientText.missing;
---
<Layout
  title={title}
  description={description}
  noindex
  skipAuth
  referrerPolicy="no-referrer"
>
  <article class="card max-w-lg mx-auto my-8">
    {
      exchange ? (
        <>
          <h1 class="card-title">{openLabel}</h1>
          <p class="card-subtitle">
            {handoffText.signInFinished}
            {handoffHint}
          </p>
          <p class="mt-4 mb-2">
            <a class="btn-primary" id="open-app" href={openHref}>
              {openLabel}
            </a>
          </p>
          <p class="text-sm text-[var(--color-text-muted)] mb-0">
            {closeHint}
          </p>
          <script is:inline define:vars={{ intentUrl, customUrl }}>
            (() => {
              const go = () => {
                if (intentUrl) {
                  window.location.href = intentUrl;
                  setTimeout(() => {
                    if (customUrl) window.location.href = customUrl;
                  }, 900);
                  return;
                }
                if (customUrl) window.location.href = customUrl;
              };
              setTimeout(go, 250);
              document.getElementById("open-app")?.addEventListener("click", (event) => {
                event.preventDefault();
                go();
              });
            })();
          </script>
        </>
      ) : (
        <>
          <h1 class="card-title">{handoffText.missingTitle}</h1>
          <p class="card-subtitle mb-0">
            {missingHint}
          </p>
        </>
      )
    }
  </article>
</Layout>
