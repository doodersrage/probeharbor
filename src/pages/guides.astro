---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import EditorialPhotoStrip from "../components/EditorialPhotoStrip.astro";
import FaqSection from "../components/FaqSection.astro";
import { guidesHubPhotos } from "../lib/aboutPhotos";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  getItemListSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale, localizePath } from "../i18n";
import { guidesMessages } from "../i18n/messages/guides";
import {
  getLocalizedGuideHubCategories,
  getLocalizedGuideHubCategoryTitle,
} from "../i18n/content/guideHub";

const locale = getLocale(Astro);
const t = guidesMessages(locale);
const categories = getLocalizedGuideHubCategories(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/guides", locale));
const guidesFaqs = t.faqs;
const alsoUsefulHrefs = ["/stories", "/compare", "/integrations", "/accessories", "/gift"];
const alsoUseful = alsoUsefulHrefs.map((href) => ({ href, ...t.alsoUseful[href] }));
const guideListItems =categories.flatMap((category) =>
  category.links.map((link) => ({
    name: link.label,
    url: resolvePageUrl(siteUrl, link.href),
  })),
);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbPage, path: localizePath("/guides", locale) },
  ]),
  getFaqPageSchema(pageUrl, guidesFaqs),
  getItemListSchema({
    pageUrl,
    name: t.itemListName,
    description: t.itemListDescription,
    items: guideListItems,
  }),
].filter(Boolean) as Record<string, unknown>[];

const stripPhotoIds = guidesHubPhotos.map((p) => p.id);
const stripLabels = guidesHubPhotos.map((p) => t.photoLabels[p.id] ?? p.label);
const stripHrefs = guidesHubPhotos.map((p) => p.href);
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.headerTitle}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">{t.startFree}</a>
      <a slot="actions" class="btn-secondary" href="/about">{t.allArticles}</a>
      <a slot="actions" class="btn-ghost" href="/about/esp32-freeze-kit">{t.esp32Kit}</a>
    </PageHeader>

    <EditorialPhotoStrip
      photoIds={stripPhotoIds}
      labels={stripLabels}
      hrefs={stripHrefs}
    />

    <div class="guide-hub-grid">
      {categories.map((category) => (
        <section class="card guide-hub-category" id={category.id} aria-labelledby={`guide-${category.id}`}>
          <h2 class="card-title" id={`guide-${category.id}`}>{category.title}</h2>
          <p class="card-subtitle mb-4">{category.description}</p>
          <ul class="guide-hub-list">
            {category.links.map((link) => (
              <li>
                <a class="guide-hub-link" href={link.href}>
                  <span class="guide-hub-link-title">{link.label}</span>
                  <span class="guide-hub-link-summary">{link.summary}</span>
                </a>
                {link.alsoIn && link.alsoIn.length > 0 && (
                  <p class="guide-hub-also">
                    {t.alsoRelevant}{" "}
                    {link.alsoIn.map((id, i) => (
                      <span>
                        {i > 0 ? ", " : ""}
                        <a class="text-link" href={`/guides#${id}`}>{getLocalizedGuideHubCategoryTitle(id, locale)}</a>
                      </span>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <section class="card">
      <h2 class="card-title">{t.alsoUsefulTitle}</h2>
      <p class="card-subtitle mb-4">
        {t.alsoUsefulSubtitle}
      </p>
      <ul class="guide-hub-list guide-hub-list--grid">
        {alsoUseful.map((link) => (
          <li>
            <a class="guide-hub-link" href={link.href}>
              <span class="guide-hub-link-title">{link.label}</span>
              <span class="guide-hub-link-summary">{link.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <FaqSection
      faqs={guidesFaqs}
      lede={t.faqLede}
    />
  </div>
</Layout>
