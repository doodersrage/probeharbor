---
import Layout from "../../layouts/Layout.astro";
import MfaSignInChallenge from "../../components/MfaSignInChallenge";
import { getAuthFromCookies } from "../../lib/auth";
import { setMfaRequiredCookie } from "../../lib/mfa";
import { sanitizeNextPath } from "../../lib/siteUrl";
import { getLocale } from "../../i18n";
import { authSigninMessages } from "../../i18n/messages/app/auth/signin";
import { hasTwoFactorChallenge } from "../../lib/betterAuthMfa";
import { betterAuthNeedsStepUp } from "../../lib/betterAuthMfaGate";
import { hasValidMfaStepUpProof } from "../../lib/mfaStepUpProof";

const t = authSigninMessages(getLocale(Astro)).mfa;

// After the password or OAuth step there is only Better Auth's two-factor
// cookie, no session yet; the code is checked by /api/auth/mfa-verify.
const pendingTotp = hasTwoFactorChallenge(Astro.cookies);
const { session, user } = pendingTotp ? { session: null, user: null } : await getAuthFromCookies(Astro.cookies);

if (!pendingTotp && (!session || !user)) {
  return Astro.redirect("/signin");
}

const needsStepUp =
  pendingTotp ||
  (await betterAuthNeedsStepUp(user, (id) => hasValidMfaStepUpProof(Astro.request, Astro.cookies, id)));

if (!needsStepUp) {
  setMfaRequiredCookie(Astro.cookies, false);
  const next = sanitizeNextPath(Astro.url.searchParams.get("next")) ?? "/dashboard";
  return Astro.redirect(next);
}

setMfaRequiredCookie(Astro.cookies, true);

const errorCode = Astro.url.searchParams.get("error");
const mfaErrors = t.errors;
const errorMessage =
  errorCode && Object.hasOwn(mfaErrors, errorCode)
    ? mfaErrors[errorCode as keyof typeof mfaErrors]
    : null;

const safeNext =
  sanitizeNextPath(Astro.url.searchParams.get("next")) ?? "/dashboard";
---
<Layout
  title={t.title}
  description={t.description}
  noindex
>
  <div class="auth-page">
    <MfaSignInChallenge
      client:load
      safeNext={safeNext}
      userEmail={user?.email ?? t.yourAccount}
      initialError={errorMessage}
      text={t.challenge}
    />
  </div>
</Layout>
