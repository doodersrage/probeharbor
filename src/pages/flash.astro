---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import BrowserFlasher from "../components/BrowserFlasher.astro";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getAuthFromCookies } from "../lib/auth";
import { BOM } from "../lib/bomLinks";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { getLocale, localizePath } from "../i18n";
import { flashMessages } from "../i18n/messages/flash";
import { aboutMediaMessages } from "../i18n/messages/aboutMedia";

const { user } = await getAuthFromCookies(Astro.cookies);

const locale = getLocale(Astro);
const t = flashMessages(locale);
const title = t.title;
const description = t.description;
const faqs = t.faqs;

const buyGroups = [
  {
    label: t.buy.board,
    items: [
      { name: "ESP32 DevKit", href: BOM.amazonEsp32DevKit, vendor: "Amazon" },
      { name: "HUZZAH32 Feather", href: BOM.adafruitHuzzah32, vendor: "Adafruit" },
      { name: "ESP32 Feather V2", href: BOM.adafruitEsp32FeatherV2, vendor: "Adafruit" },
    ],
  },
  {
    label: t.buy.s3c3,
    items: [
      { name: "ESP32-S3-DevKitC-1", href: BOM.adafruitEsp32S3DevKitC, vendor: "Adafruit" },
      { name: "ESP32-C3-DevKitM-1", href: BOM.adafruitEsp32C3DevKitM, vendor: "Adafruit" },
    ],
  },
  {
    label: t.buy.sensor,
    items: [
      { name: t.buy.ds18b20, href: BOM.adafruitDs18b20, vendor: "Adafruit" },
      { name: t.buy.resistor4k7, href: BOM.amazonResistor4k7, vendor: "Amazon" },
    ],
  },
  {
    label: t.buy.i2c,
    items: [
      { name: "SHT31-D", href: BOM.adafruitSht31, vendor: "Adafruit" },
      { name: t.buy.bme280, href: BOM.adafruitBme280, vendor: "Adafruit" },
      { name: "AHT20", href: BOM.adafruitAht20, vendor: "Adafruit" },
    ],
  },
  {
    label: t.buy.extras,
    items: [
      { name: t.buy.reed, href: BOM.adafruitReed, vendor: "Adafruit" },
      { name: t.buy.resistor100k, href: BOM.adafruitResistor100k, vendor: "Adafruit" },
    ],
  },
];

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/flash", locale));
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbFlash, path: localizePath("/flash", locale) },
  ]),
  getFaqPageSchema(pageUrl, faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a
        slot="actions"
        class="btn-primary"
        href={user ? "/dashboard/devices" : "/register?next=/dashboard/devices"}
      >{user ? t.getKey : t.startFreeGetKey}</a>
      <a slot="actions" class="btn-secondary" href="/about/esp32-freeze-kit">{t.partsAndWiring}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.beforeTitle}</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
        <li set:html={t.wireHtml} />
        <li>
          {t.extrasIntro}
          <div class="table-wrap mt-2">
            <table class="data-table text-sm">
              <thead>
                <tr><th scope="col">{t.pinTable.connect}</th><th scope="col">ESP32</th><th scope="col">ESP32-S3</th><th scope="col">ESP32-C3</th></tr>
              </thead>
              <tbody>
                <tr><td>{t.pinTable.data}</td><td>GPIO 4</td><td>GPIO 4</td><td>GPIO 4</td></tr>
                <tr><td>{t.pinTable.i2c}</td><td>21 / 22</td><td>8 / 9</td><td>6 / 7</td></tr>
                <tr><td>{t.pinTable.leak}</td><td>GPIO 27</td><td>GPIO 5</td><td>GPIO 5</td></tr>
                <tr><td>{t.pinTable.door}</td><td>GPIO 26</td><td>GPIO 6</td><td>GPIO 10</td></tr>
                <tr><td>{t.pinTable.battery}</td><td>GPIO 35</td><td>GPIO 7</td><td>GPIO 3</td></tr>
              </tbody>
            </table>
          </div>
          {t.i2cNote}
          <p class="mt-2 mb-0" id="feather-pins" set:html={t.featherHtml} />
        </li>
        <li set:html={t.deviceKeyHtml} />
      </ol>
    </section>

    <section class="card" id="what-to-buy">
      <h2 class="card-title">{t.buyTitle}</h2>
      <p class="text-sm">{t.buyIntro}</p>
      <dl class="text-sm space-y-3 mb-3">
        {buyGroups.map((group) => (
          <div>
            <dt class="font-semibold">{group.label}</dt>
            <dd class="m-0">
              {group.items.map((item, i) => (
                <>
                  {i > 0 && " · "}
                  <a class="text-link" href={item.href} target="_blank" rel={commerceLinkRel(item.href)}>{item.name}</a>
                  <span class="text-[var(--color-text-muted)]"> ({item.vendor})</span>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
      <p class="text-sm" set:html={t.leakHtml} />
      <p class="text-xs text-[var(--color-text-muted)] mb-0">{aboutMediaMessages(locale).affiliateDisclosure}</p>
    </section>

    <BrowserFlasher />

    <section class="card">
      <h2 class="card-title">{t.afterTitle}</h2>
      <p class="mb-0" set:html={t.afterHtml} />
    </section>

    <FaqSection faqs={faqs} />
  </div>
</Layout>
