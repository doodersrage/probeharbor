---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import BrowserFlasher from "../components/BrowserFlasher.astro";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getAuthFromCookies } from "../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);

const title = "Flash an ESP32 freeze sensor from your browser";
const description =
  "Turn an ESP32 and a DS18B20 probe into a freeze sensor without installing an IDE: flash from the browser, enter Wi-Fi and a device key, done.";

const faqs = [
  {
    question: "What do I need?",
    answer:
      "An ESP32, ESP32-S3, or ESP32-C3 board, a waterproof DS18B20 probe or a DHT22 (or DHT11) temperature and humidity sensor with a 4.7kΩ pull-up resistor on GPIO 4, a USB data cable, and Chrome or Edge on a desktop or laptop.",
  },
  {
    question: "Do I need the Arduino IDE?",
    answer:
      "No. The firmware is prebuilt and installed by the browser. Wi-Fi and your device key are sent to the board after flashing, so nothing has to be compiled.",
  },
  {
    question: "Can I add more than one probe?",
    answer:
      "Yes, up to four DS18B20 probes on the same pin. They report as temp1 to temp4 and can be renamed in the dashboard. A DHT22 is one sensor per board.",
  },
  {
    question: "What else can I connect?",
    answer:
      "An I²C temperature and humidity sensor (BME280, SHT31, or AHT20, found automatically; a BME280 also reports air pressure), a leak or water contact for flood alerts, a magnetic door switch, and a battery through a 1:1 resistor divider for battery-life estimates. Tick the leak, door, and battery options when you send settings so the board knows they're wired.",
  },
  {
    question: "Does it work with a DHT22?",
    answer:
      "Yes. Wire it the same way (data to GPIO 4, 4.7kΩ to 3.3V). The firmware looks for DS18B20 probes first and, if there are none, reads a DHT22 or DHT11 on that pin, reporting temperature and humidity. A DS18B20 is the better choice against a pipe; a DHT22 suits room air and humidity in a crawlspace or basement.",
  },
  {
    question: "How do I move the board to another network?",
    answer:
      "Hold the BOOT button for five seconds to erase the saved Wi-Fi and device key, then send new settings from this page or through the ProbeHarbor-Setup network.",
  },
  {
    question: "Is the firmware open source?",
    answer:
      "Yes. The source is in the ProbeHarbor repository under firmware/probeharbor-probe, alongside sketches you can edit and flash yourself.",
  },
];

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/flash");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Browser flasher", path: "/flash" },
  ]),
  getFaqPageSchema(pageUrl, faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Setup · Beta"
      title="Flash a freeze sensor from your browser"
      lede="No Arduino IDE, no editing code. Wire a DS18B20 probe or a DHT22 to an ESP32, install the firmware from this page, then send it your Wi‑Fi and device key over the same USB cable."
    >
      <a
        slot="actions"
        class="btn-primary"
        href={user ? "/dashboard/devices" : "/register?next=/dashboard/devices"}
      >{user ? "Get a device key" : "Start free → get a device key"}</a>
      <a slot="actions" class="btn-secondary" href="/about/esp32-freeze-kit">Parts list and wiring</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">Before you start</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
        <li>
          Wire the sensor: power to 3.3V, ground to GND, data to GPIO 4, with a 4.7kΩ resistor between data and 3.3V
          (<a class="text-link" href="/about/esp32-freeze-kit">diagram</a>). That's the same for a DS18B20 probe (red, black,
          yellow wires) and a DHT22; the firmware detects which one is connected.
        </li>
        <li>
          Optional extras, on these pins (each switch or contact goes between the pin and GND):
          <div class="table-wrap mt-2">
            <table class="data-table text-sm">
              <thead>
                <tr><th scope="col">Connect</th><th scope="col">ESP32</th><th scope="col">ESP32-S3</th><th scope="col">ESP32-C3</th></tr>
              </thead>
              <tbody>
                <tr><td>DS18B20 or DHT22 data</td><td>GPIO 4</td><td>GPIO 4</td><td>GPIO 4</td></tr>
                <tr><td>I²C sensor SDA / SCL (BME280, SHT31, AHT20)</td><td>21 / 22</td><td>8 / 9</td><td>6 / 7</td></tr>
                <tr><td>Leak / water contact</td><td>GPIO 27</td><td>GPIO 5</td><td>GPIO 5</td></tr>
                <tr><td>Door reed switch</td><td>GPIO 26</td><td>GPIO 6</td><td>GPIO 10</td></tr>
                <tr><td>Battery + through a 1:1 divider (2 × 100kΩ)</td><td>GPIO 35</td><td>GPIO 7</td><td>GPIO 3</td></tr>
              </tbody>
            </table>
          </div>
          I²C sensors are found automatically; tick leak, door, or battery below so the board knows they're wired.
        </li>
        <li>
          Add a push device under <a class="text-link" href="/dashboard/devices">Dashboard → Devices</a> and copy its
          device key. The free plan includes two devices.
        </li>
      </ol>
    </section>

    <BrowserFlasher />

    <section class="card">
      <h2 class="card-title">After it is live</h2>
      <p class="mb-0">
        Readings arrive once a minute. Mount the probe against the coldest pipe, set a freeze threshold of 34–38°F under
        <a class="text-link" href="/dashboard/alerts">Dashboard → Alerts</a>, and send a test alert. See
        <a class="text-link" href="/answers/crawlspace-freeze-sensor-placement">where to put the sensor</a> and
        <a class="text-link" href="/answers/freeze-alarm-temperature-setting">what temperature to alert at</a>.
        Prefer to edit the code yourself? The <a class="text-link" href="/about/esp32-web-flash">other flashing options</a>
        cover Arduino, PlatformIO, MicroPython, and ESPHome.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </div>
</Layout>
