---

import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { historicalDataMessages } from "../../i18n/messages/about-pages/historical-data";

const locale = getLocale(Astro);
const t = historicalDataMessages(locale);
const page = getLocalizedAboutPage("historical-data", locale)!;
// This slug has no entry in the hero map, so keep the explicit photo.
const hero = getLocalizedAboutPhoto("desk-workspace", locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.whyTitle}</h2>
  <p set:html={t.whyHtml} />

  <h2>{t.storedTitle}</h2>
  <p set:html={t.storedHtml} />

  <h2>{t.browseTitle}</h2>
  <p set:html={t.browseHtml} />

  <h2>{t.csvTitle}</h2>
  <ul>
    {t.csvItems.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.analysisTitle}</h2>
  <p set:html={t.analysisHtml} />

  <h2>{t.yoyTitle}</h2>
  <p set:html={t.yoyHtml} />

  <h2>{t.limitsTitle}</h2>
  <p set:html={t.limitsHtml} />

  <p set:html={t.outroHtml} />
</AboutArticle>
