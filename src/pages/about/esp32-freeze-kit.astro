---

import AboutArticle from "../../components/AboutArticle.astro";
import { fmt, getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { esp32FreezeKitMessages } from "../../i18n/messages/about-pages/esp32-freeze-kit";
import { commerceLinkRel } from "../../lib/affiliateLinks";
import { BOM } from "../../lib/bomLinks";
import {
  getHowToSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";

const locale = getLocale(Astro);
const t = esp32FreezeKitMessages(locale);
const page = getLocalizedAboutPage("esp32-freeze-kit", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, `/about/${page.slug}`);

const ADAFRUIT_DS18B20 = BOM.adafruitDs18b20;
const ADAFRUIT_DS18B20_HIGH_TEMP = BOM.adafruitDs18b20HighTemp;
const ADAFRUIT_ESP32_FEATHER_V2 = BOM.adafruitEsp32FeatherV2;
const ADAFRUIT_HUZZAH32 = BOM.adafruitHuzzah32;
const AMAZON_ESP32 = BOM.amazonEsp32DevKit;
const AMAZON_DS18B20 = BOM.amazonDs18b20;
const AMAZON_RESISTOR = BOM.amazonResistor4k7;

const highTempLinkHtml = `<a class="text-link" href="${ADAFRUIT_DS18B20_HIGH_TEMP}" target="_blank" rel="${commerceLinkRel(ADAFRUIT_DS18B20_HIGH_TEMP)}">Adafruit #642</a>`;

const stepUrls = [
  pageUrl,
  undefined,
  `${siteUrl}/dashboard/devices`,
  `${siteUrl}/flash`,
  `${siteUrl}/dashboard/alerts?tab=settings#alert-section-essentials`,
];

const freezeKitHowTo = getHowToSchema({
  name: t.howTo.name,
  description: page.description,
  pageUrl,
  totalTime: "PT45M",
  steps: t.howTo.steps.map((step, i) => (stepUrls[i] ? { ...step, url: stepUrls[i] } : { ...step })),
});

const relatedLinks = [
  "/about/adding-devices",
  "/about/esp32-web-flash",
  "/about/pico-w-ingest",
  "/about/kit-qr-onboarding",
  "/probe-mount-kit",
  "/accessories",
  "/about/probe-mounting-enclosures",
  "/freeze-season",
].map((href, i) => ({ href, label: t.related.labels[i] }));
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
  commerceDisclosure
  extraSchemas={freezeKitHowTo ? [freezeKitHowTo] : []}
>
  <p set:html={t.introHtml} />

  <h2>{t.bom.title}</h2>
  <div class="overflow-x-auto mb-6">
    <table class="plan-comparison-table">
      <caption class="sr-only">{t.bom.caption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.bom.colPart}</th>
          <th scope="col">{t.bom.colWhy}</th>
          <th scope="col">{t.bom.colBuy}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">{t.bom.boardPart}</th>
          <td>{t.bom.boardWhy}</td>
          <td>
            <a class="text-link" href={ADAFRUIT_ESP32_FEATHER_V2} target="_blank" rel={commerceLinkRel(ADAFRUIT_ESP32_FEATHER_V2)}>Adafruit ESP32 Feather V2</a>
            ·
            <a class="text-link" href={ADAFRUIT_HUZZAH32} target="_blank" rel={commerceLinkRel(ADAFRUIT_HUZZAH32)}>HUZZAH32</a>
            ·
            <a class="text-link" href={AMAZON_ESP32} target="_blank" rel={commerceLinkRel(AMAZON_ESP32)}>{t.bom.amazonDevKit}</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.bom.probePart}</th>
          <td>{t.bom.probeWhy}</td>
          <td>
            <a class="text-link" href={ADAFRUIT_DS18B20} target="_blank" rel={commerceLinkRel(ADAFRUIT_DS18B20)}>Adafruit #381</a>
            <Fragment set:html={t.bom.includesPullupHtml} />
            ·
            <a class="text-link" href={AMAZON_DS18B20} target="_blank" rel={commerceLinkRel(AMAZON_DS18B20)}>{t.bom.amazonProbe}</a>
          </td>
        </tr>
        <tr>
          <th scope="row" set:html={t.bom.pullupPartHtml} />
          <td>{t.bom.pullupWhy}</td>
          <td>
            <a class="text-link" href={AMAZON_RESISTOR} target="_blank" rel={commerceLinkRel(AMAZON_RESISTOR)}>{t.bom.amazonResistor}</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.bom.powerPart}</th>
          <td>{t.bom.powerWhy}</td>
          <td set:html={t.bom.powerBuyHtml} />
        </tr>
      </tbody>
    </table>
  </div>

  <p class="text-sm text-[var(--color-text-muted)]" set:html={t.bomNoteHtml} />

  <h2>{t.wire.title}</h2>
  <figure class="about-figure about-figure-svg card overflow-hidden p-0">
    <img
      src="/about-illustrations/esp32_ds18b20_wiring.svg"
      alt={t.wire.diagramAlt}
      width="680"
      height="400"
      class="h-auto w-full"
      loading="lazy"
      decoding="async"
    />
    <figcaption set:html={t.wire.captionHtml} />
  </figure>
  <ul>
    {t.wire.itemsHtml.map((item) => <li set:html={item} />)}
  </ul>
  <p set:html={t.wire.featherHtml} />
  <p>{t.wire.strap}</p>

  <h2>{t.flash.title}</h2>
  <ol>
    {t.flash.stepsHtml.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.avoid.title}</h2>
  <ul>
    {t.avoid.itemsHtml.map((item) => <li set:html={item} />)}
  </ul>
  <p set:html={fmt(t.avoid.dhtNoteHtml, { highTempLink: highTempLinkHtml })} />

  <h2>{t.extras.title}</h2>
  <ul>
    {t.extras.itemsHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.related.title}</h2>
  <ul>
    {relatedLinks.map((link) => <li><a class="text-link" href={link.href}>{link.label}</a></li>)}
  </ul>
</AboutArticle>
