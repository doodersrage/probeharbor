---
import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { esp32WebFlashMessages } from "../../i18n/messages/about-pages/esp32-web-flash";

const locale = getLocale(Astro);
const t = esp32WebFlashMessages(locale);
const page = getLocalizedAboutPage("esp32-web-flash", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.devicesTitle}</h2>
  <ol>
    <li set:html={t.devicesStep1Html} />
    <li set:html={t.devicesStep2Html} />
    <li set:html={t.devicesStep3Html} />
  </ol>

  <h2>{t.arduinoTitle}</h2>
  <ul>
    <li set:html={t.arduinoItem1Html} />
    <li set:html={t.arduinoItem2Html} />
    <li set:html={t.arduinoItem3Html} />
  </ul>

  <h2>{t.pioTitle}</h2>
  <p set:html={t.pioBodyHtml} />
  <pre><code>{`cd sketches/arduino/ds18b20_ingest
pio run -t upload
pio device monitor`}</code></pre>

  <h2>{t.microTitle}</h2>
  <p set:html={t.microBodyHtml} />

  <h2>{t.esptoolTitle}</h2>
  <p set:html={t.esptoolBodyHtml} />
  <p>
    <a
      class="text-link"
      href="https://espressif.github.io/esptool-js/"
      target="_blank"
      rel="noreferrer"
    >espressif.github.io/esptool-js ↗</a>
  </p>
  <p class="text-sm text-[var(--color-text-muted)]">{t.esptoolNote}</p>

  <h2>{t.portalTitle}</h2>
  <p set:html={t.portalBodyHtml} />

  <h2>{t.relatedTitle}</h2>
  <ul>
    <li><a class="text-link" href="/about/esp32-freeze-kit">{t.related.kit}</a></li>
    <li><a class="text-link" href="/about/pico-w-ingest">{t.related.pico}</a></li>
    <li><a class="text-link" href="/about/stm32-zephyr-ingest">{t.related.stm32}</a></li>
    <li><a class="text-link" href="/about/ch32v-riscv-ingest">{t.related.ch32v}</a></li>
    <li><a class="text-link" href="/about/avr-asm-ingest">{t.related.avr}</a></li>
    <li><a class="text-link" href="/about/adding-devices">{t.related.adding}</a></li>
    <li><a class="text-link" href="/about/esp32-ota-firmware">{t.related.ota}</a></li>
    <li><a class="text-link" href="/about/kit-qr-onboarding">{t.related.qr}</a></li>
    <li>
      <a
        class="text-link"
        href="https://github.com/doodersrage/probeharbor/tree/main/sketches"
        target="_blank"
        rel="noreferrer"
      >{t.related.sketches}</a>
    </li>
  </ul>
</AboutArticle>
