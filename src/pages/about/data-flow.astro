---

import AboutArticle from "../../components/AboutArticle.astro";
import AboutCcFigure from "../../components/AboutCcFigure.astro";
import { Image } from "astro:assets";
import JSONProbe from "../../assets/json-temp.jpg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { dataFlowMessages } from "../../i18n/messages/about-pages/data-flow";

const locale = getLocale(Astro);
const t = dataFlowMessages(locale);
const page = getLocalizedAboutPage("data-flow", locale)!;
// This slug has no entry in the hero map, so keep the explicit photo.
const hero = getLocalizedAboutPhoto("ethernet-cable", locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.step1Title}</h2>
  <p set:html={t.step1Html} />

  <AboutCcFigure photoId="arduino-dht11" />

  <h2>{t.step2Title}</h2>
  <p set:html={t.step2Html} />

  <figure class="about-figure">
    <Image
      src={JSONProbe}
      alt={t.jsonAlt}
      widths={[480, 768, 1024]}
      sizes="(max-width: 768px) 100vw, 640px"
      class="w-full h-auto rounded-lg"
    />
    <figcaption>{t.jsonCaption}</figcaption>
  </figure>

  <h2>{t.step3Title}</h2>
  <p set:html={t.step3Html} />

  <h2>{t.step4Title}</h2>
  <p set:html={t.step4Html} />

  <h2>{t.step5Title}</h2>
  <p set:html={t.step5Html} />

  <h2>{t.failuresTitle}</h2>
  <ol>
    {t.failures.map((item) => <li set:html={item} />)}
  </ol>
</AboutArticle>
