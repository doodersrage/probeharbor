---
import AboutArticle from "../../components/AboutArticle.astro";
import { affiliateHref, commerceLinkRel } from "../../lib/affiliateLinks";
import { BOM } from "../../lib/bomLinks";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { cellularIngestMessages } from "../../i18n/messages/about-pages/cellular-ingest";

const locale = getLocale(Astro);
const t = cellularIngestMessages(locale);
const page = getLocalizedAboutPage("cellular-ingest", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);

const PARTICLE_BORON = affiliateHref("https://www.particle.io/wifi/#boron");
const ADAFRUIT_DS18B20 = BOM.adafruitDs18b20;
const AMAZON_DS18B20 = BOM.amazonDs18b20;
const AMAZON_RESISTOR = BOM.amazonResistor4k7;
const BLUES_NOTECARD = affiliateHref("https://blues.io/products/notecard/");
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
  commerceDisclosure
>
  <p set:html={t.introHtml} />
  <p set:html={t.bluesHtml} />

  <h2>{t.partsTitle}</h2>
  <div class="overflow-x-auto mb-6">
    <table class="plan-comparison-table">
      <caption class="sr-only">{t.partsCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.colPart}</th>
          <th scope="col">{t.colWhy}</th>
          <th scope="col">{t.colBuy}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Particle Boron / B-Series</th>
          <td>{t.boronWhy}</td>
          <td>
            <a class="text-link" href={PARTICLE_BORON} target="_blank" rel={commerceLinkRel(PARTICLE_BORON)}>Particle Boron</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.probePart}</th>
          <td set:html={t.probeWhyHtml} />
          <td>
            <a class="text-link" href={ADAFRUIT_DS18B20} target="_blank" rel={commerceLinkRel(ADAFRUIT_DS18B20)}>Adafruit DS18B20</a>
            ·
            <a class="text-link" href={AMAZON_DS18B20} target="_blank" rel={commerceLinkRel(AMAZON_DS18B20)}>Amazon</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.resistorPart}</th>
          <td>{t.resistorWhy}</td>
          <td>
            <a class="text-link" href={AMAZON_RESISTOR} target="_blank" rel={commerceLinkRel(AMAZON_RESISTOR)}>Amazon 4.7k</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.planPart}</th>
          <td>{t.planWhy}</td>
          <td>{t.planBuy}</td>
        </tr>
        <tr>
          <th scope="row">{t.bluesPart}</th>
          <td>{t.bluesWhy}</td>
          <td>
            <a class="text-link" href={BLUES_NOTECARD} target="_blank" rel={commerceLinkRel(BLUES_NOTECARD)}>Blues Notecard</a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>{t.wiringTitle}</h2>
  <ul>
    {t.wiringHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.flashTitle}</h2>
  <ol>
    {t.stepsHtml.map((item) => <li set:html={item} />)}
  </ol>
  <p>
    {t.repoLead}
    <a
      class="text-link"
      href="https://github.com/doodersrage/probeharbor/tree/main/sketches/particle/boron_ds18b20_ingest"
      target="_blank"
      rel="noreferrer"
    ><code>sketches/particle/boron_ds18b20_ingest/</code></a>
  </p>

  <h2>{t.dropoutsTitle}</h2>
  <p set:html={t.dropoutsHtml} />

  <h2>{t.relatedTitle}</h2>
  <ul>
    <li><a class="text-link" href="/about/adding-devices">{t.related.addingDevices}</a></li>
    <li><a class="text-link" href="/about/debugging-stale-readings">{t.related.stale}</a></li>
    <li><a class="text-link" href="/about/teensy41-ingest">{t.related.teensy}</a></li>
    <li><a class="text-link" href="/about/pic18-ethernet-ingest">{t.related.pic18}</a></li>
    <li>
      <a
        class="text-link"
        href="https://github.com/doodersrage/probeharbor/tree/main/sketches"
        target="_blank"
        rel="noreferrer"
      >{t.related.allSketches}</a>
    </li>
  </ul>
</AboutArticle>
