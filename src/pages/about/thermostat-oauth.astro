---

import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { thermostatOauthMessages } from "../../i18n/messages/about-pages/thermostat-oauth";

const locale = getLocale(Astro);
const t = thermostatOauthMessages(locale);
const page = getLocalizedAboutPage("thermostat-oauth", locale)!;
// This slug has no entry in the hero map, so keep the explicit photo.
const hero = getLocalizedAboutPhoto("ethernet-cable", locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.connectTitle}</h2>
  <p set:html={t.connectHtml} />

  <h2>{t.nestTitle}</h2>
  <p class="text-sm text-[var(--color-text-muted)] mb-3" set:html={t.nestRedirectHtml} />
  <pre class="text-xs mb-4 overflow-x-auto"><code>https://probeharbor.dev/api/integrations/nest/callback</code></pre>
  <ol class="text-sm space-y-2 pl-5 list-decimal">
    {t.nestSteps.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.ecobeeTitle}</h2>
  <p class="text-sm text-[var(--color-text-muted)] mb-3" set:html={t.ecobeeRedirectHtml} />
  <pre class="text-xs mb-4 overflow-x-auto"><code>https://probeharbor.dev/api/integrations/ecobee/callback</code></pre>
  <ol class="text-sm space-y-2 pl-5 list-decimal">
    {t.ecobeeSteps.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.uxTitle}</h2>
  <p set:html={t.uxHtml} />

  <p class="mb-0" set:html={t.seeAlsoHtml} />
</AboutArticle>
