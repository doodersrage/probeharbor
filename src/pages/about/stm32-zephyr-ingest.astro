---
import AboutArticle from "../../components/AboutArticle.astro";
import { affiliateHref, commerceLinkRel } from "../../lib/affiliateLinks";
import { BOM } from "../../lib/bomLinks";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { stm32ZephyrIngestMessages } from "../../i18n/messages/about-pages/stm32-zephyr-ingest";

const locale = getLocale(Astro);
const t = stm32ZephyrIngestMessages(locale);
const page = getLocalizedAboutPage("stm32-zephyr-ingest", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);

const ST_NUCLEO_F767ZI = affiliateHref(
  "https://www.st.com/en/evaluation-tools/nucleo-f767zi.html",
);
const ADAFRUIT_DS18B20 = BOM.adafruitDs18b20;
const AMAZON_DS18B20 = BOM.amazonDs18b20;
const AMAZON_RESISTOR = BOM.amazonResistor4k7;
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
  commerceDisclosure
>
  <p set:html={t.intro1Html} />
  <p set:html={t.intro2Html} />

  <h2>{t.parts.title}</h2>
  <div class="overflow-x-auto mb-6">
    <table class="plan-comparison-table">
      <caption class="sr-only">{t.parts.caption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.parts.colPart}</th>
          <th scope="col">{t.parts.colWhy}</th>
          <th scope="col">{t.parts.colBuy}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Nucleo-F767ZI</th>
          <td>{t.parts.boardWhy}</td>
          <td>
            <a class="text-link" href={ST_NUCLEO_F767ZI} target="_blank" rel={commerceLinkRel(ST_NUCLEO_F767ZI)}>ST Nucleo-F767ZI</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.parts.probePart}</th>
          <td set:html={t.parts.probeWhyHtml} />
          <td>
            <a class="text-link" href={ADAFRUIT_DS18B20} target="_blank" rel={commerceLinkRel(ADAFRUIT_DS18B20)}>Adafruit DS18B20</a>
            ·
            <a class="text-link" href={AMAZON_DS18B20} target="_blank" rel={commerceLinkRel(AMAZON_DS18B20)}>{t.parts.amazon}</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.parts.resistorPart}</th>
          <td>{t.parts.resistorWhy}</td>
          <td>
            <a class="text-link" href={AMAZON_RESISTOR} target="_blank" rel={commerceLinkRel(AMAZON_RESISTOR)}>{t.parts.amazonResistor}</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.parts.ethernetPart}</th>
          <td>{t.parts.ethernetWhy}</td>
          <td>{t.parts.ethernetBuy}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>{t.wiringTitle}</h2>
  <ul>
    {t.wiringHtml.map((html) => <li set:html={html} />)}
  </ul>

  <h2>{t.build.title}</h2>
  <ol>
    <li set:html={t.build.step1Html} />
    <li>
      {t.build.relayLabel}
      <pre><code>{`python3 sketches/relay/push_https_forward.py --listen 0.0.0.0:8080 \\
  --upstream https://probeharbor.dev`}</code></pre>
    </li>
    <li set:html={t.build.step3Html} />
    <li>
      {t.build.westLabel}
      <pre><code>{`west build -b nucleo_f767zi path/to/sketches/zephyr/ds18b20_ingest
west flash`}</code></pre>
    </li>
    <li set:html={t.build.step5Html} />
  </ol>
  <p set:html={t.build.repoHtml} />

  <h2>{t.otherBoardsTitle}</h2>
  <p set:html={t.otherBoardsHtml} />

  <h2>{t.whyNot.title}</h2>
  <ul>
    {t.whyNot.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>

  <h2>{t.related.title}</h2>
  <ul>
    {t.related.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>
</AboutArticle>
