---

import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { zapierMakeRecipesMessages } from "../../i18n/messages/about-pages/zapier-make-recipes";

const locale = getLocale(Astro);
const t = zapierMakeRecipesMessages(locale);
const page = getLocalizedAboutPage("zapier-make-recipes", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <h2>{t.outboundTitle}</h2>
  <ol>
    {t.outboundSteps.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.othersTitle}</h2>
  <p set:html={t.othersHtml} />

  <h2>{t.inboundTitle}</h2>
  <p set:html={t.inboundHtml} />
  <pre><code>{`POST /api/inbound/gtw_…
Content-Type: application/json

{"action":"snooze","hours":24}
{"action":"vacation","days":7}
{"action":"clear_snooze"}
{"action":"clear_vacation"}
{"action":"status"}`}</code></pre>
  <p set:html={t.inboundUseHtml} />

  <h2>{t.haTitle}</h2>
  <p set:html={t.haHtml} />
</AboutArticle>
