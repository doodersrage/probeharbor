---
import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { mqttBridgeMessages } from "../../i18n/messages/about-pages/mqtt-bridge";

const locale = getLocale(Astro);
const t = mqttBridgeMessages(locale);
const page = getLocalizedAboutPage("mqtt-bridge", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale)!;
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.curlTitle}</h2>
  <p set:html={t.curlHtml} />
  <pre><code>{`curl -X POST "https://probeharbor.dev/api/ingest/mqtt" \\
  -H "Content-Type: application/json" \\
  -H "X-Ingest-Key: YOUR_DEVICE_KEY" \\
  -d '{"topic":"home/garage/temp","message":{"temp1":42.5,"humidity":38}}'`}</code></pre>
  <p set:html={t.devicesHtml} />

  <h2 set:html={t.haTitleHtml} />
  <p set:html={t.haHtml} />
  <pre><code>{`# configuration.yaml
rest_command:
  probeharbor_ingest:
    url: "https://probeharbor.dev/api/ingest/mqtt"
    method: POST
    headers:
      Content-Type: application/json
      X-Ingest-Key: !secret probeharbor_ingest_key
    payload: >
      {"topic":"{{ trigger.topic }}","payload":{{ trigger.payload }}}`}</code></pre>
  <pre><code>{`automation:
  - alias: ProbeHarbor MQTT bridge
    trigger:
      - platform: mqtt
        topic: home/garage/temp
    action:
      - service: rest_command.probeharbor_ingest`}</code></pre>

  <h2>{t.noderedTitle}</h2>
  <p set:html={t.noderedHtml} />

  <h2>{t.relatedTitle}</h2>
  <ul>
    {t.related.map((item) => <li set:html={item} />)}
  </ul>
</AboutArticle>
