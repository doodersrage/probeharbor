---

import AboutArticle from "../../components/AboutArticle.astro";
import { Image } from "astro:assets";
import arduinoPinLevelWiring from "../../assets/dht22_arduino_lcd_pin_level_wiring.svg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { arduinoPinWiringMessages } from "../../i18n/messages/about-pages/arduino-pin-wiring";

const locale = getLocale(Astro);
const t = arduinoPinWiringMessages(locale);
const page = getLocalizedAboutPage("arduino-pin-wiring", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
const sectionParent = {
  slug: "arduino-sketches",
  title: getLocalizedAboutPage("arduino-sketches", locale)?.title ?? "Arduino and Arduino sketches",
};
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  sectionParent={sectionParent}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <p set:html={t.introHtml} />

  <figure class="about-figure about-figure-svg card overflow-hidden p-0">
    <Image
      src={arduinoPinLevelWiring}
      alt={t.diagramAlt}
      class="h-auto w-full"
    />
    <figcaption>{t.diagramCaption}</figcaption>
  </figure>

  <h2>{t.lcdTitle}</h2>
  <p set:html={t.lcdIntroHtml} />
  <ul>
    {t.lcdItemsHtml.map((item) => <li set:html={item} />)}
  </ul>
  <p>{t.lcdRw}</p>

  <h2>{t.backlightTitle}</h2>
  <p>{t.backlightBody}</p>

  <h2>{t.dhtTitle}</h2>
  <ul>
    {t.dhtItemsHtml.map((item) => <li set:html={item} />)}
  </ul>
  <p set:html={t.dhtBodyHtml} />

  <h2>{t.spiTitle}</h2>
  <p>{t.spiBody}</p>

  <pre><code>{`// Example constructor matching this wiring
#include <LiquidCrystal.h>
LiquidCrystal lcd(8, 9, A2, 5, 6, 3, A3);

// DHT22 data lines (DHT library pin arguments)
#define DHT_PIN_1 A4
#define DHT_PIN_2 A5
#define BACKLIGHT_PIN 7`}</code></pre>

  <p set:html={t.outroHtml} />
</AboutArticle>
