---
import AboutArticle from "../../components/AboutArticle.astro";
import { affiliateHref, commerceLinkRel } from "../../lib/affiliateLinks";
import { BOM } from "../../lib/bomLinks";
import { fmt, getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { ch32vRiscvIngestMessages } from "../../i18n/messages/about-pages/ch32v-riscv-ingest";

const locale = getLocale(Astro);
const t = ch32vRiscvIngestMessages(locale);
const page = getLocalizedAboutPage("ch32v-riscv-ingest", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);

const WCH_CH32V307 = affiliateHref("https://www.wch-ic.com/products/CH32V307.html");
const ADAFRUIT_DS18B20 = BOM.adafruitDs18b20;
const AMAZON_DS18B20 = BOM.amazonDs18b20;
const AMAZON_RESISTOR = BOM.amazonResistor4k7;
const MOUNRIVER = "http://www.mounriver.com/";
const EVT_DHCP = "https://github.com/openwch/ch32v307/tree/main/EVT/EXAM/ETH/DHCP";
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
  commerceDisclosure
>
  <p set:html={t.introHtml} />
  <p set:html={t.relayHtml} />

  <h2>{t.partsTitle}</h2>
  <div class="overflow-x-auto mb-6">
    <table class="plan-comparison-table">
      <caption class="sr-only">{t.partsCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.colPart}</th>
          <th scope="col">{t.colWhy}</th>
          <th scope="col">{t.colBuy}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">CH32V307V-EVT-R1</th>
          <td>{t.boardWhy}</td>
          <td>
            <a class="text-link" href={WCH_CH32V307} target="_blank" rel={commerceLinkRel(WCH_CH32V307)}>WCH CH32V307</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.probePart}</th>
          <td set:html={t.probeWhyHtml} />
          <td>
            <a class="text-link" href={ADAFRUIT_DS18B20} target="_blank" rel={commerceLinkRel(ADAFRUIT_DS18B20)}>Adafruit DS18B20</a>
            ·
            <a class="text-link" href={AMAZON_DS18B20} target="_blank" rel={commerceLinkRel(AMAZON_DS18B20)}>Amazon</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.resistorPart}</th>
          <td>{t.resistorWhy}</td>
          <td>
            <a class="text-link" href={AMAZON_RESISTOR} target="_blank" rel={commerceLinkRel(AMAZON_RESISTOR)}>Amazon 4.7k</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.ethernetPart}</th>
          <td>{t.ethernetWhy}</td>
          <td>{t.ethernetBuy}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>{t.wiringTitle}</h2>
  <ul>
    {t.wiringHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.buildTitle}</h2>
  <ol>
    <li set:html={t.stepDownloadHtml} />
    <li>
      {t.stepRelayLead}
      <pre><code>{`python3 sketches/relay/push_https_forward.py --listen 0.0.0.0:8080 \\
  --upstream https://probeharbor.dev`}</code></pre>
    </li>
    <li set:html={t.stepHostHtml} />
    <li set:html={fmt(t.stepMounriverHtml, { mounriver: MOUNRIVER, evtDhcp: EVT_DHCP })} />
    <li set:html={t.stepSerialHtml} />
  </ol>
  <p>
    {t.repoLead}
    <a
      class="text-link"
      href="https://github.com/doodersrage/probeharbor/tree/main/sketches/wch/ch32v307_ds18b20_ingest"
      target="_blank"
      rel="noreferrer"
    ><code>sketches/wch/ch32v307_ds18b20_ingest/</code></a>
    {t.repoNote}
  </p>

  <h2>{t.otherTitle}</h2>
  <p>{t.other}</p>

  <h2>{t.whyNotTitle}</h2>
  <ul>
    {t.whyNotHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.relatedTitle}</h2>
  <ul>
    <li><a class="text-link" href="/about/adding-devices">{t.related.addingDevices}</a></li>
    <li><a class="text-link" href="/about/stm32-zephyr-ingest">{t.related.stm32}</a></li>
    <li><a class="text-link" href="/about/pico-w-ingest">{t.related.pico}</a></li>
    <li><a class="text-link" href="/about/python-feeds">{t.related.relay}</a></li>
    <li><a class="text-link" href="/about/avr-asm-ingest">{t.related.avr}</a></li>
    <li>
      <a
        class="text-link"
        href="https://github.com/doodersrage/probeharbor/tree/main/sketches"
        target="_blank"
        rel="noreferrer"
      >{t.related.allSketches}</a>
    </li>
  </ul>
</AboutArticle>
