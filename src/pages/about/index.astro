---

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import AboutQuickStart from "../../components/AboutQuickStart.astro";
import AboutJourneys from "../../components/AboutJourneys.astro";
import AboutHubNav from "../../components/AboutHubNav.astro";
import AboutProbeActivity from "../../components/AboutProbeActivity";
import AboutSearch from "../../components/AboutSearch";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { getAboutStats } from "../../lib/aboutPages";
import { fmt, getLocale, localizePath } from "../../i18n";
import { aboutMessages } from "../../i18n/messages/about";
import { aboutArticleMessages } from "../../i18n/messages/aboutArticle";
import {
  getLocalizedAboutSearchIndex,
  getLocalizedFeaturedAboutSearchIndex,
} from "../../i18n/content/aboutNavigation";
import FaqSection from "../../components/FaqSection.astro";
import EditorialPhotoStrip from "../../components/EditorialPhotoStrip.astro";
import "../../styles/about.css";
import { aboutHubPhotoIds } from "../../lib/aboutPhotos";

const locale = getLocale(Astro);
const t = aboutMessages(locale);
const chrome = aboutArticleMessages(locale);
const title = t.title;
const description = t.description;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/about");
const aboutHubFaqs = t.faqs;
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: "/" },
    { name: t.breadcrumbAbout, path: "/about" },
  ]),
  getFaqPageSchema(pageUrl, aboutHubFaqs),
].filter(Boolean) as Record<string, unknown>[];

const stats = getAboutStats();
const searchIndex = getLocalizedAboutSearchIndex(locale);
const featuredSearchIndex = getLocalizedFeaturedAboutSearchIndex(locale);
const searchAboutBase = localizePath("/about", locale);
const initialSearchQuery = Astro.url.searchParams.get("q")?.trim() ?? "";
---
<Layout
  title={t.layoutTitle}
  description={description}
  schema={schema}
  skipAuth
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={title}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">{t.startFree}</a>
      <a slot="actions" class="btn-secondary" href="/guides">{t.guidesHub}</a>
    </PageHeader>

    <AboutJourneys />

    <EditorialPhotoStrip photoIds={aboutHubPhotoIds} />

    <AboutQuickStart />

    <section class="card about-browse">
      <h2 class="card-title">{t.findTitle}</h2>
      <p class="card-subtitle">{fmt(t.findSubtitle, { count: stats.totalCount })}</p>
      <AboutSearch
        client:visible
        pages={searchIndex}
        featured={featuredSearchIndex}
        initialQuery={initialSearchQuery}
        text={chrome.search}
        aboutBase={searchAboutBase}
      />
    </section>

    <AboutHubNav />

    <section class="about-probe-hero">
      <div class="about-probe-hero-shell card overflow-hidden p-0">
        <div class="about-probe-hero-intro">
          <p class="about-probe-hero-eyebrow">{t.probe.eyebrow}</p>
          <h2 class="about-probe-hero-title">{t.probe.title}</h2>
          <p class="about-probe-hero-lede">{t.probe.lede}</p>
        </div>
        <AboutProbeActivity client:visible text={chrome.probeActivity} />
      </div>
    </section>

    <section class="card about-repos">
      <h2 class="card-title">{t.repos.title}</h2>
      <p class="card-subtitle" set:html={t.repos.subtitleHtml} />
      <ul class="about-repos-list">
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/arduino-network-json-temperature-sever">
            <strong>arduino-network-json-temperature-sever</strong>
            <span>{t.repos.firmware}</span>
          </a>
        </li>
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/probeharbor">
            <strong>probeharbor</strong>
            <span>{t.repos.website}</span>
          </a>
        </li>
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/fast-api-relay">
            <strong>fast-api-relay</strong>
            <span>{t.repos.relay}</span>
          </a>
        </li>
      </ul>
    </section>

    <FaqSection
      faqs={aboutHubFaqs}
      lede={t.faqLede}
    />
  </div>
</Layout>
