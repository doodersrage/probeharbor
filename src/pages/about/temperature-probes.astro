---

import AboutArticle from "../../components/AboutArticle.astro";
import AboutCcFigure from "../../components/AboutCcFigure.astro";
import { Image } from "astro:assets";
import tempProbeV2 from "../../assets/temp-probe-v2.jpg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { temperatureProbesMessages } from "../../i18n/messages/about-pages/temperature-probes";

const locale = getLocale(Astro);
const t = temperatureProbesMessages(locale);
const page = getLocalizedAboutPage("temperature-probes", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale)!;
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.measureTitle}</h2>
  <p set:html={t.measureHtml} />
  <p set:html={t.jsonHtml} />

  <h2>{t.usesTitle}</h2>
  <ul>
    {t.uses.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.placementTitle}</h2>
  <p set:html={t.placementHtml} />

  <AboutCcFigure photoId="garage-workbench" />

  <h2>{t.multipleTitle}</h2>
  <p set:html={t.multipleHtml} />

  <figure class="about-figure">
    <Image
      src={tempProbeV2}
      alt={t.boardAlt}
      widths={[480, 768, 1024]}
      sizes="(max-width: 768px) 100vw, 640px"
      class="w-full h-auto rounded-lg"
    />
    <figcaption>{t.boardCaption}</figcaption>
  </figure>

  <h2>{t.webTitle}</h2>
  <p set:html={t.webHtml} />
</AboutArticle>
