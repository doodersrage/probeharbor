---
import AboutArticle from "../../components/AboutArticle.astro";
import { commerceLinkRel } from "../../lib/affiliateLinks";
import { BOM } from "../../lib/bomLinks";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { avrAsmIngestMessages } from "../../i18n/messages/about-pages/avr-asm-ingest";

const locale = getLocale(Astro);
const t = avrAsmIngestMessages(locale);
const page = getLocalizedAboutPage("avr-asm-ingest", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);

const ADAFRUIT_UNO = BOM.adafruitUno;
const ADAFRUIT_ETH = BOM.adafruitEthShield;
const ADAFRUIT_DS18B20 = BOM.adafruitDs18b20;
const AMAZON_UNO = BOM.amazonUno;
const AMAZON_ETH = BOM.amazonEthShield;
const AMAZON_DS18B20 = BOM.amazonDs18b20;
const AMAZON_RESISTOR = BOM.amazonResistor4k7;
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
  commerceDisclosure
>
  <p set:html={t.introHtml} />
  <p>{t.relay}</p>

  <h2>{t.partsTitle}</h2>
  <div class="overflow-x-auto mb-6">
    <table class="plan-comparison-table">
      <caption class="sr-only">{t.partsCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.colPart}</th>
          <th scope="col">{t.colWhy}</th>
          <th scope="col">{t.colBuy}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Arduino Uno (ATmega328P)</th>
          <td set:html={t.unoWhyHtml} />
          <td>
            <a class="text-link" href={ADAFRUIT_UNO} target="_blank" rel={commerceLinkRel(ADAFRUIT_UNO)}>Adafruit Uno</a>
            ·
            <a class="text-link" href={AMAZON_UNO} target="_blank" rel={commerceLinkRel(AMAZON_UNO)}>Amazon</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.shieldPart}</th>
          <td>{t.shieldWhy}</td>
          <td>
            <a class="text-link" href={ADAFRUIT_ETH} target="_blank" rel={commerceLinkRel(ADAFRUIT_ETH)}>Adafruit Ethernet</a>
            ·
            <a class="text-link" href={AMAZON_ETH} target="_blank" rel={commerceLinkRel(AMAZON_ETH)}>Amazon</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.probePart}</th>
          <td set:html={t.probeWhyHtml} />
          <td>
            <a class="text-link" href={ADAFRUIT_DS18B20} target="_blank" rel={commerceLinkRel(ADAFRUIT_DS18B20)}>Adafruit DS18B20</a>
            ·
            <a class="text-link" href={AMAZON_DS18B20} target="_blank" rel={commerceLinkRel(AMAZON_DS18B20)}>Amazon</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.resistorPart}</th>
          <td>{t.resistorWhy}</td>
          <td>
            <a class="text-link" href={AMAZON_RESISTOR} target="_blank" rel={commerceLinkRel(AMAZON_RESISTOR)}>Amazon 4.7k</a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>{t.wiringTitle}</h2>
  <ul>
    {t.wiringHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.buildTitle}</h2>
  <ol>
    <li set:html={t.stepDownloadHtml} />
    <li>
      {t.stepRelayLead}
      <pre><code>{`python3 sketches/relay/push_https_forward.py --listen 0.0.0.0:8080 \\
  --upstream https://probeharbor.dev`}</code></pre>
    </li>
    <li set:html={t.stepHostHtml} />
    <li>
      <pre><code>{`cd sketches/avr/atmega328_w5100_ds18b20
make flash PORT=/dev/ttyACM0`}</code></pre>
      <Fragment set:html={t.stepAssembleHtml} />
    </li>
    <li set:html={t.stepSerialHtml} />
  </ol>
  <p>
    {t.repoLead}
    <a
      class="text-link"
      href="https://github.com/doodersrage/probeharbor/tree/main/sketches/avr/atmega328_w5100_ds18b20"
      target="_blank"
      rel="noreferrer"
    ><code>sketches/avr/atmega328_w5100_ds18b20/</code></a>
    <Fragment set:html={t.repoNoteHtml} />
  </p>

  <h2>{t.notAddingTitle}</h2>
  <ul>
    {t.notAddingHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.relatedTitle}</h2>
  <ul>
    <li><a class="text-link" href="/about/adding-devices">{t.related.addingDevices}</a></li>
    <li><a class="text-link" href="/about/arduino-sketches">{t.related.arduino}</a></li>
    <li><a class="text-link" href="/about/ch32v-riscv-ingest">{t.related.ch32v}</a></li>
    <li><a class="text-link" href="/about/stm32-zephyr-ingest">{t.related.stm32}</a></li>
    <li><a class="text-link" href="/about/python-feeds">{t.related.relay}</a></li>
  </ul>
</AboutArticle>
