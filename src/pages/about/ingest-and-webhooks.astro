---

import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { ingestAndWebhooksMessages } from "../../i18n/messages/about-pages/ingest-and-webhooks";

const locale = getLocale(Astro);
const t = ingestAndWebhooksMessages(locale);
const page = getLocalizedAboutPage("ingest-and-webhooks", locale)!;
const hero = getLocalizedAboutPhoto("ethernet-cable", locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.push.title}</h2>
  <p set:html={t.push.bodyHtml} />
  <pre><code>POST /api/ingest/&lt;device-key&gt;
Content-Type: application/json</code></pre>

  <h3>{t.classicTitle}</h3>
  <pre><code>{`{
  "temp": {
    "0": { "c": 18.5, "f": 65.3, "h": 42 },
    "1": { "c": 19.0, "f": 66.2, "h": 40 }
  }
}`}</code></pre>

  <h3>{t.typed.title}</h3>
  <pre><code>{`{
  "sensors": [
    { "key": "garage_temp", "kind": "temperature", "value": 65.3, "unit": "F" },
    { "key": "garage_rh", "kind": "humidity", "value": 42, "unit": "%" },
    { "key": "door1", "kind": "door", "bool": true },
    { "key": "co2", "kind": "co2", "value": 820, "unit": "ppm" },
    { "key": "pm25", "kind": "pm25", "value": 12, "unit": "µg/m³" },
    { "key": "sump", "kind": "level", "value": 22, "unit": "%" }
  ],
  "battery": 87,
  "rssi": -62
}`}</code></pre>
  <p set:html={t.typed.kindsHtml} />

  <h3>{t.senml.title}</h3>
  <p set:html={t.senml.bodyHtml} />
  <pre><code>{`[
  { "bn": "probeharbor/garage/", "n": "0", "u": "Cel", "v": 18.5 },
  { "n": "0", "u": "%RH", "v": 42 },
  { "n": "door", "vb": true }
]`}</code></pre>
  <p set:html={t.senml.liveHtml} />

  <h3>{t.ha.title}</h3>
  <p set:html={t.ha.bodyHtml} />
  <pre><code>{`{
  "state": "65.3",
  "attributes": {
    "unit_of_measurement": "°F",
    "friendly_name": "Garage temperature"
  }
}`}</code></pre>
  <p set:html={t.ha.liveHtml} />

  <h2>{t.webhooks.title}</h2>
  <p set:html={t.webhooks.introHtml} />
  <pre><code>{`{
  "title": "Garage temperature alert",
  "body": "Probe 1 is 31.2°F …",
  "kind": "threshold",
  "sent_at": "2026-08-25T12:00:00.000Z"
}`}</code></pre>
  <p set:html={t.webhooks.kindsHtml} />

  <h2>{t.homeAssistant.title}</h2>
  <p set:html={t.homeAssistant.bodyHtml} />
  <p set:html={t.homeAssistant.blueprintHtml} />
  <pre><code>{`automation:
  - alias: ProbeHarbor webhook
    trigger:
      - platform: webhook
        webhook_id: probeharbor_alerts
        allowed_methods:
          - POST
        local_only: false
    action:
      - service: notify.persistent_notification
        data:
          title: "{{ trigger.json.title }}"
          message: "{{ trigger.json.body }}"`}</code></pre>
  <p set:html={t.homeAssistant.pointHtml} />
  <p set:html={t.homeAssistant.mqttHtml} />

  <h2>{t.metrics.title}</h2>
  <p set:html={t.metrics.introHtml} />
  <pre><code>GET /api/v1/metrics
Authorization: Bearer gtm_…</code></pre>
  <p set:html={t.metrics.shareHtml} />
  <pre><code>GET /api/share/&lt;token&gt;/readings?format=prometheus</code></pre>
  <p set:html={t.metrics.grafanaHtml} />

  <h2>{t.channels.title}</h2>
  <ul>
    {t.channels.items.map((item) => <li>{item}</li>)}
  </ul>
  <p set:html={t.channels.rulesHtml} />
  <p set:html={t.channels.emailHtml} />

  <h2>{t.related.title}</h2>
  <ul>
    {t.related.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>
</AboutArticle>
