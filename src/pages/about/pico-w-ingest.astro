---
import AboutArticle from "../../components/AboutArticle.astro";
import { commerceLinkRel } from "../../lib/affiliateLinks";
import { BOM } from "../../lib/bomLinks";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { picoWIngestMessages } from "../../i18n/messages/about-pages/pico-w-ingest";

const locale = getLocale(Astro);
const t = picoWIngestMessages(locale);
const page = getLocalizedAboutPage("pico-w-ingest", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);

const ADAFRUIT_PICO_W = BOM.adafruitPicoW;
const ADAFRUIT_PICO_2W = BOM.adafruitPico2W;
const ADAFRUIT_DS18B20 = BOM.adafruitDs18b20;
const AMAZON_DS18B20 = BOM.amazonDs18b20;
const AMAZON_RESISTOR = BOM.amazonResistor4k7;
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
  commerceDisclosure
>
  <p set:html={t.intro1Html} />
  <p set:html={t.intro2Html} />

  <h2>{t.parts.title}</h2>
  <div class="overflow-x-auto mb-6">
    <table class="plan-comparison-table">
      <caption class="sr-only">{t.parts.caption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.parts.colPart}</th>
          <th scope="col">{t.parts.colWhy}</th>
          <th scope="col">{t.parts.colBuy}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">{t.parts.boardPart}</th>
          <td>{t.parts.boardWhy}</td>
          <td>
            <a class="text-link" href={ADAFRUIT_PICO_W} target="_blank" rel={commerceLinkRel(ADAFRUIT_PICO_W)}>Adafruit Pico W</a>
            ·
            <a class="text-link" href={ADAFRUIT_PICO_2W} target="_blank" rel={commerceLinkRel(ADAFRUIT_PICO_2W)}>Pico 2 W</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.parts.probePart}</th>
          <td set:html={t.parts.probeWhyHtml} />
          <td>
            <a class="text-link" href={ADAFRUIT_DS18B20} target="_blank" rel={commerceLinkRel(ADAFRUIT_DS18B20)}>Adafruit DS18B20</a>
            ·
            <a class="text-link" href={AMAZON_DS18B20} target="_blank" rel={commerceLinkRel(AMAZON_DS18B20)}>{t.parts.amazon}</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.parts.resistorPart}</th>
          <td>{t.parts.resistorWhy}</td>
          <td>
            <a class="text-link" href={AMAZON_RESISTOR} target="_blank" rel={commerceLinkRel(AMAZON_RESISTOR)}>{t.parts.amazonResistor}</a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>{t.wiringTitle}</h2>
  <ul>
    {t.wiringHtml.map((html) => <li set:html={html} />)}
  </ul>
  <p set:html={t.wiringNoteHtml} />

  <h2>{t.circuitpythonTitle}</h2>
  <ol>
    {t.circuitpythonStepsHtml.map((html) => <li set:html={html} />)}
  </ol>
  <p set:html={t.repoSampleHtml} />

  <h2>{t.micropythonTitle}</h2>
  <p set:html={t.micropythonHtml} />

  <h2>{t.arduinoTitle}</h2>
  <p set:html={t.arduinoHtml} />

  <h2>{t.notAddingTitle}</h2>
  <p set:html={t.notAddingHtml} />
  <ul>
    {t.notAddingItemsHtml.map((html) => <li set:html={html} />)}
  </ul>

  <h2>{t.related.title}</h2>
  <ul>
    {t.related.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>
</AboutArticle>
