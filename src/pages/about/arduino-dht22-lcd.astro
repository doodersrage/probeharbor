---

import AboutArticle from "../../components/AboutArticle.astro";
import tempProbeV2 from "../../assets/temp-probe-v2.jpg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { arduinoDht22LcdMessages } from "../../i18n/messages/about-pages/arduino-dht22-lcd";

const locale = getLocale(Astro);
const t = arduinoDht22LcdMessages(locale);
const page = getLocalizedAboutPage("arduino-dht22-lcd", locale)!;
const sectionParent = {
  slug: "arduino-sketches",
  title: getLocalizedAboutPage("arduino-sketches", locale)?.title ?? "Arduino and Arduino sketches",
};
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={tempProbeV2}
  heroAlt={t.heroAlt}
  heroCaption={t.heroCaption}
  sectionParent={sectionParent}
>
  <p>{t.intro}</p>

  <h2>{t.twoSensorsTitle}</h2>
  <p>{t.twoSensorsBody}</p>
  <p set:html={t.keysHtml} />

  <h2>{t.wiresTitle}</h2>
  <ul>
    {t.wiresItemsHtml.map((item) => <li set:html={item} />)}
  </ul>
  <p>{t.wiresBody}</p>

  <h2>{t.lcdTitle}</h2>
  <p>{t.lcdBody1}</p>
  <p>{t.lcdBody2}</p>

  <h2>{t.backlightTitle}</h2>
  <p>{t.backlightBody}</p>

  <h2>{t.ethernetTitle}</h2>
  <p set:html={t.ethernetBodyHtml} />

  <h2>{t.jsonTitle}</h2>
  <p set:html={t.jsonBodyHtml} />
</AboutArticle>
