---
import AboutArticle from "../../components/AboutArticle.astro";
import AboutPageSections from "../../components/AboutPageSections.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedExpandedAboutContent } from "../../i18n/content/aboutExpanded";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/about");
}

const locale = getLocale(Astro);
const page = getLocalizedAboutPage(slug, locale);
const sections = getLocalizedExpandedAboutContent(slug, locale);

if (!page || !sections) {
  return Astro.rewrite("/404");
}

const hero = getLocalizedAboutHeroPhoto(slug, locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <AboutPageSections sections={sections} />
</AboutArticle>
