---

import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { installPwaMessages } from "../../i18n/messages/about-pages/install-pwa";

const locale = getLocale(Astro);
const t = installPwaMessages(locale);
const page = getLocalizedAboutPage("install-pwa", locale) ?? {
  slug: "install-pwa",
  title: "Install as an app (PWA)",
  description:
    "Add ProbeHarbor to your home screen for faster access and optional push alerts.",
};
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <p set:html={t.introHtml} />

  <p set:html={t.androidAppHtml} />

  <h2>{t.desktopTitle}</h2>
  <ol>
    {t.desktopSteps.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.androidTitle}</h2>
  <ol>
    {t.androidSteps.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.iosTitle}</h2>
  <p set:html={t.iosIntroHtml} />
  <ol>
    {t.iosSteps.map((item) => <li set:html={item} />)}
  </ol>
  <p set:html={t.iosPushHtml} />

  <h2>{t.afterTitle}</h2>
  <ul>
    {t.afterItems.map((item) => <li set:html={item} />)}
  </ul>
</AboutArticle>
