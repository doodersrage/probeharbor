---

import AboutArticle from "../../components/AboutArticle.astro";
import AboutCcFigure from "../../components/AboutCcFigure.astro";
import { Image } from "astro:assets";
import tempProbeV2 from "../../assets/temp-probe-v2.jpg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto, getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { arduinoSketchesMessages } from "../../i18n/messages/about-pages/arduino-sketches";

const locale = getLocale(Astro);
const t = arduinoSketchesMessages(locale);
const page = getLocalizedAboutPage("arduino-sketches", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale)!;
const dht11Photo = getLocalizedAboutPhoto("arduino-dht11", locale);

const wiringGuides = [
  getLocalizedAboutPage("arduino-circuit-wiring", locale)!,
  getLocalizedAboutPage("arduino-pin-wiring", locale)!,
  getLocalizedAboutPage("arduino-dht22-lcd", locale)!,
];
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p>{t.intro}</p>

  <h2>{t.responsibilitiesTitle}</h2>
  <ol>
    {t.responsibilities.map((item) => <li>{item}</li>)}
  </ol>

  <h2>{t.jsonTitle}</h2>
  <p set:html={t.jsonHtml} />
  <pre><code>{`{
  "temp": {
    "0": { "f": 38.2, "c": 3.4, "h": 41.0 },
    "1": { "f": 36.8, "c": 2.7, "h": 43.5 },
    "avg": { "f": 37.5, "c": 3.1, "h": 42.2 }
  }
}`}</code></pre>
  <p set:html={t.pushJsonHtml} />
  <pre><code>{`{
  "temp": {
    "0": { "f": 38.2, "c": 3.4, "h": 41.0 }
  },
  "battery": 87,
  "rssi": -62
}`}</code></pre>

  <h2>{t.pushTitle}</h2>
  <p set:html={t.pushHtml} />

  <h2>{t.wiringTitle}</h2>
  <p>{t.wiringLede}</p>
  <div class="about-subguide-grid">
    {wiringGuides.map((guide) => (
      <a class="about-nav-card" href={`/about/${guide.slug}`}>
        <h3>{guide.title}</h3>
        <p>{guide.summary}</p>
      </a>
    ))}
  </div>

  <h2>{t.networkTitle}</h2>
  <p set:html={t.networkHtml} />

  <AboutCcFigure photoId="arduino-dht11" caption={dht11Photo.caption} />

  <figure class="about-figure">
    <Image
      src={tempProbeV2}
      alt={t.rev2Alt}
      widths={[480, 768, 1024]}
      sizes="(max-width: 768px) 100vw, 640px"
      class="w-full h-auto rounded-lg"
    />
    <figcaption>{t.rev2Caption}</figcaption>
  </figure>

  <h2>{t.workflowTitle}</h2>
  <p>{t.workflow}</p>
  <p set:html={t.samplesHtml} />

  <h2>{t.tipsTitle}</h2>
  <ul>
    {t.tips.map((item) => <li>{item}</li>)}
  </ul>
</AboutArticle>
