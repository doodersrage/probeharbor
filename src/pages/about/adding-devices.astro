---
import AboutArticle from "../../components/AboutArticle.astro";
import ExampleFeedCard from "../../components/ExampleFeedCard.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { addingDevicesMessages } from "../../i18n/messages/about-pages/adding-devices";

const locale = getLocale(Astro);
const t = addingDevicesMessages(locale);
const page = getLocalizedAboutPage("adding-devices", locale)!;
const hero = getLocalizedAboutPhoto("ethernet-cable", locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  {t.introHtml.map((html) => <p set:html={html} />)}

  <h2>{t.choose.title}</h2>
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th></th>
          <th>{t.choose.colPush}</th>
          <th>{t.choose.colPull}</th>
        </tr>
      </thead>
      <tbody>
        {t.choose.rowsHtml.map(([label, push, pull]) => (
          <tr>
            <td set:html={label} />
            <td set:html={push} />
            <td set:html={pull} />
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>{t.push.title}</h2>
  <ol>
    {t.push.stepsHtml.map((html) => <li set:html={html} />)}
  </ol>

  <h3>{t.curl.title}</h3>
  <p class="text-sm text-[var(--color-text-muted)]" set:html={t.curl.introHtml} />
  <pre><code>{`curl -X POST "https://probeharbor.dev/api/ingest/YOUR_DEVICE_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"temp1": 42.5, "door1": false, "battery": 87, "rssi": -62}'`}</code></pre>

  <p set:html={t.curl.payloadsHtml} />

  <h2>{t.pull.title}</h2>
  <ExampleFeedCard class="mb-6" />
  <ol>
    <li set:html={t.pull.step1Html} />
  </ol>
  <pre><code>{`{
  "temp": {
    "0": { "c": 18.5, "f": 65.3, "h": 42 },
    "1": { "c": 19.0, "f": 66.2, "h": 40 },
    "avg": { "f": 65.75, "c": 18.75, "h": 41 }
  },
  "battery_pct": 87,
  "rssi": -62
}`}</code></pre>
  <ol start="2">
    {t.pull.stepsHtml.map((html) => <li set:html={html} />)}
  </ol>
  <p set:html={t.pull.noteHtml} />

  <h2 id="mqtt-bridge">{t.mqtt.title}</h2>
  <p set:html={t.mqtt.bodyHtml} />

  <h2>{t.verify.title}</h2>
  <ul>
    {t.verify.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>

  <h2>{t.related.title}</h2>
  <ul>
    {t.related.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>
</AboutArticle>
