---

import AboutArticle from "../../components/AboutArticle.astro";
import ProductScreenshot from "../../components/ProductScreenshot.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { accountsAndDashboardMessages } from "../../i18n/messages/about-pages/accounts-and-dashboard";

const locale = getLocale(Astro);
const t = accountsAndDashboardMessages(locale);
const page = getLocalizedAboutPage("accounts-and-dashboard", locale)!;
const hero = getLocalizedAboutPhoto("desk-workspace", locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <ProductScreenshot
    shot="overview-cards"
    caption={t.screenshots[0]}
  />

  <h2>{t.account.title}</h2>
  <p set:html={t.account.bodyHtml} />

  <h2>{t.checklist.title}</h2>
  <p set:html={t.checklist.bodyHtml} />

  <h2>{t.overview.title}</h2>
  <p set:html={t.overview.bodyHtml} />
  <ProductScreenshot
    shot="overview-status"
    caption={t.screenshots[1]}
  />

  <h2>{t.live.title}</h2>
  <p set:html={t.live.bodyHtml} />

  <h2>{t.devices.title}</h2>
  <p set:html={t.devices.introHtml} />
  <ul>
    {t.devices.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>
  <ProductScreenshot
    shot="devices"
    caption={t.screenshots[2]}
  />
  <p set:html={t.devices.stepsHtml} />

  <h2>{t.display.title}</h2>
  <p set:html={t.display.bodyHtml} />

  <h2>{t.history.title}</h2>
  <p set:html={t.history.bodyHtml} />

  <h2>{t.activity.title}</h2>
  <p set:html={t.activity.bodyHtml} />

  <h2>{t.alerts.title}</h2>
  <p set:html={t.alerts.bodyHtml} />
  <ProductScreenshot
    shot="history-chart"
    caption={t.screenshots[3]}
  />

  <h2>{t.households.title}</h2>
  <p set:html={t.households.bodyHtml} />

  <h2>{t.plans.title}</h2>
  <ul>
    {t.plans.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>
  <p set:html={t.plans.upgradeHtml} />

  <h2>{t.admin.title}</h2>
  <ul>
    {t.admin.itemsHtml.map((html) => <li set:html={html} />)}
  </ul>

  <h2>{t.firstPath.title}</h2>
  <ol>
    {t.firstPath.stepsHtml.map((html) => <li set:html={html} />)}
  </ol>
</AboutArticle>
