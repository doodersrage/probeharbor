---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProbeDemo from "../../components/ProbeDemo";
import FaqSection from "../../components/FaqSection.astro";
import AboutCcFigure from "../../components/AboutCcFigure.astro";
import { getLocale, LOCALE_META } from "../../i18n";
import { getLocalizedAboutFaqs } from "../../i18n/content/aboutFaqs";
import { probeDemoPageMessages } from "../../i18n/messages/about-pages/probe-demo";
import { probeDemoMessages } from "../../i18n/messages/probeDemo";
import {
  DEFAULT_ARTICLE_MODIFIED,
  DEFAULT_ARTICLE_PUBLISHED,
  getArticleSchema,
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import "../../styles/about.css";

const locale = getLocale(Astro);
const t = probeDemoPageMessages(locale);
const demoText = probeDemoMessages(locale);
const title = t.title;
const description = t.description;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/about/probe-demo");
const faqs = getLocalizedAboutFaqs("probe-demo", locale);
const schema = [
  getArticleSchema({
    siteUrl,
    pageUrl,
    headline: title,
    description,
    datePublished: DEFAULT_ARTICLE_PUBLISHED,
    dateModified: DEFAULT_ARTICLE_MODIFIED,
  }),
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: "/" },
    { name: t.breadcrumbAbout, path: "/about" },
    { name: title, path: "/about/probe-demo" },
  ]),
  getFaqPageSchema(pageUrl, faqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    description,
    url: pageUrl,
    applicationCategory: "EducationalApplication",
    operatingSystem: "Any",
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={title}
      lede={description}
    >
      <a slot="actions" class="btn-primary" href="#try-real">
        {t.ctaTryReal}
      </a>
      <a slot="actions" class="btn-secondary" href="?preset=coldSnap">
        {t.ctaColdSnap}
      </a>
      <a slot="actions" class="btn-ghost" href="/about/esp32-freeze-kit">
        {t.ctaKit}
      </a>
    </PageHeader>
    <p class="probe-demo-hero-note" set:html={t.heroNoteHtml} />

    <ProbeDemo
      client:visible
      text={locale === "en" ? undefined : demoText}
      locale={locale === "en" ? undefined : LOCALE_META[locale].intl}
    />

    <AboutCcFigure
      photoId="garage-workbench"
      caption={t.figureCaption}
    />

    <FaqSection faqs={faqs} title={t.faqTitle} />

    <nav class="card about-pagination" aria-label={t.paginationAria}>
      <a class="btn-secondary" href="/about/temperature-probes">
        <span class="btn-icon btn-icon--start" aria-hidden="true">←</span>
        {t.prev}
      </a>
      <a class="btn-secondary" href="/about/adding-devices">
        {t.next}
        <span class="btn-icon btn-icon--end" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</Layout>
