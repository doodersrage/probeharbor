---

import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { kitQrOnboardingMessages } from "../../i18n/messages/about-pages/kit-qr-onboarding";

const locale = getLocale(Astro);
const t = kitQrOnboardingMessages(locale);
const page = getLocalizedAboutPage("kit-qr-onboarding", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <h2>{t.pathTitle}</h2>
  <ol>
    {t.pathSteps.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.encodeTitle}</h2>
  <p set:html={t.encodeHtml} />
  <pre><code>{`https://your-domain/api/ingest/YOUR_DEVICE_KEY`}</code></pre>
  <p set:html={t.encodeWarningHtml} />

  <h2>{t.nfcTitle}</h2>
  <p set:html={t.nfcHtml} />

  <h2>{t.devicesQrTitle}</h2>
  <p set:html={t.devicesQrHtml} />

  <h2>{t.checklistTitle}</h2>
  <p set:html={t.checklistHtml} />
  <p set:html={t.gettingStartedHtml} />
</AboutArticle>
