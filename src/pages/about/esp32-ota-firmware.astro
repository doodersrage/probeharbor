---
import AboutArticle from "../../components/AboutArticle.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { esp32OtaFirmwareMessages } from "../../i18n/messages/about-pages/esp32-ota-firmware";

const locale = getLocale(Astro);
const t = esp32OtaFirmwareMessages(locale);
const page = getLocalizedAboutPage("esp32-ota-firmware", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <p set:html={t.introHtml} />

  <h2>{t.firstFlashTitle}</h2>
  <ul>
    <li set:html={t.usbFlashHtml} />
    <li set:html={t.lanOtaHtml} />
  </ul>

  <h2>{t.arduinoOtaTitle}</h2>
  <p set:html={t.arduinoOtaBodyHtml} />
  <pre><code>{`#include <ArduinoOTA.h>

void setup() {
  // … WiFi connected …
  ArduinoOTA.setHostname("garage-probe");
  ArduinoOTA.setPassword("change-me");
  ArduinoOTA.begin();
}

void loop() {
  ArduinoOTA.handle();
  // … your ingest POST on an interval …
}`}</code></pre>
  <p class="text-sm text-[var(--color-text-muted)]">{t.independentNote}</p>

  <h2>{t.payloadTitle}</h2>
  <p>{t.payloadIntro}</p>
  <pre><code>{`{
  "temp1": 42.5,
  "door1": false,
  "battery": 87,
  "rssi": -62
}`}</code></pre>
  <p set:html={t.payloadAfterHtml} />

  <h2>{t.wifiTitle}</h2>
  <p set:html={t.wifiBodyHtml} />

  <h2>{t.relatedTitle}</h2>
  <ul>
    <li><a class="text-link" href="/about/adding-devices">{t.related.adding}</a></li>
    <li><a class="text-link" href="/about/esp32-web-flash">{t.related.flash}</a></li>
    <li><a class="text-link" href="/about/kit-qr-onboarding">{t.related.qr}</a></li>
    <li><a class="text-link" href="/docs/api#ingest">{t.related.api}</a></li>
  </ul>
</AboutArticle>
