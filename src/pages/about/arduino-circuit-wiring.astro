---

import AboutArticle from "../../components/AboutArticle.astro";
import { Image } from "astro:assets";
import arduinoWiring from "../../assets/dht22_arduino_lcd_wiring.svg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { arduinoCircuitWiringMessages } from "../../i18n/messages/about-pages/arduino-circuit-wiring";

const locale = getLocale(Astro);
const t = arduinoCircuitWiringMessages(locale);
const page = getLocalizedAboutPage("arduino-circuit-wiring", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);
const sectionParent = {
  slug: "arduino-sketches",
  title: getLocalizedAboutPage("arduino-sketches", locale)?.title ?? "Arduino and Arduino sketches",
};
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  sectionParent={sectionParent}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
>
  <p set:html={t.introHtml} />

  <figure class="about-figure about-figure-svg card overflow-hidden p-0">
    <Image
      src={arduinoWiring}
      alt={t.diagramAlt}
      class="h-auto w-full"
    />
    <figcaption>
      {t.diagramCaption}
    </figcaption>
  </figure>

  <h2>{t.breadboardTitle}</h2>
  <p set:html={t.breadboardHtml} />

  <h2>{t.contrastTitle}</h2>
  <p set:html={t.contrastHtml} />

  <h2>{t.dhtTitle}</h2>
  <p set:html={t.dhtHtml} />

  <h2>{t.ethernetTitle}</h2>
  <p set:html={t.ethernetHtml} />

  <p set:html={t.nextHtml} />
</AboutArticle>
