---

import AboutArticle from "../../components/AboutArticle.astro";
import { Image } from "astro:assets";
import JSONProbe from "../../assets/json-temp.jpg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutPhoto } from "../../i18n/content/aboutPhotos";
import { pythonFeedsMessages } from "../../i18n/messages/about-pages/python-feeds";

const locale = getLocale(Astro);
const t = pythonFeedsMessages(locale);
const page = getLocalizedAboutPage("python-feeds", locale)!;
const hero = getLocalizedAboutPhoto("ethernet-cable", locale);
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p>{t.intro}</p>

  <h2>{t.relayTitle}</h2>
  <p>{t.relayBody}</p>

  <h2>{t.fastapiTitle}</h2>
  <ul>
    {t.fastapiItemsHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.consumerTitle}</h2>
  <p set:html={t.consumerBodyHtml} />

  <figure class="about-figure">
    <Image
      src={JSONProbe}
      alt={t.figureAlt}
      widths={[480, 768, 1024]}
      sizes="(max-width: 768px) 100vw, 640px"
      class="w-full h-auto rounded-lg"
    />
    <figcaption>{t.figureCaption}</figcaption>
  </figure>

  <pre><code>{`# Periodic upstream pull (cron or asyncio task)
import httpx

UPSTREAM = "http://192.168.1.50/temp.json"
response = httpx.get(UPSTREAM, timeout=5.0)
response.raise_for_status()
cache.set("garage:latest", response.text)`}</code></pre>

  <h2>{t.scriptsTitle}</h2>
  <p>{t.scriptsBody}</p>

  <h2>{t.repoTitle}</h2>
  <p set:html={t.repoBodyHtml} />

  <h2>{t.unoTitle}</h2>
  <p set:html={t.unoBodyHtml} />
  <pre><code>{`python3 sketches/relay/push_https_forward.py --listen 0.0.0.0:8080 \\
  --upstream https://probeharbor.dev`}</code></pre>
</AboutArticle>
