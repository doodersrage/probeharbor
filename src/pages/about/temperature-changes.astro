---

import AboutArticle from "../../components/AboutArticle.astro";
import AboutCcFigure from "../../components/AboutCcFigure.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { temperatureChangesMessages } from "../../i18n/messages/about-pages/temperature-changes";

const locale = getLocale(Astro);
const t = temperatureChangesMessages(locale);
const page = getLocalizedAboutPage("temperature-changes", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale)!;
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero.image}
  heroAlt={hero.alt}
  heroCaption={hero.caption}
  heroCredit={hero.credit}
  heroCreditHref={hero.sourceUrl}
>
  <p set:html={t.introHtml} />

  <AboutCcFigure photoId="garage-workbench" />
  <AboutCcFigure photoId="crawlspace" />

  <h2>{t.dailyTitle}</h2>
  <p set:html={t.dailyHtml} />

  <h2>{t.seasonalTitle}</h2>
  <p set:html={t.seasonalHtml} />

  <h2>{t.suddenTitle}</h2>
  <ul>
    {t.sudden.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.massTitle}</h2>
  <p set:html={t.massHtml} />

  <h2>{t.humidityTitle}</h2>
  <p set:html={t.humidityHtml} />

  <h2>{t.decisionsTitle}</h2>
  <p set:html={t.decisionsHtml} />
</AboutArticle>
