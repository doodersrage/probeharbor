---

import AboutArticle from "../../components/AboutArticle.astro";
import { Image } from "astro:assets";
import tempProbeV1 from "../../assets/temp-probe-v1.jpg";
import tempProbeV2 from "../../assets/temp-probe-v2.jpg";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { temperatureProbeCaseStudyMessages } from "../../i18n/messages/about-pages/temperature-probe-case-study";

const locale = getLocale(Astro);
const t = temperatureProbeCaseStudyMessages(locale);
const page = getLocalizedAboutPage("temperature-probe-case-study", locale)!;
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={tempProbeV2}
  heroAlt={t.heroAlt}
  heroCaption={t.heroCaption}
>
  <p>{t.intro}</p>

  <h2>{t.challengeTitle}</h2>
  {t.challenge.map((para) => <p>{para}</p>)}

  <h2>{t.environmentTitle}</h2>
  <p>{t.environment}</p>
  <ul>
    {t.zonesHtml.map((item) => <li set:html={item} />)}
  </ul>
  <p set:html={t.demoHtml} />

  <h2>{t.approachTitle}</h2>
  {t.approachHtml.map((para) => <p set:html={para} />)}

  <figure class="about-figure">
    <Image
      src={tempProbeV1}
      alt={t.rev1Alt}
      widths={[480, 768, 1024]}
      sizes="(max-width: 768px) 100vw, 640px"
      class="w-full h-auto rounded-lg"
    />
    <figcaption>{t.rev1Caption}</figcaption>
  </figure>

  <h2>{t.timelineTitle}</h2>
  <ol>
    {t.timelineHtml.map((item) => <li set:html={item} />)}
  </ol>

  <h2>{t.dataTitle}</h2>
  <p>{t.dataLede}</p>
  <ul>
    {t.data.map((item) => <li>{item}</li>)}
  </ul>
  <p set:html={t.flowHtml} />

  <h2>{t.lessonsTitle}</h2>
  <ul>
    {t.lessonsHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.relatedTitle}</h2>
  <p set:html={t.relatedHtml} />
</AboutArticle>
