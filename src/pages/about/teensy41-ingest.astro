---
import AboutArticle from "../../components/AboutArticle.astro";
import { commerceLinkRel } from "../../lib/affiliateLinks";
import { BOM } from "../../lib/bomLinks";
import { getLocale } from "../../i18n";
import { getLocalizedAboutPage } from "../../i18n/content/aboutPages";
import { getLocalizedAboutHeroPhoto } from "../../i18n/content/aboutPhotos";
import { teensy41IngestMessages } from "../../i18n/messages/about-pages/teensy41-ingest";

const locale = getLocale(Astro);
const t = teensy41IngestMessages(locale);
const page = getLocalizedAboutPage("teensy41-ingest", locale)!;
const hero = getLocalizedAboutHeroPhoto(page.slug, locale);

const PJRC_TEENSY = BOM.pjrcTeensy41;
const PJRC_ETH = BOM.pjrcEthKit;
const ADAFRUIT_DS18B20 = BOM.adafruitDs18b20;
const AMAZON_DS18B20 = BOM.amazonDs18b20;
const AMAZON_RESISTOR = BOM.amazonResistor4k7;
const QNETH = "https://github.com/ssilverman/QNEthernet";
---
<AboutArticle
  slug={page.slug}
  title={page.title}
  description={page.description}
  heroImage={hero?.image}
  heroAlt={hero?.alt}
  heroCaption={hero?.caption}
  heroCredit={hero?.credit}
  heroCreditHref={hero?.sourceUrl}
  commerceDisclosure
>
  <p set:html={t.introHtml} />

  <h2>{t.partsTitle}</h2>
  <div class="overflow-x-auto mb-6">
    <table class="plan-comparison-table">
      <caption class="sr-only">{t.partsCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.colPart}</th>
          <th scope="col">{t.colWhy}</th>
          <th scope="col">{t.colBuy}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Teensy 4.1</th>
          <td>{t.teensyWhy}</td>
          <td>
            <a class="text-link" href={PJRC_TEENSY} target="_blank" rel={commerceLinkRel(PJRC_TEENSY)}>PJRC Teensy 4.1</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.kitPart}</th>
          <td>{t.kitWhy}</td>
          <td>
            <a class="text-link" href={PJRC_ETH} target="_blank" rel={commerceLinkRel(PJRC_ETH)}>PJRC Ethernet kit</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.probePart}</th>
          <td set:html={t.probeWhyHtml} />
          <td>
            <a class="text-link" href={ADAFRUIT_DS18B20} target="_blank" rel={commerceLinkRel(ADAFRUIT_DS18B20)}>Adafruit DS18B20</a>
            ·
            <a class="text-link" href={AMAZON_DS18B20} target="_blank" rel={commerceLinkRel(AMAZON_DS18B20)}>Amazon</a>
          </td>
        </tr>
        <tr>
          <th scope="row">{t.resistorPart}</th>
          <td>{t.resistorWhy}</td>
          <td>
            <a class="text-link" href={AMAZON_RESISTOR} target="_blank" rel={commerceLinkRel(AMAZON_RESISTOR)}>Amazon 4.7k</a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>{t.wiringTitle}</h2>
  <ul>
    {t.wiringHtml.map((item) => <li set:html={item} />)}
  </ul>

  <h2>{t.buildTitle}</h2>
  <ol>
    <li set:html={t.stepDownloadHtml} />
    <li>
      {t.stepRelayLead}
      <pre><code>{`python3 sketches/relay/push_https_forward.py --listen 0.0.0.0:8080 \\
  --upstream https://probeharbor.dev`}</code></pre>
    </li>
    <li set:html={t.stepInstallHtml(QNETH)} />
    <li set:html={t.stepSerialHtml} />
  </ol>
  <p>
    {t.repoLead}
    <a
      class="text-link"
      href="https://github.com/doodersrage/probeharbor/tree/main/sketches/teensy/teensy41_ds18b20_ingest"
      target="_blank"
      rel="noreferrer"
    ><code>sketches/teensy/teensy41_ds18b20_ingest/</code></a>
  </p>

  <h2>{t.relatedTitle}</h2>
  <ul>
    <li><a class="text-link" href="/about/adding-devices">{t.related.addingDevices}</a></li>
    <li><a class="text-link" href="/about/pic18-ethernet-ingest">{t.related.pic18}</a></li>
    <li><a class="text-link" href="/about/stm32-zephyr-ingest">{t.related.stm32}</a></li>
    <li><a class="text-link" href="/about/cellular-ingest">{t.related.cellular}</a></li>
    <li><a class="text-link" href="/about/python-feeds">{t.related.relay}</a></li>
  </ul>
</AboutArticle>
