---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { BRAND_NAME } from "../lib/brand";
import {
  DESKTOP_NAME,
  DESKTOP_RELEASES_URL,
  DESKTOP_REPO_URL,
} from "../lib/desktop";
import {
  getBreadcrumbSchema,
  getSoftwareApplicationSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { fmt, getLocale, localizePath } from "../i18n";
import { desktopMessages } from "../i18n/messages/desktop";
import { getLocalizedDesktopTagline } from "../i18n/content/apps";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

const locale = getLocale(Astro);
const t = desktopMessages(locale);
const tagline = getLocalizedDesktopTagline(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/desktop", locale));
const desktopFaqs = getLocalizedMarketingFaqs("desktop", locale);

const software = getSoftwareApplicationSchema(siteUrl);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbApps, path: localizePath("/apps", locale) },
    { name: DESKTOP_NAME, path: localizePath("/desktop", locale) },
  ]),
  {
    ...software,
    "@type": ["SoftwareApplication", "DesktopApplication"],
    name: DESKTOP_NAME,
    operatingSystem: "Windows, macOS, Linux",
    applicationCategory: "UtilitiesApplication",
    url: pageUrl,
    downloadUrl: DESKTOP_RELEASES_URL,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: DESKTOP_RELEASES_URL,
    },
  },
  getLocalizedMarketingFaqSchema(pageUrl, "desktop", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={DESKTOP_NAME}
  description={tagline}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={DESKTOP_NAME}
      lede={fmt(t.lede, { brand: BRAND_NAME })}
    >
      <a slot="actions" class="btn-primary" href={DESKTOP_RELEASES_URL} target="_blank" rel="noreferrer">
        {t.download}
      </a>
      <a slot="actions" class="btn-secondary" href="/register?next=/dashboard/devices">
        {t.freeAccount}
      </a>
      <a slot="actions" class="btn-ghost" href={DESKTOP_REPO_URL} target="_blank" rel="noreferrer">
        {t.sourceOnGithub}
      </a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.doesTitle}</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li set:html={t.doesHtml} />
        <li set:html={t.doesNotHtml} />
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.installTitle}</h2>
      <p class="card-subtitle mb-4">
        {t.installCopy}
      </p>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        {t.installStepsHtml.map((item) => <li set:html={fmt(item, { releasesUrl: DESKTOP_RELEASES_URL })} />)}
      </ol>
      <a class="btn-primary" href={DESKTOP_RELEASES_URL} target="_blank" rel="noreferrer">
        {t.openReleases}
      </a>
    </section>

    <FaqSection
      title={t.faqTitle}
      faqs={desktopFaqs}
      lede={t.faqLede}
    />

    <p class="mb-0 text-sm">
      <a class="text-link" href="/apps">{t.backToApps}</a>
    </p>
  </div>
</Layout>
