---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getBreadcrumbSchema, resolveSiteUrl } from "../lib/schemaMarkup";
import {
  HARDWARE_RECIPES,
  RECIPE_GOAL_LABELS,
  RECIPE_STATUS_LABELS,
  type RecipeGoal,
} from "../lib/hardwareRecipes";

const title = "Which sensor hardware works with ProbeHarbor";
const description =
  "Pick what you want to watch (freeze, humidity, leaks, doors) and see the boards, sensors, and setup paths that work, with honest testing status for each.";

const siteUrl = resolveSiteUrl(Astro.site);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Hardware", path: "/hardware" },
  ]),
].filter(Boolean) as Record<string, unknown>[];

const goals = Object.entries(RECIPE_GOAL_LABELS) as Array<[RecipeGoal, string]>;
const statusTone: Record<string, string> = {
  verified: "text-[var(--color-success)]",
  "built-in": "text-[var(--color-warning)]",
  guide: "text-[var(--color-text-muted)]",
};
---
<Layout title={title} description={description} schema={schema}>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Hardware"
      title="What can I connect?"
      lede="ProbeHarbor is software: it works with sensors you buy or already own. Choose what you want to watch, and whether you'd rather not write code."
    >
      <a slot="actions" class="btn-primary" href="/flash">Flash an ESP32</a>
      <a slot="actions" class="btn-secondary" href="/payload-checker">Check a payload</a>
    </PageHeader>

    <section class="card" aria-labelledby="hardware-filter-title">
      <h2 class="card-title" id="hardware-filter-title">Filter</h2>
      <fieldset class="mb-3">
        <legend class="form-label">I want to watch</legend>
        <div class="flex flex-wrap gap-3">
          <label class="checkbox-row mb-0">
            <input type="radio" name="hardware-goal" value="" checked /> <span>Anything</span>
          </label>
          {goals.map(([value, label]) => (
            <label class="checkbox-row mb-0">
              <input type="radio" name="hardware-goal" value={value} /> <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label class="checkbox-row mb-0">
        <input type="checkbox" id="hardware-no-code" /> <span>No coding</span>
      </label>
      <p class="form-hint mt-3 mb-0" id="hardware-count" aria-live="polite"></p>
    </section>

    <ul class="grid gap-4 md:grid-cols-2 list-none p-0 m-0" id="hardware-list">
      {HARDWARE_RECIPES.map((recipe) => (
        <li class="card mb-0" data-goals={recipe.goals.join(" ")} data-no-code={recipe.noCode ? "1" : "0"}>
          <h2 class="card-title">{recipe.title}</h2>
          <p class={`text-sm font-medium mb-2 ${statusTone[recipe.status]}`}>{RECIPE_STATUS_LABELS[recipe.status]}</p>
          <dl class="text-sm mb-3 space-y-1">
            <div><dt class="inline font-medium">Hardware: </dt><dd class="inline">{recipe.hardware}</dd></div>
            <div><dt class="inline font-medium">Setup: </dt><dd class="inline">{recipe.path}</dd></div>
            <div><dt class="inline font-medium">Watches: </dt><dd class="inline">{recipe.goals.map((g) => RECIPE_GOAL_LABELS[g]).join(", ")}</dd></div>
          </dl>
          <p class="text-sm mb-3">{recipe.notes}</p>
          <p class="mb-0 flex flex-wrap gap-3 text-sm">
            {recipe.links.map((link) => (
              <a class="text-link" href={link.href}>{link.label}</a>
            ))}
          </p>
        </li>
      ))}
    </ul>

    <section class="card">
      <h2 class="card-title">What the labels mean</h2>
      <ul class="mb-0 space-y-2 text-sm">
        <li><strong>{RECIPE_STATUS_LABELS.verified}:</strong> we've run this combination on a real board and seen readings arrive.</li>
        <li><strong>{RECIPE_STATUS_LABELS["built-in"]}:</strong> the flasher firmware supports it, but we haven't wired one up ourselves yet. Tell us if it works for you.</li>
        <li><strong>{RECIPE_STATUS_LABELS.guide}:</strong> a documented path where you adapt example code or configuration. Anything that can send JSON over HTTPS can report.</li>
      </ul>
    </section>
  </div>
</Layout>

<script>
  const list = document.getElementById("hardware-list");
  const noCode = document.getElementById("hardware-no-code") as HTMLInputElement | null;
  const count = document.getElementById("hardware-count");

  function apply() {
    const goal = (document.querySelector('input[name="hardware-goal"]:checked') as HTMLInputElement | null)?.value ?? "";
    let shown = 0;
    list?.querySelectorAll<HTMLElement>("li[data-goals]").forEach((item) => {
      const goals = (item.dataset.goals ?? "").split(" ");
      const visible = (!goal || goals.includes(goal)) && (!noCode?.checked || item.dataset.noCode === "1");
      item.hidden = !visible;
      if (visible) shown += 1;
    });
    if (count) count.textContent = shown === 0 ? "Nothing matches; try another filter." : `${shown} setup${shown === 1 ? "" : "s"} shown.`;
  }

  document.querySelectorAll('input[name="hardware-goal"]').forEach((input) => input.addEventListener("change", apply));
  noCode?.addEventListener("change", apply);
  apply();
</script>
