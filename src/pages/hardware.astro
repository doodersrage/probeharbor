---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getBreadcrumbSchema, resolveSiteUrl } from "../lib/schemaMarkup";
import type { RecipeGoal } from "../lib/hardwareRecipes";
import { getLocale, localizePath } from "../i18n";
import { hardwareMessages } from "../i18n/messages/hardware";
import { getLocalizedHardwareRecipes } from "../i18n/content/hardwareRecipes";

const locale = getLocale(Astro);
const t = hardwareMessages(locale);
const recipes = getLocalizedHardwareRecipes(locale);
const title = t.title;
const description = t.description;

const siteUrl = resolveSiteUrl(Astro.site);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbHardware, path: localizePath("/hardware", locale) },
  ]),
].filter(Boolean) as Record<string, unknown>[];

const goals = Object.entries(t.goalLabels) as Array<[RecipeGoal, string]>;
const statusTone: Record<string, string> = {
  verified: "text-[var(--color-success)]",
  "built-in": "text-[var(--color-warning)]",
  guide: "text-[var(--color-text-muted)]",
};
const countText = { none: t.countNone, one: t.countOne, many: t.countMany };
---
<Layout title={title} description={description} schema={schema}>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="/flash">{t.flashCta}</a>
      <a slot="actions" class="btn-secondary" href="/payload-checker">{t.checkerCta}</a>
    </PageHeader>

    <section class="card" aria-labelledby="hardware-filter-title">
      <h2 class="card-title" id="hardware-filter-title">{t.filterTitle}</h2>
      <fieldset class="mb-3">
        <legend class="form-label">{t.watchLegend}</legend>
        <div class="flex flex-wrap gap-3">
          <label class="checkbox-row mb-0">
            <input type="radio" name="hardware-goal" value="" checked /> <span>{t.anything}</span>
          </label>
          {goals.map(([value, label]) => (
            <label class="checkbox-row mb-0">
              <input type="radio" name="hardware-goal" value={value} /> <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label class="checkbox-row mb-0">
        <input type="checkbox" id="hardware-no-code" /> <span>{t.noCode}</span>
      </label>
      <p class="form-hint mt-3 mb-0" id="hardware-count" aria-live="polite" data-count-text={JSON.stringify(countText)}></p>
    </section>

    <ul class="grid gap-4 md:grid-cols-2 list-none p-0 m-0" id="hardware-list">
      {recipes.map((recipe) => (
        <li class="card mb-0" data-goals={recipe.goals.join(" ")} data-no-code={recipe.noCode ? "1" : "0"}>
          <h2 class="card-title">{recipe.title}</h2>
          <p class={`text-sm font-medium mb-2 ${statusTone[recipe.status]}`}>{t.statusLabels[recipe.status]}</p>
          <dl class="text-sm mb-3 space-y-1">
            <div><dt class="inline font-medium">{t.hardwareLabel}</dt><dd class="inline">{recipe.hardware}</dd></div>
            <div><dt class="inline font-medium">{t.setupLabel}</dt><dd class="inline">{recipe.path}</dd></div>
            <div><dt class="inline font-medium">{t.watchesLabel}</dt><dd class="inline">{recipe.goals.map((g) => t.goalLabels[g]).join(", ")}</dd></div>
          </dl>
          <p class="text-sm mb-3">{recipe.notes}</p>
          <p class="mb-0 flex flex-wrap gap-3 text-sm">
            {recipe.links.map((link) => (
              <a class="text-link" href={link.href}>{link.label}</a>
            ))}
          </p>
        </li>
      ))}
    </ul>

    <section class="card">
      <h2 class="card-title">{t.labelsTitle}</h2>
      <ul class="mb-0 space-y-2 text-sm">
        <li><strong>{t.statusLabels.verified}:</strong> {t.verifiedExplain}</li>
        <li><strong>{t.statusLabels["built-in"]}:</strong> {t.builtInExplain}</li>
        <li><strong>{t.statusLabels.guide}:</strong> {t.guideExplain}</li>
      </ul>
    </section>
  </div>
</Layout>

<script>
  const list = document.getElementById("hardware-list");
  const noCode = document.getElementById("hardware-no-code") as HTMLInputElement | null;
  const count = document.getElementById("hardware-count");
  const text = JSON.parse(count?.dataset.countText ?? "{}") as { none: string; one: string; many: string };

  function apply() {
    const goal = (document.querySelector('input[name="hardware-goal"]:checked') as HTMLInputElement | null)?.value ?? "";
    let shown = 0;
    list?.querySelectorAll<HTMLElement>("li[data-goals]").forEach((item) => {
      const goals = (item.dataset.goals ?? "").split(" ");
      const visible = (!goal || goals.includes(goal)) && (!noCode?.checked || item.dataset.noCode === "1");
      item.hidden = !visible;
      if (visible) shown += 1;
    });
    if (count) count.textContent = shown === 0 ? text.none : shown === 1 ? text.one : text.many.replace("{n}", String(shown));
  }

  document.querySelectorAll('input[name="hardware-goal"]').forEach((input) => input.addEventListener("change", apply));
  noCode?.addEventListener("change", apply);
  apply();
</script>
