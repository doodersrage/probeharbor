---
export const prerender = false;

import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import DemoTempsPanel from "../components/DemoTempsPanel";
import WeatherPanel from "../components/WeatherPanel";
import DemoHistoryChart from "../components/DemoHistoryChart";
import HomeStatusChip from "../components/HomeStatusChip.astro";
import FaqSection from "../components/FaqSection.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { fetchAppStatusSummary } from "../lib/appStatus";
import { getLocale, LOCALE_META, localizePath } from "../i18n";
import { demoMessages } from "../i18n/messages/demo";
import { demoIslandMessages } from "../i18n/messages/demoIslands";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import historyChart from "../assets/marketing/probeharbor-dashboard-history-chart.jpg";

const locale = getLocale(Astro);
const t = demoMessages(locale);
const islands = demoIslandMessages(locale);
const intl = LOCALE_META[locale].intl;
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/demo", locale));
const demoFaqs = getLocalizedMarketingFaqs("demo", locale);
const appStatus = await fetchAppStatusSummary();
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbDemo, path: localizePath("/demo", locale) },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "demo", locale),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: t.schemaName,
    description: t.schemaDescription,
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
  ogImage="/og-dashboard.jpg"
  ogImageAlt={t.ogImageAlt}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.header.kicker}
      title={t.header.title}
      lede={t.header.lede}
    >
      <a slot="actions" class="btn-primary" href="/about/probe-demo?preset=coldSnap">{t.header.simulator}</a>
      <a slot="actions" class="btn-secondary" href="#live-feed">{t.header.liveReadings}</a>
      <a slot="actions" class="btn-ghost" href="/register?next=/dashboard/devices">{t.header.connect}</a>
    </PageHeader>

    <section class="card" aria-labelledby="demo-paths-title">
      <h2 class="card-title" id="demo-paths-title">{t.paths.title}</h2>
      <p class="card-subtitle mb-4">{t.paths.lede}</p>
      <ul class="demo-paths text-sm space-y-3 mb-0">
        {["/about/probe-demo", "#live-feed", "/about/kit-qr-onboarding"].map((href, i) => (
          <li>
            <strong><a class="text-link" href={href}>{t.paths.items[i].label}</a></strong>
            {": "}
            {t.paths.items[i].text}
          </li>
        ))}
      </ul>
    </section>

    <section class="card demo-sim-promo" aria-labelledby="demo-sim-title">
      <h2 class="card-title" id="demo-sim-title">{t.sim.title}</h2>
      <p class="card-subtitle mb-4">{t.sim.lede}</p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-secondary" href="/about/probe-demo?preset=doorDraft">{t.sim.doorDraft}</a>
        <a class="btn-secondary" href="/about/probe-demo?preset=coldSnap">{t.sim.coldSnap}</a>
        <a class="btn-ghost" href="/about/probe-demo">{t.sim.openFull}</a>
      </div>
    </section>

    <HomeStatusChip status={appStatus} />

    <section class="card" id="live-feed" aria-labelledby="live-feed-title">
      <h2 class="card-title" id="live-feed-title">{t.live.title}</h2>
      <p class="card-subtitle mb-4" set:html={t.live.ledeHtml} />
      <div class="home-live" aria-label={t.live.readingsLabel}>
        <DemoTempsPanel client:visible intervalMs={15000} text={islands.temps} locale={intl} />
        <WeatherPanel client:visible cityId={null} guest text={islands.weather} locale={intl} />
      </div>
      <div class="mt-6" id="demo-history">
        <DemoHistoryChart client:visible text={islands.history} ui={locale === "en" ? undefined : islands.chart} />
        <p class="mt-2 mb-0 text-xs text-[var(--color-text-muted)]">{t.live.historyNote}</p>
      </div>
    </section>

    <ProductScreenshot
      shot="insights"
      caption={t.screenshotCaption}
    />

    <section class="demo-freeze" aria-labelledby="demo-freeze-title">
      <div class="demo-freeze-copy">
        <h2 class="demo-freeze-title" id="demo-freeze-title">{t.freeze.title}</h2>
        <p class="demo-freeze-lede">{t.freeze.lede}</p>
        <ul class="demo-freeze-channels" aria-label={t.freeze.channelsLabel}>
          {t.freeze.channels.map((channel) => <li>{channel}</li>)}
        </ul>
        <div class="demo-freeze-actions">
          <a class="btn-secondary" href="/register?next=/dashboard/devices">{t.freeze.startFree}</a>
          <a class="btn-secondary" href="/stories/water-heater-pad-leak">{t.freeze.story}</a>
          <a class="btn-ghost" href="/about/alert-channel-cookbook">{t.freeze.cookbook}</a>
        </div>
      </div>
      <figure class="demo-freeze-visual">
        <Image
          src={historyChart}
          alt={t.freeze.imageAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 767px) 100vw, 42vw"
          class="demo-freeze-img"
        />
      </figure>
    </section>

    <section class="home-steps" aria-labelledby="demo-steps-title">
      <div class="home-steps-intro">
        <h2 class="home-steps-title" id="demo-steps-title">{t.steps.title}</h2>
        <p class="home-steps-lede" set:html={t.steps.ledeHtml} />
      </div>
      <ol class="home-steps-list">
        {t.steps.items.map((step, i) => (
          <li class="home-step">
            <span class="home-step-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="home-step-title">{step.title}</h3>
              <p class="home-step-copy" set:html={step.copyHtml} />
            </div>
          </li>
        ))}
      </ol>
      <div class="home-steps-actions">
        <a class="btn-primary" href="/register?next=/dashboard/devices">{t.steps.startFree}</a>
        <a class="btn-secondary" href="/about/adding-devices">{t.steps.guide}</a>
        <a class="btn-ghost" href="/about/kit-qr-onboarding">{t.steps.walkthrough}</a>
      </div>
    </section>

    <section class="home-compat" aria-label={t.compat.label}>
      <p class="home-compat-label">{t.compat.label}</p>
      <ul class="home-compat-list">
        <li>ESP32</li>
        <li>Arduino</li>
        <li>{t.compat.push}</li>
        <li>{t.compat.pull}</li>
        <li>{t.compat.mqtt}</li>
        <li><a class="text-link" href="/integrations/home-assistant">{t.compat.homeAssistant}</a></li>
        <li>Discord · Telegram · Slack</li>
      </ul>
      <p class="home-compat-note" set:html={t.compat.noteHtml} />
    </section>

    <section class="demo-explore" aria-labelledby="demo-explore-title">
      <h2 class="demo-explore-title" id="demo-explore-title">{t.explore.title}</h2>
      <p class="demo-explore-lede">{t.explore.lede}</p>
      <ul class="demo-explore-list">
        {["/about/probe-demo", "/freeze-map", "/about/kit-qr-onboarding", "/stories/garage-freeze-alert"].map((href, i) => (
          <li>
            <a class="text-link" href={href}>{t.explore.items[i].label}</a>
            <span class="demo-explore-hint">{t.explore.items[i].hint}</span>
          </li>
        ))}
      </ul>
    </section>

    <FaqSection
      faqs={demoFaqs}
      lede={t.faqLede}
    />
  </div>
</Layout>

<style>
  .demo-paths {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .demo-paths li {
    padding: 0.65rem 0;
    border-top: 1px solid var(--color-border);
  }

  .demo-paths li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .demo-freeze {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .demo-freeze {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2rem;
    }
  }

  .demo-freeze-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-text);
  }

  .demo-freeze-lede {
    margin: 0 0 1rem;
    max-width: 36rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .demo-freeze-channels {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .demo-freeze-channels li + li {
    margin-top: 0.35rem;
  }

  .demo-freeze-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .demo-freeze-visual {
    margin: 0;
  }

  .demo-freeze-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 12px);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .demo-explore-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    color: var(--color-text);
  }

  .demo-explore-lede {
    margin: 0 0 1rem;
    max-width: 36rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .demo-explore-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .demo-explore-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.5rem;
    }
  }

  .demo-explore-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .demo-explore-hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
