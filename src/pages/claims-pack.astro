---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { getAuthFromCookies } from "../lib/auth";
import {
  FREE_HISTORY_DAYS,
  MEMBER_HISTORY_DAYS,
  PRO_HISTORY_DAYS,
} from "../lib/entitlements";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { fmt, getLocale, localizePath } from "../i18n";
import { claimsPackMessages } from "../i18n/messages/claimsPack";
import { formatRetention } from "../i18n/content/planComparison/format";

const { user } = await getAuthFromCookies(Astro.cookies);

const locale = getLocale(Astro);
const t = claimsPackMessages(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/claims-pack", locale));
const freeRetention = formatRetention(FREE_HISTORY_DAYS, locale);
const memberRetention = formatRetention(MEMBER_HISTORY_DAYS, locale);
const proRetention = formatRetention(PRO_HISTORY_DAYS, locale);

const faqVars = { free: freeRetention, member: memberRetention, pro: proRetention, disclaimer: t.disclaimer };
const claimsFaqs = t.faqs.map((faq) => ({
  question: fmt(faq.question, faqVars),
  answer: fmt(faq.answer, faqVars),
}));

const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbPage, path: localizePath("/claims-pack", locale) },
  ]),
  getFaqPageSchema(pageUrl, claimsFaqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.headerTitle}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href={user ? "/dashboard/history?tab=exports#claims-pack" : "/register?next=/dashboard/devices"}>
        {user ? t.generate : t.startFree}
      </a>
      <a slot="actions" class="btn-secondary" href="/samples/claims-pack-example.pdf">{t.downloadSample}</a>
      <a slot="actions" class="btn-ghost" href="/pricing">{t.seeProPricing}</a>
    </PageHeader>

    <div class="product-shot-row">
      <ProductScreenshot
        shot="claims-pack"
        caption={t.shotPackCaption}
      />
      <ProductScreenshot
        shot="claims-verification"
        caption={t.shotVerifyCaption}
        compact
      />
    </div>

    <section class="card">
      <h2 class="card-title">{t.contents.title}</h2>
      <p class="card-subtitle mb-4">
        {t.contents.subtitle}
      </p>
      <ul class="text-sm space-y-2 mb-0">
        {t.contents.itemsHtml.map((html) => <li set:html={html} />)}
      </ul>
      <p class="mt-4 mb-0 text-sm">
        {t.contents.whoFor}
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.adjuster.title}</h2>
      <p class="card-subtitle mb-4">
        {t.adjuster.subtitle}
      </p>
      <ol class="text-sm space-y-3 mb-0">
        {t.adjuster.items.map((item) => (
          <li>
            <strong>{item.lead}</strong> {item.body}
          </li>
        ))}
      </ol>
    </section>

    <ProductScreenshot
      shot="monitoring-certificate"
      caption={t.shotCertCaption}
    />

    <section class="card">
      <h2 class="card-title">{t.nearMiss.title}</h2>
      <p class="mb-4 text-sm" set:html={t.nearMiss.bodyHtml} />
      <p class="mb-0">
        <a class="btn-secondary" href="/stories/pipe-near-miss">{t.nearMiss.cta}</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.durable.title}</h2>
      <p class="mb-4 text-sm">
        {t.durable.body}
      </p>
      <ul class="text-sm space-y-2 mb-0">
        {t.durable.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.insurer.title}</h2>
      <p class="mb-4 text-sm" set:html={t.insurer.bodyHtml} />
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        {t.disclaimer}
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.howTo.title}</h2>
      <ol class="text-sm space-y-2 mb-0">
        <li>{t.howTo.step1}</li>
        <li>
          {fmt(t.howTo.step2, { free: freeRetention, member: memberRetention })}
        </li>
        <li set:html={t.howTo.step3Html} />
      </ol>
      <p class="mt-4 mb-0 flex flex-wrap gap-3">
        <a class="btn-primary" href={user ? "/dashboard/history?tab=exports#claims-pack" : "/register?next=/dashboard/devices"}>
          {user ? t.generate : t.startFree}
        </a>
        <a class="btn-secondary" href="/samples/claims-pack-example.pdf">{t.howTo.samplePdf}</a>
      </p>
    </section>

    <FaqSection faqs={claimsFaqs} lede={t.faqLede} />
  </div>
</Layout>
