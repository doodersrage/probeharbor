---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";

const m = accessoriesMessages(getLocale(Astro));
const c = m.common;
const t = m.probeMountKit;

const DS18B20 = BOM.adafruitDs18b20;
const CLIPS = BOM.mcmasterCableTieMounts;
const ZIP = BOM.mcmasterUvZipTies;
const RESISTOR = BOM.amazonResistor4k7;
const PADS = BOM.adafruitFoamTape;
---
<AccessoryProduct
  accessoryId="probe-mount-kit"
  faqKey="probeMountKit"
  title={t.title}
  description={t.description}
  kicker={c.kitKicker}
>
  <a slot="actions" class="btn-primary" href="/about/esp32-freeze-kit">{c.esp32FreezeKit}</a>
  <a slot="actions" class="btn-secondary" href="/about/probe-mounting-enclosures">{t.mountingGuide}</a>
  <a slot="actions" class="btn-ghost" href="/about/pico-w-ingest">{t.picoIngest}</a>

  <section class="card">
    <h2 class="card-title">{c.whatItIs}</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>{c.does}</strong> <Fragment set:html={t.doesHtml} />
      </li>
      <li>
        <strong>{c.doesNot}</strong> <Fragment set:html={t.doesNotHtml} />
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">{t.bom}</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.colPart}</th>
            <th scope="col">{c.colWhy}</th>
            <th scope="col">{c.colBuy}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{t.ds18b20Part}</th>
            <td>{t.ds18b20Why}</td>
            <td>
              <a class="text-link" href={DS18B20} target="_blank" rel={commerceLinkRel(DS18B20)}>{t.ds18b20Buy}</a>
              ·
              <a class="text-link" href={BOM.amazonDs18b20} target="_blank" rel={commerceLinkRel(BOM.amazonDs18b20)}>Amazon</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.resistorPart}</th>
            <td>{t.resistorWhy}</td>
            <td>
              <a class="text-link" href={RESISTOR} target="_blank" rel={commerceLinkRel(RESISTOR)}>{t.resistorBuy}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.zipPart}</th>
            <td>{t.zipWhy}</td>
            <td>
              <a class="text-link" href={ZIP} target="_blank" rel={commerceLinkRel(ZIP)}>{t.zipBuy}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.clipPart}</th>
            <td>{t.clipWhy}</td>
            <td>
              <a class="text-link" href={CLIPS} target="_blank" rel={commerceLinkRel(CLIPS)}>{t.clipBuy}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.padsPart}</th>
            <td>{t.padsWhy}</td>
            <td>
              <a class="text-link" href={PADS} target="_blank" rel={commerceLinkRel(PADS)}>{t.padsBuy}</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">{t.placementTips}</h2>
    <ul class="text-sm space-y-2 mb-0">
      {t.tipsHtml.map((tip) => <li set:html={tip} />)}
    </ul>
  </section>
</AccessoryProduct>
