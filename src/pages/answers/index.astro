---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { answers } from "../../lib/answers";
import {
  getBreadcrumbSchema,
  getItemListSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";

const title = "Freeze alarm answers";
const description =
  "Straight answers about freezing pipes and freeze alarms: when garage pipes freeze, where to put a sensor, what temperature to alert at, and your options.";
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/answers");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Answers", path: "/answers" },
  ]),
  getItemListSchema({
    pageUrl,
    name: title,
    description,
    items: answers.map((a) => ({ name: a.question, url: resolvePageUrl(siteUrl, a.path) })),
  }),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout title={title} description={description} schema={schema}>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Answers"
      title="Freezing pipes and freeze alarms, answered"
      lede="Short, direct answers first, then the detail. Sources are linked where a number comes from research or a vendor."
    />
    <div class="page-grid">
      {answers.map((a) => (
        <section class="card">
          <h2 class="card-title"><a class="text-link" href={a.path}>{a.question}</a></h2>
          <p class="card-subtitle mb-0">{a.description}</p>
        </section>
      ))}
    </div>
  </div>
</Layout>
