---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAnswers } from "../../i18n/content/answers";
import { answersMessages } from "../../i18n/messages/answers";
import {
  getBreadcrumbSchema,
  getItemListSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";

const locale = getLocale(Astro);
const t = answersMessages(locale);
const answers = getLocalizedAnswers(locale);
const title = t.hub.title;
const description = t.hub.description;
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/answers");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: "/" },
    { name: t.breadcrumbAnswers, path: "/answers" },
  ]),
  getItemListSchema({
    pageUrl,
    name: title,
    description,
    items: answers.map((a) => ({ name: a.question, url: resolvePageUrl(siteUrl, a.path) })),
  }),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout title={title} description={description} schema={schema}>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.hub.kicker}
      title={t.hub.heading}
      lede={t.hub.lede}
    />
    <div class="page-grid">
      {answers.map((a) => (
        <section class="card">
          <h2 class="card-title"><a class="text-link" href={a.path}>{a.question}</a></h2>
          <p class="card-subtitle mb-0">{a.description}</p>
        </section>
      ))}
    </div>
  </div>
</Layout>
