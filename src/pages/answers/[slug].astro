---
import Layout from "../../layouts/Layout.astro";
import FaqSection from "../../components/FaqSection.astro";
import { getLocale } from "../../i18n";
import { getLocalizedAnswer } from "../../i18n/content/answers";
import { answersMessages } from "../../i18n/messages/answers";
import {
  getArticleSchema,
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";

const t = answersMessages(getLocale(Astro));
const answer = getLocalizedAnswer(Astro.params.slug ?? "", getLocale(Astro));
if (!answer) {
  return Astro.rewrite("/404");
}

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, answer.path);
// The short answer leads the FAQ schema too, so it is the answer engines quote.
const faqs = [{ question: answer.question, answer: answer.shortAnswer }, ...answer.faqs];
const schema = [
  getArticleSchema({
    siteUrl,
    pageUrl,
    headline: answer.question,
    description: answer.description,
    articleSection: t.articleSection,
    datePublished: answer.datePublished,
    dateModified: answer.dateModified,
  }),
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: "/" },
    { name: t.breadcrumbAnswers, path: "/answers" },
    { name: answer.question, path: answer.path },
  ]),
  getFaqPageSchema(pageUrl, faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={answer.question}
  description={answer.description}
  schema={schema}
  ogType="article"
  ogPublishedTime={answer.datePublished}
  ogModifiedTime={answer.dateModified}
  ogSection={t.articleSection}
  speakableSelectors={[".answer-question", ".answer-short", ".faq-answer"]}
>
  <article class="page-shell page-stack">
    <section class="card">
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        <a class="text-link" href="/answers">{t.answer.backLink}</a>
      </p>
      <h1 class="card-title answer-question">{answer.question}</h1>
      <p class="answer-short mb-0">{answer.shortAnswer}</p>
    </section>

    {answer.sections.map((section) => (
      <section class="card">
        <h2 class="card-title">{section.heading}</h2>
        {section.paragraphs.map((text, i) => (
          <p class:list={[i === section.paragraphs.length - 1 && !section.code ? "mb-0" : "mb-3"]}>{text}</p>
        ))}
        {section.code && (
          <pre class="ingest-key-curl text-xs overflow-x-auto mb-0"><code>{section.code}</code></pre>
        )}
      </section>
    ))}

    <FaqSection faqs={answer.faqs} />

    <section class="card">
      <h2 class="card-title">{t.answer.related}</h2>
      <ul class="text-sm space-y-1 mb-0">
        {answer.related.map((link) => (
          <li><a class="text-link" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      {answer.sources && (
        <>
          <h3 class="text-base font-semibold mt-4 mb-2">{t.answer.sources}</h3>
          <ul class="text-sm space-y-1 mb-0">
            {answer.sources.map((link) => (
              <li><a class="text-link" href={link.url} rel="noopener noreferrer" target="_blank">{link.label}</a></li>
            ))}
          </ul>
        </>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">{t.answer.ctaTitle}</h2>
      <p class="mb-4">{t.answer.ctaCopy}</p>
      <p class="mb-0">
        <a class="btn-primary" href="/register?next=/dashboard/devices">{t.answer.startFree}</a>
        {" "}
        <a class="btn-secondary" href="/demo">{t.answer.seeDemo}</a>
      </p>
    </section>
  </article>
</Layout>

<style>
  .answer-short {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text);
  }
</style>
