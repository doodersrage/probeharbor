---
import { getHouseholdFields } from "../../lib/householdRecord";
import Layout from "../../layouts/Layout.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getInviteByToken, getInviteTokenState } from "../../lib/householdInvites";
import { getHouseholdErrorMessage } from "../../lib/householdErrors";
import { fmt, getLocale } from "../../i18n";
import { authHandoffMessages } from "../../i18n/messages/app/auth/handoff";

const locale = getLocale(Astro);
const t = authHandoffMessages(locale).invite;

const token = Astro.params.token;
if (!token) {
  return Astro.redirect("/");
}

// Only a usable invite comes back; for a used or expired link the state
// lookup says which (no email or role), so the right message still shows.
const invite = await getInviteByToken(token);
const linkState = invite ? null : await getInviteTokenState(token);
const { session, user } = await getAuthFromCookies(Astro.cookies);

let householdName = t.aHousehold;
if (invite) {
  const { data } = await getHouseholdFields(invite.household_id, ["name"]);
  householdName = (data?.name as string | undefined) ?? householdName;
}

const expired = invite ? Date.parse(invite.expires_at) < Date.now() : Boolean(linkState?.expired);
const alreadyAccepted = invite ? Boolean(invite.accepted_at) : Boolean(linkState?.accepted);
const rawError = Astro.url.searchParams.get("error");
const acceptError = getHouseholdErrorMessage(rawError, locale);
const isEmailMismatch =
  Boolean(rawError) &&
  (rawError === "email_mismatch" ||
    (rawError ?? "").toLowerCase().includes("invited email"));
const nextPath = `/invite/${token}`;
const inviteEmail = invite?.email ?? "";
const authQuery = new URLSearchParams({ next: nextPath });
if (inviteEmail) authQuery.set("email", inviteEmail);
// "{household}" / "{email}" render in <strong>; both are user data, so split
// the template instead of building HTML.
const invitedParts = (invite?.email ? t.invitedAs : t.invited).split(/(\{household\}|\{email\})/);
---
<Layout title={t.title} description={t.description} noindex>
  <div class="mx-auto w-full max-w-lg px-4 py-12 sm:px-6">
    <section class="card">
      <h1 class="card-title">{t.heading}</h1>
      {expired ? (
        <p>{t.expired}</p>
      ) : alreadyAccepted ? (
        <p>
          {t.alreadyAccepted}{" "}
          <a class="text-link" href="/dashboard/household">{t.openHousehold}</a>
        </p>
      ) : !invite ? (
        <p>{t.invalid}</p>
      ) : (
        <>
          <p class="card-subtitle">
            {invitedParts.map((part) =>
              part === "{household}" ? (
                <strong>{householdName}</strong>
              ) : part === "{email}" ? (
                <strong>{invite.email}</strong>
              ) : (
                part
              ),
            )}
          </p>
          {acceptError && (
            <div class="space-y-2">
              <p class="alert-warning" role="alert">{acceptError}</p>
              {isEmailMismatch && session && user && (
                <p class="m-0 text-sm">
                  <a class="text-link" href={`/api/auth/signout?${authQuery.toString()}`}>{t.signOut}</a>
                  {" "}{t.useInvitedEmail}
                </p>
              )}
            </div>
          )}
          {!session || !user ? (
            <div class="space-y-3 mt-4">
              <p class="mb-0">
                {inviteEmail ? fmt(t.signInOrRegisterAs, { email: inviteEmail }) : t.signInOrRegister}
              </p>
              <a class="btn-primary" href={`/signin?${authQuery.toString()}`}>
                {t.signIn}
              </a>
              <a class="btn-secondary" href={`/register?${authQuery.toString()}`}>
                {t.createAccount}
              </a>
            </div>
          ) : isEmailMismatch ? (
            <div class="space-y-3 mt-4">
              <p class="mb-0 text-sm">
                {fmt(t.signedInMismatch, { email: user.email ?? "" })}
              </p>
              <a class="btn-primary" href={`/api/auth/signout?${authQuery.toString()}`}>{t.signOutButton}</a>
              <a class="btn-secondary" href={`/signin?${authQuery.toString()}`}>
                {inviteEmail ? fmt(t.signInAs, { email: inviteEmail }) : t.signInAsInvited}
              </a>
            </div>
          ) : (
            <form action="/api/household/accept" method="post" class="mt-4 space-y-3">
              <input type="hidden" name="token" value={token} />
              <p class="text-sm mb-0">{fmt(t.signedInAs, { email: user.email ?? "" })}</p>
              <button class="btn-primary" type="submit">{t.join}</button>
            </form>
          )}
        </>
      )}
    </section>
  </div>
</Layout>
