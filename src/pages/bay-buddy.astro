---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { BRAND_NAME } from "../lib/brand";
import {
  BAYBUDDY_NAME,
  BAYBUDDY_RELEASES_URL,
  BAYBUDDY_REPO_URL,
} from "../lib/bayBuddy";
import {
  getBreadcrumbSchema,
  getSoftwareApplicationSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale, localizePath } from "../i18n";
import { bayBuddyMessages } from "../i18n/messages/bayBuddy";
import { getLocalizedBayBuddyTagline } from "../i18n/content/apps";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

const locale = getLocale(Astro);
const t = bayBuddyMessages(locale);
const tagline = getLocalizedBayBuddyTagline(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/bay-buddy", locale));
const bayBuddyFaqs = getLocalizedMarketingFaqs("bayBuddy", locale);

const software = getSoftwareApplicationSchema(siteUrl);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbApps, path: localizePath("/apps", locale) },
    { name: BAYBUDDY_NAME, path: localizePath("/bay-buddy", locale) },
  ]),
  {
    ...software,
    "@type": ["SoftwareApplication", "DesktopApplication"],
    name: BAYBUDDY_NAME,
    operatingSystem: "Windows, macOS, Linux",
    applicationCategory: "UtilitiesApplication",
    url: pageUrl,
    downloadUrl: BAYBUDDY_RELEASES_URL,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: BAYBUDDY_RELEASES_URL,
    },
  },
  getLocalizedMarketingFaqSchema(pageUrl, "bayBuddy", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={BAYBUDDY_NAME}
  description={tagline}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={BAYBUDDY_NAME}
      lede={t.lede(BAYBUDDY_NAME, BRAND_NAME)}
    >
      <a slot="actions" class="btn-primary" href={BAYBUDDY_RELEASES_URL} target="_blank" rel="noreferrer">
        {t.download}
      </a>
      <a slot="actions" class="btn-secondary" href="/register?next=/dashboard/devices">
        {t.freeAccount}
      </a>
      <a slot="actions" class="btn-ghost" href={BAYBUDDY_REPO_URL} target="_blank" rel="noreferrer">
        {t.sourceOnGithub}
      </a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.showsTitle}</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li set:html={t.doesHtml} />
        <li set:html={t.doesNotHtml} />
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.installTitle}</h2>
      <p class="card-subtitle mb-4">
        {t.installCopy}
      </p>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        {t.installStepsHtml(BAYBUDDY_RELEASES_URL).map((item) => <li set:html={item} />)}
      </ol>
      <a class="btn-primary" href={BAYBUDDY_RELEASES_URL} target="_blank" rel="noreferrer">
        {t.openReleases}
      </a>
    </section>

    <FaqSection
      title={t.faqTitle}
      faqs={bayBuddyFaqs}
      lede={t.faqLede}
    />

    <p class="mb-0 text-sm">
      <a class="text-link" href="/apps">{t.backToApps}</a>
    </p>
  </div>
</Layout>
