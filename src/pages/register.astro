---
import Layout from "../layouts/Layout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
import { getRegisterErrorMessage, REGISTER_ERROR_MESSAGES } from "../lib/registerErrors";
import { getLocale } from "../i18n";
import { authSigninMessages } from "../i18n/messages/app/auth/signin";
import {
  REGISTER_NEXT_DEVICES,
  sanitizeRegisterNext,
} from "../lib/registerUrl";

const nextPath = Astro.url.searchParams.get("next") ?? "";
const safeNext = sanitizeRegisterNext(nextPath) ?? REGISTER_NEXT_DEVICES;
const t = authSigninMessages(getLocale(Astro)).register;
const errorCode = Astro.url.searchParams.get("error");
// Known codes are translated; anything else (a raw Supabase message) shows as is.
const rawErrorMessage = getRegisterErrorMessage(errorCode);
const errorMessage =
  errorCode && Object.hasOwn(t.errors, errorCode)
    ? t.errors[errorCode as keyof typeof t.errors]
    : rawErrorMessage === REGISTER_ERROR_MESSAGES.generic
      ? t.errors.generic
      : rawErrorMessage;
const emailValue = Astro.url.searchParams.get("email") ?? "";
const signInParams = new URLSearchParams();
signInParams.set("next", safeNext);
if (emailValue) signInParams.set("email", emailValue);
const refCode = Astro.url.searchParams.get("ref")?.trim().toLowerCase() ?? "";
const signInHref = `/signin?${signInParams.toString()}`;
// The referral code is visitor input, so it is rendered as text around the template.
const [referralBefore = "", referralAfter = ""] = t.referral.split("{code}");
---

<Layout
  title={t.title}
  description={t.description}
  noindex
>
  <div class="auth-page">
    <header class="auth-intro page-header">
      <h1 class="page-header-title">{t.heading}</h1>
      <p class="page-header-lede">{t.lede}</p>
      <p class="form-hint mt-2 mb-0">
        {t.preferLook}
        <a class="text-link" href="/demo">{t.liveDemo}</a>
      </p>
    </header>

    <div class="form-panel">
      {refCode && (
        <p class="form-hint mb-4">
          {referralBefore}<strong>{refCode}</strong>{referralAfter}
        </p>
      )}
      {errorMessage && (
        <div class="alert-warning mb-4" role="alert">
          <p class="m-0">{errorMessage}</p>
        </div>
      )}

      <OAuthButtons action="/api/auth/signin" next={safeNext} ref={refCode} primary />

      <form action="/api/auth/register" method="post">
        <input type="hidden" name="next" value={safeNext} />
        {refCode && <input type="hidden" name="ref" value={refCode} />}
        <div class="form-field">
          <label class="form-label" for="email">{t.email}</label>
          <input
            class="form-input"
            type="email"
            name="email"
            id="email"
            value={emailValue}
            required
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="password">{t.password}</label>
          <input
            class="form-input"
            type="password"
            name="password"
            id="password"
            required
            minlength={8}
            autocomplete="new-password"
          />
          <p class="form-hint">{t.passwordHint}</p>
        </div>
        <div class="form-field">
          <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
        </div>
        <button class="btn-primary" type="submit">{t.submit}</button>
        <p class="form-hint mt-3 mb-0" set:html={t.agreeHtml} />
      </form>
    </div>

    <p class="auth-switch">
      {t.haveAccount}
      <a class="text-link" href={signInHref}>{t.signIn}</a>
    </p>
  </div>
</Layout>
