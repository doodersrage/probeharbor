---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { getAuthFromCookies } from "../lib/auth";
import {
  PORTFOLIO_MAX_OWNED_HOUSEHOLDS,
  PRO_MAX_OWNED_HOUSEHOLDS,
} from "../lib/entitlements";
import { getPortfolioPriceDisplay } from "../lib/stripePricing";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { fmt, getLocale, localizePath } from "../i18n";
import { localizeUsd, propertyManagementMessages } from "../i18n/messages/propertyManagement";

const { user } = await getAuthFromCookies(Astro.cookies);

const locale = getLocale(Astro);
const t = propertyManagementMessages(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/property-management", locale));
const portfolioPrices = getPortfolioPriceDisplay();
const portfolioAnnual = portfolioPrices.annual ? localizeUsd(portfolioPrices.annual, locale) : null;
const portfolioMonthly = portfolioPrices.monthly ? localizeUsd(portfolioPrices.monthly, locale) : null;
const portfolioConfigured = portfolioAnnual != null || portfolioMonthly != null;
const priceInline = portfolioConfigured
  ? portfolioAnnual
    ? fmt(portfolioMonthly ? t.priceAnnualWithMonthly : t.priceAnnual, {
        annual: portfolioAnnual,
        max: PORTFOLIO_MAX_OWNED_HOUSEHOLDS,
        monthly: portfolioMonthly ?? "",
      })
    : fmt(t.priceMonthly, { monthly: portfolioMonthly!, max: PORTFOLIO_MAX_OWNED_HOUSEHOLDS })
  : fmt(t.priceCustom, { max: PORTFOLIO_MAX_OWNED_HOUSEHOLDS });

const ownedLimits = { pro: PRO_MAX_OWNED_HOUSEHOLDS, portfolio: PORTFOLIO_MAX_OWNED_HOUSEHOLDS };
const propertyFaqs = t.faqs.map((faq) => ({
  question: fmt(faq.question, ownedLimits),
  answer: fmt(faq.answer, ownedLimits),
}));

const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumbPage, path: localizePath("/property-management", locale) },
  ]),
  getFaqPageSchema(pageUrl, propertyFaqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.headerTitle}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href={user ? "/dashboard/portfolio" : "/register?next=/dashboard/devices"}>
        {user ? t.openPortfolio : t.startFree}
      </a>
      <a slot="actions" class="btn-secondary" href="/pricing#portfolio">
        {portfolioConfigured ? fmt(t.portfolioPrice, { price: (portfolioAnnual ?? portfolioMonthly)! }) : t.seePortfolioPricing}
      </a>
    </PageHeader>

    <ProductScreenshot
      shot="portfolio"
      caption={t.screenshotCaption}
    />

    <section class="card">
      <h2 class="card-title">{t.proof.title}</h2>
      <p class="card-subtitle mb-4">
        {t.proof.subtitle}
      </p>
      <ul class="text-sm space-y-2 mb-4">
        {t.proof.itemsHtml.map((html) => <li set:html={html} />)}
      </ul>
      <p class="mb-0">
        <a class="btn-secondary" href="/claims-pack">{t.proof.cta}</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.built.title}</h2>
      <p class="card-subtitle mb-4">
        {t.built.subtitle}
      </p>
      <ul class="text-sm space-y-2 mb-0">
        {t.built.itemsHtml.map((html) => <li set:html={html} />)}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.audience.title}</h2>
      <ul class="text-sm space-y-3 mb-0">
        {t.audience.itemsHtml.map((html) => <li set:html={html} />)}
      </ul>
    </section>

    <section class="card" id="portfolio-pricing">
      <h2 class="card-title">{t.plans.title}</h2>
      <p class="mb-4 text-sm">
        {fmt(t.plans.body, ownedLimits)}
      </p>
      <p class="text-sm mb-4">
        <strong>{t.plans.portfolioLabel}</strong> {priceInline}.
        {" "}
        <a class="text-link" href="/pricing#portfolio">{t.plans.fullComparison}</a>
        {" · "}
        <a class="text-link" href="/pricing#pro">{t.plans.proPricing}</a>
      </p>
      <p class="mt-4 mb-0">
        <a class="btn-primary" href="/pricing#portfolio">{t.plans.cta}</a>
      </p>
    </section>

    <FaqSection faqs={propertyFaqs} lede={t.faqLede} />
  </div>
</Layout>
