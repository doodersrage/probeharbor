---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { BRAND_NAME } from "../lib/brand";
import { fmt, getLocale } from "../i18n";
import { authErrorPagesMessages } from "../i18n/messages/app/auth/errorPages";

const t = authErrorPagesMessages(getLocale(Astro)).notFound;
---
<Layout title={t.title} description={fmt(t.description, { brand: BRAND_NAME })} noindex>
  <div class="page-shell page-stack">
    <section class="card">
      <h1 class="card-title">{t.heading}</h1>
      <p class="card-subtitle mb-4">
        {t.lede}
      </p>
      <p class="mb-4 flex flex-wrap gap-3">
        <a class="btn-primary" href="/">{t.home}</a>
        <a class="btn-secondary" href="/about">{t.guides}</a>
        <a class="btn-secondary" href="/dashboard">{t.dashboard}</a>
      </p>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        {t.lookingFor}
        <a class="text-link" href="/about/ingest-and-webhooks">{t.ingest}</a>
        ·
        <a class="text-link" href="/contact">{t.contact}</a>
      </p>
    </section>
  </div>
</Layout>
