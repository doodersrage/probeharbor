---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import PipeFreezeForecast from "../components/PipeFreezeForecast";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

const title = "Will my pipes freeze tonight? Pipe freeze forecast";
const description =
  "Enter a US city or ZIP to see the next five nights' lows, hours below freezing, and pipe freeze risk for unheated garages, crawlspaces, and attics.";

const faqs = [
  {
    question: "At what outdoor temperature do pipes freeze?",
    answer:
      "Water freezes at 32°F, but pipes inside a building usually need colder air outside before they freeze. Research from the University of Illinois, widely cited by insurers, puts the danger point for pipes in unheated spaces at an outdoor temperature of about 20°F. That is why this forecast marks nights at or below 20°F as high risk.",
  },
  {
    question: "Can pipes freeze when the low is above 20°F?",
    answer:
      "Yes. A long night below 32°F can freeze a pipe that is uninsulated, on an exterior wall, near a garage door, or in a vented crawlspace, especially with wind. Nights between 21°F and 32°F are marked Watch for that reason.",
  },
  {
    question: "Why does wind matter?",
    answer:
      "Moving air strips heat from a pipe much faster than still air, so pipes near vents, door gaps, and cracks in exterior walls freeze first. The forecast calls out wind of 15 mph or more during freezing hours.",
  },
  {
    question: "Does this tell me how cold my garage will get?",
    answer:
      "No. It forecasts outdoor air. An attached or insulated garage can stay well above the outdoor low, and a drafty one can get almost as cold. The only way to know is a thermometer near the pipes, ideally one that alerts you before they reach freezing.",
  },
  {
    question: "Where does the forecast come from?",
    answer:
      "The National Weather Service hourly forecast for your location, refreshed about every 30 minutes. It covers the United States and its territories.",
  },
];

const alertsStatus = Astro.url.searchParams.get("alerts");
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/pipe-freeze-forecast");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Pipe freeze forecast", path: "/pipe-freeze-forecast" },
  ]),
  getFaqPageSchema(pageUrl, faqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Pipe freeze forecast",
    description,
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Free tool"
      title="Will my pipes freeze tonight?"
      lede="Check the next five nights for your area: the low, how many hours it stays below freezing, wind, and whether pipes in an unheated garage, crawlspace, or attic are at risk."
    >
      <a slot="actions" class="btn-primary" href="#pipe-freeze-tool-heading">Get free freeze alerts by email</a>
      <a slot="actions" class="btn-secondary" href="/answers/garage-pipe-freeze-temperature">When garage pipes freeze</a>
    </PageHeader>

    {alertsStatus === "confirmed" && (
      <p class="alert-success mb-0" role="status">
        Freeze alerts are on. We'll email you the afternoon before a freezing night.
      </p>
    )}
    {alertsStatus === "invalid" && (
      <p class="alert-warning mb-0" role="status">
        That confirmation link isn't valid anymore. Look up your area below and sign up again.
      </p>
    )}
    <PipeFreezeForecast client:load turnstileSiteKey={import.meta.env.TURNSTILE_SITE_KEY} />

    <section class="card">
      <h2 class="card-title">How to read the risk levels</h2>
      <ul class="mb-3">
        <li><strong>High risk:</strong> the outdoor low is 20°F or colder, the commonly cited point where pipes in unheated spaces freeze.</li>
        <li><strong>Watch:</strong> below freezing but above 20°F. Exposed pipes can still freeze on a long or windy night.</li>
        <li><strong>Low risk:</strong> the night stays above freezing.</li>
      </ul>
      <p class="mb-0">
        On a High or Watch night: open cabinet doors on exterior walls, keep the garage door shut, let a faucet on an
        exposed line drip, and know where your main shutoff is. See
        <a class="text-link" href="/answers/drip-faucets-to-prevent-frozen-pipes">whether dripping faucets helps</a>,
        <a class="text-link" href="/answers/how-long-for-pipes-to-freeze">how long pipes take to freeze</a>, and the
        <a class="text-link" href="/freeze-time-calculator">freeze time calculator</a> if you have a thermometer in the space.
      </p>
    </section>

    <FaqSection faqs={faqs} />

    <section class="card">
      <h2 class="card-title">The forecast is outdoors. Your pipes are inside.</h2>
      <p class="mb-4">
        A probe next to the pipe tells you what the space is actually doing and alerts you before it reaches freezing,
        while there is still time to act. The free plan includes email alerts; use an ESP32 probe (about $25 in parts)
        or sensors you already have in Home Assistant.
      </p>
      <p class="mb-0">
        <a class="btn-primary" href="/register?next=/dashboard/devices">Start free</a>
        {" "}
        <a class="btn-secondary" href="/about/esp32-freeze-kit">ESP32 freeze kit parts</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Sources</h2>
      <ul class="mb-0 text-sm">
        <li>
          <a class="text-link" href="https://www.kxan.com/weather/weather-blog/at-what-temperature-do-pipes-freeze/" rel="noopener">At what temperature do pipes freeze? (KXAN, citing University of Illinois research)</a>
        </li>
        <li>
          <a class="text-link" href="https://www.scfbins.com/articles/how-pipes-freeze-and-burst" rel="noopener">How pipes freeze and burst (Farm Bureau Insurance)</a>
        </li>
        <li>
          <a class="text-link" href="https://www.weather.gov/documentation/services-web-api" rel="noopener">National Weather Service API</a>: hourly forecast data
        </li>
      </ul>
    </section>
  </div>
</Layout>
