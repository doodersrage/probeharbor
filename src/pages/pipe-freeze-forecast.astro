---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import PipeFreezeForecast from "../components/PipeFreezeForecast";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale, localizePath, LOCALE_META } from "../i18n";
import { freezePipeForecastMessages } from "../i18n/messages/freezePipeForecast";

const locale = getLocale(Astro);
const t = freezePipeForecastMessages(locale);
const title = t.title;
const description = t.description;
const faqs = t.faqs;

const alertsStatus = Astro.url.searchParams.get("alerts");
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/pipe-freeze-forecast", locale));
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumb, path: localizePath("/pipe-freeze-forecast", locale) },
  ]),
  getFaqPageSchema(pageUrl, faqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: t.appName,
    description,
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.heading}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="#pipe-freeze-tool-heading">{t.getAlerts}</a>
      <a slot="actions" class="btn-secondary" href="/answers/garage-pipe-freeze-temperature">{t.whenGaragePipes}</a>
    </PageHeader>

    {alertsStatus === "confirmed" && (
      <p class="alert-success mb-0" role="status">
        {t.alertsConfirmed}
      </p>
    )}
    {alertsStatus === "invalid" && (
      <p class="alert-warning mb-0" role="status">
        {t.alertsInvalid}
      </p>
    )}
    <PipeFreezeForecast
      client:load
      turnstileSiteKey={import.meta.env.TURNSTILE_SITE_KEY}
      text={t.tool}
      locale={locale === "en" ? undefined : LOCALE_META[locale].intl}
    />

    <section class="card">
      <h2 class="card-title">{t.levelsTitle}</h2>
      <ul class="mb-3">
        {t.levelsHtml.map((item) => <li set:html={item} />)}
      </ul>
      <p class="mb-0" set:html={t.levelsActionHtml} />
    </section>

    <FaqSection faqs={faqs} />

    <section class="card">
      <h2 class="card-title">{t.insideTitle}</h2>
      <p class="mb-4">{t.insideBody}</p>
      <p class="mb-0">
        <a class="btn-primary" href="/register?next=/dashboard/devices">{t.startFree}</a>
        {" "}
        <a class="btn-secondary" href="/about/esp32-freeze-kit">{t.kitParts}</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">{t.sourcesTitle}</h2>
      <ul class="mb-0 text-sm">
        <li>
          <a class="text-link" href="https://www.kxan.com/weather/weather-blog/at-what-temperature-do-pipes-freeze/" rel="noopener">{t.sourceKxan}</a>
        </li>
        <li>
          <a class="text-link" href="https://www.scfbins.com/articles/how-pipes-freeze-and-burst" rel="noopener">{t.sourceFarmBureau}</a>
        </li>
        <li>
          <a class="text-link" href="https://www.weather.gov/documentation/services-web-api" rel="noopener">{t.sourceNws}</a>{t.sourceNwsNote}
        </li>
      </ul>
    </section>
  </div>
</Layout>
