---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";
import { getLocalizedAccessories } from "../i18n/content/accessories";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

const locale = getLocale(Astro);
const m = accessoriesMessages(locale);
const t = m.hub;
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/accessories");
const faqs = getLocalizedMarketingFaqs("accessories", locale);
const accessories = getLocalizedAccessories(locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: m.common.breadcrumbHome, path: "/" },
    { name: m.common.breadcrumbAccessories, path: "/accessories" },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "accessories", locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.title}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href="/claim-puck">{m.common.claimPuck}</a>
      <a slot="actions" class="btn-secondary" href="/about/esp32-freeze-kit">{t.freezeKitBom}</a>
      <a slot="actions" class="btn-ghost" href="/apps">{t.companionApps}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.catalog}</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">{t.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{t.colAccessory}</th>
              <th scope="col">{t.colRole}</th>
              <th scope="col">{t.colKind}</th>
            </tr>
          </thead>
          <tbody>
            {
              accessories.map((item) => (
                <tr>
                  <th scope="row">
                    <a class="text-link" href={item.path}>
                      {item.name}
                    </a>
                  </th>
                  <td>{item.tagline}</td>
                  <td class="whitespace-nowrap">
                    {item.kind === "companion"
                      ? t.kindCompanion
                      : item.kind === "sensor-contact"
                        ? t.kindContact
                        : t.kindKit}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <FaqSection
      title={t.faqTitle}
      faqs={faqs}
      lede={t.faqLede}
    />
  </div>
</Layout>
