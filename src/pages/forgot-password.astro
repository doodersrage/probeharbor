---
import Layout from "../layouts/Layout.astro";
import { getLocale } from "../i18n";
import { authPasswordMessages } from "../i18n/messages/app/auth/password";

const messages = authPasswordMessages(getLocale(Astro));

const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "missing_email"
    ? messages.errors.missing_email
    : error === "verification"
      ? messages.errors.verification
      : null;
---

<Layout
  title={messages.forgot.title}
  description={messages.forgot.description}
  noindex
>
  <div class="auth-page">
    <header class="auth-intro page-header">
      <h1 class="page-header-title">{messages.forgot.heading}</h1>
      <p class="page-header-lede">{messages.forgot.lede}</p>
    </header>

    <section class="form-panel">
      {sent ? (
        <div class="alert-success mt-0">
          <p class="m-0">{messages.forgot.sent}</p>
        </div>
      ) : (
        <form action="/api/auth/forgot-password" method="post">
          {errorMessage && (
            <div class="alert-warning mb-4" role="alert">
              <p class="m-0">{errorMessage}</p>
            </div>
          )}
          <div class="form-field">
            <label class="form-label" for="email">{messages.email}</label>
            <input class="form-input" type="email" name="email" id="email" required />
          </div>
          <div class="form-field">
            <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
          </div>
          <button class="btn-primary" type="submit">{messages.forgot.submit}</button>
        </form>
      )}
    </section>

    <p class="auth-switch">
      <a class="text-link" href="/signin">{messages.backToSignIn}</a>
    </p>
  </div>
</Layout>
