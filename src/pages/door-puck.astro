---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";

const m = accessoriesMessages(getLocale(Astro));
const c = m.common;
const t = m.doorPuck;

const REED = BOM.adafruitReed;
const ESP32 = BOM.adafruitEsp32;
---
<AccessoryProduct
  accessoryId="door-puck"
  faqKey="doorPuck"
  title={t.title}
  description={t.description}
>
  <a slot="actions" class="btn-primary" href="/dashboard/devices">{c.devices}</a>
  <a slot="actions" class="btn-secondary" href="/about/adding-devices">{t.addingDevices}</a>
  <a
    slot="actions"
    class="btn-ghost"
    href="https://github.com/doodersrage/probeharbor/tree/main/sketches/arduino/door_contact_ingest"
    target="_blank"
    rel="noreferrer"
  >
    {c.sketch}
  </a>

  <section class="card">
    <h2 class="card-title">{c.whatItIs}</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>{c.does}</strong> <Fragment set:html={t.doesHtml} />
      </li>
      <li>
        <strong>{c.doesNot}</strong> <Fragment set:html={t.doesNotHtml} />
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">{c.parts}</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.colPart}</th>
            <th scope="col">{c.colWhy}</th>
            <th scope="col">{c.colBuy}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">ESP32 DevKit</th>
            <td>{t.esp32Why}</td>
            <td>
              <a class="text-link" href={ESP32} target="_blank" rel={commerceLinkRel(ESP32)}>{c.adafruitEsp32}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.reedPart}</th>
            <td>{t.reedWhy}</td>
            <td>
              <a class="text-link" href={REED} target="_blank" rel={commerceLinkRel(REED)}>{t.reedBuy}</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">{c.setup}</h2>
    <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
      {t.stepsHtml.map((step) => <li set:html={step} />)}
    </ol>
  </section>
</AccessoryProduct>
