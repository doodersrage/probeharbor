                statusVisible={showPinnedMetric("freeze_hours")}
                canPin={canEdit}
              />
            )}
            {(canEdit || showPinnedMetric("coldest_margin")) && (
              <MetricCard
                label={metricLabel("coldest_margin")}
                value={
                  coldestProbeMarginF == null
                    ? "—"
                    : `${signed(coldestProbeMarginF, 1)}°F`
                }
                detail={
                  coldestProbeTempF != null
                    ? fmt(t.client.marginDetail, {
                        temp: num(coldestProbeTempF, 1),
                        threshold: plainNum(alertSettings.freezeThresholdF),
                      })
