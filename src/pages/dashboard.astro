        {(canEdit || showPinnedMetric("sensors")) && (
          <MetricCard
            label={metricLabel("sensors")}
            value={sensorsValue}
            detail={sensorCount > 0 ? fmt(t.client.totalCount, { count: plainNum(sensorCount) }) : null}
            href="/dashboard/devices"
            tone={staleSensorCount > 0 ? "warning" : "neutral"}
            metricId="sensors"
            pinned={showPinnedMetric("sensors")}
            statusVisible={showPinnedMetric("sensors")}
            canPin={canEdit}
            snapshotField="sensors"
          />
        )}
        {!firstRunFocus && (canEdit || showPinnedMetric("feeds")) && (
          <MetricCard
            label={metricLabel("feeds")}
            value={feedsValue}
            href={devicesSetupPath({ tab: "pull", hash: "pull-feeds" })}
            tone={feedIssueCount > 0 ? "warning" : "neutral"}
            metricId="feeds"
            pinned={showPinnedMetric("feeds")}
            statusVisible={showPinnedMetric("feeds")}
            canPin={canEdit}
          />
        )}
        {(canEdit || showPinnedMetric("alerts")) && (
          <MetricCard
            label={metricLabel("alerts")}
            value={alertSettings.enabled ? t.client.on : t.client.off}
            detail={
              lastAlertAt ? fmt(tm.lastAlert, { age: lastAlertAge.label }) : hasSentAnyAlert ? tm.testSent : tm.sendTest
            }
            href="/dashboard/alerts"
            tone={alertSettings.enabled ? "success" : "neutral"}
            metricId="alerts"
            pinned={showPinnedMetric("alerts")}
            statusVisible={showPinnedMetric("alerts")}
            canPin={canEdit}
            snapshotField="alerts"
          />
        )}
        {!firstRunFocus && houseContext && (canEdit || showPinnedMetric("house")) && (
          <MetricCard
            label={metricLabel("house")}
            value={houseContext.metricValue}
            detail={houseContext.metricDetail}
            href={devicesSetupPath({ tab: "thermostat", hash: "indoor-reference" })}
            tone="neutral"
            metricId="house"
            pinned={showPinnedMetric("house")}
            statusVisible={showPinnedMetric("house")}
            canPin={canEdit}
          />
        )}
        {!firstRunFocus && (
          <>
            {(canEdit || showPinnedMetric("freeze_hours")) && (
              <MetricCard
                label={metricLabel("freeze_hours")}
                value={
                  chartWeek.points.length < 2
                    ? "—"
                    : fmt(tm.hours, { hours: num(freezeHours.hoursBelow34, 1) })
                }
                detail={
                  freezeHours.degreeHoursBelow > 0
                    ? fmt(tm.degreeHoursBelow, {
                        value: num(freezeHours.degreeHoursBelow, 0),
                        threshold: plainNum(alertSettings.freezeThresholdF),
                      })
                    : freezeHours.coldestF != null
                      ? fmt(tm.coldest, { temp: num(freezeHours.coldestF, 1) })
                      : fmt(tm.atOrBelow, { threshold: plainNum(alertSettings.freezeThresholdF) })
                }
                href="/dashboard/history"
                tone={freezeHours.hoursBelow34 > 0 ? "warning" : "neutral"}
                metricId="freeze_hours"
