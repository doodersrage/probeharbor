            <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]" data-pin-count>
              {fmt(t.client.pinCount, { count: plainNum(pinnedMetricSet.size), max: plainNum(PINNED_METRICS_MAX) })} {t.client.pinRoomHint}
            </p>
            <form
              action="/api/user/dashboard-pinned-metrics"
              method="post"
              class="mt-3 flex flex-wrap gap-3 items-end"
              data-pin-form
              data-pin-max={PINNED_METRICS_MAX}
            >
              <input type="hidden" name="redirect" value="/dashboard" />
              {PINNABLE_OVERVIEW_METRICS.map((id) => (
                <label class="text-sm flex items-center gap-1">
                  <input
                    type="checkbox"
                    name="metrics"
                    value={id}
                    checked={pinnedMetricSet.has(id)}
                  />
                  <span>{metricLabel(id)}</span>
                </label>
              ))}
              <button type="submit" class="btn-secondary btn-sm">{t.glance.savePins}</button>
            </form>
          </details>
        )}
      </div>
      {pinnedFlash && (
        <p class:list={[pinnedFlash === "saved" ? "alert-success" : "alert-warning", "mt-0 mb-0"]} role="status">
          {pinnedFlash === "saved"
            ? t.glance.pinnedSaved
            : pinnedFlash === "max"
              ? fmt(t.glance.pinnedMax, { max: plainNum(PINNED_METRICS_MAX) })
              : t.glance.pinnedError}
