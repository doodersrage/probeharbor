---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { CLAIM_PUCK_REPO_URL } from "../lib/claimPuck";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";
import { getLocalizedClaimPuckText } from "../i18n/content/accessories";

const locale = getLocale(Astro);
const m = accessoriesMessages(locale);
const c = m.common;
const t = m.claimPuck;
const puck = getLocalizedClaimPuckText(locale);

const ZERO = BOM.amazonRp2040Zero;
const BUTTON = BOM.adafruitButton;
---
<AccessoryProduct
  accessoryId="claim-puck"
  faqKey="claimPuck"
  title={puck.name}
  description={puck.tagline}
>
  <a slot="actions" class="btn-primary" href="/bay-buddy">
    {c.getBayBuddy}
  </a>
  <a slot="actions" class="btn-secondary" href={CLAIM_PUCK_REPO_URL} target="_blank" rel="noreferrer">
    {t.firmware}
  </a>
  <a slot="actions" class="btn-ghost" href="/docs/api#claim-puck">
    {t.claimApi}
  </a>

  <section class="card">
    <h2 class="card-title">{c.whatItIs}</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>{c.does}</strong> <Fragment set:html={t.doesHtml} />
      </li>
      <li>
        <strong>{c.doesNot}</strong> <Fragment set:html={t.doesNotHtml} />
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">{c.parts}</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.colPart}</th>
            <th scope="col">{c.colWhy}</th>
            <th scope="col">{c.colBuy}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Waveshare RP2040-Zero</th>
            <td>{t.zeroWhy}</td>
            <td>
              <a class="text-link" href={ZERO} target="_blank" rel={commerceLinkRel(ZERO)}>Amazon</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{c.momentaryButton}</th>
            <td>{c.buttonWhy}</td>
            <td>
              <a class="text-link" href={BUTTON} target="_blank" rel={commerceLinkRel(BUTTON)}>{c.adafruitButton}</a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.casePart}</th>
            <td>{t.caseWhy}</td>
            <td>
              <a class="text-link" href="/claim-puck-case">{t.caseBuy}</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">{c.setup}</h2>
    <p class="card-subtitle mb-4">{puck.bayBuddyNote}</p>
    <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
      {t.stepsHtml.map((step) => <li set:html={step} />)}
    </ol>
    <div class="flex flex-wrap gap-3">
      <a class="btn-primary" href="/bay-buddy">{t.openBayBuddy}</a>
      <a class="btn-secondary" href="/docs/api#claim-puck">{t.claimApiReference}</a>
      <a class="btn-ghost" href="/claim-puck-case">{t.caseDiffuser}</a>
    </div>
  </section>
</AccessoryProduct>
