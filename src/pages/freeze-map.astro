---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  countFreezeMapOptIns,
  listFreezeMapSparklines,
  listLatestFreezeMapSnapshots,
} from "../lib/freezeMap";
import {
  FREEZE_MAP_SAMPLE_FLOOR,
  resolveFreezeMapDisplay,
} from "../lib/freezeMapSeed";
import { getAuthFromCookies } from "../lib/auth";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getLocale, localizePath } from "../i18n";
import { freezeMapMessages, formatFreezeMapAge } from "../i18n/messages/freezeMap";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

const { user } = await getAuthFromCookies(Astro.cookies);
const locale = getLocale(Astro);
const t = freezeMapMessages(locale);
const clientText = t.client;
const showSparse = Astro.url.searchParams.get("sparse") === "1";
const [liveSnapshots, liveSparklines, optInCount] = await Promise.all([
  listLatestFreezeMapSnapshots(),
  listFreezeMapSparklines(7),
  countFreezeMapOptIns(),
]);
const resolved = resolveFreezeMapDisplay(liveSnapshots, liveSparklines);
const snapshots = resolved.snapshots;
const sparklines = resolved.sparklines;
const isSeed = resolved.isSeed;
const approaching = resolved.approaching.slice(0, 6);
const visible = showSparse
  ? snapshots
  : snapshots.filter((row) => row.sample_count >= FREEZE_MAP_SAMPLE_FLOOR);
const sparseHidden = snapshots.length - visible.length;
const capturedAt = isSeed ? null : (snapshots[0]?.captured_at ?? null);
const captureAge = formatFreezeMapAge(capturedAt, locale);

const coldest = [...visible]
  .filter((row) => row.min_temp_f != null)
  .sort((a, b) => (a.min_temp_f ?? 999) - (b.min_temp_f ?? 999))
  .slice(0, 5);

const mapPins = visible
  .filter((row) => row.lat != null && row.lon != null)
  .map((row) => ({
    lat: row.lat!,
    lon: row.lon!,
    label: row.city_label,
    avg: row.avg_temp_f,
    samples: row.sample_count,
    riskPct:
      row.sample_count > 0
        ? Math.round((row.freeze_risk_count / row.sample_count) * 100)
        : 0,
  }));
const mapPinsJson = JSON.stringify(mapPins);

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath("/freeze-map", locale));
// Plain attribution link outside the iframe: links inside an iframe don't count for the host page.
const embedSnippet = `<iframe src="${siteUrl}/embed/freeze-map" title="ProbeHarbor freeze-risk map" width="100%" height="420" style="border:0;border-radius:12px" loading="lazy"></iframe>
<p><a href="${siteUrl}/freeze-map">Freeze-risk map</a> by ProbeHarbor</p>`;
const badgeSnippet = `[![ProbeHarbor freeze map](${siteUrl}/badge/freeze-map.svg)](${siteUrl}/freeze-map)`;
const freezeMapFaqs = getLocalizedMarketingFaqs("freeze-map", locale);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.breadcrumb, path: localizePath("/freeze-map", locale) },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, "freeze-map", locale),
].filter(Boolean) as Record<string, unknown>[];

const optInHref = user
  ? "/dashboard/household#freeze-map"
  : "/register?next=/dashboard/household";
const optInLabel = user ? t.optInHousehold : t.optInStart;

function sparkPath(values: number[]): string {
  if (values.length < 2) return "";
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const w = 80;
  const h = 24;
  return values
    .map((v, i) => {
      const x = (i / (values.length - 1)) * w;
      const y = h - ((v - min) / range) * h;
      return `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}

function trendDeltaLabel(values: number[]): string {
  if (values.length < 2) return t.trendNoHistory;
  const delta = values[values.length - 1]! - values[0]!;
  if (Math.abs(delta) < 0.3) return t.trendSteady;
  return delta < 0 ? t.trendCooling(Math.abs(delta)) : t.trendWarming(delta);
}
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.title}
      lede={t.lede}
    >
      <a slot="actions" class="btn-primary" href={optInHref}>{optInLabel}</a>
      {!user && (
        <a slot="actions" class="btn-secondary" href="/signin?next=/dashboard/household">{t.signIn}</a>
      )}
      <a slot="actions" class="btn-ghost" href="/embed/freeze-map">{t.embed}</a>
      <a slot="actions" class="btn-ghost" href="/freeze-season">{t.freezeSeason}</a>
      <a slot="actions" class="btn-ghost" href="/share-kit">{t.shareKit}</a>
    </PageHeader>

    {isSeed ? (
      <p class="alert-warning mt-0" role="status">
        <Fragment set:html={t.seedIntroHtml(FREEZE_MAP_SAMPLE_FLOOR)} />
        {" "}
        {optInCount === 0 ? t.optInNone : t.optInCount(optInCount)}
        {" "}
        <a class="text-link" href={optInHref}>{user ? t.linkOptIn : t.linkCreate}</a>.
      </p>
    ) : (
      <p class="alert-info mt-0" role="status">
        {t.liveNotice(optInCount, FREEZE_MAP_SAMPLE_FLOOR)}
        {capturedAt ? (
          <>
            {t.lastSnapshot(captureAge.label)}
            {captureAge.absolute ? ` (${captureAge.absolute})` : ""}
          </>
        ) : null}
        {t.liveOptOut}
      </p>
    )}

    {(isSeed || approaching.length > 0) && (
      <section class="card">
        <h2 class="card-title">{t.momentumTitle}</h2>
        <p class="card-subtitle mb-4">
          {approaching.length > 0
            ? t.momentumApproaching(FREEZE_MAP_SAMPLE_FLOOR)
            : t.momentumWaiting(FREEZE_MAP_SAMPLE_FLOOR)}
        </p>
        {approaching.length > 0 ? (
          <ul class="space-y-2 mb-4 text-sm">
            {approaching.map((row) => {
              const needed = FREEZE_MAP_SAMPLE_FLOOR - row.sample_count;
              return (
                <li>
                  <strong>{row.city_label}</strong>
                  {": "}
                  {t.householdsProgress(row.sample_count, FREEZE_MAP_SAMPLE_FLOOR)}
                  {needed > 0 ? t.moreToGo(needed) : ""}
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="text-sm text-[var(--color-text-muted)] mb-4">
            {t.noSparse}
          </p>
        )}
        <a class="btn-secondary" href={optInHref}>{optInLabel}</a>
      </section>
    )}

    {coldest.length > 0 && (
      <section class="card">
        <h2 class="card-title">{t.coldestTitle}</h2>
        <ol class="space-y-2 mb-0 text-sm">
          {coldest.map((row, i) => (
            <li>
              <strong>#{i + 1} {row.city_label}</strong>
              {": "}
              {row.min_temp_f != null ? t.coldestMin(row.min_temp_f) : ""}
              {row.avg_temp_f != null ? t.coldestAvg(row.avg_temp_f) : ""}
              {" · "}
              {t.households(row.sample_count)}
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="card">
      <p class="mb-0 text-sm">
        {showSparse ? (
          <a class="text-link" href="/freeze-map">{t.hideSparse(FREEZE_MAP_SAMPLE_FLOOR)}</a>
        ) : (
          <a class="text-link" href="/freeze-map?sparse=1">
            {t.showSparse}{sparseHidden > 0 ? t.hiddenCount(sparseHidden) : ""}
          </a>
        )}
      </p>
    </section>

    {mapPins.length > 0 && (
      <section class="card">
        <h2 class="card-title">{t.mapTitle}</h2>
        <p class="card-subtitle mb-4">
          {t.mapSubtitle}
        </p>
        <div id="freeze-map-leaflet" class="weather-map-frame freeze-map-frame" style="height:22rem">
          <div class="loading-state freeze-map-loading" id="freeze-map-loading">
            <p class="m-0">{t.loadingMap}</p>
          </div>
        </div>
        <link
          rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          crossorigin=""
        />
        <script is:inline define:vars={{ mapPinsJson, clientText }}>
          (() => {
            const pins = JSON.parse(mapPinsJson);
            function init() {
              const el = document.getElementById("freeze-map-leaflet");
              const loading = document.getElementById("freeze-map-loading");
              if (!el || typeof L === "undefined" || pins.length === 0) return;
              if (loading) loading.remove();
              const map = L.map(el).setView([pins[0].lat, pins[0].lon], 4);
              const base = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution:
                  '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                maxZoom: 18,
                subdomains: "abc",
              }).addTo(map);

              const overlays = {};
              {
                const owmAttr =
                  'Weather &copy; <a href="https://openweathermap.org/">OpenWeather</a>';
                overlays[clientText.layerTemperature] = L.tileLayer(
                  "/api/weather/tiles/temp_new/{z}/{x}/{y}",
                  { opacity: 0.55, maxZoom: 18, attribution: owmAttr },
                );
                overlays[clientText.layerPrecipitation] = L.tileLayer(
                  "/api/weather/tiles/precipitation_new/{z}/{x}/{y}",
                  { opacity: 0.55, maxZoom: 18, attribution: owmAttr },
                );
                overlays[clientText.layerTemperature].addTo(map);
                L.control.layers({ [clientText.layerMap]: base }, overlays, { collapsed: false }).addTo(map);
              }

              for (const pin of pins) {
                const color =
                  pin.riskPct >= 50 ? "#ef4444" : pin.riskPct >= 25 ? "#f59e0b" : "#22c55e";
                const radius = Math.min(24, 6 + Math.sqrt(pin.samples || 1) * 2);
                L.circleMarker([pin.lat, pin.lon], {
                  radius,
                  color,
                  fillColor: color,
                  fillOpacity: 0.55,
                })
                  .bindPopup(
                    `<strong>${pin.label}</strong><br/>${clientText.popupAvg} ${pin.avg?.toFixed(1) ?? "—"}°F<br/>${clientText.popupRisk} ${pin.riskPct}% · ${pin.samples} ${clientText.popupHouseholds}`,
                  )
                  .addTo(map);
                L.circle([pin.lat, pin.lon], {
                  radius: radius * 8000,
                  color,
                  fillColor: color,
                  fillOpacity: 0.08,
                  weight: 1,
                }).addTo(map);
              }
              if (pins.length > 1) {
                const bounds = L.latLngBounds(pins.map((p) => [p.lat, p.lon]));
                map.fitBounds(bounds, { padding: [24, 24] });
              }
            }
            if (typeof L !== "undefined") {
              init();
            } else {
              const s = document.createElement("script");
              s.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
              s.crossOrigin = "";
              s.onload = init;
              document.head.appendChild(s);
            }
          })();
        </script>
      </section>
    )}

    <section class="card">
      {visible.length === 0 ? (
        <p class="mb-0 text-[var(--color-text-muted)]">
          {t.noSamples}{!showSparse && sparseHidden > 0 ? t.noSamplesFloor : ""}.
          {user ? t.noSamplesUser : t.noSamplesGuest}
        </p>
      ) : (
        <>
          <div class="overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>{t.thCity}</th>
                  <th scope="col">{t.thTrend} <span class="font-normal text-[var(--color-text-muted)]">{t.thTrendUnit}</span></th>
                  <th>{t.thHouseholds}</th>
                  <th>{t.thAvg}</th>
                  <th>{t.thMin}</th>
                  <th>
                    {t.thRisk}
                    <span class="block font-normal text-xs text-[var(--color-text-muted)]">{t.thRiskNote}</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {visible.map((row) => {
                  const riskPct =
                    row.sample_count > 0
                      ? Math.round((row.freeze_risk_count / row.sample_count) * 100)
                      : 0;
                  const sparse = row.sample_count < FREEZE_MAP_SAMPLE_FLOOR;
                  const spark = sparklines.get(row.city_id) ?? [];
                  const path = sparkPath(spark);
                  const delta = trendDeltaLabel(spark);
                  return (
                    <tr>
                      <td>
                        <strong>{row.city_label}</strong>
                        {sparse && (
                          <span class="block text-xs text-[var(--color-text-muted)]">
                            {t.sparse}
                          </span>
                        )}
                      </td>
                      <td>
                        {path ? (
                          <span class="inline-flex items-center gap-2" title={delta}>
                            <svg width="80" height="24" viewBox="0 0 80 24" aria-hidden="true">
                              <path
                                d={path}
                                fill="none"
                                stroke="var(--color-accent)"
                                stroke-width="1.75"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <span class="text-xs text-[var(--color-text-muted)]">{delta}</span>
                          </span>
                        ) : (
                          <span class="text-[var(--color-text-muted)]" title={t.needsSnapshots}>: </span>
                        )}
                      </td>
                      <td>{row.sample_count}</td>
                      <td>
                        {row.avg_temp_f != null ? t.tableNumber(row.avg_temp_f) : "—"}
                      </td>
                      <td>
                        {row.min_temp_f != null ? t.tableNumber(row.min_temp_f) : "—"}
                      </td>
                      <td>
                        {riskPct}%
                        <span class="text-[var(--color-text-muted)]">
                          {" "}{t.riskOf(row.freeze_risk_count, row.sample_count)}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-[var(--color-text-muted)] mt-3 mb-0">
            {t.tableNote}
          </p>
        </>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">{t.findTitle}</h2>
      <p class="card-subtitle mb-4">
        {t.findSubtitle}
        {user ? t.findUser : t.findGuest}
      </p>
      <div class="form-field mb-0">
        <label class="form-label" for="freeze-map-search">{t.searchLabel}</label>
        <input class="form-input" id="freeze-map-search" type="search" placeholder={t.searchPlaceholder} autocomplete="off" />
      </div>
      <ul id="freeze-map-search-results" class="space-y-2 text-sm mt-3 mb-0"></ul>
    </section>

    <section class="card" id="embed">
      <h2 class="card-title">{t.embedTitle}</h2>
      <p class="card-subtitle mb-4" set:html={t.embedLedeHtml} />
      <div class="form-field">
        <label class="form-label" for="freeze-embed-code">{t.embedCode}</label>
        <textarea class="form-textarea font-mono text-xs" id="freeze-embed-code" rows="4" readonly>{embedSnippet}</textarea>
        <button type="button" class="btn-secondary mt-2" data-copy-target="freeze-embed-code">{t.copyEmbed}</button>
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="freeze-badge-code">{t.badgeLabel}</label>
        <textarea class="form-textarea font-mono text-xs" id="freeze-badge-code" rows="2" readonly>{badgeSnippet}</textarea>
        <button type="button" class="btn-secondary mt-2" data-copy-target="freeze-badge-code">{t.copyBadge}</button>
      </div>
    </section>

    <FaqSection
      faqs={freezeMapFaqs}
      lede={t.faqLede}
    />
  </div>
</Layout>

<script is:inline define:vars={{ clientText }}>
  (() => {
    const input = document.getElementById("freeze-map-search");
    const results = document.getElementById("freeze-map-search-results");
    if (!(input instanceof HTMLInputElement) || !results) return;

    let timer = null;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) {
        results.innerHTML = "";
        return;
      }
      timer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/weather/city-search?q=${encodeURIComponent(q)}`);
          const data = await res.json();
          const rows = Array.isArray(data.results) ? data.results : [];
          results.innerHTML = rows
            .slice(0, 6)
            .map((row) => {
              const lat = row.lat?.toFixed?.(2) ?? "?";
              const lon = row.lon?.toFixed?.(2) ?? "?";
              const label = String(row.label ?? "").replace(/</g, "&lt;");
              return `<li><strong>${label}</strong> · ${lat}, ${lon}</li>`;
            })
            .join("");
        } catch {
          results.innerHTML = `<li>${clientText.searchFailed}</li>`;
        }
      }, 300);
    });

    document.querySelectorAll("[data-copy-target]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-copy-target");
        const el = id ? document.getElementById(id) : null;
        if (!(el instanceof HTMLTextAreaElement) || !(btn instanceof HTMLButtonElement)) return;
        try {
          await navigator.clipboard.writeText(el.value);
          const prev = btn.textContent;
          btn.textContent = clientText.copied;
          setTimeout(() => {
            btn.textContent = prev;
          }, 1800);
        } catch {
          btn.textContent = clientText.copyFailed;
        }
      });
    });
  })();
</script>
