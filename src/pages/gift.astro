---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import {
  getBreadcrumbSchema,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getAuthFromCookies } from "../lib/auth";
import { getLocale, localizePath } from "../i18n";
import { giftMessages } from "../i18n/messages/gift";

const { user } = await getAuthFromCookies(Astro.cookies);
const locale = getLocale(Astro);
const t = giftMessages(locale);
const siteUrl = resolveSiteUrl(Astro.site);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: localizePath("/", locale) },
    { name: t.title, path: localizePath("/gift", locale) },
  ]),
];
---
<Layout
  title={t.title}
  description={t.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={t.title}
      lede={t.lede}
    >
      {user ? (
        <a slot="actions" class="btn-primary" href="/dashboard/alerts?tab=settings#referral-card">{t.copyLink}</a>
      ) : (
        <a slot="actions" class="btn-primary" href="/register?next=/dashboard/alerts">{t.createAccount}</a>
      )}
      <a slot="actions" class="btn-secondary" href="/pricing">{t.seePlans}</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">{t.howTitle}</h2>
      <ol class="text-sm space-y-2 mb-0">
        {t.howStepsHtml.map((item) => <li set:html={item} />)}
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">{t.freeTitle}</h2>
      <p class="card-subtitle mb-0" set:html={t.freeHtml} />
    </section>
  </div>
</Layout>
