---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";

const m = accessoriesMessages(getLocale(Astro));
const c = m.common;
const t = m.kitLabels;

const NFC = BOM.adafruitNfcNtag213;
---
<AccessoryProduct
  accessoryId="kit-labels"
  faqKey="kitLabels"
  title={t.title}
  description={t.description}
  kicker={c.kitKicker}
>
  <a slot="actions" class="btn-primary" href="/about/kit-qr-onboarding">{t.kitQrGuide}</a>
  <a slot="actions" class="btn-secondary" href="/dashboard/devices">{c.devices}</a>
  <a slot="actions" class="btn-ghost" href="/claims-pack">{t.claimsPack}</a>

  <section class="card">
    <h2 class="card-title">{c.whatItIs}</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>{c.does}</strong> <Fragment set:html={t.doesHtml} />
      </li>
      <li>
        <strong>{c.doesNot}</strong> <Fragment set:html={t.doesNotHtml} />
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">{c.parts}</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.colPart}</th>
            <th scope="col">{c.colWhy}</th>
            <th scope="col">{c.colBuy}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{t.stockPart}</th>
            <td>{t.stockWhy}</td>
            <td>{t.stockBuy}</td>
          </tr>
          <tr>
            <th scope="row">{t.nfcPart}</th>
            <td>{t.nfcWhy}</td>
            <td>
              <a class="text-link" href={NFC} target="_blank" rel={commerceLinkRel(NFC)}>{t.nfcBuy}</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">{c.setup}</h2>
    <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
      {t.stepsHtml.map((step) => <li set:html={step} />)}
    </ol>
  </section>
</AccessoryProduct>
