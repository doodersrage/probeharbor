---
import type { AlertChannelName } from "../../lib/alerts";
import { channelLastAttemptFailed, type ChannelDelivery } from "../../lib/channelDelivery";
import { formatRelativeAge } from "../../lib/relativeTime";
import { fmt, getLocale, type Locale } from "../../i18n";
import { alertSettingsMessages } from "../../i18n/messages/app/alertSettings";

interface Props {
  channel: AlertChannelName;
  delivery?: ChannelDelivery;
  /** Channel is on in saved settings (tests use saved settings). */
  enabledSaved: boolean;
  canEdit: boolean;
}

const { channel, delivery, enabledSaved, canEdit } = Astro.props;
const locale = getLocale(Astro);
const t = alertSettingsMessages(locale).delivery;

/** "5m ago" in English (as before); Intl relative time elsewhere. */
function age(iso: string | null | undefined, locale: Locale): string {
  return formatRelativeAge(iso, undefined, locale).label;
}

const failed = channelLastAttemptFailed(delivery);
const status = failed
  ? fmt(t.lastFailed, { age: age(delivery?.lastFailedAt, locale) })
  : delivery?.lastSentAt
    ? fmt(t.lastDelivered, { age: age(delivery.lastSentAt, locale) })
    : t.none;
---
<div class="channel-delivery" data-channel-delivery={channel}>
  <span
    class:list={["channel-delivery-status", failed && "is-failed"]}
    title={delivery?.lastFailedAt && failed ? t.failedTitle : undefined}
  >
    {status}
  </span>
  {canEdit && (
    <button
      type="button"
      class="btn-ghost btn-sm"
      data-channel-test={channel}
      disabled={!enabledSaved}
      title={enabledSaved ? t.sendTestTitle : t.saveFirstTitle}
    >
      {t.sendTest}
    </button>
  )}
  <span class="channel-delivery-result" data-channel-test-result={channel} role="status" aria-live="polite"></span>
</div>

<style>
  .channel-delivery {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .channel-delivery-status.is-failed {
    color: var(--color-danger);
    font-weight: 600;
  }
  .channel-delivery-result:empty {
    display: none;
  }
  .channel-delivery-result[data-state="ok"] {
    color: var(--color-success-text, var(--color-success));
  }
  .channel-delivery-result[data-state="error"] {
    color: var(--color-danger);
  }
</style>
