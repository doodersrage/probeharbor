---
import I18nJson from "../I18nJson.astro";
import { getLocale } from "../../i18n";
import { alertSettingsMessages } from "../../i18n/messages/app/alertSettings";
import { ALERT_CHANNEL_LABELS, formatAlertChannelList } from "../../lib/alertChannelLabels";

const locale = getLocale(Astro);
const t = alertSettingsMessages(locale);
// Channel / skip-reason names for "Sent. Check …" and "Not sent: …".
const channelLabels = Object.fromEntries(
  Object.keys(ALERT_CHANNEL_LABELS).map((key) => [key, formatAlertChannelList([key], locale)]),
);
---
<I18nJson id="alert-settings-submit-i18n" data={t.clientSubmit} />
<I18nJson id="alert-settings-channel-labels" data={channelLabels} />
<script>
  import { actions } from "astro:actions";
  import { prepareAlertSettingsFormData } from "../../lib/alertSettingsForm";
  import alertMessagesEn from "../../i18n/messages/app/alertMessages/en";
  import { fmt, readI18nJson } from "../../i18n/client";
  import en from "../../i18n/messages/app/alertSettings/en";

  const text = readI18nJson("alert-settings-submit-i18n", en.clientSubmit);
  const channelLabels = readI18nJson<Record<string, string>>("alert-settings-channel-labels", alertMessagesEn.channelLabels);

  const form = document.querySelector<HTMLFormElement>("[data-alert-settings-form]");
  const statusEl = document.getElementById("alert-action-status");
  const errorEl = document.getElementById("alert-action-error");
  const submitBtn = document.getElementById("alert-settings-submit");

  function showStatus(message: string) {
    statusEl?.classList.remove("hidden");
    errorEl?.classList.add("hidden");
    if (statusEl) statusEl.textContent = message;
  }

  function showError(message: string) {
    errorEl?.classList.remove("hidden");
    statusEl?.classList.add("hidden");
    if (errorEl) errorEl.textContent = message;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const sync = (
      window as Window & { syncAlertSettingsFormFields?: () => void }
    ).syncAlertSettingsFormFields;
    sync?.();

    statusEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = text.saving;
    }

    const formData = prepareAlertSettingsFormData(new FormData(form));
    const { data, error } = await actions.updateAlertSettings(formData);

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = false;
      submitBtn.textContent = text.saveButton;
    }

    if (error) {
      showError(error.message || text.saveFailed);
      return;
    }

    // Navigate immediately so a quick "Send test now" click cannot race a
    // delayed reload (SSR flash banner carries the same success copy).
    const params = new URLSearchParams({ tab: "settings", alert_saved: "1" });
    if (data?.channelsIncomplete) params.set("channels_incomplete", "1");
    window.location.assign(`/dashboard/alerts?${params.toString()}`);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-snooze-action]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const action = btn.dataset.snoozeAction;
      if (!action) return;
      btn.disabled = true;
      const formData = new FormData();
      formData.set("action", action);
      if (action === "vacation_until") {
        const until = document.querySelector<HTMLInputElement>("[data-vacation-until-date]")?.value;
        if (!until) {
          btn.disabled = false;
          showError(text.pickVacationDate);
          return;
        }
        formData.set("until", until);
      }
      const { data, error } = await actions.updateAlertSnooze(formData);
      btn.disabled = false;
      if (error) {
        showError(error.message || text.snoozeFailed);
        return;
      }
      showStatus(data?.message ?? text.updated);
      window.setTimeout(() => window.location.reload(), 600);
    });
  });

  // Per-channel "Send test": uses saved settings, reports the result inline.
  document.querySelectorAll<HTMLButtonElement>("[data-channel-test]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const channel = btn.dataset.channelTest;
      if (!channel) return;
      const out = document.querySelector<HTMLElement>(`[data-channel-test-result="${channel}"]`);
      const say = (message: string, state: "pending" | "ok" | "error") => {
        if (!out) return;
        out.textContent = message;
        out.dataset.state = state;
      };
      btn.disabled = true;
      say(text.sending, "pending");
      try {
        const res = await fetch(`/api/user/alert-test?channel=${encodeURIComponent(channel)}`, {
          method: "POST",
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        const body = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          skipped?: string[];
        };
        if (res.ok && body.ok) {
          say(fmt(text.sent, { channel: channelLabels[channel] ?? channel }), "ok");
          return;
        }
        const reasons = (body.skipped ?? [])
          .filter((reason) => reason !== channel)
          .map((reason) => channelLabels[reason] ?? reason);
        say(
          reasons.length > 0
            ? fmt(text.notSentReasons, { reasons: reasons.join(", ") })
            : text.notSent,
          "error",
        );
      } catch {
        say(text.unreachable, "error");
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
