---
import { getLocale, LOCALE_META } from "../../i18n";
import { alertSettingsMessages } from "../../i18n/messages/app/alertSettings";

interface Props {
  vapidPublicKey: string;
}

const { vapidPublicKey } = Astro.props;
const locale = getLocale(Astro);
const text = alertSettingsMessages(locale).clientPush;
const intlLocale = LOCALE_META[locale].intl;
---
<script is:inline define:vars={{ vapidPublicKey, text, intlLocale }}>
    function fill(template, vars) {
      return template.replace(/\{(\w+)\}/g, (whole, name) => (name in vars ? String(vars[name]) : whole));
    }
    function androidDevices(count) {
      const forms = text.androidDevices;
      const form = forms[new Intl.PluralRules(intlLocale).select(count)] ?? forms.other;
      return fill(form, { count: new Intl.NumberFormat(intlLocale).format(count) });
    }

    function urlBase64ToUint8Array(base64String) {
      if (!base64String) throw new Error(text.noVapidKey);
      const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
      const rawData = atob(base64);
      return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
    }

    const btn = document.getElementById("enable-push-btn");
    const status = document.getElementById("push-status");
    const hint = document.getElementById("push-hint");
    const pushChannel = document.querySelector('[name="channel_push"]');
    let autoSubscribeAttempted = false;

    async function ensureServiceWorker() {
      await navigator.serviceWorker.register("/sw.js?v=6");
      return navigator.serviceWorker.ready;
    }

    async function subscribeThisBrowser() {
      if (!vapidPublicKey) {
        throw new Error(text.noVapidKeyServer);
      }
      const reg = await ensureServiceWorker();
      const permission = await Notification.requestPermission();
      if (permission !== "granted") {
        throw new Error(text.permissionDenied);
      }
      let sub = await reg.pushManager.getSubscription();
      if (!sub) {
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
        });
      }
      const json = sub.toJSON();
      const res = await fetch("/api/push/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ endpoint: json.endpoint, keys: json.keys }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => null);
        throw new Error(err?.error || text.serverRejected);
      }
      if (pushChannel instanceof HTMLInputElement) {
        pushChannel.checked = true;
      }
      if (status) {
        status.textContent = text.subscribed;
      }
      if (hint) {
        hint.textContent = text.subscribedHint;
      }
      if (btn) btn.textContent = text.refresh;
    }

    async function refreshPushStatus() {
      if (!status) return;
      if (!("Notification" in window) || !("serviceWorker" in navigator) || !("PushManager" in window)) {
        status.textContent = text.unsupported;
        if (btn) btn.hidden = true;
        return;
      }

      const permission = Notification.permission;
      if (permission === "denied") {
        status.textContent = text.blocked;
        if (btn) btn.textContent = text.retry;
        return;
      }

      try {
        const res = await fetch("/api/push/status");
        const server = res.ok ? await res.json() : null;
        const reg = await ensureServiceWorker();
        const existing = await reg.pushManager.getSubscription();

        if (existing && server?.subscriptionCount > 0) {
          const androidNote =
            typeof server.fcmTokenCount === "number" && server.fcmTokenCount > 0
              ? " " + androidDevices(server.fcmTokenCount)
              : "";
          status.textContent = text.enabled + androidNote;
          if (btn) btn.textContent = text.refresh;
          if (hint) {
            hint.textContent = server.channelEnabled
              ? text.channelOnHint
              : text.channelOffHint;
          }
        } else if (permission === "granted") {
          // Permission alone is not enough — finish PushManager subscribe + POST to server.
          if (!autoSubscribeAttempted && vapidPublicKey) {
            autoSubscribeAttempted = true;
            status.textContent = text.finishing;
            try {
              await subscribeThisBrowser();
              await refreshPushStatus();
              return;
            } catch (e) {
              status.textContent = fill(text.subscribeFailed, { error: e?.message || e });
              if (btn) btn.textContent = text.subscribe;
            }
          } else {
            status.textContent = text.notSubscribed;
            if (btn) btn.textContent = text.subscribe;
          }
        } else {
          status.textContent = text.notEnabled;
          if (btn) btn.textContent = text.enable;
        }

        if (server && !server.vapidConfigured && hint) {
          hint.textContent = text.vapidMissing;
        }
        if (server && server.fcmTokenCount > 0 && !server.channelEnabled && hint) {
          hint.textContent = text.androidRegistered;
        }
      } catch {
        status.textContent = text.statusFailed;
      }
    }

    btn?.addEventListener("click", async () => {
      try {
        await subscribeThisBrowser();
      } catch (e) {
        if (status) status.textContent = fill(text.enableFailed, { error: e?.message || e });
        await refreshPushStatus();
      }
    });

    refreshPushStatus();
  </script>
