---
/** Post-first-ingest checklist on Devices. */
interface Props {
  show: boolean;
  alertsDone?: boolean;
}

import { getLocale } from "../i18n";
import { devicesSetupMessages } from "../i18n/messages/app/devices/setup";

const { show, alertsDone = false } = Astro.props;
const t = devicesSetupMessages(getLocale(Astro)).funnel;
---

{show && (
  <section class="card alert-success" id="post-setup-funnel">
    <h2 class="card-title">{t.title}</h2>
    <ol class="waiting-ingest-checklist mb-4">
      <li class="waiting-ingest-done">{t.firstPost}</li>
      <li class:list={[alertsDone && "waiting-ingest-done", !alertsDone && "waiting-ingest-pending"]}>
        {alertsDone ? t.alertDone : t.alertTodo}
      </li>
      <li class="waiting-ingest-pending">
        <a class="text-link" href="/dashboard/share/links">{t.shareLink}</a>
        <span class="text-[var(--color-text-muted)]">{t.optional}</span>
      </li>
    </ol>
    <p class="mb-3 text-sm text-[var(--color-text-muted)]" set:html={t.renameHtml} />
    <div class="flex flex-wrap gap-3 mb-3">
      {!alertsDone && (
        <a class="btn-primary" href="#first-alert-setup">{t.setAlert}</a>
      )}
      {alertsDone && (
        <a class="btn-primary" href="/dashboard/alerts?tab=settings#send-test-alert">{t.sendTest}</a>
      )}
      <a class="btn-secondary" href="/dashboard">{t.overview}</a>
    </div>
    <details class="text-sm">
      <summary class="cursor-pointer text-link">{t.guides}</summary>
      <div class="mt-2 flex flex-wrap gap-2">
        <a class="btn-ghost btn-sm" href="/about/kit-qr-onboarding">{t.kitQr}</a>
        <a class="btn-ghost btn-sm" href="/about/esp32-freeze-kit">ESP32</a>
        <a class="btn-ghost btn-sm" href="/about/pico-w-ingest">Pico W</a>
        <a class="btn-ghost btn-sm" href="/about/cellular-ingest">{t.cellular}</a>
        <a class="btn-ghost btn-sm" href="/about/esphome-shelly-recipes">ESPHome / Shelly</a>
      </div>
    </details>
  </section>
)}
