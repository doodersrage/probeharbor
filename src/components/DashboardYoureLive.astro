---
import DashboardCard from "./dashboard/DashboardCard.astro";
import { getLocale } from "../i18n";
import { overviewNudgesMessages } from "../i18n/messages/app/overview/nudges";

interface Props {
  show: boolean;
  hasAlertsEnabled: boolean;
  hasEmailAlerts: boolean;
  hasTestAlert: boolean;
}

const { show, hasAlertsEnabled, hasEmailAlerts, hasTestAlert } = Astro.props;
if (!show) return null;
const t = overviewNudgesMessages(getLocale(Astro));
const tl = t.youreLive;

const nextHref =
  !hasAlertsEnabled || !hasEmailAlerts
    ? "/dashboard/alerts?tab=settings#alert-section-channels"
    : !hasTestAlert
      ? "/dashboard/alerts?tab=settings#send-test-alert"
      : "/dashboard/history";
const nextLabel =
  !hasAlertsEnabled || !hasEmailAlerts
    ? tl.finishAlertSetup
    : !hasTestAlert
      ? tl.sendTestAlert
      : tl.reviewHistory;
---
<div data-nudge-key="live_coach">
  <DashboardCard>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="card-title">{tl.title}</h2>
        <p class="card-subtitle mb-0">
          {tl.body}
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-primary" href="/dashboard/live">{tl.openLive}</a>
        <a class="btn-secondary" href={nextHref}>{nextLabel}</a>
        <button type="button" class="btn-ghost btn-sm" data-dismiss="live_coach">{t.dismiss}</button>
      </div>
    </div>
  </DashboardCard>
</div>
