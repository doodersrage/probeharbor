---
import type { UserPreferences } from "../lib/userPreferences";
import { WEATHER_CITY_PRESETS } from "../lib/weatherCities";
import { getDefaultWeatherCityId } from "../lib/FetchWeather";
import DashboardCard from "./dashboard/DashboardCard.astro";
import { fmt, getLocale } from "../i18n";
import { settingsMessages } from "../i18n/messages/app/settings";

interface Props {
  preferences: UserPreferences;
  redirectTo?: string;
}

const { preferences, redirectTo = "/" } = Astro.props;
const t = settingsMessages(getLocale(Astro)).display;
const defaultCityId = getDefaultWeatherCityId() ?? "";
const currentId = preferences.weatherCityId?.trim() || "";
const isCustom =
  Boolean(currentId) && !WEATHER_CITY_PRESETS.some((p) => p.id === currentId);
const selectValue = !currentId ? "" : isCustom ? "custom" : currentId;
---

<DashboardCard class="animate-zoom-in">
  <form method="POST" id="weather-prefs-form" data-prefs-form data-i18n={JSON.stringify(t.client)}>
    <input type="hidden" name="redirect" value={redirectTo} />
    <input type="hidden" name="weather_city_id" id="weather_city_id_value" value={currentId} />
    <h2 class="card-title">{t.heading}</h2>
    <p class="card-subtitle">{t.subtitle}</p>
    <p class="alert-success mt-0 mb-4 hidden" id="prefs-status" role="status"></p>
    <p class="alert-warning mt-0 mb-4 hidden" id="prefs-error" role="alert"></p>

    <div class="mb-6 flex flex-col gap-4">
      <label class="checkbox-row">
        <input
          type="checkbox"
          name="show_garage_temps"
          value="true"
          checked={preferences.showGarageTemps}
        />
        <span>{t.showProbeTemps}</span>
      </label>

      <label class="checkbox-row">
        <input
          type="checkbox"
          name="show_weather"
          value="true"
          checked={preferences.showWeather}
        />
        <span>{t.showWeather}</span>
      </label>

      <fieldset class="checkbox-group-nested" id="weather">
        <legend class="checkbox-group-label">{t.weatherSourceLegend}</legend>
        <div class="form-field mb-3">
          <label class="form-label" for="weather_source">{t.sourceLabel}</label>
          <select class="form-input" id="weather_source" name="weather_source">
            <option value="openweather" selected={preferences.weatherSource === "openweather"}>
              {t.sourceOpenWeather}
            </option>
            <option value="ambient" selected={preferences.weatherSource === "ambient"}>
              {t.sourceAmbient}
            </option>
            <option value="weatherflow" selected={preferences.weatherSource === "weatherflow"}>
              {t.sourceWeatherFlow}
            </option>
          </select>
          <p class="preference-hint mb-0" set:html={t.sourceHintHtml} />
        </div>

        <div id="weather-openweather-fields" hidden={preferences.weatherSource !== "openweather"}>
          <div class="form-field mb-0">
            <label class="form-label" for="weather_city_preset">{t.cityLabel}</label>
            <select class="form-input" id="weather_city_preset">
              <option value="" selected={selectValue === ""}>
                {defaultCityId ? fmt(t.siteDefaultWithId, { id: defaultCityId }) : t.siteDefault}
              </option>
              {WEATHER_CITY_PRESETS.map((city) => (
                <option value={city.id} selected={selectValue === city.id}>
                  {city.label}
                </option>
              ))}
              <option value="custom" selected={selectValue === "custom"}>{t.customCity}</option>
            </select>
          </div>
          <div class="form-field mb-0 mt-3" id="weather-custom-field" hidden={selectValue !== "custom"}>
            <label class="form-label" for="weather_city_custom">{t.customCityLabel}</label>
            <input
              type="text"
              id="weather_city_custom"
              class="form-input"
              value={isCustom ? currentId : ""}
              placeholder={t.customCityPlaceholder}
              inputmode="numeric"
              pattern="\d*"
            />
            <p class="preference-hint" set:html={t.customCityHintHtml} />
          </div>
        </div>

        <div id="weather-ambient-fields" class="mt-3" hidden={preferences.weatherSource !== "ambient"}>
          <details class="alert-settings-nested">
            <summary>{t.ambientCredentials}</summary>
            <div class="alert-settings-nested-body">
          <div class="form-field mb-3">
            <label class="form-label" for="ambient_weather_mac">{t.ambientMacLabel}</label>
            <input
              type="text"
              class="form-input font-mono text-sm"
              id="ambient_weather_mac"
              name="ambient_weather_mac"
              value={preferences.ambientWeatherMac ?? ""}
              placeholder="AA:BB:CC:DD:EE:FF"
              autocomplete="off"
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="ambient_weather_api_key">{t.ambientKeyLabel}</label>
            <input
              type="password"
              class="form-input font-mono text-sm"
              id="ambient_weather_api_key"
              name="ambient_weather_api_key"
              value={preferences.ambientWeatherApiKey ?? ""}
              autocomplete="off"
            />
            <p class="preference-hint mb-0">
              {t.ambientKeyHint}
            </p>
          </div>
            </div>
          </details>
        </div>

        <div id="weather-weatherflow-fields" class="mt-3" hidden={preferences.weatherSource !== "weatherflow"}>
          <details class="alert-settings-nested">
            <summary>{t.weatherflowCredentials}</summary>
            <div class="alert-settings-nested-body">
          <div class="form-field mb-3">
            <label class="form-label" for="weatherflow_station_id">{t.weatherflowStationLabel}</label>
            <input
              type="text"
              class="form-input"
              id="weatherflow_station_id"
              name="weatherflow_station_id"
              value={preferences.weatherflowStationId ?? ""}
              placeholder="12345"
              inputmode="numeric"
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="weatherflow_token">{t.weatherflowTokenLabel}</label>
            <input
              type="password"
              class="form-input font-mono text-sm"
              id="weatherflow_token"
              name="weatherflow_token"
              value={preferences.weatherflowToken ?? ""}
              autocomplete="off"
            />
            <p class="preference-hint mb-0">
              {t.weatherflowTokenHint}
            </p>
          </div>
            </div>
          </details>
        </div>
      </fieldset>

      <label class="checkbox-row">
        <input type="checkbox" name="use_celsius" value="true" checked={preferences.useCelsius} />
        <span>{t.useCelsius}</span>
      </label>

      <div class="form-field mb-0">
        <label class="form-label" for="theme">{t.themeLabel}</label>
        <select class="form-input" id="theme" name="theme">
          <option value="dark" selected={preferences.theme === "dark"}>{t.themeDark}</option>
          <option value="light" selected={preferences.theme === "light"}>{t.themeLight}</option>
          <option value="system" selected={preferences.theme === "system"}>{t.themeSystem}</option>
        </select>
      </div>
    </div>

    <button type="submit" class="btn-primary" id="prefs-submit">
      {t.submit}
    </button>
  </form>
</DashboardCard>

<script>
  import { actions } from "astro:actions";
  import { readI18n } from "../i18n/client";
  import en from "../i18n/messages/app/settings/en";

  const form = document.querySelector<HTMLFormElement>("[data-prefs-form]");
  const preset = document.getElementById("weather_city_preset");
  const sourceSelect = document.getElementById("weather_source");
  const openWeatherFields = document.getElementById("weather-openweather-fields");
  const ambientFields = document.getElementById("weather-ambient-fields");
  const weatherflowFields = document.getElementById("weather-weatherflow-fields");
  const hidden = document.getElementById("weather_city_id_value");
  const customField = document.getElementById("weather-custom-field");
  const customInput = document.getElementById("weather_city_custom");
  const statusEl = document.getElementById("prefs-status");
  const errorEl = document.getElementById("prefs-error");
  const submitBtn = document.getElementById("prefs-submit");
  const text = readI18n(form, en.display.client);

  function syncWeatherPanels() {
    if (!(sourceSelect instanceof HTMLSelectElement)) return;
    const source = sourceSelect.value;
    if (openWeatherFields) openWeatherFields.hidden = source !== "openweather";
    if (ambientFields) ambientFields.hidden = source !== "ambient";
    if (weatherflowFields) weatherflowFields.hidden = source !== "weatherflow";
  }

  if (sourceSelect instanceof HTMLSelectElement) {
    sourceSelect.addEventListener("change", syncWeatherPanels);
    syncWeatherPanels();
  }

  if (preset instanceof HTMLSelectElement && hidden instanceof HTMLInputElement) {
    const sync = () => {
      const value = preset.value;
      const showCustom = value === "custom";
      if (customField) customField.hidden = !showCustom;
      if (showCustom) {
        hidden.value = customInput instanceof HTMLInputElement ? customInput.value.trim() : "";
      } else {
        hidden.value = value;
      }
    };
    preset.addEventListener("change", sync);
    customInput?.addEventListener("input", sync);
    sync();
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    statusEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = text.saving;
    }

    // Ensure checkbox fields are present for unchecked boxes (FormData omits them).
    const formData = new FormData(form);
    for (const name of ["show_garage_temps", "show_weather", "use_celsius"]) {
      if (!formData.has(name)) formData.set(name, "");
    }

    const { data, error } = await actions.updateDisplayPreferences(formData);

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = false;
      submitBtn.textContent = text.submit;
    }

    if (error) {
      if (errorEl) {
        // Server messages are English; show ours unless it carries a specific (technical) reason.
        const reason = error.message;
        errorEl.textContent =
          error.code === "UNAUTHORIZED"
            ? text.sessionExpired
            : !reason || reason === en.display.client.saveError
              ? text.saveError
              : reason;
        errorEl.classList.remove("hidden");
      }
      return;
    }

    if (data?.theme) {
      document.documentElement.dataset.theme =
        data.theme === "system"
          ? window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark"
          : data.theme;
    }

    if (statusEl) {
      statusEl.textContent = text.saved;
      statusEl.classList.remove("hidden");
    }
  });
</script>
