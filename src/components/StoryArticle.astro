---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import FaqSection from "./FaqSection.astro";
import type { Story } from "../lib/stories";
import { getLocale, localizePath } from "../i18n";
import { storiesMessages } from "../i18n/messages/stories";
import { getLocalizedAnswersRelatedTo } from "../i18n/content/answers";
import { getLocalizedAboutPhoto } from "../i18n/content/aboutPhotos";
import {
  getArticleSchema,
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import "../styles/about.css";

interface Props {
  story: Story;
  heroImage?: ImageMetadata;
  heroCaption?: string;
  heroCredit?: string;
  heroCreditHref?: string;
}

const { story, heroImage, heroCaption, heroCredit, heroCreditHref } = Astro.props;
const locale = getLocale(Astro);
const m = storiesMessages(locale);
const t = m.article;
const ccHero = !heroImage && story.photoId ? getLocalizedAboutPhoto(story.photoId, locale) : undefined;
const resolvedImage = heroImage ?? ccHero?.image;
const resolvedCaption = heroCaption ?? ccHero?.caption;
const resolvedCredit = heroCredit ?? ccHero?.credit;
const resolvedCreditHref = heroCreditHref ?? ccHero?.sourceUrl;
const resolvedAlt = ccHero?.alt ?? t.illustrationAlt(story.headline);

const relatedAnswers = getLocalizedAnswersRelatedTo(story.path, locale, [
  "how-long-for-pipes-to-freeze",
  "freeze-alarm-temperature-setting",
  "water-leak-sensor-placement",
]);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, localizePath(story.path, locale));
const schema = [
  getArticleSchema({
    siteUrl,
    pageUrl,
    headline: story.headline,
    description: story.description,
    articleSection: m.articleSection,
    datePublished: story.datePublished,
    dateModified: story.dateModified,
    imageUrl: `${siteUrl}${story.ogImage}`,
  }),
  getBreadcrumbSchema(siteUrl, [
    { name: m.breadcrumbHome, path: localizePath("/", locale) },
    { name: m.breadcrumbScenarios, path: localizePath("/stories", locale) },
    { name: story.headline, path: localizePath(story.path, locale) },
  ]),
  getFaqPageSchema(pageUrl, story.faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={story.headline}
  description={story.description}
  schema={schema}
  ogType="article"
  ogImage={story.ogImage}
  ogPublishedTime={story.datePublished}
  ogModifiedTime={story.dateModified}
  ogSection={m.articleSection}
  speakableSelectors={[".card-title", ".card-subtitle", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <section class="card animate-slide-in-left">
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        {t.scenarioLabel(story.setting)}
      </p>
      <h1 class="card-title">{story.title}</h1>
      <p class="card-subtitle">{story.description}</p>
      <p class="scenario-note mt-4 mb-0 text-sm" role="note">
        <strong>{t.noteLabel}</strong> {t.noteBody}
      </p>
    </section>

    {
      resolvedImage && (
        <figure class="card overflow-hidden p-0 mb-0">
          <Image
            src={resolvedImage}
            alt={resolvedAlt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 960px) 100vw, 900px"
            class="w-full h-auto block"
            fetchpriority="high"
          />
          {(resolvedCaption || resolvedCredit) && (
            <figcaption class="px-4 py-3 text-sm text-[var(--color-text-muted)] flex flex-col gap-1">
              {resolvedCaption && <span>{resolvedCaption}</span>}
              {resolvedCredit && resolvedCreditHref ? (
                <a class="about-figure-credit" href={resolvedCreditHref} rel="noopener noreferrer" target="_blank">
                  {resolvedCredit}
                </a>
              ) : resolvedCredit ? (
                <span class="about-figure-credit">{resolvedCredit}</span>
              ) : null}
            </figcaption>
          )}
        </figure>
      )
    }

    <section class="card">
      <h2 class="card-title">{t.setupTitle}</h2>
      <ul class="text-sm space-y-2 mb-0">
        {story.setup.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.timelineTitle}</h2>
      <ol class="text-sm space-y-3 mb-0 list-decimal pl-5">
        {
          story.timeline.map((step) => (
            <li>
              <strong>{t.timeLabel(step.time)}</strong> {step.detail}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">{t.whyTitle}</h2>
      <p class="mb-4">{story.outcome}</p>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        {t.outcomeCaveat}
      </p>
    </section>

    <FaqSection faqs={story.faqs} title={t.faqTitle} />

    <section class="card">
      <h2 class="card-title">{t.relatedTitle}</h2>
      <ul class="text-sm space-y-1 mb-0">
        {relatedAnswers.map((answer) => (
          <li><a class="text-link" href={answer.path}>{answer.question}</a></li>
        ))}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.tryTitle}</h2>
      <p class="mb-4">
        {t.tryCopy}
      </p>
      <p class="mb-0">
        <a class="btn-primary" href="/pricing">{t.seePlansPricing}</a>
        {" "}
        <a class="btn-secondary" href="/register?next=/dashboard/devices">{t.createAccount}</a>
        {" "}
        <a class="text-link" href="/compare">{t.compareDiy}</a>
        {" · "}
        <a class="text-link" href="/stories">{t.allScenarios}</a>
      </p>
    </section>
  </div>
</Layout>

<style>
  .scenario-note {
    padding: 0.6rem 0.8rem;
    border-left: 3px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-surface) 85%, var(--color-accent) 15%);
    border-radius: 0.4rem;
  }
</style>
