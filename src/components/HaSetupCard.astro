---
import DashboardCard from "./dashboard/DashboardCard.astro";
import {
  HACS_REPO_URL,
  HA_INTEGRATION_PAGE,
  HA_DEV_DOCS_INGEST,
  HA_BLUEPRINT_URL,
  HA_ENTITIES_YAML,
} from "../lib/homeAssistantIntegration";
import { fmt, getLocale } from "../i18n";
import { shareMessages } from "../i18n/messages/app/share";

interface Props {
  siteUrl?: string;
  /** Full API key only when freshly minted (query param); otherwise omit secrets. */
  apiKey?: string | null;
  inboundWebhookUrl?: string | null;
}

const { siteUrl = Astro.url.origin, apiKey = null, inboundWebhookUrl = null } =
  Astro.props;

const t = shareMessages(getLocale(Astro)).ha;
const metricsUrl = `${siteUrl}/api/v1/metrics`;
const restCommandYaml = inboundWebhookUrl
  ? `rest_command:
  probeharbor_status:
    url: "${inboundWebhookUrl}"
    method: POST
    headers:
      Content-Type: application/json
    payload: '{"action":"status"}'`
  : null;

const prometheusYaml = `scrape_configs:
  - job_name: probeharbor
    metrics_path: /api/v1/metrics
    scheme: ${siteUrl.startsWith("https") ? "https" : "http"}
    static_configs:
      - targets: ["${siteUrl.replace(/^https?:\/\//, "")}"]
    authorization:
      type: Bearer
      credentials: ${apiKey ? apiKey : "<your-api-key>"}`;
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4" set:html={fmt(t.introHtml, { integrationHref: HA_INTEGRATION_PAGE })} />
  <ul class="text-sm space-y-2 mb-4">
    <li>
      <strong>{t.recommended}</strong>
      <a class="text-link" href={HACS_REPO_URL} target="_blank" rel="noreferrer">{t.hacsCustom}</a>
      {t.hacsCustomTail}
    </li>
    <li>
      <a class="text-link" href={HA_INTEGRATION_PAGE}>{t.guide}</a>
      ·
      <a class="text-link" href={HA_DEV_DOCS_INGEST}>{t.devDocs}</a>
    </li>
    <li>
      <a class="text-link" href={HA_ENTITIES_YAML} download>
        {t.downloadEntities}
      </a>
    </li>
    <li>
      <a class="text-link" href={HA_BLUEPRINT_URL} download>
        {t.downloadBlueprint}
      </a>
    </li>
    <li>
      {t.blueprintLead}
      <code class="text-xs break-all">{siteUrl}{HA_BLUEPRINT_URL}</code>
      {t.blueprintTail}
    </li>
    <li set:html={t.inboundHtml} />
    <li set:html={t.scrapeHtml} />
  </ul>
  {restCommandYaml && (
    <div class="mb-4">
      <p class="form-label mb-1">{t.prefillRest}</p>
      <pre class="text-xs overflow-x-auto mb-0"><code>{restCommandYaml}</code></pre>
    </div>
  )}
  {(apiKey || siteUrl) && (
    <div class="mb-4">
      <p class="form-label mb-1">{t.prefillPrometheus}</p>
      <pre class="text-xs overflow-x-auto mb-0"><code>{prometheusYaml}</code></pre>
    </div>
  )}
  <p class="mb-0 text-sm text-muted-foreground" set:html={t.seeAlsoHtml} />
</DashboardCard>
