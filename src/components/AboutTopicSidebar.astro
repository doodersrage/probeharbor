---
import { getLocale } from "../i18n";
import { aboutArticleMessages } from "../i18n/messages/aboutArticle";
import { getLocalizedTopicContext } from "../i18n/content/aboutNavigation";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro);
const t = aboutArticleMessages(locale).sidebar;
const context = getLocalizedTopicContext(slug, locale);

if (!context) {
  return null;
}

const { core, guides, current } = context;
const isCorePage = current.slug === core.slug;
---
<aside class="about-topic-sidebar card" aria-label={t.label}>
  <p class="about-topic-sidebar-label">{t.inThisTopic}</p>
  <a class="about-topic-sidebar-core" href={`/about/${core.slug}`}>
    {core.title}
  </a>

  {guides.length > 0 && (
    <nav aria-label={t.relatedLabel}>
      <ul class="about-topic-sidebar-list">
        {guides.map((guide) => (
          <li>
            <a
              href={`/about/${guide.slug}`}
              aria-current={guide.slug === current.slug ? "page" : undefined}
              class:list={[
                "about-topic-sidebar-item",
                guide.slug === current.slug && "about-topic-sidebar-item-active",
              ]}
            >
              {guide.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {!isCorePage && (
    <a class="text-link about-topic-sidebar-back" href={`/about/${core.slug}`}>
      {t.backToOverview}
    </a>
  )}

  <div class="about-topic-sidebar-hubs">
    <a class="text-link about-topic-sidebar-hub" href="/guides">
      {t.guidesHub}
    </a>
    <a class="text-link about-topic-sidebar-hub" href="/about">
      {t.allArticles}
    </a>
  </div>
</aside>
