---
import DashboardCard from "./dashboard/DashboardCard.astro";
import { fmt, getLocale } from "../i18n";
import { overviewMessages } from "../i18n/messages/app/overview";

interface Props {
  hasDevices: boolean;
  hasSensors: boolean;
  hasHistory: boolean;
  hasAlertsEnabled?: boolean;
  hasEmailAlerts?: boolean;
  hasTestAlert?: boolean;
  hasHouseholdMembers?: boolean;
  hasLiveSensors?: boolean;
  hasHousehold?: boolean;
  hasFloodSensor?: boolean;
  dismissed?: boolean;
  showDemoFeed?: boolean;
  /**
   * Overview renders this twice: "top" (above space status) shows the setup
   * phases; "below-status" shows the optional phase, collapsed, so status
   * stays above the fold once setup is done.
   */
  placement?: "top" | "below-status";
}

const {
  hasDevices,
  hasSensors,
  hasHistory,
  hasAlertsEnabled = false,
  hasEmailAlerts = false,
  hasTestAlert = false,
  hasHouseholdMembers = false,
  hasLiveSensors = false,
  hasHousehold = false,
  hasFloodSensor = false,
  dismissed = false,
  showDemoFeed = false,
  placement = "top",
} = Astro.props;

const t = overviewMessages(getLocale(Astro)).onboarding;

const showFreezeMapCta = hasLiveSensors && hasHousehold;
const ingestVerified = hasLiveSensors || hasHistory;

/** Path most users need before winter. */
const essentialSteps = [
  {
    done: hasDevices,
    href: "/dashboard/devices?view=setup",
    title: t.essential.device.title,
    detail: t.essential.device.detail,
  },
  {
    done: hasAlertsEnabled && hasEmailAlerts,
    href: "/dashboard/alerts?tab=settings#alert-section-essentials",
    title: t.essential.alerts.title,
    detail: t.essential.alerts.detail,
  },
  {
    done: hasTestAlert,
    href: "/dashboard/alerts?tab=settings#send-test-alert",
    title: t.essential.test.title,
    detail: t.essential.test.detail,
  },
];

const kitSteps = [
  {
    done: hasLiveSensors || hasSensors,
    href: "/dashboard/devices?view=setup",
    title: t.kit.firstPost.title,
    detail: t.kit.firstPost.detail,
  },
  {
    done: ingestVerified,
    href: "/dashboard/devices?view=setup#verify-ingest-step",
    title: t.kit.rename.title,
    detail: t.kit.rename.detail,
  },
  {
    done: hasSensors,
    href: "/about/kit-qr-onboarding",
    title: t.kit.qr.title,
    detail: t.kit.qr.detail,
  },
];

// Only steps the dashboard can see you finish. Companion apps live under Overview → Tips,
// and the claim puck under Devices → Other ways to connect.
const nextSteps = [
  {
    done: hasHistory,
    required: true,
    href: "/dashboard/history",
    title: t.next.history.title,
    detail: t.next.history.detail,
  },
  {
    done: hasHouseholdMembers,
    required: true,
    href: "/dashboard/household",
    title: t.next.household.title,
    detail: t.next.household.detail,
  },
];

const essentialDone = essentialSteps.every((step) => step.done);
const kitDone = kitSteps.every((step) => step.done);
const optionalDone = nextSteps.filter((step) => step.required).every((step) => step.done);
const fullyDone = essentialDone && kitDone && optionalDone;

const activeSteps = !essentialDone ? essentialSteps : !kitDone ? kitSteps : nextSteps;
const completedCount = activeSteps.filter((step) => step.done).length;
const progressPct = activeSteps.length
  ? Math.round((completedCount / activeSteps.length) * 100)
  : 100;

const sectionTitle = !essentialDone
  ? t.gettingStarted
  : !kitDone
    ? t.hardwareSetup
    : t.nextSteps;
const sectionSubtitle = !essentialDone
  ? fmt(t.essentialsProgress, { done: completedCount, total: essentialSteps.length })
  : !kitDone
    ? fmt(t.hardwareProgress, { done: completedCount, total: kitSteps.length })
    : fmt(t.optionalProgress, { done: completedCount, total: nextSteps.length });

const optionalPhase = essentialDone && kitDone;
const wantedPlacement = optionalPhase ? "below-status" : "top";

if (dismissed || fullyDone || placement !== wantedPlacement) {
  return null;
}
---
{optionalPhase ? (
  <DashboardCard>
    <details class="dashboard-onboarding-optional">
      <summary class="dashboard-onboarding-optional-summary">
        <span>
          <strong>{sectionTitle}</strong>
          <span class="text-sm text-[var(--color-text-muted)]"> · {sectionSubtitle}</span>
        </span>
        <span class="text-sm text-[var(--color-text-muted)]">{t.show}</span>
      </summary>
      <div class="dashboard-onboarding mt-4">
        {activeSteps.map((step, index) => (
          <a class="dashboard-onboarding-item" href={step.href}>
            <span class="dashboard-onboarding-step">
              {step.done ? "✓" : index + 1}
            </span>
            <span>
              <strong>{step.title}</strong>
              <span class="block text-sm text-[var(--color-text-muted)]">{step.detail}</span>
            </span>
          </a>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          {t.guides}
          <a class="text-link" href="/about/esp32-ota-firmware">{t.guideOta}</a> ·
          <a class="text-link" href="/about/kit-qr-onboarding">{t.guideKitQr}</a> ·
          <a class="text-link" href="/about/ingest-and-webhooks">{t.guideIngest}</a> ·
          <a class="text-link" href="/freeze-map">{t.guideFreezeMap}</a>
          {showFreezeMapCta && (
            <>
              {" · "}
              <a class="text-link" href="/dashboard/household">{t.optInMap}</a>
            </>
          )}
        </p>
        <form action="/api/user/onboarding" method="post">
          <input type="hidden" name="action" value="dismiss" />
          <input type="hidden" name="redirect" value="/dashboard" />
          <button class="btn-ghost btn-sm" type="submit">{t.dismiss}</button>
        </form>
      </div>
    </details>
  </DashboardCard>
) : (
<DashboardCard>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="card-title">{sectionTitle}</h2>
      <p class="card-subtitle mb-0">{sectionSubtitle}</p>
      <div
        class="onboarding-progress mt-3"
        role="progressbar"
        aria-label={fmt(t.progressAria, { done: completedCount, total: activeSteps.length })}
        aria-valuenow={progressPct}
        aria-valuemin={0}
        aria-valuemax={100}
      >
        <div class="onboarding-progress-bar" style={`width: ${progressPct}%`}></div>
      </div>
    </div>
    {essentialDone && (
      <form action="/api/user/onboarding" method="post">
        <input type="hidden" name="action" value="dismiss" />
        <input type="hidden" name="redirect" value="/dashboard" />
        <button class="btn-ghost" type="submit">{t.dismiss}</button>
      </form>
    )}
  </div>
  <div class="dashboard-onboarding mt-4">
    {activeSteps.map((step, index) => (
      <a class="dashboard-onboarding-item" href={step.href}>
        <span class="dashboard-onboarding-step">
          {step.done ? "✓" : index + 1}
        </span>
        <span>
          <strong>{step.title}</strong>
          <span class="block text-sm text-[var(--color-text-muted)]">{step.detail}</span>
        </span>
      </a>
    ))}
  </div>
  {!essentialDone && (
    <div class="mt-4 flex flex-wrap gap-2">
      {!hasLiveSensors && (
        <>
          <a class="btn-secondary btn-sm" href="/dashboard/devices?view=setup">{t.openDevices}</a>
          {showDemoFeed && (
            <a class="btn-secondary btn-sm" href="#demo-pull-nudge">{t.tryDemoFeed}</a>
          )}
          {!hasDevices && (
            <a class="btn-ghost btn-sm" href="/about/esp32-freeze-kit">{t.esp32Parts}</a>
          )}
          <a class="btn-ghost btn-sm" href="/about/probe-demo">{t.probeSimulator}</a>
        </>
      )}
      {hasLiveSensors && !hasEmailAlerts && (
        <a class="btn-secondary btn-sm" href="/dashboard/alerts?tab=settings#alert-section-essentials">
          {t.setFreezeEmail}
        </a>
      )}
      {hasLiveSensors && hasEmailAlerts && !hasTestAlert && (
        <a class="btn-secondary btn-sm" href="/dashboard/alerts?tab=settings#send-test-alert">
          {t.sendTestAlert}
        </a>
      )}
    </div>
  )}
  {essentialDone && (
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
      {t.guides}
      <a class="text-link" href="/about/esp32-ota-firmware">{t.guideOta}</a> ·
      <a class="text-link" href="/about/kit-qr-onboarding">{t.guideKitQr}</a> ·
      <a class="text-link" href="/about/ingest-and-webhooks">{t.guideIngest}</a> ·
      <a class="text-link" href="/freeze-map">{t.guideFreezeMap}</a>
      {showFreezeMapCta && (
        <>
          {" · "}
          <a class="text-link" href="/dashboard/household">{t.optInMap}</a>
        </>
      )}
    </p>
  )}
</DashboardCard>
)}
