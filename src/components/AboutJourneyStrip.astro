---
import { fmt, getLocale } from "../i18n";
import { aboutArticleMessages } from "../i18n/messages/aboutArticle";
import { getLocalizedJourneysForSlug } from "../i18n/content/aboutNavigation";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro);
const t = aboutArticleMessages(locale).journeyStrip;
const matches = getLocalizedJourneysForSlug(slug, locale);

if (matches.length === 0) {
  return null;
}
---
<aside class="card about-journey-strip" aria-label={t.label}>
  {matches.map(({ journey, stepIndex, nextStep, previousStep }) => (
    <div class="about-journey-strip-row">
      <p class="about-journey-strip-label">
        {t.path} <a class="text-link" href={`/about#journey-${journey.id}`}>{journey.title}</a>
        <span class="about-journey-strip-meta">
          {fmt(t.step, { n: stepIndex + 1, total: journey.steps.length })}
        </span>
      </p>
      <div class="about-journey-strip-actions">
        {previousStep && (
          <a class="btn-ghost" href={`/about/${previousStep.slug}`}>
            ← {previousStep.label}
          </a>
        )}
        {nextStep ? (
          <a class="btn-secondary" href={`/about/${nextStep.slug}`}>
            {fmt(t.next, { label: nextStep.label })}
          </a>
        ) : (
          <a class="btn-secondary" href={journey.ctaHref}>
            {journey.ctaLabel}
          </a>
        )}
      </div>
    </div>
  ))}
</aside>
