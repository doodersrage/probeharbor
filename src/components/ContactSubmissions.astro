---
import type { PaginatedContactSubmissions } from "../lib/contactSubmissions";
import {
  getContactMessageText,
} from "../lib/contactSubmissions";
import DashboardCard from "./dashboard/DashboardCard.astro";
import { fmt, formatDateTime, getLocale } from "../i18n";
import { adminMessages } from "../i18n/messages/app/admin";

interface Props {
  submissions: PaginatedContactSubmissions;
  basePath?: string;
  statusFilter?: string;
  searchFilter?: string;
}

const {
  submissions,
  basePath = "/dashboard/contacts",
  statusFilter = "",
  searchFilter = "",
} = Astro.props;
const locale = getLocale(Astro);
const a = adminMessages(locale);
const t = a.contacts;
const { submissions: rows, page, pageSize, totalCount, totalPages, error } =
  submissions;

const showingFrom = totalCount === 0 ? 0 : (page - 1) * pageSize + 1;
const showingTo = totalCount === 0 ? 0 : Math.min(page * pageSize, totalCount);
const prevPage = page > 1 ? page - 1 : null;
const nextPage = page < totalPages ? page + 1 : null;

function buildPageUrl(nextPage: number): string {
  const params = new URLSearchParams();
  params.set("page", String(nextPage));
  if (statusFilter) params.set("status", statusFilter);
  if (searchFilter) params.set("q", searchFilter);
  return `${basePath}?${params.toString()}`;
}
---

<DashboardCard>
  <div class="card-header-row">
    <div>
      <h2 class="card-title">{t.heading}</h2>
      <p class="card-subtitle">
        {t.intro}
      </p>
    </div>
    {!error && totalCount > 0 && (
      <a class="btn-secondary" href="/api/contacts/export.csv" download>
        {t.downloadCsv}
      </a>
    )}
  </div>

  <form class="history-filters" method="get" action={basePath}>
    <div class="form-field mb-0">
      <label class="form-label" for="contact-status">{a.common.status}</label>
      <select class="form-input" id="contact-status" name="status">
        <option value="">{t.all}</option>
        <option value="new" selected={statusFilter === "new"}>{t.statusNew}</option>
        <option value="read" selected={statusFilter === "read"}>{t.statusRead}</option>
        <option value="spam" selected={statusFilter === "spam"}>{t.statusSpam}</option>
      </select>
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="contact-search">{a.common.search}</label>
      <input
        class="form-input"
        type="search"
        id="contact-search"
        name="q"
        value={searchFilter}
        placeholder={t.searchPlaceholder}
      />
    </div>
    <button type="submit" class="btn-secondary self-end">{t.filter}</button>
  </form>

  {error ? (
    <div class="empty-state">
      <p>{fmt(t.loadError, { error })}</p>
    </div>
  ) : rows.length === 0 ? (
    <div class="empty-state">
      <p>{t.empty}</p>
    </div>
  ) : (
    <>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{t.submitted}</th>
              <th scope="col">{a.common.status}</th>
              <th scope="col">{t.name}</th>
              <th scope="col">{a.common.email}</th>
              <th scope="col">{t.message}</th>
              <th scope="col">{t.actions}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((submission) => (
              <tr>
                <td>{formatDateTime(submission.created_at, locale, { dateStyle: "medium", timeStyle: "short" })}</td>
                <td>{submission.status}</td>
                <td>{submission.name}</td>
                <td>
                  <a href={`mailto:${submission.email}`}>{submission.email}</a>
                </td>
                <td class="contact-message-cell">
                  {getContactMessageText(submission.message)}
                </td>
                <td class="contact-actions-cell">
                  {submission.status !== "read" && (
                    <form action="/api/admin/contacts/status" method="post">
                      <input type="hidden" name="id" value={submission.id} />
                      <input type="hidden" name="status" value="read" />
                      <input type="hidden" name="redirect" value={buildPageUrl(page)} />
                      <button class="btn-ghost" type="submit">{t.markRead}</button>
                    </form>
                  )}
                  {submission.status !== "spam" && (
                    <form action="/api/admin/contacts/status" method="post">
                      <input type="hidden" name="id" value={submission.id} />
                      <input type="hidden" name="status" value="spam" />
                      <input type="hidden" name="redirect" value={buildPageUrl(page)} />
                      <button class="btn-ghost" type="submit">{t.spam}</button>
                    </form>
                  )}
                  <form action="/api/admin/contacts/status" method="post" class="contact-notes-form">
                    <input type="hidden" name="id" value={submission.id} />
                    <input type="hidden" name="redirect" value={buildPageUrl(page)} />
                    <label class="sr-only" for={`notes-${submission.id}`}>{t.adminNotes}</label>
                    <textarea
                      class="form-input"
                      id={`notes-${submission.id}`}
                      name="admin_notes"
                      rows="2"
                      placeholder={t.adminNotes}
                    >{submission.admin_notes ?? ""}</textarea>
                    <button class="btn-ghost" type="submit">{t.saveNotes}</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="pagination">
        <p class="pagination-summary">
          {fmt(t.showing, { from: showingFrom, to: showingTo, total: totalCount })}
        </p>
        <div class="pagination-controls">
          {prevPage ? (
            <a class="btn-secondary" href={buildPageUrl(prevPage)}>{a.common.previous}</a>
          ) : (
            <span class="btn-secondary pagination-disabled">{a.common.previous}</span>
          )}
          <span class="pagination-current">{fmt(a.common.pageOf, { page, total: totalPages })}</span>
          {nextPage ? (
            <a class="btn-secondary" href={buildPageUrl(nextPage)}>{a.common.next}</a>
          ) : (
            <span class="btn-secondary pagination-disabled">{a.common.next}</span>
          )}
        </div>
      </div>
    </>
  )}
</DashboardCard>

<style>
  .contact-message-cell {
    max-width: 28rem;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .contact-actions-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 6rem;
  }
</style>
