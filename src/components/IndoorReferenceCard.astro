---
import DashboardCard from "./dashboard/DashboardCard.astro";
import type { IndoorReferenceOption } from "../lib/indoorReference";
import { fmt, getLocale } from "../i18n";
import { deviceSetupThermostatMessages } from "../i18n/messages/app/deviceSetup/thermostat";

interface Props {
  canManage: boolean;
  options: IndoorReferenceOption[];
  selectedSensorId: string | null;
  saved?: boolean;
  error?: string | null;
}

const { canManage, options, selectedSensorId, saved, error } = Astro.props;
const t = deviceSetupThermostatMessages(getLocale(Astro)).indoor;
---
<DashboardCard id="indoor-reference">
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4" set:html={t.introHtml} />
  {saved && (
    <p class="alert-success text-sm mb-4" role="status">{t.saved}</p>
  )}
  {error && (
    <p class="alert-warning text-sm mb-4" role="alert">{error}</p>
  )}
  {canManage ? (
    <form method="post" action="/api/household/indoor-reference" class="flex flex-wrap items-end gap-3">
      <input type="hidden" name="redirect" value="/dashboard/devices?view=setup&tab=thermostat#indoor-reference" />
      <div class="form-field mb-0 min-w-[14rem] flex-1">
        <label class="form-label" for="indoor-reference-sensor">{t.sensorLabel}</label>
        <select
          class="form-input"
          id="indoor-reference-sensor"
          name="sensor_id"
        >
          <option value="">{t.noneOption}</option>
          {options.map((option) => (
            <option
              value={option.sensorId}
              selected={option.sensorId === selectedSensorId}
            >
              {fmt(t.optionLabel, { label: option.label, device: option.deviceName })}
            </option>
          ))}
        </select>
      </div>
      <button type="submit" class="btn-secondary">{t.save}</button>
    </form>
  ) : (
    <p class="mb-0 text-sm text-[var(--color-text-muted)]">
      {selectedSensorId
        ? t.configured
        : t.notSelected}
    </p>
  )}
  {options.length === 0 && canManage && (
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.noOptionsHtml} />
  )}
</DashboardCard>
