---
/** Handling alerts lives in Overview's Quick actions; this banner only links out. */
import { getLocale, plural } from "../i18n";
import { shellMessages } from "../i18n/messages/app/shell";

interface Props {
  count: number;
  /** Inside the Overview status card: a plain row instead of a warning box. */
  embedded?: boolean;
  /**
   * An unhandled freeze or leak alert is open, the incidents the claims
   * evidence pack documents. Without one the claims link is left out.
   */
  claimsRelevant?: boolean;
  /** The plan includes the claims pack; otherwise the link carries a "(Pro)" upgrade hint. */
  canUseClaimsPack?: boolean;
}

const { count, embedded = false, claimsRelevant = false, canUseClaimsPack = false } = Astro.props;
const locale = getLocale(Astro);
const t = shellMessages(locale).unacked;
---
<div
  class:list={[embedded ? "garage-risk-row" : "alert-warning mb-4", count <= 0 && "hidden"]}
  role="status"
  data-unacked-banner
  data-unacked-count={String(count)}
  data-i18n={JSON.stringify({ label: t.label })}
  hidden={count <= 0}
>
  <strong data-overview-field="unackedCount">{count}</strong>
  <span data-unacked-label>{" "}{plural(t.label, count, locale)}</span>
  <a href="/dashboard/alerts?tab=activity" class="text-link ml-1">{t.review}</a>
  {claimsRelevant && (
    <span data-unacked-claims class:list={[count <= 0 && "hidden"]}>
      {" · "}
      <a href="/dashboard/history?tab=exports#claims-pack" class="text-link">
        {t.claimsPack}
      </a>
      {!canUseClaimsPack && (
        <>
          {" "}
          <span class="text-[var(--color-text-muted)]">{t.proTag}</span>
        </>
      )}
    </span>
  )}
</div>
