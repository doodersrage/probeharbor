---
/** Handling alerts lives in Overview's Quick actions; this banner only links out. */
interface Props {
  count: number;
  /** Inside the Overview status card: a plain row instead of a warning box. */
  embedded?: boolean;
}

const { count, embedded = false } = Astro.props;
---
<div
  class:list={[embedded ? "garage-risk-row" : "alert-warning mb-4", count <= 0 && "hidden"]}
  role="status"
  data-unacked-banner
  data-unacked-count={String(count)}
  hidden={count <= 0}
>
  <strong data-overview-field="unackedCount">{count}</strong>
  <span data-unacked-label> unhandled alert{count === 1 ? "" : "s"}.</span>
  <a href="/dashboard/alerts?tab=activity" class="text-link ml-1">Review</a>
  <span data-unacked-claims class:list={[count <= 0 && "hidden"]}>
    {" · "}
    <a href="/dashboard/history?tab=exports#claims-pack" class="text-link">
      Download claims evidence pack
    </a>
    {" "}
    <span class="text-[var(--color-text-muted)]">(Pro)</span>
  </span>
</div>
