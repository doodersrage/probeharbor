---
import type { UserSubscription } from "../lib/stripeSubscriptions";
import { isActiveSubscriptionStatus } from "../lib/stripe";
import type { Entitlements } from "../lib/entitlements";
import DashboardCard from "./dashboard/DashboardCard.astro";
import { fmt, formatNumber, getLocale, plural } from "../i18n";
import { plansMessages } from "../i18n/messages/app/plans";
import { formatRetention } from "../i18n/content/planComparison/format";

interface Props {
  canDownloadCsv: boolean;
  subscription: UserSubscription | null;
  entitlements?: Entitlements | null;
  subscriptionNotice?: string | null;
  title?: string;
  showCsvNote?: boolean;
  /** When false, hide Portfolio upgrade CTAs (e.g. display price unset). Default true. */
  portfolioCheckoutAvailable?: boolean;
}

const {
  canDownloadCsv,
  subscription,
  entitlements = null,
  subscriptionNotice = null,
  title: titleProp,
  showCsvNote = true,
  portfolioCheckoutAvailable = true,
} = Astro.props;

const locale = getLocale(Astro);
const t = plansMessages(locale).card;
const title = titleProp ?? t.title;

const hasActiveSubscription =
  subscription !== null && isActiveSubscriptionStatus(subscription.status);

const isPortfolioOrAbove =
  entitlements?.tier === "portfolio" ||
  entitlements?.tier === "admin" ||
  subscription?.plan_tier === "portfolio";

const isProOrAbove =
  isPortfolioOrAbove ||
  entitlements?.tier === "pro" ||
  subscription?.plan_tier === "pro";

const isProOnly = isProOrAbove && !isPortfolioOrAbove;

const tierId =
  entitlements?.tier ??
  (isPortfolioOrAbove ? "portfolio" : isProOrAbove ? "pro" : canDownloadCsv ? "member" : "free");
// Plan names are proper nouns in the UI ("Pro", not "pro").
const tierLabel = tierId.charAt(0).toUpperCase() + tierId.slice(1);

const activeSubscriptionLabel = isPortfolioOrAbove
  ? "Portfolio"
  : isProOrAbove
    ? "Pro"
    : "Member";
---

<DashboardCard id="plans">
  <h2 class="card-title">{title}</h2>
  <p class="card-subtitle">
    <Fragment set:html={t.introHtml} />
  </p>

  {subscriptionNotice === "success" && (
    <div class="alert-success mb-4" role="status">
      <p class="m-0">{t.subscriptionActivated}</p>
    </div>
  )}

  {subscriptionNotice === "cancelled" && (
    <div class="alert-warning mb-4" role="status">
      <p class="m-0">{t.checkoutCancelled}</p>
    </div>
  )}

  <p class="mb-4 text-sm text-[var(--color-text-muted)]">
    {t.currentPlan} <strong class="text-[var(--color-text)]">{tierLabel}</strong>
    {entitlements
      ? ` · ${[
          fmt(t.maxDevices, { count: formatNumber(entitlements.maxDevices, locale) }),
          fmt(t.history, { retention: formatRetention(entitlements.historyDays, locale) }),
          plural(t.ownedProperties, entitlements.maxOwnedHouseholds, locale),
        ].join(" · ")}`
      : ""}
    {" · "}
    <a class="text-link" href="/pricing">{t.fullComparison}</a>
  </p>

  {canDownloadCsv || isProOrAbove ? (
    <div class="card-muted">
      {showCsvNote && (
        <p class="m-0 mb-3 text-sm">
          {hasActiveSubscription
            ? fmt(t.subscriptionActive, { plan: activeSubscriptionLabel })
            : t.csvAccess}
        </p>
      )}
      {hasActiveSubscription && (
        <form action="/api/stripe/portal" method="post" class="inline-block mr-3">
          <button class="btn-secondary" type="submit">
            {t.manageBilling}
          </button>
        </form>
      )}
      {hasActiveSubscription && !isProOrAbove && (
        <div class="inline-flex flex-wrap gap-2 mt-3 sm:mt-0">
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="monthly" />
            <button class="btn-primary" type="submit">{t.upgradeProMonthly}</button>
          </form>
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="annual" />
            <button class="btn-secondary" type="submit">{t.proAnnual}</button>
          </form>
        </div>
      )}
      {isProOnly && portfolioCheckoutAvailable && (
        <div class="inline-flex flex-wrap gap-2 mt-3">
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="portfolio" />
            <input type="hidden" name="interval" value="monthly" />
            <input type="hidden" name="source" value="plans_card" />
            <button class="btn-primary" type="submit">{t.upgradePortfolioMonthly}</button>
          </form>
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="portfolio" />
            <input type="hidden" name="interval" value="annual" />
            <input type="hidden" name="source" value="plans_card" />
            <button class="btn-secondary" type="submit">{t.portfolioAnnual}</button>
          </form>
        </div>
      )}
      {isProOnly && !portfolioCheckoutAvailable && (
        <p class="mt-3 mb-0 text-sm" set:html={t.seePortfolioPricingHtml} />
      )}
      {!hasActiveSubscription && !isProOrAbove && (
        <div class="flex flex-wrap gap-2">
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="monthly" />
            <button class="btn-primary" type="submit">{t.upgradeProMonthly}</button>
          </form>
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="annual" />
            <button class="btn-secondary" type="submit">{t.proAnnual}</button>
          </form>
        </div>
      )}
    </div>
  ) : (
    <div class="card-muted space-y-3">
      <div class="flex flex-wrap gap-2">
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="member" />
          <input type="hidden" name="interval" value="monthly" />
          <button class="btn-primary" type="submit">
            {t.memberMonthly}
          </button>
        </form>
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="member" />
          <input type="hidden" name="interval" value="annual" />
          <button class="btn-secondary" type="submit">
            {t.memberAnnual}
          </button>
        </form>
      </div>
      <div class="flex flex-wrap gap-2">
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="pro" />
          <input type="hidden" name="interval" value="monthly" />
          <button class="btn-primary" type="submit">
            {t.proMonthly}
          </button>
        </form>
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="pro" />
          <input type="hidden" name="interval" value="annual" />
          <button class="btn-secondary" type="submit">
            {t.proAnnual}
          </button>
        </form>
      </div>
    </div>
  )}
</DashboardCard>
