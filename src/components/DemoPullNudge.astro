---
import DemoPullQuickStart from "./DemoPullQuickStart";
import { getExampleFeedUrl } from "../lib/exampleFeed";
import { getLocale } from "../i18n";
import { overviewNudgesMessages } from "../i18n/messages/app/overview/nudges";
import { deviceSetupPullMessages } from "../i18n/messages/app/deviceSetup/pull";

interface Props {
  show: boolean;
  redirectTo?: string;
}

const { show, redirectTo = "/dashboard" } = Astro.props;
const exampleFeedUrl = getExampleFeedUrl(Astro.site);
const locale = getLocale(Astro);
const t = overviewNudgesMessages(locale).demoPull;
const demoText = deviceSetupPullMessages(locale).demo;
---

{show && (
  <section class="card" id="demo-pull-nudge">
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-4">
      {t.body}
    </p>
    <DemoPullQuickStart
      client:visible
      exampleFeedUrl={exampleFeedUrl}
      redirectTo={redirectTo}
      buttonLabel={t.button}
      text={demoText}
    />
  </section>
)}
