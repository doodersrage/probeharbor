---
import { getLocale } from "../i18n";
import { aboutArticleMessages } from "../i18n/messages/aboutArticle";
import { getLocalizedTopicContext } from "../i18n/content/aboutNavigation";
import { getLocalizedAboutPage } from "../i18n/content/aboutPages";

interface Props {
  slug: string;
  limit?: number;
}

const { slug, limit = 4 } = Astro.props;
const locale = getLocale(Astro);
const t = aboutArticleMessages(locale).related;
const context = getLocalizedTopicContext(slug, locale);
const parent = context?.core;
const siblings = (context?.guides ?? [])
  .filter((guide) => guide.slug !== slug)
  .slice(0, limit);

const crossLinks = [
  getLocalizedAboutPage("cold-snap-playbook", locale),
  getLocalizedAboutPage("alert-channel-cookbook", locale),
  getLocalizedAboutPage("ingest-and-webhooks", locale),
  getLocalizedAboutPage("probe-demo", locale),
]
  .filter((page): page is NonNullable<typeof page> => Boolean(page))
  .filter((page) => page.slug !== slug)
  .filter((page) => !siblings.some((s) => s.slug === page.slug))
  .slice(0, 2);

if (siblings.length === 0 && crossLinks.length === 0) {
  return null;
}
---
<aside class="card about-related" aria-labelledby={`about-related-${slug}`}>
  <h2 class="about-related-title" id={`about-related-${slug}`}>{t.title}</h2>
  {parent && (
    <p class="about-related-lead">
      {t.moreUnder}{" "}
      <a class="text-link" href={`/about/${parent.slug}`}>{parent.title}</a>
    </p>
  )}
  <ul class="about-related-list">
    {siblings.map((guide) => (
      <li>
        <a href={`/about/${guide.slug}`}>
          <strong>{guide.title}</strong>
          <span>{guide.summary}</span>
        </a>
      </li>
    ))}
    {crossLinks.map((guide) => (
      <li>
        <a href={`/about/${guide.slug}`}>
          <strong>{guide.title}</strong>
          <span>{guide.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
