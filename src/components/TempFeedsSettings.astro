---
import type { TempFeedConfig } from "../lib/tempFeedConfig";
import { MAX_TEMP_FEEDS } from "../lib/tempFeedConfig";
import FeedTestButton from "./FeedTestButton";
import { fmt, getLocale } from "../i18n";
import { deviceSetupPullMessages } from "../i18n/messages/app/deviceSetup/pull";

interface Props {
  feeds: TempFeedConfig[];
}

const { feeds } = Astro.props;

const existingFeeds = feeds.filter((feed) => Boolean(feed.url));
const canAddMore = existingFeeds.length < MAX_TEMP_FEEDS;
const pullText = deviceSetupPullMessages(getLocale(Astro));
const t = pullText.feeds;
---

<div id="pull-feeds-form" class="space-y-4" data-i18n={JSON.stringify(pullText.client)}>
  <div>
    <h3 class="text-base font-semibold m-0">{t.heading}</h3>
    <p class="card-subtitle mb-0 mt-1" set:html={t.introHtml} />
  </div>

  {/* Bulk tools only help with two or more feeds; a single feed has its own Delete and Enabled. */}
  {existingFeeds.length > 1 && (
    <form
      id="bulk-pull-form"
      action="/api/user/pull-setup/bulk"
      method="post"
      class="flex flex-wrap items-center gap-2 rounded-lg border border-[var(--color-border)] p-3"
      data-bulk-pull-form
    >
      <input type="hidden" name="redirect" value="/dashboard/devices?tab=pull" />
      <button type="button" class="btn-ghost btn-sm" data-bulk-pull-select-all>{t.selectAll}</button>
      <button type="submit" name="action" value="enable" class="btn-secondary btn-sm">{t.enable}</button>
      <button type="submit" name="action" value="disable" class="btn-secondary btn-sm">{t.disable}</button>
      <button
        type="submit"
        name="action"
        value="delete"
        class="btn-ghost btn-sm"
        data-bulk-pull-delete
      >
        {t.deleteSelected}
      </button>
    </form>
  )}

  <div class="flex flex-col gap-3">
    {existingFeeds.map((feed, index) => (
      <div class="sensor-map-row">
        <input type="hidden" name={`feed_${index}_id`} value={feed.id} />
        <div class="sensor-map-primary">
          {existingFeeds.length > 1 && (
          <label class="checkbox-row mb-0 self-start mt-2">
            <input
              type="checkbox"
              class="bulk-pull-id"
              name="feed_id"
              value={feed.id}
              form="bulk-pull-form"
            />
            <span class="sr-only">{fmt(t.selectFeed, { name: feed.name || feed.id })}</span>
          </label>
          )}
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${index}_name`}>{t.name}</label>
            <input
              class="form-input"
              type="text"
              id={`feed_${index}_name`}
              name={`feed_${index}_name`}
              value={feed.name}
              placeholder={t.namePlaceholder}
            />
          </div>
          <div class="form-field mb-0 sm:col-span-2">
            <label class="form-label" for={`feed_${index}_url`}>{t.url}</label>
            <input
              class="form-input font-mono text-sm"
              type="url"
              id={`feed_${index}_url`}
              name={`feed_${index}_url`}
              value={feed.url}
              placeholder="https://probeharbor.dev/api/feeds/example"
              required
            />
            <FeedTestButton
              client:visible
              inputId={`feed_${index}_url`}
              rootInputId={`feed_${index}_json_root`}
              text={pullText.feedTest}
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${index}_json_root`}>{t.jsonRoot}</label>
            <input
              class="form-input font-mono"
              type="text"
              id={`feed_${index}_json_root`}
              name={`feed_${index}_json_root`}
              value={feed.jsonRoot || "temp"}
              placeholder="temp"
              pattern="[A-Za-z_][A-Za-z0-9_]*"
              title={t.jsonRootTitle}
            />
            <p class="form-hint mb-0" set:html={t.jsonRootHintHtml} />
          </div>
          <div class="sensor-map-actions">
            <label class="checkbox-row mb-0">
              <input
                type="checkbox"
                name={`feed_${index}_enabled`}
                value="true"
                checked={feed.enabled}
              />
              <span>{t.enabled}</span>
            </label>
            <span
              class="text-sm text-[var(--color-text-muted)]"
              data-pull-fetch-status={feed.id}
              aria-live="polite"
            />
            <form action="/api/user/pull-setup/delete" method="post">
              <input type="hidden" name="feed_id" value={feed.id} />
              <input type="hidden" name="redirect" value="/dashboard/devices?tab=pull" />
              <button
                type="submit"
                class="btn-ghost"
                onclick={`return confirm(${JSON.stringify(t.deleteConfirm)});`}
              >
                {t.delete}
              </button>
            </form>
          </div>
        </div>
      </div>
    ))}

    {canAddMore && (
      <div class="sensor-map-row sensor-quick-pair">
        <p class="m-0 mb-3 text-sm font-medium">{t.addFeed}</p>
        <input type="hidden" name={`feed_${existingFeeds.length}_id`} value="" />
        <div class="sensor-map-primary">
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${existingFeeds.length}_name`}>{t.name}</label>
            <input
              class="form-input"
              type="text"
              id={`feed_${existingFeeds.length}_name`}
              name={`feed_${existingFeeds.length}_name`}
              placeholder={t.namePlaceholder}
            />
          </div>
          <div class="form-field mb-0 sm:col-span-2">
            <label class="form-label" for={`feed_${existingFeeds.length}_url`}>{t.url}</label>
            <input
              class="form-input font-mono text-sm"
              type="url"
              id={`feed_${existingFeeds.length}_url`}
              name={`feed_${existingFeeds.length}_url`}
              placeholder="https://probeharbor.dev/api/feeds/example"
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${existingFeeds.length}_json_root`}>{t.jsonRoot}</label>
            <input
              class="form-input font-mono"
              type="text"
              id={`feed_${existingFeeds.length}_json_root`}
              name={`feed_${existingFeeds.length}_json_root`}
              value="temp"
              placeholder="temp"
            />
          </div>
          <div class="sensor-map-actions">
            <label class="checkbox-row mb-0">
              <input
                type="checkbox"
                name={`feed_${existingFeeds.length}_enabled`}
                value="true"
                checked
              />
              <span>{t.enabled}</span>
            </label>
          </div>
        </div>
      </div>
    )}
  </div>
</div>

<script>
  import { fmt, pageIntlLocale, readI18n } from "../i18n/client";
  import en from "../i18n/messages/app/deviceSetup/pull/en";

  const text = readI18n(document.getElementById("pull-feeds-form"), en.client);
  const form = document.querySelector<HTMLFormElement>("[data-bulk-pull-form]");
  form?.querySelector("[data-bulk-pull-select-all]")?.addEventListener("click", () => {
    document.querySelectorAll(".bulk-pull-id").forEach((el) => {
      if (el instanceof HTMLInputElement) el.checked = true;
    });
  });
  form?.addEventListener("submit", (event) => {
    const submitter = (event as SubmitEvent).submitter;
    if (!(submitter instanceof HTMLButtonElement) || submitter.value !== "delete") return;
    const checked = document.querySelectorAll(".bulk-pull-id:checked").length;
    if (checked === 0) return;
    const forms = text.bulkDeleteConfirm as Record<string, string | undefined>;
    const category = new Intl.PluralRules(pageIntlLocale()).select(checked);
    const template = forms[category] ?? text.bulkDeleteConfirm.other;
    const count = new Intl.NumberFormat(pageIntlLocale()).format(checked);
    if (!confirm(fmt(template, { count }))) {
      event.preventDefault();
    }
  });
</script>
