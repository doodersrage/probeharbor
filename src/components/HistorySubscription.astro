---
import PlansCard from "./PlansCard.astro";
import type { UserSubscription } from "../lib/stripeSubscriptions";
import { getLocale } from "../i18n";
import { plansMessages } from "../i18n/messages/app/plans";

interface Props {
  canDownloadCsv: boolean;
  subscription: UserSubscription | null;
  subscriptionNotice?: string | null;
}

const {
  canDownloadCsv,
  subscription,
  subscriptionNotice = null,
} = Astro.props;
const title = plansMessages(getLocale(Astro)).card.titleWithCsv;
---

<PlansCard
  canDownloadCsv={canDownloadCsv}
  subscription={subscription}
  subscriptionNotice={subscriptionNotice}
  title={title}
  showCsvNote={true}
/>
