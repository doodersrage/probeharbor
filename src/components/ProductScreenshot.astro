---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ProductShotId } from "../lib/productScreenshots";
import { getLocale } from "../i18n";
import { aboutMediaMessages } from "../i18n/messages/aboutMedia";
import insightsImg from "../assets/marketing/probeharbor-dashboard-insights.jpg";
import historyImg from "../assets/marketing/probeharbor-dashboard-history.jpg";
import historyChartImg from "../assets/marketing/probeharbor-dashboard-history-chart.jpg";
import devicesImg from "../assets/marketing/probeharbor-dashboard-devices.jpg";
import overviewCardsImg from "../assets/marketing/probeharbor-dashboard-overview-cards.jpg";
import overviewStatusImg from "../assets/marketing/probeharbor-dashboard-overview-status.jpg";
import portfolioImg from "../assets/marketing/probeharbor-dashboard-portfolio.jpg";
import claimsPackImg from "../assets/marketing/probeharbor-claims-pack-preview.jpg";
import claimsVerifyImg from "../assets/marketing/probeharbor-claims-pack-verification.jpg";
import monitoringCertImg from "../assets/marketing/probeharbor-monitoring-certificate-preview.jpg";

interface Props {
  shot: ProductShotId;
  caption?: string;
  class?: string;
  /** Tighter framing for side-by-side layouts. */
  compact?: boolean;
  /** Max-width inset that scales the full shot (no vertical crop). */
  peek?: boolean;
}

type ShotMeta = { image: ImageMetadata };

const shots: Record<ProductShotId, ShotMeta> = {
  insights: {
    image: insightsImg,
  },
  history: {
    image: historyImg,
  },
  "history-chart": {
    image: historyChartImg,
  },
  devices: {
    image: devicesImg,
  },
  "overview-cards": {
    image: overviewCardsImg,
  },
  "overview-status": {
    image: overviewStatusImg,
  },
  portfolio: {
    image: portfolioImg,
  },
  "claims-pack": {
    image: claimsPackImg,
  },
  "claims-verification": {
    image: claimsVerifyImg,
  },
  "monitoring-certificate": {
    image: monitoringCertImg,
  },
};

const { shot, caption, class: className, compact = false, peek = false } = Astro.props;
const item = shots[shot];
const text = aboutMediaMessages(getLocale(Astro)).shots[shot];
const captionText = caption ?? text.caption;
---
<figure class:list={["product-shot", compact && "product-shot--compact", peek && "product-shot--peek", className]}>
  <Image
    src={item.image}
    alt={text.alt}
    widths={compact || peek ? [400, 640, 800] : [480, 768, 1024, 1200]}
    sizes={compact || peek ? "(max-width: 767px) 100vw, 420px" : "(max-width: 767px) 100vw, 720px"}
    class="product-shot-img"
  />
  <figcaption class="product-shot-caption">{captionText}</figcaption>
</figure>
