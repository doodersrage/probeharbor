// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HistoryChart markup (snapshots) > everything on, in °C 1`] = `"<div class="history-chart-wrap"><div class="history-chart-header"><p class="history-chart-title">Last 12 hours</p><div class="history-chart-zoom" role="group" aria-label="Chart controls"><button type="button" class="history-chart-zoom-btn" aria-label="Zoom in">+</button><button type="button" class="history-chart-zoom-btn" aria-label="Zoom out" disabled>−</button><button type="button" class="history-chart-zoom-btn" aria-label="Reset zoom" disabled>Reset</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Download chart PNG">PNG</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Copy link to this chart window">Link</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Share chart snapshot">Share</button><a class="history-chart-zoom-btn history-chart-expand-btn" href="/api/claims/pack?from=2026-01-10&amp;to=2026-01-10" aria-label="Download claims pack PDF for this chart window">Claims</a><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Expand chart" aria-haspopup="dialog">Expand</button></div></div><div class="history-chart-presets" role="group" aria-label="Time range presets"><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">24h</button><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">7d</button><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">30d</button><button type="button" class="history-chart-preset-btn is-active" aria-pressed="true">All</button></div><p class="m-0 mb-2 text-xs text-[var(--color-text-muted)]">Loaded window is about 11h.</p><div class="history-chart-legend" role="group" aria-label="Series visibility"><button type="button" class="history-chart-legend-btn is-on" style="--legend-color:#e2e8f0;" aria-pressed="true">Garage</button><button type="button" class="history-chart-legend-btn is-on" style="--legend-color:#34d399;" aria-pressed="true">Attic</button><button type="button" class="history-chart-legend-btn is-on" style="--legend-color:#f59e0b;" aria-pressed="true">Thermostat</button><button type="button" class="history-chart-legend-btn history-chart-legend-btn--door is-on" style="--legend-color:#fde68a;" aria-pressed="true" title="Show or hide when Side door was open">Side door</button></div><p class="m-0 mb-2 text-xs text-[var(--color-text-muted)]">Last year</p><p class="m-0 mb-2 text-xs text-[var(--color-text-muted)] flex flex-wrap items-center gap-x-2 gap-y-1"><span><span style="color:#a78bfa;">Humidity %</span> · <span style="color:#2dd4bf;">dew point °C</span> (dashed) · from Garage</span></p><details class="history-chart-tips m-0 mb-2 text-xs text-[var(--color-text-muted)]"><summary>Chart tips</summary>Drag to select a range (Shift+drag when zoomed), scroll to zoom, Link to copy this window, PNG to save. Colored ticks mark alerts — hover near a tick for details. Trace turns <span style="color:#38bdf8;">cool</span> at/below freeze and <span style="color:#fb923c;">warm</span> at/above the high line. The dashed dew-point line is worked out from temperature and humidity: surfaces colder than it get damp. Shaded bands show when a door sensor in your household reported open; with more than one door, each door has its own row above the chart.</details><div class="history-chart-canvas-wrap"><canvas class="w-full history-chart-canvas" role="img" aria-label="Interactive line chart of Last 12 hours. Drag to select a range, scroll to zoom, expand for a larger view." aria-describedby="history-chart-summary"></canvas></div><p id="history-chart-summary" class="sr-only">Latest reading -1.9°C. Range over this period: -1.9°C to 10.0°C. Dropped to or below the 1.1°C freeze line in 5 of 24 readings. Door-open periods shaded on the chart: Side door: 1.</p><p class="sr-only" aria-live="polite"></p><details class="history-chart-tips m-0 mt-2 text-xs text-[var(--color-text-muted)]"><summary>Chart options: guide lines, humidity</summary><form class="chart-threshold-controls"><label class="chart-threshold-field"><span>Target ambient (°C)</span><input type="number" step="0.5" class="form-input" value="4.444444444444445" placeholder="Optional"/></label><label class="chart-threshold-field"><span>High warning (°C)</span><input type="number" step="0.5" class="form-input" value="32.22222222222222" placeholder="Optional"/></label><label class="chart-threshold-field chart-threshold-check"><span>Humidity + dew</span><input type="checkbox" checked/></label><p class="chart-threshold-note mb-0">Freeze line from alerts: 1.1°C</p></form></details></div>"`;

exports[`HistoryChart markup (snapshots) > everything on: probes, humidity, house, prior year, doors, alert marker, share 1`] = `"<div class="history-chart-wrap"><div class="history-chart-header"><p class="history-chart-title">Last 12 hours</p><div class="history-chart-zoom" role="group" aria-label="Chart controls"><button type="button" class="history-chart-zoom-btn" aria-label="Zoom in">+</button><button type="button" class="history-chart-zoom-btn" aria-label="Zoom out" disabled>−</button><button type="button" class="history-chart-zoom-btn" aria-label="Reset zoom" disabled>Reset</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Download chart PNG">PNG</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Copy link to this chart window">Link</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Share chart snapshot">Share</button><a class="history-chart-zoom-btn history-chart-expand-btn" href="/api/claims/pack?from=2026-01-10&amp;to=2026-01-10" aria-label="Download claims pack PDF for this chart window">Claims</a><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Expand chart" aria-haspopup="dialog">Expand</button></div></div><div class="history-chart-presets" role="group" aria-label="Time range presets"><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">24h</button><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">7d</button><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">30d</button><button type="button" class="history-chart-preset-btn is-active" aria-pressed="true">All</button></div><p class="m-0 mb-2 