exports[`HistoryChart markup (snapshots) > one probe, defaults 1`] = `"<div class="history-chart-wrap"><div class="history-chart-header"><p class="history-chart-title">Temperature trend (last 7 days)</p><div class="history-chart-zoom" role="group" aria-label="Chart controls"><button type="button" class="history-chart-zoom-btn" aria-label="Zoom in">+</button><button type="button" class="history-chart-zoom-btn" aria-label="Zoom out" disabled>−</button><button type="button" class="history-chart-zoom-btn" aria-label="Reset zoom" disabled>Reset</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Download chart PNG">PNG</button><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Copy link to this chart window">Link</button><a class="history-chart-zoom-btn history-chart-expand-btn" href="/dashboard/plans" aria-label="Upgrade to share chart snapshots" title="Chart share is on Member+">Share</a><button type="button" class="history-chart-zoom-btn history-chart-expand-btn" aria-label="Expand chart" aria-haspopup="dialog">Expand</button></div></div><div class="history-chart-presets" role="group" aria-label="Time range presets"><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">24h</button><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">7d</button><button type="button" class="history-chart-preset-btn" aria-pressed="false" disabled title="Only 11h loaded here — open History for a longer range">30d</button><button type="button" class="history-chart-preset-btn is-active" aria-pressed="true">All</button></div><p class="m-0 mb-2 text-xs text-[var(--color-text-muted)]">Loaded window is about 11h.</p><div class="history-chart-legend" role="group" aria-label="Series visibility"><button type="button" class="history-chart-legend-btn is-on" style="--legend-color:#e2e8f0;" aria-pressed="true">Garage</button></div><details class="history-chart-tips m-0 mb-2 text-xs text-[var(--color-text-muted)]"><summary>Chart tips</summary>Drag to select a range (Shift+drag when zoomed), scroll to zoom, Link to copy this window, PNG to save. Trace turns <span style="color:#38bdf8;">cool</span> at/below freeze and <span style="color:#fb923c;">warm</span> at/above the high line.</details><div class="history-chart-canvas-wrap"><canvas class="w-full history-chart-canvas" role="img" aria-label="Interactive line chart of Temperature trend (last 7 days). Drag to select a range, scroll to zoom, expand for a larger view." aria-describedby="history-chart-summary"></canvas></div><p id="history-chart-summary" class="sr-only">Latest reading 33.5°F. Range over this period: 33.5°F to 50.0°F. Dropped to or below the 34°F freeze line in 1 of 12 readings.</p><p class="sr-only" aria-live="polite"></p><details class="history-chart-tips m-0 mt-2 text-xs text-[var(--color-text-muted)]"><summary>Chart options: guide lines</summary><form class="chart-threshold-controls"><label class="chart-threshold-field"><span>Target ambient (°F)</span><input type="number" step="0.5" class="form-input" value placeholder="Optional"/></label><label class="chart-threshold-field"><span>High warning (°F)</span><input type="number" step="0.5" class="form-input" value placeholder="Optional"/></label><p class="chart-threshold-note mb-0">Freeze line from alerts: 34°F</p></form></details></div>"`;
