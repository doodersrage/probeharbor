---
import DashboardCard from "./dashboard/DashboardCard.astro";
import { getLocale, LOCALE_META, plural } from "../i18n";
import { alertsMessages } from "../i18n/messages/app/alerts";

interface Props {
  siteUrl: string;
  rewardDays?: number;
}

const { siteUrl, rewardDays = 0 } = Astro.props;
const locale = getLocale(Astro);
const t = alertsMessages(locale).referral;
// Strings for the inline script below (it can't import modules).
const text = {
  copyInvite: t.copyInvite,
  copied: t.copied,
  copyFailed: t.copyFailed,
  unavailable: t.unavailable,
  friendsJoined: t.friendsJoined,
  noSignups: t.noSignups,
};
const intl = LOCALE_META[locale].intl;
---
<DashboardCard id="referral-card">
  <h2 class="card-title">{t.heading}</h2>
  <p class="card-subtitle mb-4">
    <Fragment set:html={t.introHtml} />
    {rewardDays > 0
      ? ` ${plural(t.bonusDays, rewardDays, locale)}`
      : ` ${t.earn}`}
    {" "}
    <a class="text-link" href="/gift">{t.howGifting}</a>
  </p>
  <p class="ingest-key-value break-all text-sm mb-2" id="referral-url">{t.loading}</p>
  <p class="text-sm text-muted-foreground mb-3" id="referral-stats"></p>
  <button type="button" class="btn-secondary" id="referral-copy" disabled>{t.copyInvite}</button>
</DashboardCard>

<script is:inline define:vars={{ siteUrl, text, intl }}>
  (async () => {
    const urlEl = document.getElementById("referral-url");
    const statsEl = document.getElementById("referral-stats");
    const btn = document.getElementById("referral-copy");
    try {
      const res = await fetch("/api/user/referral");
      if (!res.ok) throw new Error("Could not load referral");
      const data = await res.json();
      const link = data.registerUrl || `${siteUrl}/register?ref=${data.code}`;
      if (urlEl) urlEl.textContent = link;
      if (statsEl) {
        statsEl.textContent =
          data.signupCount > 0
            ? (
                text.friendsJoined[new Intl.PluralRules(intl).select(data.signupCount)] ||
                text.friendsJoined.other
              ).replace("{count}", new Intl.NumberFormat(intl).format(data.signupCount))
            : text.noSignups;
      }
      if (btn instanceof HTMLButtonElement) {
        btn.disabled = false;
        btn.dataset.copy = link;
        btn.dataset.copyLabel = text.copyInvite;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(link);
            btn.textContent = text.copied;
            setTimeout(() => {
              btn.textContent = text.copyInvite;
            }, 2000);
          } catch {
            btn.textContent = text.copyFailed;
          }
        });
      }
    } catch {
      if (urlEl) urlEl.textContent = text.unavailable;
    }
  })();
</script>
