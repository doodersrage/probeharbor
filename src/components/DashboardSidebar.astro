---
import { Image } from "astro:assets";
import Building2 from "@lucide/astro/icons/building-2";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import Thermometer from "@lucide/astro/icons/thermometer";
import Cpu from "@lucide/astro/icons/cpu";
import Bell from "@lucide/astro/icons/bell";
import History from "@lucide/astro/icons/history";
import Users from "@lucide/astro/icons/users";
import Share2 from "@lucide/astro/icons/share-2";
import CreditCard from "@lucide/astro/icons/credit-card";
import Settings from "@lucide/astro/icons/settings";
import Activity from "@lucide/astro/icons/activity";
import logo from "../assets/gtm.svg";
import logoLight from "../assets/gtm-light.svg";
import { isAdminDashboardPath, mobileMonitorHrefs } from "../lib/dashboardNav";
import { fmt, getLocale } from "../i18n";
import { shellMessages } from "../i18n/messages/app/shell";

const t = shellMessages(getLocale(Astro));
const nav = t.nav;

interface Props {
  currentPath: string;
  isAdmin: boolean;
  email?: string | null;
  planLabel?: string;
  unackedAlerts?: number;
  liveLagging?: boolean;
  showPortfolioInMonitor?: boolean;
}

const {
  currentPath,
  isAdmin,
  email,
  planLabel,
  unackedAlerts = 0,
  liveLagging = false,
  showPortfolioInMonitor = false,
} = Astro.props;

type NavItem = {
  href: string;
  label: string;
  isActive: boolean;
  Icon: typeof LayoutDashboard;
  badge?: number | null;
  warn?: boolean;
};

const portfolioItem: NavItem = {
  href: "/dashboard/portfolio",
  label: nav.portfolio,
  isActive: currentPath.startsWith("/dashboard/portfolio"),
  Icon: Building2,
};

const monitorItems: NavItem[] = [
  {
    href: "/dashboard",
    label: nav.overview,
    isActive: currentPath === "/dashboard",
    Icon: LayoutDashboard,
  },
  {
    href: "/dashboard/live",
    label: nav.live,
    isActive: currentPath.startsWith("/dashboard/live"),
    Icon: Thermometer,
    warn: liveLagging,
  },
  ...(showPortfolioInMonitor ? [portfolioItem] : []),
  {
    href: "/dashboard/devices",
    label: nav.devices,
    isActive:
      currentPath.startsWith("/dashboard/devices") ||
      currentPath.startsWith("/dashboard/temperature"),
    Icon: Cpu,
  },
  {
    href: "/dashboard/alerts",
    label: nav.alerts,
    isActive: currentPath.startsWith("/dashboard/alerts"),
    Icon: Bell,
    badge: unackedAlerts > 0 ? unackedAlerts : null,
  },
  {
    href: "/dashboard/history",
    label: nav.history,
    isActive: currentPath.startsWith("/dashboard/history"),
    Icon: History,
  },
];

const accountItems: NavItem[] = [
  ...(!showPortfolioInMonitor ? [portfolioItem] : []),
  {
    href: "/dashboard/household",
    label: nav.household,
    isActive: currentPath.startsWith("/dashboard/household"),
    Icon: Users,
  },
  {
    href: "/dashboard/share",
    label: nav.share,
    isActive: currentPath.startsWith("/dashboard/share"),
    Icon: Share2,
  },
  {
    href: "/dashboard/plans",
    label: nav.plans,
    isActive: currentPath.startsWith("/dashboard/plans"),
    Icon: CreditCard,
  },
  {
    href: "/dashboard/settings",
    label: nav.settings,
    isActive: currentPath.startsWith("/dashboard/settings"),
    Icon: Settings,
  },
];

const adminItems: NavItem[] = isAdmin
  ? [
      {
        href: "/dashboard/ops",
        label: nav.ops,
        isActive: isAdminDashboardPath(currentPath),
        Icon: Activity,
      },
    ]
  : [];

const groups = [
  { label: t.sidebar.groups.monitor, items: monitorItems },
  { label: t.sidebar.groups.account, items: accountItems },
  ...(adminItems.length > 0 ? [{ label: t.sidebar.groups.admin, items: adminItems }] : []),
];

const activeLabel =
  [...monitorItems, ...accountItems, ...adminItems].find((item) => item.isActive)?.label ??
  nav.dashboard;

const monitorByHref = new Map(monitorItems.map((item) => [item.href, item]));
const mobileMonitor = mobileMonitorHrefs(showPortfolioInMonitor)
  .map((href) => monitorByHref.get(href))
  .filter((item): item is NavItem => Boolean(item));
---

<aside class="dashboard-sidebar">
  <nav class="dashboard-sidebar-inner" aria-label={t.sidebar.ariaLabel} id="dashboard-nav">
    <div class="dashboard-sidebar-top">
      <a href="/dashboard" class="dashboard-sidebar-brand">
        <Image src={logo} height={32} width={162} alt="ProbeHarbor" class="dashboard-sidebar-logo logo-on-dark" />
        <Image src={logoLight} height={32} width={162} alt="ProbeHarbor" class="dashboard-sidebar-logo logo-on-light" />
      </a>
      <div class="dashboard-sidebar-top-meta">
        {planLabel && <span class="plan-badge plan-badge--sidebar">{planLabel}</span>}
        <button
          type="button"
          class="dashboard-nav-toggle btn-secondary lg:hidden"
          id="dashboard-nav-toggle"
          aria-expanded="false"
          aria-controls="dashboard-nav-panel"
        >
          <span class="dashboard-nav-toggle-label">{t.sidebar.menu}</span>
          <span class="dashboard-nav-toggle-page">{activeLabel}</span>
        </button>
      </div>
    </div>
    <div id="dashboard-nav-panel" class="dashboard-nav-panel">
      {email && (
        <p class="dashboard-sidebar-email" title={email}>{email}</p>
      )}
      {groups.map((group) => (
        <div class="dashboard-nav-group">
          <p class="dashboard-nav-group-label">{group.label}</p>
          <ul class="dashboard-nav-list">
            {group.items.map(({ href, label, isActive, Icon, badge, warn }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    "dashboard-nav-link",
                    isActive && "dashboard-nav-link-active",
                    warn && "dashboard-nav-link--warn",
                  ]}
                  aria-current={isActive ? "page" : undefined}
                >
                  <Icon class="dashboard-nav-icon" size={16} aria-hidden="true" />
                  <span class="dashboard-nav-label">{label}</span>
                  {typeof badge === "number" && badge > 0 && (
                    <span class="dashboard-nav-badge" aria-label={fmt(t.sidebar.unhandledBadge, { count: badge })}>
                      {badge > 99 ? "99+" : badge}
                    </span>
                  )}
                  {warn && !badge && (
                    <span class="dashboard-nav-dot" aria-label={t.sidebar.laggingProbes}></span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="dashboard-sidebar-footer">
        <button
          type="button"
          class="dashboard-nav-link dashboard-shortcut-help"
          data-tt-shortcut-help
        >
          {t.sidebar.search} <kbd>/</kbd>
        </button>
        <button
          type="button"
          class="dashboard-nav-link dashboard-sidebar-phone-tools"
          data-dashboard-refresh
        >
          {t.sidebar.refresh}
        </button>
        <button
          type="button"
          class="dashboard-nav-link"
          data-tt-kiosk-proxy
          aria-pressed="false"
        >
          {t.kiosk.enter}
        </button>
        <a class="dashboard-nav-link" href="/">{t.sidebar.backToSite}</a>
        <a class="dashboard-nav-link" href="/api/auth/signout">{t.sidebar.signOut}</a>
      </div>
    </div>
  </nav>
</aside>

<nav class="dashboard-mobile-monitor" aria-label={t.sidebar.mobileAriaLabel}>
  {mobileMonitor.map(({ href, label, isActive, Icon, badge, warn }) => (
    <a
      href={href}
      class:list={[
        "dashboard-mobile-monitor-link",
        isActive && "dashboard-mobile-monitor-link-active",
        warn && "dashboard-mobile-monitor-link--warn",
      ]}
      aria-current={isActive ? "page" : undefined}
    >
      <Icon class="dashboard-mobile-monitor-icon" size={18} aria-hidden="true" />
      <span>{label}</span>
      {typeof badge === "number" && badge > 0 && (
        <span class="dashboard-nav-badge dashboard-nav-badge--mobile">{badge > 99 ? "99+" : badge}</span>
      )}
    </a>
  ))}
</nav>

<script is:inline>
  (() => {
    const toggle = document.getElementById("dashboard-nav-toggle");
    const panel = document.getElementById("dashboard-nav-panel");
    if (!toggle || !panel) return;

    const setOpen = (open) => {
      panel.classList.toggle("dashboard-nav-open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    };

    toggle.addEventListener("click", () => {
      setOpen(!panel.classList.contains("dashboard-nav-open"));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!panel.contains(target) && !toggle.contains(target)) {
        setOpen(false);
      }
    });
  })();
</script>
