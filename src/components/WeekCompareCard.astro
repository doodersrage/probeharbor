---
import { formatDeltaF, formatTemperature } from "../lib/temperatureFormat";
import type { WeekCompareResult } from "../lib/weekCompare";
import DashboardCard from "./dashboard/DashboardCard.astro";
import { fmt, formatDateTime, getLocale, plural } from "../i18n";
import { overviewCardsMessages } from "../i18n/messages/app/overviewCards";

interface Props {
  compare: WeekCompareResult;
  useCelsius?: boolean;
}

const { compare, useCelsius = false } = Astro.props;
const locale = getLocale(Astro);
const t = overviewCardsMessages(locale).weekCompareCard;

function formatEarliest(iso: string | null): string | null {
  if (!iso) return null;
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return null;
  return formatDateTime(date, locale, { month: "short", day: "numeric", year: "numeric" });
}

const earliestLabel = formatEarliest(compare.earliestLocalReadingAt);
const priorYearIsOutdoor = compare.priorYearSource === "outdoor_estimate";
const priorYearLabel = priorYearIsOutdoor
  ? compare.priorYearOutdoorLabel
    ? fmt(t.outdoorLastYearAt, { label: compare.priorYearOutdoorLabel })
    : t.outdoorLastYear
  : t.sameWeekLastYear;
// English as before: the raw count, no digit grouping.
const samplesLabel = plural(
  t.samples,
  compare.sampleCount,
  locale,
  locale === "en" ? { count: String(compare.sampleCount) } : {},
);
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4">
    {priorYearIsOutdoor
      ? t.subtitleOutdoor
      : t.subtitle}
  </p>
  {compare.thisWeekAvgF == null ? (
    <p class="mb-0 text-sm text-muted-foreground">{t.notEnough}</p>
  ) : (
    <>
      <div class="stat-grid">
        <article class="stat-item">
          <span class="stat-label">{priorYearIsOutdoor ? t.yourProbesThisWeek : t.thisWeek}</span>
          <p class="stat-value">{formatTemperature(compare.thisWeekAvgF, useCelsius, 1)}</p>
          <p class="stat-detail">{samplesLabel}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">{priorYearLabel}</span>
          <p class="stat-value">
            {compare.priorYearAvgF != null
              ? formatTemperature(compare.priorYearAvgF, useCelsius, 1)
              : "—"}
          </p>
          {compare.priorYearAvgF == null && earliestLabel && (
            <p class="stat-detail">{fmt(t.historyStarts, { date: earliestLabel })}</p>
          )}
        </article>
        <article class="stat-item">
          <span class="stat-label">{priorYearIsOutdoor ? t.outdoorChange : t.change}</span>
          <p class="stat-value">
            {compare.deltaF != null ? formatDeltaF(compare.deltaF, useCelsius) : "—"}
          </p>
          <p class="stat-detail">
            {priorYearIsOutdoor
              ? compare.thisWeekOutdoorAvgF != null
                ? fmt(t.outdoorThisWeek, { temp: formatTemperature(compare.thisWeekOutdoorAvgF, useCelsius, 1) })
                : t.outdoorUnavailable
              : compare.deltaF == null
                ? ""
                : compare.deltaF < 0
                  ? t.colder
                  : t.warmer}
          </p>
        </article>
      </div>
      {compare.priorYearAvgF == null && !priorYearIsOutdoor && (
        <p class="mb-0 mt-3 text-sm text-[var(--color-text-muted)]">
          {earliestLabel
            ? fmt(t.noPriorStarts, { date: earliestLabel })
            : t.noPrior}
        </p>
      )}
    </>
  )}
</DashboardCard>
