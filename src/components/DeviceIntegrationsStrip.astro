---
/** Quick links and short setup wizards for non-ESP paths. */
import { getLocale } from "../i18n";
import { devicesSetupMessages } from "../i18n/messages/app/devices/setup";

const t = devicesSetupMessages(getLocale(Astro)).integrations;
---

<section class="card" id="device-integrations">
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4">
    {t.subtitle}
  </p>

  <div class="space-y-3">
    <details class="rounded-lg border border-[var(--color-border)] p-3">
      <summary class="cursor-pointer font-medium">{t.claimPuck.summary}</summary>
      <ol class="mt-3 mb-0 text-sm space-y-2 pl-4 list-decimal">
        {t.claimPuck.stepsHtml.map((step) => <li set:html={step} />)}
        <li>
          <a class="text-link" href="/claim-puck">{t.claimPuck.productPage}</a>
          ·
          <a class="text-link" href="/claim-puck-case">{t.claimPuck.caseDiffuser}</a>
          ·
          <a class="text-link" href="/docs/api#claim-puck">{t.claimPuck.claimApi}</a>
        </li>
      </ol>
    </details>

    <details class="rounded-lg border border-[var(--color-border)] p-3">
      <summary class="cursor-pointer font-medium">{t.contacts.summary}</summary>
      <ol class="mt-3 mb-0 text-sm space-y-2 pl-4 list-decimal">
        {t.contacts.stepsHtml.map((step) => <li set:html={step} />)}
        <li>
          <a class="text-link" href="/door-puck">{t.contacts.doorPuck}</a>
          ·
          <a class="text-link" href="/leak-puck">{t.contacts.leakPuck}</a>
          ·
          <a class="text-link" href="/power-nudge">{t.contacts.powerNudge}</a>
          ·
          <a class="text-link" href="/accessories">{t.contacts.allAccessories}</a>
        </li>
      </ol>
    </details>

    <details class="rounded-lg border border-[var(--color-border)] p-3">
      <summary class="cursor-pointer font-medium">{t.beacon.summary}</summary>
      <p class="mt-3 mb-2 text-sm" set:html={t.beacon.bodyHtml} />
    </details>

    <details class="rounded-lg border border-[var(--color-border)] p-3">
      <summary class="cursor-pointer font-medium">{t.homeAssistant.summary}</summary>
      <ol class="mt-3 mb-0 text-sm space-y-2 pl-4 list-decimal">
        {t.homeAssistant.stepsHtml.map((step) => <li set:html={step} />)}
      </ol>
    </details>

    <details class="rounded-lg border border-[var(--color-border)] p-3">
      <summary class="cursor-pointer font-medium">{t.mqtt.summary}</summary>
      <ol class="mt-3 mb-0 text-sm space-y-2 pl-4 list-decimal">
        {t.mqtt.stepsHtml.map((step) => <li set:html={step} />)}
      </ol>
    </details>

    <details class="rounded-lg border border-[var(--color-border)] p-3">
      <summary class="cursor-pointer font-medium">{t.esphome.summary}</summary>
      <p class="mt-3 mb-2 text-sm" set:html={t.esphome.bodyHtml} />
      <a class="text-link text-sm" href="/dashboard/share/integrations#esphome">{t.esphome.recipes}</a>
    </details>
  </div>

  <div class="flex flex-wrap gap-3 mt-4">
    <a class="btn-ghost" href="/about/ingest-and-webhooks">{t.ingestFormats}</a>
    <a class="btn-ghost" href="/integrations">{t.allIntegrations}</a>
  </div>
</section>
