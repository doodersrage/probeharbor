---
import DashboardCard from "./dashboard/DashboardCard.astro";
import { COLD_SNAP_CHECKLIST } from "../lib/coldSnapChecklist";
import { getLocale } from "../i18n";
import { overviewNudgesMessages } from "../i18n/messages/app/overview/nudges";

interface Props {
  show: boolean;
  coldSnapEnabled?: boolean;
  canUseForecast?: boolean;
}

const {
  show,
  coldSnapEnabled = false,
  canUseForecast = false,
} = Astro.props;
if (!show) return null;
const t = overviewNudgesMessages(getLocale(Astro)).coldSnap;
const checklist = COLD_SNAP_CHECKLIST.map((item, i) => t.checklist[i] ?? item);
---
<DashboardCard id="cold-snap">
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4">
    {t.body}
  </p>
  {!coldSnapEnabled && canUseForecast && (
    <p class="alert-warning mb-4" role="status" set:html={t.forecastOffHtml} />
  )}
  {!canUseForecast && (
    <p class="form-hint mb-4" set:html={t.memberHtml} />
  )}
  <ol class="mb-4 space-y-2 pl-5 text-sm">
    {checklist.map((item) => (
      <li>{item}</li>
    ))}
  </ol>
  <div class="flex flex-wrap gap-3">
    <a class="btn-secondary" href="/freeze-season">{t.seasonGuide}</a>
    <a class="btn-ghost" href="/about/cold-snap-playbook">{t.playbook}</a>
    <a class="btn-ghost" href="/dashboard/alerts?tab=settings#alert-section-essentials">{t.essentials}</a>
    <a class="btn-ghost" href="/dashboard/alerts?tab=settings#send-test-alert">{t.sendTest}</a>
  </div>
</DashboardCard>
