---
import type { DeviceWithSensors } from "../lib/devices";
import { readIngestClient } from "../lib/ingestClient";
import { formatRelativeAge } from "../lib/relativeTime";
import { HACS_REPO_URL } from "../lib/homeAssistantIntegration";
import { fmt, getLocale } from "../i18n";
import { shareAgeLabel, shareMessages } from "../i18n/messages/app/share";

/**
 * Share → Integrations: is Home Assistant actually feeding us? Lists devices
 * whose pushes came from Home Assistant (HACS push service or rest_command),
 * with when it last pushed and which HA version. Only what the server saw.
 */
interface Props {
  devices: DeviceWithSensors[];
}

const { devices } = Astro.props;
const t = shareMessages(getLocale(Astro)).haDiag;
const fed = devices
  .map((device) => ({ device, client: readIngestClient(device.meta?.ingest_client) }))
  .filter((row): row is { device: DeviceWithSensors; client: NonNullable<typeof row.client> } => row.client !== null)
  .sort((a, b) => Date.parse(b.device.last_seen_at ?? "") - Date.parse(a.device.last_seen_at ?? ""));
---
<section class="card" aria-labelledby="ha-diagnostics-title">
  <h2 class="card-title" id="ha-diagnostics-title">{t.title}</h2>
  {fed.length === 0 ? (
    <p class="mb-0" set:html={fmt(t.emptyHtml, { hacsHref: HACS_REPO_URL })} />
  ) : (
    <>
      <p class="card-subtitle mb-3">{t.subtitle}</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">{t.caption}</caption>
          <thead>
            <tr class="text-left">
              <th scope="col" class="py-2 pr-3">{t.colDevice}</th>
              <th scope="col" class="py-2 pr-3">{t.colSensors}</th>
              <th scope="col" class="py-2 pr-3">{t.colLastPush}</th>
              <th scope="col" class="py-2 pr-3">{t.colHa}</th>
            </tr>
          </thead>
          <tbody>
            {fed.map(({ device, client }) => {
              const age = formatRelativeAge(device.last_seen_at);
              return (
                <tr>
                  <td class="py-2 pr-3">
                    <a class="text-link" href={`/dashboard/devices/${device.id}`}>{device.name}</a>
                  </td>
                  <td class="py-2 pr-3">{device.sensors.length}</td>
                  <td class="py-2 pr-3">
                    {shareAgeLabel(device.last_seen_at, t.age)}
                    {age.stale && <span class="text-[var(--color-warning)]"> · {t.stale}</span>}
                  </td>
                  <td class="py-2 pr-3">{client.version ?? t.versionUnknown}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="form-hint mt-3 mb-0" set:html={t.staleHintHtml} />
    </>
  )}
</section>
