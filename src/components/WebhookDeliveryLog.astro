---
import type { WebhookDeliveryRow } from "../lib/webhookDeliveries";
import DashboardCard from "./dashboard/DashboardCard.astro";
import { formatDateTime, getLocale } from "../i18n";
import { shareMessages } from "../i18n/messages/app/share";

interface Props {
  deliveries: WebhookDeliveryRow[];
}

const { deliveries } = Astro.props;
const locale = getLocale(Astro);
const t = shareMessages(locale).webhookLog;
const dateTimeOptions: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "numeric",
  day: "numeric",
  hour: "numeric",
  minute: "numeric",
  second: "numeric",
};

function typeLabel(type: string): string {
  if (type === "reading") return t.typeReading;
  if (type === "outbound_alert") return t.typeAlert;
  return type;
}
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4">
    {t.subtitle}
  </p>
  {deliveries.length === 0 ? (
    <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.empty}</p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-[var(--color-text-muted)]">
            <th class="py-2 pr-3">{t.colWhen}</th>
            <th class="py-2 pr-3">{t.colType}</th>
            <th class="py-2 pr-3">{t.colHost}</th>
            <th class="py-2 pr-3">{t.colStatus}</th>
            <th class="py-2">{t.colDuration}</th>
          </tr>
        </thead>
        <tbody>
          {deliveries.map((row) => (
            <tr class="border-t border-[var(--color-border)]">
              <td class="py-2 pr-3 whitespace-nowrap">{formatDateTime(row.created_at, locale, dateTimeOptions)}</td>
              <td class="py-2 pr-3">{typeLabel(row.webhook_type)}</td>
              <td class="py-2 pr-3 font-mono text-xs">{row.url_host}</td>
              <td class="py-2 pr-3">
                {row.success ? (
                  <span class="text-[var(--color-success)]">{row.status_code ?? t.ok}</span>
                ) : (
                  <span class="text-[var(--color-danger)]" title={row.error_message ?? undefined}>
                    {row.status_code ?? t.failed}
                  </span>
                )}
              </td>
              <td class="py-2">{row.duration_ms != null ? `${row.duration_ms}ms` : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardCard>
