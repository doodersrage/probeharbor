---
import { getLocale } from "../i18n";
import { aboutArticleMessages } from "../i18n/messages/aboutArticle";
import { getLocalizedAboutJourneys } from "../i18n/content/aboutNavigation";
import { resolveJourneyStepPages } from "../lib/aboutJourneys";
import { buildRegisterHref } from "../lib/registerUrl";

const locale = getLocale(Astro);
const t = aboutArticleMessages(locale).journeys;
const journeys = getLocalizedAboutJourneys(locale);
const registerHref = buildRegisterHref();
---
<section class="card about-journeys" aria-labelledby="about-journeys-title">
  <div class="about-journeys-header">
    <div>
      <h2 class="card-title" id="about-journeys-title">{t.title}</h2>
      <p class="card-subtitle mb-0">{t.subtitle}</p>
    </div>
    <a class="btn-primary" href={registerHref}>{t.startFree}</a>
  </div>

  <div class="about-journeys-grid">
    {journeys.map((journey) => {
      const steps = resolveJourneyStepPages(journey);
      return (
        <article class="about-journey-card" id={`journey-${journey.id}`}>
          <h3 class="about-journey-title">{journey.title}</h3>
          <p class="about-journey-desc">{journey.description}</p>
          <ol class="about-journey-steps">
            {steps.map((step, index) => (
              <li>
                <span class="about-journey-step-num" aria-hidden="true">
                  {index + 1}
                </span>
                {step.page ? (
                  <a class="about-journey-step-link" href={`/about/${step.slug}`}>
                    {step.label}
                  </a>
                ) : (
                  <span>{step.label}</span>
                )}
              </li>
            ))}
          </ol>
          <a class="btn-secondary about-journey-cta" href={journey.ctaHref}>
            {journey.ctaLabel}
          </a>
        </article>
      );
    })}
  </div>
</section>
