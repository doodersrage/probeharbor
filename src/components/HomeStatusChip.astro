---
import type { AppStatusSummary } from "../lib/appStatus";
import { getLocale } from "../i18n";
import { systemStatusMessages } from "../i18n/messages/systemStatus";

interface Props {
  status: AppStatusSummary | null;
}

const { status } = Astro.props;
const known = status != null;
const healthy = status?.healthy === true;
const chip = systemStatusMessages(getLocale(Astro)).chip;
const label = !known
  ? chip.unknown
  : healthy
    ? chip.healthy
    : chip.degraded;
---
<a
  class:list={["home-status", known && !healthy && "home-status-warn"]}
  href="/system-status"
>
  <span
    class:list={[
      "home-status-dot",
      known && healthy && "home-status-dot-ok",
      known && !healthy && "home-status-dot-warn",
    ]}
    aria-hidden="true"
  ></span>
  {label}
</a>
