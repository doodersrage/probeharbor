---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getLocale } from "../i18n";
import { getLocalizedAboutPages, getLocalizedAboutParent } from "../i18n/content/aboutPages";
import { getLocalizedAboutFaqs } from "../i18n/content/aboutFaqs";
import { aboutArticleMessages } from "../i18n/messages/aboutArticle";
import {
  DEFAULT_ARTICLE_MODIFIED,
  DEFAULT_ARTICLE_PUBLISHED,
  getArticleSchema,
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { aboutFaqsToBlocks } from "../lib/aboutFaqs";
import { NOINDEX_ABOUT_SLUGS } from "../lib/sitemapPages";
import "../styles/about.css";
import AboutTopicSidebar from "./AboutTopicSidebar.astro";
import AboutRelatedGuides from "./AboutRelatedGuides.astro";
import AboutProductCta from "./AboutProductCta.astro";
import AboutJourneyStrip from "./AboutJourneyStrip.astro";
import AboutPageSections from "./AboutPageSections.astro";
import AboutConvertBar from "./AboutConvertBar.astro";
import AffiliateDisclosure from "./AffiliateDisclosure.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  heroCaption?: string;
  heroCredit?: string;
  heroCreditHref?: string;
  /** Show Amazon Associates disclosure (kit / BOM pages with tagged buy links). */
  commerceDisclosure?: boolean;
  /** Extra JSON-LD graphs (HowTo, etc.). */
  extraSchemas?: Record<string, unknown>[];
  sectionParent?: {
    slug: string;
    title: string;
  };
}

const {
  slug,
  title,
  description,
  heroImage,
  heroAlt,
  heroCaption,
  heroCredit,
  heroCreditHref,
  commerceDisclosure = false,
  extraSchemas = [],
  sectionParent: sectionParentProp,
} = Astro.props;

const locale = getLocale(Astro);
const t = aboutArticleMessages(locale);

const sectionParent =
  sectionParentProp ??
  (() => {
    const parent = getLocalizedAboutParent(slug, locale);
    return parent ? { slug: parent.slug, title: parent.title } : undefined;
  })();

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, `/about/${slug}`);
const aboutPages = getLocalizedAboutPages(locale);
const pageIndex = aboutPages.findIndex((page) => page.slug === slug);
const previousPage = pageIndex > 0 ? aboutPages[pageIndex - 1] : null;
const nextPage =
  pageIndex >= 0 && pageIndex < aboutPages.length - 1
    ? aboutPages[pageIndex + 1]
    : null;

const faqs = getLocalizedAboutFaqs(slug, locale);
const faqBlocks = aboutFaqsToBlocks(faqs, t.faqHeading);
const faqSchema = getFaqPageSchema(pageUrl, faqs);

const breadcrumbs = [
  { name: t.breadcrumbHome, path: "/" },
  { name: t.breadcrumbAbout, path: "/about" },
  ...(sectionParent
    ? [{ name: sectionParent.title, path: `/about/${sectionParent.slug}` }]
    : []),
  { name: title, path: `/about/${slug}` },
];

const schema = [
  getArticleSchema({
    siteUrl,
    pageUrl,
    headline: title,
    description,
    imageUrl: `${siteUrl}/og-about.jpg`,
    datePublished: DEFAULT_ARTICLE_PUBLISHED,
    dateModified: DEFAULT_ARTICLE_MODIFIED,
  }),
  getBreadcrumbSchema(siteUrl, breadcrumbs),
  ...(faqSchema ? [faqSchema] : []),
  ...extraSchemas.filter(Boolean),
];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  noindex={NOINDEX_ABOUT_SLUGS.has(slug) ? "follow" : false}
  skipAuth
  ogType="article"
  ogImage="/og-about.jpg"
  ogSection={sectionParent?.title ?? t.ogSectionFallback}
  speakableSelectors={[".card-title", ".card-subtitle", ".about-prose p"]}
>
  <div class="page-shell page-stack">
    <div class="about-article-layout">
      <AboutTopicSidebar slug={slug} />

      <div class="about-article-main page-stack">
        <section class="card animate-slide-in-left">
          <nav aria-label={t.breadcrumbLabel}>
            <ol class="about-breadcrumbs">
              <li><a href="/">{t.breadcrumbHome}</a> /</li>
              <li><a href="/about">{t.breadcrumbAbout}</a> /</li>
              {sectionParent && (
                <li>
                  <a href={`/about/${sectionParent.slug}`}>{sectionParent.title}</a> /
                </li>
              )}
              <li aria-current="page">{title}</li>
            </ol>
          </nav>
          <h1 class="card-title">{title}</h1>
          <p class="card-subtitle">{description}</p>
        </section>

        <AboutJourneyStrip slug={slug} />

        {heroImage && (
          <figure class="about-figure card overflow-hidden p-0">
            <Image
              src={heroImage}
              alt={heroAlt ?? title}
              class="h-full w-full object-cover"
              fetchpriority="high"
            />
            {(heroCaption || heroCredit) && (
              <figcaption>
                {heroCaption && <span class="about-figure-caption">{heroCaption}</span>}
                {heroCredit && heroCreditHref ? (
                  <a class="about-figure-credit" href={heroCreditHref} rel="noopener noreferrer" target="_blank">
                    {heroCredit}
                  </a>
                ) : heroCredit ? (
                  <span class="about-figure-credit">{heroCredit}</span>
                ) : null}
              </figcaption>
            )}
          </figure>
        )}

        <section class="card about-prose">
          <slot />
          {commerceDisclosure && <AffiliateDisclosure />}
          {faqBlocks.length > 0 && <AboutPageSections sections={faqBlocks} />}
        </section>

        <AboutProductCta slug={slug} />
        <AboutRelatedGuides slug={slug} />

        <nav class="card about-pagination" aria-label={t.paginationLabel}>
          {previousPage ? (
            <a class="btn-secondary" href={`/about/${previousPage.slug}`}>
              <span class="btn-icon btn-icon--start" aria-hidden="true">←</span>
              {previousPage.title}
            </a>
          ) : (
            <a class="btn-secondary" href="/about">
              <span class="btn-icon btn-icon--start" aria-hidden="true">←</span>
              {t.aboutOverview}
            </a>
          )}
          {nextPage ? (
            <a class="btn-secondary" href={`/about/${nextPage.slug}`}>
              {nextPage.title}
              <span class="btn-icon btn-icon--end" aria-hidden="true">→</span>
            </a>
          ) : (
            <a class="btn-secondary" href="/about">
              {t.backToOverview}
              <span class="btn-icon btn-icon--end" aria-hidden="true">→</span>
            </a>
          )}
        </nav>
      </div>
    </div>
  </div>
  <AboutConvertBar />
</Layout>
