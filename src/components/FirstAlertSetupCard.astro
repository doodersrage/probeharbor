---
/** Inline freeze + email setup on Devices after first ingest. */
import { getLocale } from "../i18n";
import { devicesSetupMessages } from "../i18n/messages/app/devices/setup";

interface Props {
  show: boolean;
  freezeThresholdF?: number;
  email?: string | null;
  alertSaved?: boolean;
  testSent?: boolean;
  testError?: boolean;
}

const {
  show,
  freezeThresholdF = 34,
  email = "",
  alertSaved = false,
  testSent = false,
  testError = false,
} = Astro.props;

const redirectTo = "/dashboard/devices";
const t = devicesSetupMessages(getLocale(Astro)).firstAlert;
---

{show && (
  <section class="card" id="first-alert-setup">
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-4">
      {t.subtitle}
    </p>
    {alertSaved && !testError && (
      <p class="alert-success mt-0 mb-4">
        {testSent
          ? t.savedAndTested
          : t.saved}
      </p>
    )}
    {testError && (
      <p class="alert-warning mt-0 mb-4">
        {t.testFailed}
      </p>
    )}
    <form action="/api/user/alert-essentials" method="post" class="space-y-3">
      <input type="hidden" name="redirect" value={redirectTo} />
      <div class="flex flex-wrap gap-4">
        <div class="form-field mb-0">
          <label class="form-label" for="first-alert-freeze">{t.freezeLabel}</label>
          <input
            class="form-input"
            type="number"
            step="0.5"
            id="first-alert-freeze"
            name="freeze_threshold_f"
            value={freezeThresholdF}
            required
          />
        </div>
        <div class="form-field mb-0 min-w-[16rem] flex-1">
          <label class="form-label" for="first-alert-email">{t.emailLabel}</label>
          <input
            class="form-input"
            type="email"
            id="first-alert-email"
            name="alert_email"
            value={email ?? ""}
            placeholder={t.emailPlaceholder}
            required
          />
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <button class="btn-primary" type="submit" name="also_test" value="1">
          {t.saveAndTest}
        </button>
        <button class="btn-secondary" type="submit">{t.saveOnly}</button>
        <a class="btn-ghost" href="/dashboard/alerts?tab=settings#alert-section-essentials">{t.fullSettings}</a>
      </div>
    </form>
  </section>
)}
