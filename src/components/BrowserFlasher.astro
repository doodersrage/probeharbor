---
/**
 * Flash the generic probe firmware from the browser (ESP Web Tools), then send
 * Wi-Fi and the device key to the board over the same USB cable. Needs Web
 * Serial, so Chrome or Edge on a desktop; other browsers see the fallback note.
 */
import { getLocale } from "../i18n";
import { browserFlasherMessages } from "../i18n/messages/flashBrowser";

interface Props {
  /** Pre-fill the device key (dashboard, right after a device is created). */
  deviceKey?: string;
  /** Heading level for the two step titles. */
  headingLevel?: "h2" | "h3";
}

const { deviceKey = "", headingLevel: Heading = "h2" } = Astro.props;
const t = browserFlasherMessages(getLocale(Astro));
---
<div class="browser-flasher" data-browser-flasher data-flasher-text={JSON.stringify(t.status)}>
  <section class="card">
    <Heading class="card-title">{t.installTitle}</Heading>
    <p class="mb-4">{t.installCopy}</p>
    <esp-web-install-button manifest="/firmware/manifest.json">
      <button slot="activate" class="btn-primary" type="button">{t.installButton}</button>
      <p slot="unsupported" class="alert-warning mb-0" set:html={t.unsupportedHtml} />
      <p slot="not-allowed" class="alert-warning mb-0">{t.notAllowed}</p>
    </esp-web-install-button>
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">{t.noPort}</p>
  </section>

  <section class="card">
    <Heading class="card-title">{t.connectTitle}</Heading>
    <p class="mb-4">{t.connectCopy}</p>
    <form class="grid gap-4 sm:grid-cols-2 mb-4" data-flasher-form>
      <label class="block">
        <span class="form-label">{t.ssidLabel}</span>
        <input class="form-input" name="ssid" required autocomplete="off" maxlength="32" />
        <span class="text-sm text-[var(--color-text-muted)]">{t.ssidHint}</span>
      </label>
      <label class="block">
        <span class="form-label">{t.passwordLabel}</span>
        <input class="form-input" name="password" type="password" autocomplete="off" maxlength="64" />
      </label>
      <label class="block sm:col-span-2">
        <span class="form-label">{t.keyLabel}</span>
        <input class="form-input" name="key" required autocomplete="off" maxlength="300" value={deviceKey} />
        <span class="text-sm text-[var(--color-text-muted)]">
          {deviceKey
            ? t.keyHintPrefilled
            : t.keyHint}
        </span>
      </label>
      <fieldset class="sm:col-span-2 m-0 p-0 border-0">
        <legend class="form-label">{t.extrasLegend}</legend>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <label class="checkbox-row mb-0"><input type="checkbox" name="extras" value="leak" /> {t.extraLeak}</label>
          <label class="checkbox-row mb-0"><input type="checkbox" name="extras" value="door" /> {t.extraDoor}</label>
          <label class="checkbox-row mb-0"><input type="checkbox" name="extras" value="battery" /> {t.extraBattery}</label>
        </div>
        <span class="text-sm text-[var(--color-text-muted)]">{t.extrasHint}</span>
      </fieldset>
      <div class="sm:col-span-2">
        <button class="btn-primary" type="submit" data-flasher-send>{t.sendButton}</button>
      </div>
    </form>
    <p class="mb-2 font-semibold" role="status" aria-live="polite" data-flasher-status></p>
    <pre class="ingest-key-curl text-xs overflow-x-auto mb-4" data-flasher-log hidden></pre>
    <p class="mb-0 text-sm text-[var(--color-text-muted)]" set:html={t.phoneSetupHtml} />
  </section>
</div>

<script>
  // The pre-bundled build: the package source imports @material/web internals that newer releases no longer export.
  import "esp-web-tools/dist/web/install-button.js";
  import { trackProductEvent } from "../lib/productAnalytics";

  type SerialPortLike = {
    open(options: { baudRate: number }): Promise<void>;
    close(): Promise<void>;
    setSignals?(signals: { dataTerminalReady?: boolean; requestToSend?: boolean }): Promise<void>;
    readable: ReadableStream<Uint8Array> | null;
    writable: WritableStream<Uint8Array> | null;
  };
  type SerialLike = { requestPort(): Promise<SerialPortLike> };

  const RESEND_EVERY_MS = 5000;
  const GIVE_UP_AFTER_MS = 90_000;

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  /** Tabs separate the fields on the wire, so they cannot appear inside one. */
  const clean = (value: FormDataEntryValue | null) => String(value ?? "").replace(/[\t\r\n]/g, "").trim();

  for (const root of document.querySelectorAll<HTMLElement>("[data-browser-flasher]")) {
    const form = root.querySelector<HTMLFormElement>("[data-flasher-form]");
    const status = root.querySelector<HTMLElement>("[data-flasher-status]");
    const log = root.querySelector<HTMLElement>("[data-flasher-log]");
    const button = root.querySelector<HTMLButtonElement>("[data-flasher-send]");
    if (!form || !status || !log || !button) continue;
    const text = JSON.parse(root.dataset.flasherText ?? "{}") as Record<string, string>;

    const serial = (navigator as Navigator & { serial?: SerialLike }).serial;
    if (!serial) {
      button.disabled = true;
      status.textContent = text.noSerial ?? "";
      continue;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const ssid = clean(data.get("ssid"));
      // Passwords may contain spaces at either end; only strip the separators.
      const password = String(data.get("password") ?? "").replace(/[\t\r\n]/g, "");
      const key = clean(data.get("key"));
      if (!ssid || !key) return;

      button.disabled = true;
      log.hidden = false;
      log.textContent = "";
      status.textContent = text.pickPort ?? "";

      let port: SerialPortLike | null = null;
      let reader: ReadableStreamDefaultReader<Uint8Array> | null = null;
      try {
        port = await serial.requestPort();
        await port.open({ baudRate: 115200 });
        // Opening the port resets many dev boards; release the lines and let it boot.
        await port.setSignals?.({ dataTerminalReady: false, requestToSend: false });
        status.textContent = text.waiting ?? "";
        await sleep(2500);

        const writer = port.writable!.getWriter();
        // Extras go on their own line first: firmware 1.2+ saves them, older firmware
        // ignores unknown lines (a fifth TTCFG field would end up in its device key).
        const extras = data.getAll("extras").map(String).join(",");
        const send = () =>
          writer.write(new TextEncoder().encode(`TTEXTRAS\t${extras}\nTTCFG\t${ssid}\t${password}\t${key}\n`));
        reader = port.readable!.getReader();

        const decoder = new TextDecoder();
        const startedAt = Date.now();
        let lastSent = 0;
        let acknowledged = false;
        let sensorName: string | null = null;
        let buffer = "";
        let outcome: "ok" | "failed" | "timeout" = "timeout";
        // One read stays pending across loop passes: starting a new read each
        // time the one-second tick wins would hand the next bytes to an abandoned promise.
        let pendingRead: ReturnType<typeof reader.read> | null = null;

        while (Date.now() - startedAt < GIVE_UP_AFTER_MS) {
          if (!acknowledged && Date.now() - lastSent > RESEND_EVERY_MS) {
            await send();
            lastSent = Date.now();
            status.textContent = text.sending ?? "";
          }
          pendingRead ??= reader.read();
          const chunk = await Promise.race([pendingRead, sleep(1000).then(() => null)]);
          if (!chunk) continue;
          pendingRead = null;
          if (chunk.done) break;
          buffer += decoder.decode(chunk.value, { stream: true });
          const lines = buffer.split("\n");
          buffer = lines.pop() ?? "";
          for (const raw of lines) {
            const line = raw.trim();
            if (!line.startsWith("TT ")) continue;
            log.textContent += `${line.slice(3)}\n`;
            if (line === "TT key saved") {
              acknowledged = true;
              status.textContent = text.received ?? "";
              // Funnel: device created → settings on the board → first reading.
              trackProductEvent("flasher_settings_sent");
            } else if (line === "TT wifi ok") {
              status.textContent = text.wifiOk ?? "";
            } else if (line.startsWith("TT sensor: ")) {
              // e.g. "TT sensor: DHT22 on GPIO 4" (firmware 1.1+; DS18B20s are the default and not announced)
              sensorName = line.slice("TT sensor: ".length).split(" on ")[0] ?? null;
            } else if (/^TT post 2\d\d /.test(line)) {
              outcome = "ok";
            } else if (
              line.startsWith("TT wifi failed") ||
              line.startsWith("TT key rejected") ||
              line.startsWith("TT config error") ||
              line.startsWith("TT no probe")
            ) {
              outcome = "failed";
              status.textContent = line.charAt(3).toUpperCase() + line.slice(4);
            }
          }
          if (outcome !== "timeout") break;
        }

        writer.releaseLock();
        if (outcome === "ok") {
          trackProductEvent("flasher_first_reading", sensorName ? { sensor: sensorName } : undefined);
          status.textContent = sensorName
            ? (text.liveWithSensor ?? "").replace("{sensor}", sensorName)
            : (text.live ?? "");
          root.dispatchEvent(new CustomEvent("probeharbor:probe-live", { bubbles: true }));
        } else if (outcome === "timeout") {
          status.textContent = acknowledged
            ? (text.noReading ?? "")
            : (text.noAnswer ?? "");
        }
      } catch (error) {
        status.textContent =
          error instanceof DOMException && error.name === "NotFoundError"
            ? (text.noPortSelected ?? "")
            : (text.couldNotTalk ?? "").replace("{error}", error instanceof Error ? error.message : String(error));
      } finally {
        try {
          await reader?.cancel();
          reader?.releaseLock();
          await port?.close();
        } catch {
          // The port is already gone (cable pulled); nothing left to release.
        }
        button.disabled = false;
      }
    });
  }
</script>
