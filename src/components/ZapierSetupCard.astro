---
import DashboardCard from "./dashboard/DashboardCard.astro";
import { getLocale } from "../i18n";
import { shareMessages } from "../i18n/messages/app/share";

interface Props {
  siteUrl: string;
  /** Full inbound webhook URL if one was just created or known. */
  inboundWebhookUrl?: string | null;
  hasInboundWebhook?: boolean;
}

const {
  siteUrl,
  inboundWebhookUrl = null,
  hasInboundWebhook = false,
} = Astro.props;

const t = shareMessages(getLocale(Astro)).zapier;

const tipUrl =
  inboundWebhookUrl ??
  (hasInboundWebhook ? `${siteUrl}/api/inbound/<your-token>` : null);
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4">
    {t.subtitle}
  </p>
  <ul class="text-sm space-y-2 mb-4">
    <li set:html={t.outboundHtml} />
    <li set:html={t.recipesHtml} />
    <li set:html={t.inboundHtml} />
  </ul>
  {tipUrl ? (
    <div class="rounded-lg border border-[var(--color-border)] p-3">
      <p class="form-label mb-1">{t.urlLabel}</p>
      <p class="break-all font-mono text-xs mb-2" id="zapier-inbound-url">{tipUrl}</p>
      {inboundWebhookUrl && (
        <button
          type="button"
          class="btn-secondary"
          data-copy={inboundWebhookUrl}
          data-copy-label={t.copyUrl}
        >
          {t.copyUrl}
        </button>
      )}
      {!inboundWebhookUrl && hasInboundWebhook && (
        <p class="form-hint mb-0">
          {t.tokenHint}
        </p>
      )}
    </div>
  ) : (
    <p class="mb-0 text-sm" set:html={t.createHtml} />
  )}
</DashboardCard>
