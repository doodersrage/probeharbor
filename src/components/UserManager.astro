---
import type { PaginatedManagedUsers, ManagedUserListQuery } from "../lib/userManager";
import {
  formatUserGroups,
  managedUserListQueryString,
} from "../lib/userManager";
import DashboardCard from "./dashboard/DashboardCard.astro";
import { fmt, formatDateTime, getLocale } from "../i18n";
import { adminMessages } from "../i18n/messages/app/admin";

interface Props {
  users: PaginatedManagedUsers;
  currentUserId: string;
  query: ManagedUserListQuery;
  basePath?: string;
  status?: string | null;
}

const {
  users,
  currentUserId,
  query,
  basePath = "/dashboard/users",
  status = null,
} = Astro.props;
const locale = getLocale(Astro);
const a = adminMessages(locale);
const t = a.users.manager;
const { users: rows, page, pageSize, totalCount, totalPages, error } = users;
const { search, group, sort } = query;

const showingFrom = totalCount === 0 ? 0 : (page - 1) * pageSize + 1;
const showingTo = totalCount === 0 ? 0 : Math.min(page * pageSize, totalCount);
const prevPage = page > 1 ? page - 1 : null;
const nextPage = page < totalPages ? page + 1 : null;
const listQuery = { search, group, sort };
const redirectTo = `${basePath}${managedUserListQueryString({ ...listQuery, page })}`;
const hasFilters = Boolean(search || group || sort !== "created_desc");

function pageHref(next: number): string {
  return `${basePath}${managedUserListQueryString({ ...listQuery, page: next })}`;
}
---

<DashboardCard>
  <div class="card-header-row">
    <div>
      <h2 class="card-title">{t.title}</h2>
      <p class="card-subtitle">
        {t.subtitle}
      </p>
    </div>
  </div>

  {status === "updated" && (
    <div class="alert-success mb-4" role="status">
      <p class="m-0">{t.updated}</p>
    </div>
  )}

  {status === "error" && (
    <div class="alert-warning mb-4" role="alert">
      <p class="m-0">{t.updateError}</p>
    </div>
  )}

  <form class="history-filters" method="get" action={basePath}>
    <div class="form-field mb-0">
      <label class="form-label" for="user-search">{a.common.search}</label>
      <input
        class="form-input"
        type="search"
        id="user-search"
        name="q"
        value={search}
        placeholder={t.searchPlaceholder}
      />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="user-group">{t.group}</label>
      <select class="form-input" id="user-group" name="group">
        <option value="" selected={group === ""}>{t.allGroups}</option>
        <option value="admin" selected={group === "admin"}>{t.admin}</option>
        <option value="portfolio" selected={group === "portfolio"}>Portfolio</option>
        <option value="pro" selected={group === "pro"}>Pro</option>
        <option value="member" selected={group === "member"}>Member</option>
        <option value="user" selected={group === "user"}>{t.groupUser}</option>
      </select>
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="user-sort">{t.sort}</label>
      <select class="form-input" id="user-sort" name="sort">
        <option value="created_desc" selected={sort === "created_desc"}>{t.newest}</option>
        <option value="created_asc" selected={sort === "created_asc"}>{t.oldest}</option>
        <option value="email_asc" selected={sort === "email_asc"}>{t.emailAz}</option>
        <option value="email_desc" selected={sort === "email_desc"}>{t.emailZa}</option>
      </select>
    </div>
    <button type="submit" class="btn-secondary self-end">{t.apply}</button>
    {hasFilters && (
      <a class="btn-ghost self-end" href={basePath}>{t.clear}</a>
    )}
  </form>
  <p class="preference-hint mb-4">
    {t.hint}
  </p>

  {error ? (
    <div class="empty-state">
      <p>{fmt(t.loadError, { error })}</p>
    </div>
  ) : rows.length === 0 ? (
    <div class="empty-state">
      <p>{hasFilters ? t.noMatch : t.noUsers}</p>
    </div>
  ) : (
    <>
      <div class="table-wrap">
        <table class="data-table data-table-users">
          <thead>
            <tr>
              <th scope="col">{a.common.email}</th>
              <th scope="col">{t.joined}</th>
              <th scope="col">{t.groups}</th>
              <th scope="col">{t.admin}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((managedUser) => {
              const isSelf = managedUser.user_id === currentUserId;

              return (
                <tr>
                  <td>
                    {managedUser.email}
                    {isSelf && (
                      <span class="ml-2 rounded-full bg-[rgb(252_222_156/0.55)] px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-[var(--color-accent-hover)]">
                        {t.you}
                      </span>
                    )}
                  </td>
                  <td>{formatDateTime(managedUser.created_at, locale, { dateStyle: "medium", timeStyle: "short" })}</td>
                  <td>{managedUser.groups.length === 0 ? t.noGroups : formatUserGroups(managedUser.groups)}</td>
                  <td>
                    {managedUser.is_admin ? (
                      isSelf ? (
                        <span class="rounded-full bg-[rgb(252_222_156/0.55)] px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-[var(--color-accent-hover)]">
                          {t.admin}
                        </span>
                      ) : (
                        <form action="/api/admin/users/toggle-admin" method="post">
                          <input type="hidden" name="redirect" value={redirectTo} />
                          <input type="hidden" name="user_id" value={managedUser.user_id} />
                          <input type="hidden" name="make_admin" value="false" />
                          <button class="btn-danger" type="submit">
                            {t.revoke}
                          </button>
                        </form>
                      )
                    ) : (
                      <form action="/api/admin/users/toggle-admin" method="post">
                        <input type="hidden" name="redirect" value={redirectTo} />
                        <input type="hidden" name="user_id" value={managedUser.user_id} />
                        <input type="hidden" name="make_admin" value="true" />
                        <button class="btn-secondary" type="submit">
                          {t.grant}
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="pagination">
        <p class="pagination-summary">
          {fmt(t.showing, { from: showingFrom, to: showingTo, total: totalCount })}
        </p>
        <div class="pagination-controls">
          {prevPage ? (
            <a class="btn-secondary" href={pageHref(prevPage)}>{a.common.previous}</a>
          ) : (
            <span class="btn-secondary pagination-disabled">{a.common.previous}</span>
          )}
          <span class="pagination-current">{fmt(a.common.pageOf, { page, total: Math.max(totalPages, 1) })}</span>
          {nextPage ? (
            <a class="btn-secondary" href={pageHref(nextPage)}>{a.common.next}</a>
          ) : (
            <span class="btn-secondary pagination-disabled">{a.common.next}</span>
          )}
        </div>
      </div>
    </>
  )}
</DashboardCard>

<style>
  .data-table-users {
    min-width: 48rem;
  }
</style>
