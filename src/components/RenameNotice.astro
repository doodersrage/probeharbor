---
/** Dismissible site-wide notice for the ThermalTrace → ProbeHarbor rename. */
import { BRAND_NAME } from "../lib/brand";
import {
  FORMER_BRAND_NAME,
  FORMER_DOMAIN,
  isRenameNoticeAccountPath,
  RENAME_ARRIVAL_PARAM,
  RENAME_ARRIVAL_VALUE,
  shouldShowRenameNotice,
} from "../lib/rebrand";
import { fmt, getLocale } from "../i18n";
import { layoutMessages } from "../i18n/messages/layout";

const t = layoutMessages(getLocale(Astro)).renameNotice;

const show = shouldShowRenameNotice();
// Account pages render it visible; elsewhere it starts hidden and the script
// below reveals it only for visitors with a ThermalTrace arrival signal.
const accountPath = isRenameNoticeAccountPath(Astro.url.pathname);
---
{show && (
  <aside
    class="rename-notice"
    aria-label={t.label}
    data-rename-notice
    data-account-path={accountPath ? "1" : undefined}
    data-arrival-param={RENAME_ARRIVAL_PARAM}
    data-arrival-value={RENAME_ARRIVAL_VALUE}
    hidden={!accountPath}
  >
    <p>
      <strong>{fmt(t.headline, { former: FORMER_BRAND_NAME, brand: BRAND_NAME })}</strong>
      {" "}{fmt(t.body, { domain: FORMER_DOMAIN })}
    </p>
    <button type="button" class="rename-notice-close" aria-label={t.dismiss} data-rename-dismiss>
      ×
    </button>
  </aside>
  <script is:inline>
    (function () {
      var KEY = "probeharbor.renameNoticeDismissed";
      var ARRIVED_KEY = "probeharbor.renameNoticeArrived";
      var el = document.querySelector("[data-rename-notice]");
      if (!el) return;
      var param = el.getAttribute("data-arrival-param");
      var value = el.getAttribute("data-arrival-value");
      var arrived = false;
      try {
        var url = new URL(window.location.href);
        if (param && url.searchParams.get(param) === value) {
          arrived = true;
          // Drop the flag from the address bar so it isn't shared or bookmarked.
          url.searchParams.delete(param);
          history.replaceState(history.state, "", url.pathname + url.search + url.hash);
        }
      } catch (e) {}
      if (/thermaltrace/i.test(document.referrer || "")) arrived = true;
      try {
        if (arrived) localStorage.setItem(ARRIVED_KEY, "1");
        else arrived = localStorage.getItem(ARRIVED_KEY) === "1";
      } catch (e) {}
      var dismissed = false;
      try {
        dismissed = localStorage.getItem(KEY) === "1";
      } catch (e) {}
      el.hidden = dismissed || !(arrived || el.hasAttribute("data-account-path"));
      var btn = el.querySelector("[data-rename-dismiss]");
      if (btn) {
        btn.addEventListener("click", function () {
          el.hidden = true;
          try {
            localStorage.setItem(KEY, "1");
          } catch (e) {}
        });
      }
    })();
  </script>
)}

<style>
  .rename-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    background: var(--color-accent-soft);
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .rename-notice[hidden] {
    display: none;
  }
  .rename-notice p {
    flex: 1;
    margin: 0;
    max-width: 72rem;
    margin-inline: auto;
  }
  .rename-notice-close {
    flex: none;
    background: none;
    border: 0;
    color: var(--color-text-muted);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
  }
  .rename-notice-close:hover {
    color: var(--color-text);
  }
</style>
