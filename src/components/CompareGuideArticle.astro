---
import Layout from "../layouts/Layout.astro";
import PageHeader from "./PageHeader.astro";
import AboutCcFigure from "./AboutCcFigure.astro";
import FaqSection from "./FaqSection.astro";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import type { CompareGuide } from "../lib/compareGuides";
import { fmt, getLocale } from "../i18n";
import { compareGuideMessages } from "../i18n/messages/compareGuide";
import { getLocalizedAnswersRelatedTo } from "../i18n/content/answers";
import "../styles/about.css";

interface Props {
  guide: CompareGuide;
}

const { guide } = Astro.props;
const locale = getLocale(Astro);
const t = compareGuideMessages(locale);
const relatedAnswers = getLocalizedAnswersRelatedTo(guide.path, locale, [
  "freeze-alarm-without-subscription",
  "freeze-alarm-temperature-setting",
  "wifi-freeze-alarm-power-outage",
]);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, guide.path);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: "/" },
    { name: t.breadcrumbCompare, path: "/compare" },
    { name: guide.title, path: guide.path },
  ]),
  getFaqPageSchema(pageUrl, guide.faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={guide.seoTitle ?? guide.title}
  description={guide.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={t.kicker}
      title={guide.headline}
      lede={guide.lede}
    >
      <a slot="actions" class="btn-primary" href="/pricing">{t.seePlansPricing}</a>
      <a slot="actions" class="btn-secondary" href="/register?next=/dashboard/devices">{t.startFree}</a>
    </PageHeader>

    {guide.photoId && <AboutCcFigure photoId={guide.photoId} />}

    <section class="card">
      <h2 class="card-title">{fmt(t.versusTitle, { competitor: guide.competitor })}</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">{fmt(t.tableCaption, { headline: guide.headline })}</caption>
          <thead>
            <tr>
              <th scope="col">{t.capability}</th>
              <th scope="col">ProbeHarbor</th>
              <th scope="col">{guide.competitor}</th>
            </tr>
          </thead>
          <tbody>
            {guide.rows.map((row) => (
              <tr>
                <th scope="row">{row.capability}</th>
                <td>{row.probeharbor}</td>
                <td>{row.other}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">{t.whenTitle}</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="text-base font-semibold mb-2">{t.chooseProbeHarbor}</h3>
          <ul class="text-sm space-y-2 mb-0">
            {guide.whenProbeHarbor.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-base font-semibold mb-2">{fmt(t.chooseOther, { competitor: guide.competitor })}</h3>
          <ul class="text-sm space-y-2 mb-0">
            {guide.whenOther.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <FaqSection
      faqs={guide.faqs}
      lede={fmt(t.faqLede, { competitor: guide.competitor })}
    />

    {guide.sources && (
      <section class="card">
        <h2 class="card-title">{t.sourcesTitle}</h2>
        <p class="card-subtitle mb-3">
          {fmt(t.sourcesNote, { competitor: guide.competitor, checkedOn: guide.sources.checkedOn })}
        </p>
        <ul class="text-sm space-y-1 mb-0">
          {guide.sources.links.map((link) => (
            <li><a class="text-link" href={link.url} rel="noopener noreferrer" target="_blank">{link.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">{t.relatedTitle}</h2>
      <ul class="text-sm space-y-1 mb-0">
        {relatedAnswers.map((answer) => (
          <li><a class="text-link" href={answer.path}>{answer.question}</a></li>
        ))}
        <li><a class="text-link" href="/pipe-freeze-forecast">{t.forecastLink}</a></li>
        <li><a class="text-link" href="/freeze-time-calculator">{t.calculatorLink}</a></li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">{t.nextTitle}</h2>
      <p class="card-subtitle mb-4">
        {t.nextSubtitle}
      </p>
      <div class="flex flex-wrap gap-3 mb-4">
        <a class="btn-primary" href="/pricing">{t.seePlansPricing}</a>
        <a class="btn-secondary" href="/register?next=/dashboard/devices">{t.startFree}</a>
        {guide.slug === "diy-mqtt" && (
          <a class="btn-secondary" href="/integrations/home-assistant">{t.haButton}</a>
        )}
        {guide.slug === "diy-mqtt" && (
          <a class="btn-secondary" href="/about/mqtt-bridge">{t.mqttBridge}</a>
        )}
        {(guide.slug === "nest" || guide.slug === "ecobee") && (
          <a class="btn-secondary" href="/dashboard/devices?view=setup&tab=thermostat#thermostat-integration">
            {fmt(t.connectThermostat, { brand: guide.competitor.replace(" Thermostat", "") })}
          </a>
        )}
        {guide.slug === "tempstick" && (
          <a class="btn-secondary" href="/freeze-season">{t.freezeSeason}</a>
        )}
        {guide.slug === "tempstick" && (
          <a class="btn-secondary" href="/about/esp32-freeze-kit">{t.esp32Kit}</a>
        )}
      </div>
      <p class="mb-0 text-sm">
        <a class="text-link" href="/compare">{t.backToAll}</a>
        {guide.slug === "diy-mqtt" && (
          <>
            {" · "}
            <a class="text-link" href="/integrations/home-assistant">{t.hacsIntegration}</a>
            {" · "}
            <a class="text-link" href="/nodered/mqtt-to-probeharbor.json" download>{t.nodeRedFlow}</a>
          </>
        )}
      </p>
    </section>
  </div>
</Layout>
