---
import { getLocale } from "../i18n";
import { aboutArticleMessages } from "../i18n/messages/aboutArticle";
import { getLocalizedAboutMegaGroupSections } from "../i18n/content/aboutNavigation";
import { getAboutStats } from "../lib/aboutPages";

const locale = getLocale(Astro);
const t = aboutArticleMessages(locale).hubNav;
const megaGroups = getLocalizedAboutMegaGroupSections(locale);
const stats = getAboutStats();
---
<nav class="about-hub-toc card" aria-label={t.label}>
  <h2 class="about-hub-toc-title">{t.title}</h2>
  <p class="about-hub-toc-lead">{t.lead(stats.coreCount, stats.guideCount)}</p>
  <ol class="about-hub-toc-list">
    {megaGroups.map(({ group, coreCount, guideCount }) => (
      <li>
        <a class="about-hub-toc-link" href={`#${group.id}`}>
          <span class="about-hub-toc-link-title">{group.title}</span>
          <span class="about-hub-toc-link-desc">{group.description}</span>
          <span class="about-hub-toc-link-meta">
            {coreCount} {t.topics(coreCount)} · {guideCount} {t.guides}
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

{megaGroups.map(({ group, sections, guideCount }) => (
  <section id={group.id} class="about-mega-group">
    <header class="about-mega-group-header">
      <h2 class="about-mega-group-title">{group.title}</h2>
      <p class="about-mega-group-desc">
        {group.description}
        <span class="about-mega-group-meta">
          {sections.length} {t.topics(sections.length)} · {guideCount} {t.guides}
        </span>
      </p>
    </header>

    <div class="about-mega-group-sections">
      {sections.map(({ core, guides }) => (
        <article class="card about-topic-card">
          <div class="about-topic-card-header">
            <a class="about-topic-core-link" href={`/about/${core.slug}`}>
              <h3>{core.title}</h3>
              <p>{core.summary}</p>
            </a>
            <a class="btn-secondary about-topic-start" href={`/about/${core.slug}`}>
              {t.readOverview}
              <span class="btn-icon btn-icon--end" aria-hidden="true">→</span>
            </a>
          </div>

          {guides.length > 0 && (
            <details class="about-topic-guides">
              <summary>
                {t.deepDive}
                <span class="about-topic-count">{guides.length}</span>
              </summary>
              <ul class="about-topic-guide-list">
                {guides.map((guide) => (
                  <li>
                    <a href={`/about/${guide.slug}`}>
                      <span class="about-topic-guide-title">{guide.title}</span>
                      <span class="about-topic-guide-summary">{guide.summary}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </article>
      ))}
    </div>
  </section>
))}
