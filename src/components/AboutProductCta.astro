---
import { getLocale } from "../i18n";
import { aboutArticleMessages } from "../i18n/messages/aboutArticle";
import { buildRegisterHref } from "../lib/registerUrl";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const registerHref = buildRegisterHref();
const t = aboutArticleMessages(getLocale(Astro)).productCta;

/** Destinations per slug; copy lives in `aboutArticleMessages().productCta`. */
const productCtaHrefs: Record<string, string> = {
  "cold-snap-playbook": "/dashboard/alerts?tab=settings#alert-section-essentials",
  "alert-channel-cookbook": "/dashboard/alerts?tab=settings#alert-section-essentials",
  "household-sharing-walkthrough": "/dashboard/share/links",
  "freeze-protection-thresholds": "/dashboard/alerts?tab=settings#alert-section-essentials",
  "ingest-and-webhooks": "/dashboard/devices?view=setup",
  "adding-devices": registerHref,
  "dht22-sensor-overview": registerHref,
};

const href = productCtaHrefs[slug];
const copy = href ? (t.bySlug[slug] ?? t.fallback) : t.fallback;
const cta = { ...copy, href: href ?? registerHref };
const showDemo = cta.href.startsWith("/register");
---
<aside class="card about-product-cta" role="note">
  <div class="about-product-cta-body">
    <p class="about-product-cta-title">{cta.title}</p>
    <p class="about-product-cta-text">{cta.body}</p>
  </div>
  <div class="about-product-cta-actions">
    <a class="btn-primary" href={cta.href}>{cta.label}</a>
    {showDemo ? (
      <a class="btn-secondary" href="/demo">{t.liveDemo}</a>
    ) : (
      <a class="btn-secondary" href="/pricing">{t.seePlans}</a>
    )}
  </div>
</aside>
