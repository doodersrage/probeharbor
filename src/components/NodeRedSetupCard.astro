---
import DashboardCard from "./dashboard/DashboardCard.astro";
import { getLocale } from "../i18n";
import { shareMessages } from "../i18n/messages/app/share";

const t = shareMessages(getLocale(Astro)).nodeRed;
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4">
    {t.subtitle}
  </p>
  <ol class="text-sm space-y-2 mb-4">
    <li set:html={t.step1Html} />
    <li>{t.step2}</li>
    <li set:html={t.step3Html} />
    <li>{t.step4}</li>
  </ol>
  <div class="flex flex-wrap gap-3 mb-4">
    <a class="btn-secondary" href="/nodered/mqtt-to-probeharbor.json" download>
      {t.downloadFlow}
    </a>
    <a class="btn-ghost" href="https://probeharbor.dev/developers/integrations/mqtt-bridge">
      {t.devDocs}
    </a>
    <a class="btn-ghost" href="/integrations/node-red">
      {t.fullGuide}
    </a>
  </div>
  <p class="text-sm text-[var(--color-text-muted)] mb-0" set:html={t.footerHtml} />
</DashboardCard>
