---
import DashboardCard from "./dashboard/DashboardCard.astro";
import MfaEnroll from "./MfaEnroll.tsx";
import { getLocale } from "../i18n";
import { settingsMessages } from "../i18n/messages/app/settings";

const locale = getLocale(Astro);
const messages = settingsMessages(locale);
const t = messages.security;
---
<DashboardCard>
  <h2 class="card-title">{t.heading}</h2>
  <p class="card-subtitle mb-3">
    {t.subtitle}
  </p>
  <MfaEnroll client:visible text={messages.mfa} locale={locale} />

  <h3 class="mt-6 mb-1 text-base font-semibold">{t.signOutHeading}</h3>
  <p class="mt-0 mb-3 text-sm text-[var(--color-text-muted)]">
    {t.signOutBody}
  </p>
  <form method="post" action="/api/auth/signout-everywhere">
    <button type="submit" class="btn-secondary">{t.signOutSubmit}</button>
  </form>
</DashboardCard>
