---
import DashboardCard from "./dashboard/DashboardCard.astro";
import type { HeatingInsight } from "../lib/heatingInsights";
import { getLocale } from "../i18n";
import { overviewCardsMessages } from "../i18n/messages/app/overviewCards";

interface Props {
  insights: HeatingInsight[];
}

const { insights } = Astro.props;
const t = overviewCardsMessages(getLocale(Astro)).heatingCard;
---
{insights.length > 0 && (
  <DashboardCard>
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-3">
      {t.subtitle}
    </p>
    <ul class="space-y-2 m-0 p-0 list-none">
      {insights.map((item) => (
        <li
          class:list={[
            "rounded border p-3 text-sm",
            item.severity === "warning"
              ? "border-[var(--color-warning-border)] bg-[var(--color-warning-bg)]"
              : "border-[var(--color-border)]",
          ]}
        >
          <p class="font-semibold m-0">{item.label}</p>
          <p class="m-0 mt-1 text-[var(--color-text-muted)]">{item.detail}</p>
        </li>
      ))}
    </ul>
  </DashboardCard>
)}
