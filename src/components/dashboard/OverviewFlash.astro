---
import { fmt, getLocale } from "../../i18n";
import { overviewInsightsMessages } from "../../i18n/messages/app/overviewInsights";

interface Props {
  passwordUpdated?: boolean;
  prefsSaved?: boolean;
  prefsError?: boolean;
  checkedSaved?: boolean;
  checkedError?: boolean;
  ackOk?: boolean;
  ackMsg?: string | null;
  snoozeFlash?: boolean;
  snoozeHours?: string | null;
  snoozeCleared?: boolean;
  vacationFlash?: boolean;
  vacationCleared?: boolean;
  vacationError?: boolean;
}

const {
  passwordUpdated = false,
  prefsSaved = false,
  prefsError = false,
  checkedSaved = false,
  checkedError = false,
  ackOk = false,
  ackMsg = null,
  snoozeFlash = false,
  snoozeHours = null,
  snoozeCleared = false,
  vacationFlash = false,
  vacationCleared = false,
  vacationError = false,
} = Astro.props;

const t = overviewInsightsMessages(getLocale(Astro)).flash;

const show =
  passwordUpdated ||
  prefsSaved ||
  prefsError ||
  checkedSaved ||
  checkedError ||
  ackOk ||
  snoozeFlash ||
  snoozeCleared ||
  vacationFlash ||
  vacationCleared ||
  vacationError;
---

{show && (
  <div class="dashboard-flash" id="overview-flash">
    {passwordUpdated && (
      <p class="alert-success mt-0 mb-0" role="status">{t.passwordUpdated}</p>
    )}
    {prefsSaved && (
      <p class="alert-success mt-0 mb-0" role="status">
        {t.prefsSaved}
        {" "}
        <a class="text-link" href="/dashboard/settings">{t.openSettings}</a>
      </p>
    )}
    {prefsError && (
      <p class="alert-warning mt-0 mb-0" role="alert">
        {t.prefsError}
        {" "}
        <a class="text-link" href="/dashboard/settings">{t.tryAgainInSettings}</a>
      </p>
    )}
    {checkedSaved && (
      <p class="alert-success mt-0 mb-0" role="status">
        {t.checkedSaved}
      </p>
    )}
    {checkedError && (
      <p class="alert-warning mt-0 mb-0" role="alert">
        {t.checkedError}
      </p>
    )}
    {ackOk && (
      <p class="alert-success mt-0 mb-0" role="status">
        {ackMsg ?? t.alertHandled}
      </p>
    )}
    {snoozeFlash && (
      <p class="alert-success mt-0 mb-0" role="status">
        {snoozeHours ? fmt(t.snoozedFor, { hours: snoozeHours }) : t.snoozed}
      </p>
    )}
    {snoozeCleared && (
      <p class="alert-success mt-0 mb-0" role="status">{t.snoozeCleared}</p>
    )}
    {vacationFlash && (
      <p class="alert-success mt-0 mb-0" role="status">{t.vacationSet}</p>
    )}
    {vacationCleared && (
      <p class="alert-success mt-0 mb-0" role="status">{t.vacationCleared}</p>
    )}
    {vacationError && (
      <p class="alert-warning mt-0 mb-0" role="alert">
        {t.vacationError}
      </p>
    )}
  </div>
)}
