---
import { getLocale } from "../../i18n";
import { overviewNudgesMessages } from "../../i18n/messages/app/overview/nudges";

interface Props {
  hasAlertsEnabled: boolean;
  hasEmailAlerts: boolean;
  canEdit?: boolean;
  show?: boolean;
}

const { hasAlertsEnabled, hasEmailAlerts, canEdit = true, show = true } = Astro.props;

if (!show || !canEdit || (hasAlertsEnabled && hasEmailAlerts)) {
  return null;
}

const step = !hasAlertsEnabled ? "threshold" : "email";
const t = overviewNudgesMessages(getLocale(Astro));
const ta = t.alertSetup;
---
<aside class="card alert-setup-nudge" data-nudge-key="alert_setup_nudge" role="note">
  <div class="alert-setup-nudge-body">
    <p class="alert-setup-nudge-title">{ta.title}</p>
    {step === "threshold" ? (
      <p class="alert-setup-nudge-text">
        {ta.thresholdText}
      </p>
    ) : (
      <p class="alert-setup-nudge-text">
        {ta.emailText}
      </p>
    )}
  </div>
  <div class="alert-setup-nudge-actions">
    {step === "threshold" ? (
      <a class="btn-primary" href="/dashboard/alerts?tab=settings#alert-section-essentials">{ta.setFreezeEmail}</a>
    ) : (
      <a class="btn-primary" href="/dashboard/alerts?tab=settings#alert-section-channels">{ta.enableEmail}</a>
    )}
    <a class="btn-secondary" href="/dashboard/alerts?tab=settings">{t.openAlerts}</a>
    <button type="button" class="btn-ghost" data-dismiss="alert_setup_nudge">
      {t.dismiss}
    </button>
  </div>
</aside>
