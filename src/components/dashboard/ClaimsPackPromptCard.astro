---
import DashboardCard from "./DashboardCard.astro";
import UpgradeNudge from "../UpgradeNudge.astro";
import type { PlanTier } from "../../lib/entitlements";
import { getLocale } from "../../i18n";
import { overviewInsightsMessages } from "../../i18n/messages/app/overviewInsights";

interface Props {
  canUseClaimsPack: boolean;
  tier: PlanTier;
  show?: boolean;
}

const { canUseClaimsPack, tier, show = true } = Astro.props;
const t = overviewInsightsMessages(getLocale(Astro)).claimsPack;

if (!show) {
  return null;
}
---
{canUseClaimsPack ? (
  <DashboardCard id="claims-pack-prompt">
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-4">
      {t.body}
    </p>
    <div class="flex flex-wrap gap-2">
      <a class="btn-primary" href="/dashboard/history?tab=exports#claims-pack">{t.generate}</a>
      <a class="btn-secondary" href="/claims-pack">{t.included}</a>
    </div>
  </DashboardCard>
) : (
  <UpgradeNudge feature="claims_pack" tier={tier} compact />
)}
