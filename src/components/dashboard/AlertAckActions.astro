---
/**
 * One-click "I'm on it" plus the other acknowledge actions behind "More".
 * Each button submits its own `action` value to /api/user/alert-events/ack.
 */
import { getLocale } from "../../i18n";
import { alertsMessages } from "../../i18n/messages/app/alerts";

interface Props {
  eventId: number;
  hasTenantRelay: boolean;
  canPingWebhook: boolean;
  compact?: boolean;
}

const { eventId, hasTenantRelay, canPingWebhook, compact = false } = Astro.props;

const t = alertsMessages(getLocale(Astro)).ack;

const moreActions: Array<{ value: string; label: string }> = [
  { value: "snooze_1h", label: t.snooze1h },
  { value: "snooze_4h", label: t.snooze4h },
  { value: "snooze_24h", label: t.snooze24h },
  { value: "false_alarm", label: t.falseAlarm },
  { value: "raise_threshold", label: t.raiseThreshold },
  ...(hasTenantRelay ? [{ value: "notify_tenant", label: t.notifyTenant }] : []),
  ...(canPingWebhook ? [{ value: "webhook_ping", label: t.webhookPing }] : []),
];
---
<form
  action="/api/user/alert-events/ack"
  method="post"
  class:list={["alert-ack-actions", compact && "alert-ack-actions--compact"]}
>
  <input type="hidden" name="event_id" value={eventId} />
  <input type="hidden" name="redirect" value="/dashboard/alerts" />
  <button
    type="submit"
    name="action"
    value="ack"
    class="btn-secondary btn-sm"
    title={t.imOnItTitle}
  >
    {t.imOnIt}
  </button>
  <details class="alert-ack-more">
    <summary class="btn-ghost btn-sm">{t.more}</summary>
    <div class="alert-ack-more-menu">
      {moreActions.map((action) => (
        <button type="submit" name="action" value={action.value} class="btn-ghost btn-sm">
          {action.label}
        </button>
      ))}
    </div>
  </details>
</form>

<style>
  .alert-ack-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.35rem;
  }
  .alert-ack-more > summary {
    list-style: none;
    cursor: pointer;
  }
  .alert-ack-more > summary::-webkit-details-marker {
    display: none;
  }
  /*
   * Opens in the flow (the row grows) rather than floating: the desktop table
   * sits in an overflow-x scroll wrapper, which also clips vertically, so a
   * floating menu was cut off and its snooze options were hidden.
   */
  .alert-ack-more-menu {
    margin-top: 0.25rem;
    width: max-content;
    max-width: 100%;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
    padding: 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-elevated);
  }
  .alert-ack-more-menu button {
    justify-content: flex-start;
    text-align: left;
    white-space: nowrap;
  }
</style>
