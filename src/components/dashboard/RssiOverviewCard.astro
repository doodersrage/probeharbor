---
import DashboardCard from "./DashboardCard.astro";
import BatteryTrendChart from "../BatteryTrendChart";
import type { RssiOverviewRow } from "../../lib/overviewExtras";
import { fmt, formatNumber, getLocale, LOCALE_META } from "../../i18n";
import { overviewInsightsMessages } from "../../i18n/messages/app/overviewInsights";

interface Props {
  rows: RssiOverviewRow[];
}

const { rows } = Astro.props;
const locale = getLocale(Astro);
const messages = overviewInsightsMessages(locale);
const t = messages.rssi;
const chartText = { ...messages.chart, title: t.chartTitle };
const chartSeries = rows
  .filter((row) => row.samples.length >= 2)
  .map((row) => ({
    label: row.deviceName,
    samples: row.samples.map((sample) => ({ value: sample.dbm, at: sample.at })),
  }));
---
{rows.length > 0 && (
  <DashboardCard>
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-4">{t.subtitle}</p>
    <ul class="space-y-2 mb-0">
      {rows.map((row) => (
        <li class="text-sm flex flex-wrap justify-between gap-2">
          <strong>{row.deviceName}</strong>
          <span class:list={[row.weak && "text-[var(--color-warning-text)]"]}>
            {formatNumber(row.rssi, locale, { useGrouping: false })} dBm
            {row.samples.length >= 2 ? fmt(t.samples, { count: formatNumber(row.samples.length, locale) }) : ""}
          </span>
        </li>
      ))}
    </ul>
    {chartSeries.length > 0 && (
      <div class="mt-4">
        <BatteryTrendChart
          client:visible
          series={chartSeries}
          title={t.chartTitle}
          text={chartText}
          intl={LOCALE_META[locale].intl}
          unitSuffix=" dBm"
          valuePad={3}
          canvasClassName="history-chart-canvas--battery"
        />
      </div>
    )}
    {chartSeries.length === 0 && (
      <p class="mt-3 mb-0 text-xs text-[var(--color-text-muted)]">
        <Fragment set:html={t.trendHintHtml} />
      </p>
    )}
    <p class="mt-4 mb-0 text-sm">
      <a class="text-link" href="/dashboard/devices">{messages.extras.openDevices}</a>
    </p>
  </DashboardCard>
)}
