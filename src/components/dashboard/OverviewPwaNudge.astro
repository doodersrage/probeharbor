---
import { getLocale } from "../../i18n";
import { overviewNudgesMessages } from "../../i18n/messages/app/overview/nudges";

interface Props {
  show: boolean;
}

const { show } = Astro.props;
const t = overviewNudgesMessages(getLocale(Astro)).pwa;
---
{show && (
  <section class="card" id="overview-pwa-nudge" aria-labelledby="overview-pwa-nudge-title">
    <h2 class="card-title" id="overview-pwa-nudge-title">{t.title}</h2>
    <p class="card-subtitle mb-4">
      {t.body}
    </p>
    <div class="flex flex-wrap gap-3">
      <a class="btn-secondary" href="/dashboard/settings#pwa-install">{t.install}</a>
      <a class="btn-ghost" href="/about/install-pwa">{t.guide}</a>
    </div>
  </section>
)}
