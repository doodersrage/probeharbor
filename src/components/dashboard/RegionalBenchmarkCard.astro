---
import DashboardCard from "./DashboardCard.astro";
import type { RegionalBenchmark } from "../../lib/regionalBenchmark";
import { fmt, formatNumber, getLocale } from "../../i18n";
import { overviewCardsMessages } from "../../i18n/messages/app/overviewCards";

interface Props {
  benchmark: RegionalBenchmark;
}

const { benchmark } = Astro.props;
const delta = benchmark.deltaF;
const warmer = delta != null && delta > 0;
const locale = getLocale(Astro);
const t = overviewCardsMessages(locale).benchmarkCard;
const one = (value: number) =>
  formatNumber(value, locale, { minimumFractionDigits: 1, maximumFractionDigits: 1, useGrouping: false });
// lib/regionalBenchmark words its message in English (alerts reuse it), so
// other languages rebuild it from the same numbers.
const cityLabel =
  locale !== "en" && benchmark.cityLabel === "your region" ? t.yourRegion : benchmark.cityLabel;
const message =
  locale === "en" || delta == null
    ? benchmark.message
    : Math.abs(delta) < 1.5
      ? fmt(t.typical, { city: cityLabel })
      : fmt(delta < 0 ? t.colderMessage : t.warmerMessage, { delta: one(Math.abs(delta)), city: cityLabel });
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-3">
    {fmt(t.subtitle, { city: cityLabel })}
  </p>
  <p class="text-2xl font-bold mb-2">
    {one(benchmark.yourTempF)}°F
    {benchmark.cityAvgTempF != null && (
      <span class="text-base font-normal text-[var(--color-text-muted)]">
        {" "}· {fmt(t.cityAvg, { temp: one(benchmark.cityAvgTempF) })}
      </span>
    )}
  </p>
  <p class="mb-0 text-sm text-[var(--color-text-muted)]">{message}</p>
  {delta != null && Math.abs(delta) >= 1.5 && (
    <p class="mt-3 mb-0 text-sm">
      {fmt(warmer ? t.warmer : t.colder, { delta: one(Math.abs(delta)) })}
    </p>
  )}
  <p class="mt-4 mb-0 text-xs text-[var(--color-text-muted)]">
    <a class="text-link" href="/freeze-map">{t.publicMap}</a>
    {" · "}
    <a class="text-link" href="/dashboard/household#freeze-map">{t.mapSettings}</a>
  </p>
</DashboardCard>
