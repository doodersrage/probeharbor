---
import { getLocale } from "../../i18n";
import { overviewNudgesMessages } from "../../i18n/messages/app/overview/nudges";

interface Props {
  show: boolean;
}

const { show } = Astro.props;
const t = overviewNudgesMessages(getLocale(Astro)).multiProperty;
---
{show && (
  <div class="card mb-0" role="complementary">
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-3">
      {t.body}
    </p>
    <p class="mb-0 flex flex-wrap gap-3">
      <a class="btn-secondary" href="/dashboard/household">{t.add}</a>
      <a class="text-link self-center" href="/property-management">{t.portfolio}</a>
    </p>
  </div>
)}
