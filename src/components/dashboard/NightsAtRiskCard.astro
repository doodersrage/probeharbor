---
import DashboardCard from "./DashboardCard.astro";
import type { NightRisk, WeatherSnapshot } from "../../lib/FetchWeather";
import type { NwsAlertSummary } from "../../lib/nwsAlerts";
import WeatherMap from "../WeatherMap";
import { fmt, formatDateTime, formatNumber, getLocale, plural } from "../../i18n";
import { overviewCardsMessages } from "../../i18n/messages/app/overviewCards";
import { liveMessages } from "../../i18n/messages/app/live";

interface Props {
  nightsAtRisk: NightRisk[];
  nightsRiskCount: number;
  freezeThresholdF: number;
  weatherSnapshot: WeatherSnapshot | null;
  weatherHasCoords: boolean;
  nwsAlerts: NwsAlertSummary | null;
}

const {
  nightsAtRisk,
  nightsRiskCount,
  freezeThresholdF,
  weatherSnapshot,
  weatherHasCoords,
  nwsAlerts,
} = Astro.props;

const locale = getLocale(Astro);
const t = overviewCardsMessages(locale).nightsCard;
// Same map copy as Live's weather panel.
const weatherText = liveMessages(locale).weather;
const mapText = {
  mapLabel: weatherText.mapLabel,
  openLarger: weatherText.mapOpenLarger,
  attribution: weatherText.mapAttribution,
};
const threshold = locale === "en" ? String(freezeThresholdF) : formatNumber(freezeThresholdF, locale);
const whole = (value: number) =>
  formatNumber(value, locale, { maximumFractionDigits: 0, useGrouping: false });
/** `night.dateLabel` is English; other languages format `night.date` the same way. */
const nightLabel = (night: NightRisk) =>
  locale === "en"
    ? night.dateLabel
    : formatDateTime(`${night.date}T12:00:00Z`, locale, {
        weekday: "short",
        month: "short",
        day: "numeric",
        timeZone: "UTC",
      });

const locationLabel = weatherSnapshot
  ? `${weatherSnapshot.name}${weatherSnapshot.country ? `, ${weatherSnapshot.country}` : ""}`
  : t.weather;
---
{nightsAtRisk.length > 0 && (
  <DashboardCard>
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-4">
      {fmt(t.subtitle, { threshold })}
      {nightsRiskCount > 0
        ? ` ${plural(t.atRiskCount, nightsRiskCount, locale)}`
        : ` ${t.noneAtRisk}`}
    </p>
    {weatherHasCoords && weatherSnapshot && weatherSnapshot.lat != null && weatherSnapshot.lon != null && (
      <WeatherMap
        client:only="preact"
        lat={weatherSnapshot.lat}
        lon={weatherSnapshot.lon}
        label={locationLabel}
        text={mapText}
      >
        <div slot="fallback" class="weather-map mb-6">
          <div class="weather-map-frame freeze-map-frame" aria-hidden="true"></div>
        </div>
      </WeatherMap>
    )}
    {nwsAlerts && nwsAlerts.alerts.length > 0 && (
      <div class="alert-warning mb-4">
        <p class="m-0 mb-2"><strong>{t.nwsTitle}</strong></p>
        <ul class="m-0 pl-5">
          {nwsAlerts.alerts.slice(0, 3).map((alert) => (
            <li>
              {alert.event}: {alert.headline.slice(0, 120)}
              {alert.headline.length > 120 ? "…" : ""}
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="grid grid-cols-12 gap-3">
      {nightsAtRisk.map((night) => (
        <article
          class:list={[
            "col-span-6 sm:col-span-4 lg:col-span-2 rounded-lg border border-border bg-muted/50 p-3",
            night.atRisk && "border-[var(--color-danger-border)]",
          ]}
        >
          <span class="block text-xs text-muted-foreground">{nightLabel(night)}</span>
          <p class="m-0 mt-1 text-base font-semibold text-foreground">
            {whole(night.minTempF)}°F
          </p>
          <p class:list={[
            "m-0 mt-0.5 text-sm",
            night.atRisk ? "text-[var(--color-danger)]" : "text-muted-foreground",
          ]}>
            {night.atRisk ? t.atRisk : t.ok}
          </p>
        </article>
      ))}
    </div>
  </DashboardCard>
)}
