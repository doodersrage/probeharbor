---
import DashboardCard from "./DashboardCard.astro";
import ChartSkeleton from "./ChartSkeleton.astro";
import HistoryChart from "../HistoryChart";
import type { ChartPoint } from "../../lib/garageTempsHistory";

interface Props {
  points: ChartPoint[];
  housePoints?: ChartPoint[];
  houseLegend?: string | null;
  title?: string;
  freezeThresholdF?: number | null;
  canExport?: boolean;
  exportFrom?: string;
  exportTo?: string;
  showHumidity?: boolean;
  days?: number;
  alertMarkers?: import("../../lib/chartAlertMarkers").ChartAlertMarker[];
}

const {
  points,
  housePoints = [],
  houseLegend = null,
  title,
  freezeThresholdF = null,
  canExport = false,
  exportFrom = "",
  exportTo = "",
  showHumidity = true,
  days = 7,
  alertMarkers = [],
} = Astro.props;

const chartTitle = title ?? `Temperature trend (${days} days)`;
const cardTitle = `Temperature (last ${days} days)`;

const exportParams = new URLSearchParams();
if (exportFrom) exportParams.set("from", exportFrom);
if (exportTo) exportParams.set("to", exportTo);
const exportCsvHref = exportParams.toString()
  ? `/api/garage-temps/export.csv?${exportParams}`
  : "/api/garage-temps/export.csv";
---
<DashboardCard>
  <div class="card-header-row">
    <div>
      <h2 class="card-title">{cardTitle}</h2>
      <p class="card-subtitle mb-0">
        Every probe against your freeze line.
        <a class="text-link" href="/dashboard/history">Open History</a> for filters, exports, and year-over-year.
      </p>
    </div>
    {canExport && (
      <div class="flex flex-wrap gap-2">
        <a class="btn-secondary" href={exportCsvHref} download>Export run (CSV)</a>
        <a class="btn-ghost" href="/api/user/export">Export JSON</a>
      </div>
    )}
  </div>
  {points.length < 2 ? (
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
      The chart fills in as readings arrive: give it an hour or two after your first reading.
    </p>
  ) : (
    <div class="relative mt-4 history-chart-host">
      <HistoryChart
        client:visible
        points={points}
        housePoints={housePoints}
        houseLegend={houseLegend}
        title={chartTitle}
        hideTitle
        freezeThresholdF={freezeThresholdF}
        showHumidity={showHumidity}
        alertMarkers={alertMarkers}
      >
        <ChartSkeleton slot="fallback" />
      </HistoryChart>
    </div>
  )}
</DashboardCard>
