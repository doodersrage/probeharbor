---
import DashboardCard from "./DashboardCard.astro";
import ChartSkeleton from "./ChartSkeleton.astro";
import HistoryChart from "../HistoryChart";
import type { ChartPoint } from "../../lib/garageTempsHistory";
import { fmt, formatNumber, getLocale } from "../../i18n";
import { overviewCardsMessages } from "../../i18n/messages/app/overviewCards";
import { demoIslandMessages } from "../../i18n/messages/demoIslands";

interface Props {
  points: ChartPoint[];
  housePoints?: ChartPoint[];
  houseLegend?: string | null;
  title?: string;
  freezeThresholdF?: number | null;
  showHumidity?: boolean;
  days?: number;
  alertMarkers?: import("../../lib/chartAlertMarkers").ChartAlertMarker[];
  /** The user's °C display preference. */
  useCelsius?: boolean;
}

const {
  points,
  housePoints = [],
  houseLegend = null,
  title,
  freezeThresholdF = null,
  showHumidity = true,
  days = 7,
  alertMarkers = [],
  useCelsius = false,
} = Astro.props;

const locale = getLocale(Astro);
const t = overviewCardsMessages(locale).weekChart;
const daysLabel = locale === "en" ? String(days) : formatNumber(days, locale);
const chartTitle = title ?? fmt(t.chartTitle, { days: daysLabel });
const cardTitle = fmt(t.cardTitle, { days: daysLabel });
// Chart chrome: the same translated HistoryChart copy as the public demo.
const chartUi = locale === "en" ? undefined : demoIslandMessages(locale).chart;
---
<DashboardCard>
  <div class="card-header-row">
    <div>
      <h2 class="card-title">{cardTitle}</h2>
      <p class="card-subtitle mb-0" set:html={t.subtitleHtml} />
    </div>
  </div>
  {points.length < 2 ? (
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
      {t.empty}
    </p>
  ) : (
    <div class="relative mt-4 history-chart-host">
      <HistoryChart
        client:visible
        points={points}
        housePoints={housePoints}
        houseLegend={houseLegend}
        title={chartTitle}
        hideTitle
        freezeThresholdF={freezeThresholdF}
        showHumidity={showHumidity}
        alertMarkers={alertMarkers}
        ui={chartUi}
        useCelsius={useCelsius}
      >
        <ChartSkeleton slot="fallback" />
      </HistoryChart>
    </div>
  )}
</DashboardCard>
