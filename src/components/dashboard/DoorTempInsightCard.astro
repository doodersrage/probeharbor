---
import DashboardCard from "./DashboardCard.astro";
import { getLocale } from "../../i18n";
import { overviewInsightsMessages } from "../../i18n/messages/app/overviewInsights";

interface Props {
  title: string;
  detail: string;
  tone?: "warning" | "info";
}

const { title, detail, tone = "info" } = Astro.props;
const t = overviewInsightsMessages(getLocale(Astro)).doorTemp;
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-3">{t.subtitle}</p>
  <div class:list={[tone === "warning" ? "alert-warning" : "alert-info", "mb-0"]}>
    <p class="m-0 mb-1"><strong>{title}</strong></p>
    <p class="m-0 text-sm">{detail}</p>
  </div>
</DashboardCard>
