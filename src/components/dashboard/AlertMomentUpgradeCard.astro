---
/**
 * Shown on Overview after a freeze/leak alert reached a Free or Member account
 * by email only. Dismissal is keyed to the alert, so the next one can ask again.
 */
import { alertMomentKey, type AlertMoment } from "../../lib/alertMomentNudge";
import { fmt, getLocale, LOCALE_META } from "../../i18n";
import { overviewNudgesMessages } from "../../i18n/messages/app/overview/nudges";

interface Props {
  moment: AlertMoment;
  timeZone?: string | null;
}

const { moment, timeZone = null } = Astro.props;
const locale = getLocale(Astro);
const t = overviewNudgesMessages(locale).alertMoment;
// Without a known time zone the server clock (UTC) would print the wrong hour, so show the day only.
const when = new Date(moment.createdAt).toLocaleString(
  LOCALE_META[locale].intl,
  timeZone
    ? { weekday: "short", hour: "numeric", minute: "2-digit", timeZone }
    : { weekday: "short", month: "short", day: "numeric", timeZone: "UTC" },
);
const dismissKey = `alert-moment-${moment.eventId}`;
---
<aside class="upgrade-nudge" data-nudge-key={dismissKey} role="note">
  <div class="upgrade-nudge-body">
    <p class="upgrade-nudge-title">{fmt(t.titles[alertMomentKey(moment.kind)], { when })}</p>
    <p class="upgrade-nudge-text">
      {t.body}
    </p>
  </div>
  <div class="upgrade-nudge-actions">
    <form action="/api/stripe/checkout" method="post">
      <input type="hidden" name="plan" value="pro" />
      <input type="hidden" name="interval" value="annual" />
      <input type="hidden" name="source" value="nudge_alert_moment" />
      <button class="btn-primary" type="submit">{t.getSms}</button>
    </form>
    <a class="btn-secondary" href="/pricing#sms-alerts">{t.comparePlans}</a>
    <button type="button" class="btn-ghost" data-dismiss={dismissKey}>{t.notNow}</button>
  </div>
</aside>
