---
import type { GarageRiskStatus } from "../../lib/garageRiskStatus";
import { formatRelativeAge } from "../../lib/relativeTime";
import ReadingAgeBadge from "./ReadingAgeBadge.astro";

/** Coldest temperature probe, so the card answers "which one, how cold, how fresh". */
export type ColdestProbeSummary = {
  label: string;
  /** Pre-formatted in the user's unit. */
  temp: string;
  /** e.g. "2°F above threshold" / "1°F below threshold". */
  margin: string;
  recordedAt: string | null;
};

interface Props {
  status: GarageRiskStatus;
  coldestProbe?: ColdestProbeSummary | null;
}

const { status, coldestProbe = null } = Astro.props;
// A stale reading shouldn't look live: grey the value out.
const probeStale = coldestProbe ? formatRelativeAge(coldestProbe.recordedAt).stale : false;
---
<section
  class:list={[
    "card garage-risk-status",
    `garage-risk-status--${status.level}`,
  ]}
  id="garage-risk"
  aria-labelledby="garage-risk-heading"
  data-overview-risk
  data-risk-level={status.level}
>
  <p class="garage-risk-eyebrow">Space status</p>
  <h2
    id="garage-risk-heading"
    class="card-title garage-risk-title"
    data-overview-field="riskTitle"
  >
    {status.title}
  </h2>
  <p class="card-subtitle mb-4" data-overview-field="riskDetail">{status.detail}</p>
  {coldestProbe && (
    <p class="garage-risk-probe" data-coldest-probe>
      <span class="garage-risk-probe-label">Coldest: {coldestProbe.label}</span>
      <strong
        class:list={["garage-risk-probe-temp", probeStale && "is-stale"]}
        title={probeStale ? "Last reading is old; this may not be current." : undefined}
      >
        {coldestProbe.temp}
      </strong>
      <span class="garage-risk-probe-margin">{coldestProbe.margin}</span>
      <ReadingAgeBadge iso={coldestProbe.recordedAt} emptyLabel="No reading" />
    </p>
  )}
  <a
    class="btn-primary"
    href={status.actionHref}
    data-overview-field="riskAction"
  >
    {status.actionLabel}
  </a>
</section>

<style>
  .garage-risk-status {
    border-color: var(--color-border);
  }
  .garage-risk-probe {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    margin: -0.5rem 0 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .garage-risk-probe-temp {
    color: var(--color-text);
    font-size: 1rem;
  }
  .garage-risk-probe-temp.is-stale {
    color: var(--color-text-muted);
    opacity: 0.7;
  }
  .garage-risk-status--ok {
    border-color: var(--color-success);
  }
  .garage-risk-status--watch {
    border-color: var(--color-warning-border);
  }
  .garage-risk-status--risk,
  .garage-risk-status--offline {
    border-color: var(--color-danger);
  }
  .garage-risk-eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .garage-risk-title {
    margin-bottom: 0.35rem;
  }
</style>
