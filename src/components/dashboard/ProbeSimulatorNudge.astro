---
import { getLocale } from "../../i18n";
import { overviewNudgesMessages } from "../../i18n/messages/app/overview/nudges";

interface Props {
  show: boolean;
}

const { show } = Astro.props;
const t = overviewNudgesMessages(getLocale(Astro)).probeSimulator;
---
{show && (
  <section class="card" id="probe-simulator-nudge" aria-labelledby="probe-simulator-nudge-title">
    <h2 class="card-title" id="probe-simulator-nudge-title">{t.title}</h2>
    <p class="card-subtitle mb-4">
      {t.body}
    </p>
    <div class="flex flex-wrap gap-3">
      <a class="btn-secondary" href="/about/probe-demo?preset=coldSnap">{t.open}</a>
      <a class="btn-ghost" href="/about/probe-demo?preset=doorDraft">{t.doorDraft}</a>
    </div>
  </section>
)}
