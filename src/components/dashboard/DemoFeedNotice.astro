---
/**
 * "Demo data" notice for the example feed (simulated readings, see
 * lib/demoFeed). Says the readings aren't measured, never alert and don't
 * count as a device, and offers "Remove demo feed" to editors (the normal
 * pull-feed delete endpoint).
 */
import { getLocale } from "../../i18n";
import { shellMessages } from "../../i18n/messages/app/shell";

interface Props {
  /** The household's demo devices (empty renders nothing). */
  devices: Array<{ id: string; name: string }>;
  canEdit: boolean;
  /** Where to land after removing: Devices, which confirms the delete or shows the error. */
  redirectTo?: string;
}

const { devices, canEdit, redirectTo = "/dashboard/devices" } = Astro.props;
const t = shellMessages(getLocale(Astro)).demoData;
---
{devices.length > 0 && (
  <div class="alert-info mt-0 mb-0" data-demo-feed-notice>
    <p class="m-0 flex flex-wrap items-center gap-2">
      <span class="feed-group-badge">{t.badge}</span>
      <span class="font-semibold">{devices.map((device) => device.name).join(", ")}</span>
    </p>
    <p class="mt-2 mb-0">{t.body}</p>
    {canEdit && (
      <div class="mt-3 flex flex-wrap gap-2">
        {devices.map((device) => (
          <form action="/api/user/pull-setup/delete" method="post">
            <input type="hidden" name="feed_id" value={device.id} />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button class="btn-secondary btn-sm" type="submit">
              {devices.length > 1 ? `${t.remove}: ${device.name}` : t.remove}
            </button>
          </form>
        ))}
      </div>
    )}
  </div>
)}
