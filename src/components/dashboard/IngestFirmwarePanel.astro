---
import {
  buildEspHomeHttpRequestSnippet,
  buildWaitingIngestCurl,
  type WaitingSensorHint,
} from "../../lib/waitingIngest";
import {
  buildArduinoEthernetDefinesSnippet,
  buildArduinoHttpClientSnippet,
  buildPersonalizedDs18b20Circuitpython,
  buildPersonalizedDs18b20Ino,
  buildPersonalizedDs18b20Micropython,
  buildPersonalizedDs18b20ZephyrC,
  buildPersonalizedDs18b20Ch32vC,
  buildPersonalizedDs18b20AvrS,
  buildPersonalizedDs18b20Pic18C,
  buildPersonalizedDs18b20TeensyIno,
  buildPersonalizedDs18b20ParticleIno,
  buildPersonalizedParticleWebhookJson,
  buildPersonalizedEspHomeYaml,
  buildZephyrEthernetDefinesSnippet,
  buildCh32vEthernetDefinesSnippet,
  buildAvrAsmEthernetDefinesSnippet,
  buildPic18EthernetDefinesSnippet,
  buildTeensyEthernetDefinesSnippet,
  buildParticleCellularSnippet,
  firmwareDownloadHref,
} from "../../lib/firmwareSketches";
import BrowserFlasher from "../BrowserFlasher.astro";
import { getLocale } from "../../i18n";
import { deviceSetupFirmwareMessages } from "../../i18n/messages/app/deviceSetup/firmware";

interface Props {
  ingestUrl: string;
  ingestKey: string;
  origin: string;
  sensors?: WaitingSensorHint[];
  /** Open firmware details by default (fresh key callout). */
  presetsOpen?: boolean;
}

const {
  ingestUrl,
  ingestKey,
  origin,
  sensors = [{ key: "temp1", kind: "temperature" }],
  presetsOpen = true,
} = Astro.props;

const arduinoSnippet = buildArduinoHttpClientSnippet(ingestUrl, sensors);
const ethernetSnippet = buildArduinoEthernetDefinesSnippet(ingestUrl);
const zephyrSnippet = buildZephyrEthernetDefinesSnippet(ingestUrl);
const ch32vSnippet = buildCh32vEthernetDefinesSnippet(ingestUrl);
const avrSnippet = buildAvrAsmEthernetDefinesSnippet(ingestUrl);
const pic18Snippet = buildPic18EthernetDefinesSnippet(ingestUrl);
const teensySnippet = buildTeensyEthernetDefinesSnippet(ingestUrl);
const particleSnippet = buildParticleCellularSnippet(ingestUrl);
const esphomeSnippet = buildEspHomeHttpRequestSnippet(ingestUrl, sensors);
const esphomeYaml = buildPersonalizedEspHomeYaml(ingestUrl, sensors);
const curlExample = buildWaitingIngestCurl(origin, sensors, ingestKey);
const inoSketch = buildPersonalizedDs18b20Ino(ingestUrl);
const pySketch = buildPersonalizedDs18b20Micropython(ingestUrl);
const circuitPySketch = buildPersonalizedDs18b20Circuitpython(ingestUrl);
const zephyrSketch = buildPersonalizedDs18b20ZephyrC(ingestUrl);
const ch32vSketch = buildPersonalizedDs18b20Ch32vC(ingestUrl);
const avrSketch = buildPersonalizedDs18b20AvrS(ingestUrl);
const pic18Sketch = buildPersonalizedDs18b20Pic18C(ingestUrl);
const teensySketch = buildPersonalizedDs18b20TeensyIno(ingestUrl);
const particleSketch = buildPersonalizedDs18b20ParticleIno(ingestUrl);
const particleWebhook = buildPersonalizedParticleWebhookJson(ingestUrl);
const inoHref = firmwareDownloadHref(inoSketch);
const pyHref = firmwareDownloadHref(pySketch);
const circuitPyHref = firmwareDownloadHref(circuitPySketch);
const zephyrHref = firmwareDownloadHref(zephyrSketch);
const ch32vHref = firmwareDownloadHref(ch32vSketch);
const avrHref = firmwareDownloadHref(avrSketch);
const pic18Href = firmwareDownloadHref(pic18Sketch);
const teensyHref = firmwareDownloadHref(teensySketch);
const particleHref = firmwareDownloadHref(particleSketch);
const particleWebhookHref = firmwareDownloadHref(particleWebhook);
const esphomeHref = firmwareDownloadHref(esphomeYaml);

const t = deviceSetupFirmwareMessages(getLocale(Astro));

const presets = [
  { label: "curl", code: curlExample },
  { label: "ESPHome http_request", code: esphomeSnippet },
  { label: t.presets.arduinoHttps, code: arduinoSnippet },
  { label: t.presets.unoEthernet, code: ethernetSnippet },
  { label: t.presets.zephyr, code: zephyrSnippet },
  { label: t.presets.ch32v, code: ch32vSnippet },
  { label: t.presets.avr, code: avrSnippet },
  { label: t.presets.teensy, code: teensySnippet },
  { label: t.presets.pic18, code: pic18Snippet },
  { label: t.presets.particle, code: particleSnippet },
];

type BoardSection = {
  id: string;
  text: { heading: string; ledeHtml: string; stepsHtml: string[]; guide: string };
  downloads: Array<{ href: string; file: string; label: string }>;
  guideHref: string;
};

const boards: BoardSection[] = [
  {
    id: "pico-flash-title",
    text: t.pico,
    downloads: [{ href: circuitPyHref, file: "probeharbor_ds18b20_code.py", label: t.pico.download }],
    guideHref: "/about/pico-w-ingest",
  },
  {
    id: "stm32-flash-title",
    text: t.stm32,
    downloads: [{ href: zephyrHref, file: "probeharbor_ds18b20_zephyr_main.c", label: t.stm32.download }],
    guideHref: "/about/stm32-zephyr-ingest",
  },
  {
    id: "ch32v-flash-title",
    text: t.ch32v,
    downloads: [{ href: ch32vHref, file: "probeharbor_ds18b20_ch32v_main.c", label: t.ch32v.download }],
    guideHref: "/about/ch32v-riscv-ingest",
  },
  {
    id: "avr-asm-flash-title",
    text: t.avr,
    downloads: [{ href: avrHref, file: "probeharbor_ds18b20_avr.S", label: t.avr.download }],
    guideHref: "/about/avr-asm-ingest",
  },
  {
    id: "teensy-flash-title",
    text: t.teensy,
    downloads: [{ href: teensyHref, file: "probeharbor_ds18b20_teensy41.ino", label: t.teensy.download }],
    guideHref: "/about/teensy41-ingest",
  },
  {
    id: "pic18-flash-title",
    text: t.pic18,
    downloads: [{ href: pic18Href, file: "probeharbor_ds18b20_pic18_main.c", label: t.pic18.download }],
    guideHref: "/about/pic18-ethernet-ingest",
  },
  {
    id: "cellular-flash-title",
    text: t.cellular,
    downloads: [
      { href: particleHref, file: "probeharbor_ds18b20_boron.ino", label: t.cellular.download },
      { href: particleWebhookHref, file: "probeharbor_particle_webhook.json", label: t.cellular.downloadWebhook },
    ],
    guideHref: "/about/cellular-ingest",
  },
];

const helpLinks = [
  { href: "/about/esp32-web-flash", label: t.helpLinks.esp32 },
  { href: "/about/pico-w-ingest", label: t.helpLinks.pico },
  { href: "/about/stm32-zephyr-ingest", label: t.helpLinks.stm32 },
  { href: "/about/ch32v-riscv-ingest", label: t.helpLinks.ch32v },
  { href: "/about/avr-asm-ingest", label: t.helpLinks.avr },
  { href: "/about/teensy41-ingest", label: t.helpLinks.teensy },
  { href: "/about/pic18-ethernet-ingest", label: t.helpLinks.pic18 },
  { href: "/about/cellular-ingest", label: t.helpLinks.cellular },
  { href: "/about/adding-devices", label: t.helpLinks.addingDevices },
  { href: "/about/kit-qr-onboarding", label: t.helpLinks.kitQr },
  { href: "/docs/api#ingest", label: t.helpLinks.apiIngest },
  { href: "/about/esp32-ota-firmware", label: t.helpLinks.ota },
];
---
<section class="ingest-firmware-panel" aria-labelledby="firmware-flash-title">
  <h2 class="sr-only" id="firmware-flash-title">{t.srTitle}</h2>
  <h3 class="ingest-firmware-heading" id="esp32-flash-title">{t.esp32Heading}</h3>
  <p class="ingest-firmware-lede">{t.esp32Lede}</p>
  <div class="page-stack mb-4">
    <BrowserFlasher deviceKey={ingestKey} headingLevel="h3" />
  </div>

  {/* Everything else folds away: a first-time ESP32 user only needs the flasher above. */}
  <details class="ingest-firmware-more mb-4" open={!presetsOpen || undefined}>
    <summary class="font-semibold cursor-pointer">{t.preferCode}</summary>
  <ol class="waiting-ingest-checklist ingest-firmware-checklist mt-3">
    {t.esp32StepsHtml.map((step) => <li set:html={step} />)}
  </ol>

  <div class="flex flex-wrap gap-2 mb-4">
    <a class="btn-secondary" href={inoHref} download="probeharbor_ds18b20_ingest.ino">
      {t.downloadIno}
    </a>
    <a class="btn-secondary" href={pyHref} download="probeharbor_ds18b20_main.py">
      {t.downloadMicropython}
    </a>
    <a class="btn-secondary" href={esphomeHref} download="probeharbor_esphome_ingest.yaml">
      {t.downloadEsphome}
    </a>
    <a
      class="btn-ghost"
      href="https://github.com/doodersrage/probeharbor/tree/main/sketches"
      target="_blank"
      rel="noreferrer"
    >
      {t.allSketches}
    </a>
  </div>

  <details class="rounded-lg border border-[var(--color-border)] p-3">
    <summary class="cursor-pointer font-medium text-sm">{t.presetsSummary}</summary>
    <div class="mt-3 space-y-3">
      <p class="form-hint mb-0" set:html={t.payloadCheckerHtml} />
      {presets.map((preset) => (
        <div>
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <p class="form-label mb-0">{preset.label}</p>
            <button type="button" class="btn-ghost text-xs" data-copy={preset.code} data-copy-label={t.copy}>
              {t.copy}
            </button>
          </div>
          <pre class="ingest-key-curl text-xs overflow-x-auto mb-0"><code>{preset.code}</code></pre>
        </div>
      ))}
    </div>
  </details>
  </details>

  <details class="ingest-firmware-more mb-4">
    <summary class="font-semibold cursor-pointer">{t.otherBoards}</summary>
  {boards.map((board) => (
    <>
      <h3 class="ingest-firmware-heading ingest-firmware-heading-next" id={board.id}>{board.text.heading}</h3>
      <p class="ingest-firmware-lede" set:html={board.text.ledeHtml} />
      <ol class="waiting-ingest-checklist ingest-firmware-checklist">
        {board.text.stepsHtml.map((step) => <li set:html={step} />)}
      </ol>
      <div class="flex flex-wrap gap-2 mb-4">
        {board.downloads.map((download) => (
          <a class="btn-secondary" href={download.href} download={download.file}>
            {download.label}
          </a>
        ))}
        <a class="btn-ghost" href={board.guideHref}>{board.text.guide}</a>
      </div>
    </>
  ))}
  </details>

  <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]">
    {t.moreHelp}
    {helpLinks.map((link) => (
      <>
        <a class="text-link" href={link.href}>{link.label}</a>
        {" · "}
      </>
    ))}
    <a
      class="text-link"
      href="https://github.com/doodersrage/probeharbor/tree/main/sketches/arduino/ethernet_dht22_ingest"
      target="_blank"
      rel="noreferrer"
    >{t.helpLinks.unoSketch}</a>
  </p>
</section>

<style>
  .ingest-firmware-panel {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .ingest-firmware-heading {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 700;
  }

  .ingest-firmware-heading-next {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .ingest-firmware-lede {
    margin: 0 0 0.85rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .ingest-firmware-checklist {
    margin-bottom: 1rem;
  }
</style>
