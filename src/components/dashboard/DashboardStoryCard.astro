---
import { getLocale } from "../../i18n";
import { overviewNudgesMessages } from "../../i18n/messages/app/overview/nudges";

interface Props {
  dismissedKey?: string;
  show?: boolean;
}

const { dismissedKey = "dashboard_story_dismiss", show = true } = Astro.props;

if (!show) return;
const t = overviewNudgesMessages(getLocale(Astro));
const ts = t.story;
---
<aside class="card card-muted dashboard-story-card" data-nudge-key={dismissedKey} role="note">
  <div class="dashboard-story-body">
    <p class="dashboard-story-eyebrow">{ts.eyebrow}</p>
    <p class="dashboard-story-title">{ts.title}</p>
    <p class="dashboard-story-text">
      {ts.body}
    </p>
  </div>
  <div class="dashboard-story-actions">
    <a class="btn-secondary" href="/stories/garage-freeze-alert">{ts.read}</a>
    <a class="btn-ghost" href="/about/temperature-probe-case-study">{ts.deepDive}</a>
    <button type="button" class="btn-ghost" data-dismiss={dismissedKey}>
      {t.dismiss}
    </button>
  </div>
</aside>
