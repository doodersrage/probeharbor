---
import { getLocale } from "../../i18n";
import { shellMessages } from "../../i18n/messages/app/shell";

interface Props {
  active: "links" | "api" | "integrations";
}

const { active } = Astro.props;
const t = shellMessages(getLocale(Astro)).shareTabs;

const tabs = [
  { id: "links", label: t.links, href: "/dashboard/share/links" },
  { id: "api", label: t.api, href: "/dashboard/share/api" },
  { id: "integrations", label: t.integrations, href: "/dashboard/share/integrations" },
];
---
<div class="share-dashboard-shell">
  <nav class="dashboard-tab-nav mb-4" aria-label={t.ariaLabel}>
    {tabs.map((tab) => (
      <a
        class:list={["dashboard-tab-nav-link", tab.id === active && "is-active"]}
        href={tab.href}
        aria-current={tab.id === active ? "page" : undefined}
      >
        {tab.label}
      </a>
    ))}
  </nav>
  <slot />
</div>
