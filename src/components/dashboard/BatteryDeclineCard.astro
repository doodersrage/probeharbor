---
import DashboardCard from "./DashboardCard.astro";
import BatteryTrendChart from "../BatteryTrendChart";
import type { BatteryOverviewRow } from "../../lib/overviewExtras";
import { formatNumber, getLocale, LOCALE_META, plural } from "../../i18n";
import { overviewInsightsMessages } from "../../i18n/messages/app/overviewInsights";

interface Props {
  rows: BatteryOverviewRow[];
}

const { rows } = Astro.props;
const locale = getLocale(Astro);
const messages = overviewInsightsMessages(locale);
const t = messages.battery;
const chartText = { ...messages.chart, title: t.chartTitle };
const chartSeries = rows.map((row) => ({
  label: row.deviceName,
  samples: row.samples.map((sample) => ({ value: sample.pct, at: sample.at })),
}));
---
{rows.length > 0 && (
  <DashboardCard>
    <h2 class="card-title">{t.title}</h2>
    <p class="card-subtitle mb-4">{t.subtitle}</p>
    <ul class="space-y-3 mb-0">
      {rows.map((row) => (
        <li class="text-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <strong>{row.deviceName}</strong>
            <span>{formatNumber(row.latestPct, locale)}%</span>
          </div>
          {row.message && (
            <p class="m-0 mt-1 text-[var(--color-warning-text)]">{row.message}</p>
          )}
          {row.daysRemaining != null && (
            <p class="m-0 mt-1 text-[var(--color-text-muted)]">
              {plural(t.daysRemaining, Math.round(row.daysRemaining), locale)}
            </p>
          )}
        </li>
      ))}
    </ul>
    {chartSeries.some((s) => s.samples.length >= 2) && (
      <div class="mt-4">
        <BatteryTrendChart
          client:visible
          series={chartSeries}
          unitSuffix="%"
          text={chartText}
          intl={LOCALE_META[locale].intl}
        />
      </div>
    )}
    <p class="mt-4 mb-0 text-sm">
      <a class="text-link" href="/dashboard/devices">{messages.extras.openDevices}</a>
    </p>
  </DashboardCard>
)}
