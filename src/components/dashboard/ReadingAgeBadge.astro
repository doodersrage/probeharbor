---
import { formatRelativeAge } from "../../lib/relativeTime";
import { getLocale } from "../../i18n";
import { LOCALE_META } from "../../i18n/locales";
import { shellMessages } from "../../i18n/messages/app/shell";

interface Props {
  iso: string | null | undefined;
  emptyLabel?: string;
  class?: string;
  /**
   * Grey instead of green when fresh. For summary badges (newest reading of
   * many probes) where green would read as "everything is fine".
   */
  quietWhenFresh?: boolean;
  /**
   * The sensor's device report interval (ms), when learned. Late/stale then
   * follow the shared rule (relativeTime `readingFreshness`), here and in the
   * 30-second ticker (public/reading-age-tick.js).
   */
  reportIntervalMs?: number | null;
}

const locale = getLocale(Astro);
const {
  iso,
  emptyLabel = shellMessages(locale).readingAge.never,
  class: className,
  quietWhenFresh = false,
  reportIntervalMs = null,
} = Astro.props;
const age = formatRelativeAge(iso, emptyLabel, locale, reportIntervalMs);
const ageText = shellMessages(locale).readingAge;
const absoluteTitle = iso
  ? locale === "en"
    ? new Date(iso).toLocaleString()
    : new Date(iso).toLocaleString(LOCALE_META[locale].intl)
  : undefined;
const tone =
  !iso
    ? "neutral"
    : age.stale
      ? "danger"
      : age.lagging
        ? "warning"
        : quietWhenFresh
          ? "neutral"
          : "ok";
// Say it in words too: stale vs late shouldn't depend on telling red from amber.
const stateLabel = !iso ? null : age.stale ? ageText.stale : age.lagging ? ageText.lagging : null;
---

<span
  class:list={[
    "reading-age-badge",
    `reading-age-badge--${tone}`,
    className,
  ]}
  title={absoluteTitle}
  data-iso={iso || undefined}
  data-quiet-fresh={quietWhenFresh ? "" : undefined}
  data-report-interval-ms={reportIntervalMs != null && reportIntervalMs > 0 ? String(reportIntervalMs) : undefined}
  data-state-stale={ageText.stale}
  data-state-lagging={ageText.lagging}
>
  {/* Flex item: a plain trailing space would be dropped. */}
  {stateLabel && <span class="reading-age-badge-state">{`${stateLabel} ·\u00a0`}</span>}
  {age.label}
</span>

<style>
  .reading-age-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .reading-age-badge--ok {
    color: var(--color-success);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
  }

  .reading-age-badge--warning {
    color: var(--color-warning);
    border-color: color-mix(in srgb, var(--color-warning) 35%, transparent);
  }

  .reading-age-badge--danger {
    color: var(--color-danger);
    border-color: color-mix(in srgb, var(--color-danger) 35%, transparent);
  }
</style>
