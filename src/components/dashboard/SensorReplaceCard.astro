---
import DashboardCard from "./DashboardCard.astro";
import type { DeviceWithSensors } from "../../lib/devices";
import { replacementOptionsByKind } from "../../lib/sensorReplacement";
import type { SensorKind } from "../../lib/sensorKinds";
import en from "../../i18n/messages/app/deviceDetail/en";

/**
 * Swap a failed probe for a new one: history, name, thresholds, and indoor
 * reference move to the new sensor; the old sensor is removed.
 */
interface Props {
  devices: DeviceWithSensors[];
  redirectTo: string;
  /** Collapsed "Replace a sensor…" inside another card (the device page). */
  collapsed?: boolean;
  /** Translated strings (app/deviceDetail `replace`); English when omitted. */
  text?: typeof en.replace;
  /** Translated sensor type names for the option groups; English when omitted. */
  kindLabels?: Record<SensorKind, string>;
}

const { devices, redirectTo, collapsed = false, text = en.replace, kindLabels } = Astro.props;
const Wrapper = collapsed ? "details" : DashboardCard;
const groups = replacementOptionsByKind(devices);
---
{groups.length > 0 && (
  <Wrapper id="replace-sensor" class={collapsed ? "mt-4" : undefined}>
    {collapsed ? (
      <summary class="cursor-pointer text-sm font-semibold">{text.summary}</summary>
    ) : (
      <h2 class="card-title">{text.title}</h2>
    )}
    <p class:list={["card-subtitle mb-3", collapsed && "mt-2"]}>
      {text.intro}
    </p>
    <form
      action="/api/devices"
      method="post"
      class="space-y-3"
      data-sensor-replace-form
      onsubmit={`return confirm(${JSON.stringify(text.confirm)});`}
    >
      <input type="hidden" name="action" value="replace_sensor" />
      <input type="hidden" name="redirect" value={redirectTo} />
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="form-field mb-0">
          <label class="form-label" for="replace-old-sensor">{text.oldSensor}</label>
          <select class="form-input" id="replace-old-sensor" name="old_sensor_id" required>
            <option value="">{text.choose}</option>
            {groups.map((group) => (
              <optgroup label={kindLabels?.[group.kind] ?? group.kindLabel}>
                {group.options.map((option) => (
                  <option value={option.sensorId} data-kind={option.kind}>{option.label}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="replace-new-sensor">{text.newSensor}</label>
          <select class="form-input" id="replace-new-sensor" name="new_sensor_id" required>
            <option value="">{text.choose}</option>
            {groups.map((group) => (
              <optgroup label={kindLabels?.[group.kind] ?? group.kindLabel}>
                {group.options.map((option) => (
                  <option value={option.sensorId} data-kind={option.kind}>{option.label}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
      </div>
      <ul class="m-0 pl-5 text-sm text-[var(--color-text-muted)] list-disc">
        {text.bullets.map((item) => <li>{item}</li>)}
      </ul>
      <button class="btn-secondary" type="submit">{text.button}</button>
    </form>
  </Wrapper>
)}

<script>
  // Only offer replacements of the same type, and never the sensor itself.
  document.querySelectorAll<HTMLFormElement>("[data-sensor-replace-form]").forEach((form) => {
    const oldSelect = form.querySelector('select[name="old_sensor_id"]');
    const newSelect = form.querySelector('select[name="new_sensor_id"]');
    if (!(oldSelect instanceof HTMLSelectElement) || !(newSelect instanceof HTMLSelectElement)) return;
    const sync = () => {
      const chosen = oldSelect.selectedOptions[0];
      const kind = chosen?.dataset.kind ?? "";
      for (const option of Array.from(newSelect.options)) {
        if (!option.value) continue;
        option.disabled = Boolean(kind) && (option.dataset.kind !== kind || option.value === oldSelect.value);
      }
      if (newSelect.selectedOptions[0]?.disabled) newSelect.value = "";
    };
    oldSelect.addEventListener("change", sync);
    sync();
  });
</script>
