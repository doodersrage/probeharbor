---
import { getFalseAlarmTips, getFloodFalseAlarmTips } from "../../lib/falseAlarmHints";
import { getLocale } from "../../i18n";
import { alertsMessages } from "../../i18n/messages/app/alerts";

interface Props {
  show?: boolean;
}

const { show = true } = Astro.props;
if (!show) return null;
const locale = getLocale(Astro);
const t = alertsMessages(locale).tipsCard;
const freezeTips = getFalseAlarmTips(locale);
const floodTips = getFloodFalseAlarmTips(locale);
---
{/* Reference material: folded so the alert list stays the focus of the page. */}
<details class="card" id="false-alarm-tips">
  <summary class="card-title cursor-pointer">{t.summary}</summary>
  <p class="card-subtitle mt-3 mb-3">
    {t.intro}
  </p>
  <h3 class="text-sm font-semibold mb-2">{t.freeze}</h3>
  <ul class="text-sm space-y-3 mb-4">
    {freezeTips.map((tip) => (
      <li>
        <strong>{tip.title}</strong>
        <span class="block text-[var(--color-text-muted)]">{tip.detail}</span>
        {tip.href && tip.hrefLabel && (
          <a class="text-link text-xs" href={tip.href}>{tip.hrefLabel}</a>
        )}
      </li>
    ))}
  </ul>
  <h3 class="text-sm font-semibold mb-2">{t.flood}</h3>
  <ul class="text-sm space-y-3 mb-0">
    {floodTips.map((tip) => (
      <li>
        <strong>{tip.title}</strong>
        <span class="block text-[var(--color-text-muted)]">{tip.detail}</span>
        {tip.href && tip.hrefLabel && (
          <a class="text-link text-xs" href={tip.href}>{tip.hrefLabel}</a>
        )}
      </li>
    ))}
  </ul>
</details>
