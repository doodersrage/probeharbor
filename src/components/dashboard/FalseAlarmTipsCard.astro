---
import { FALSE_ALARM_TIPS, FLOOD_FALSE_ALARM_TIPS } from "../../lib/falseAlarmHints";

interface Props {
  show?: boolean;
}

const { show = true } = Astro.props;
if (!show) return null;
---
{/* Reference material: folded so the alert list stays the focus of the page. */}
<details class="card" id="false-alarm-tips">
  <summary class="card-title cursor-pointer">Getting too many alerts? Tips for cutting false alarms</summary>
  <p class="card-subtitle mt-3 mb-3">
    Freeze noise is usually placement or threshold. Flood noise is splash, condensation, or sump cycles: wet contacts still fire during snooze.
  </p>
  <h3 class="text-sm font-semibold mb-2">Freeze</h3>
  <ul class="text-sm space-y-3 mb-4">
    {FALSE_ALARM_TIPS.map((tip) => (
      <li>
        <strong>{tip.title}</strong>
        <span class="block text-[var(--color-text-muted)]">{tip.detail}</span>
        {tip.href && tip.hrefLabel && (
          <a class="text-link text-xs" href={tip.href}>{tip.hrefLabel}</a>
        )}
      </li>
    ))}
  </ul>
  <h3 class="text-sm font-semibold mb-2">Flood / leak</h3>
  <ul class="text-sm space-y-3 mb-0">
    {FLOOD_FALSE_ALARM_TIPS.map((tip) => (
      <li>
        <strong>{tip.title}</strong>
        <span class="block text-[var(--color-text-muted)]">{tip.detail}</span>
        {tip.href && tip.hrefLabel && (
          <a class="text-link text-xs" href={tip.href}>{tip.hrefLabel}</a>
        )}
      </li>
    ))}
  </ul>
</details>
