---
import DashboardCard from "./DashboardCard.astro";
import {
  COVERAGE_RISK_LABELS,
  type CoverageRisk,
  type CoverageState,
  type SpaceCoverage,
} from "../../lib/protectionCoverage";

interface Props {
  coverage: SpaceCoverage[];
}

const { coverage } = Astro.props;
const risks = Object.keys(COVERAGE_RISK_LABELS) as CoverageRisk[];
const stateText: Record<CoverageState, string> = { live: "✓", stale: "!", none: "—" };
const stateLabel: Record<CoverageState, string> = {
  live: "reporting",
  stale: "not reporting",
  none: "not monitored",
};
const stateTone: Record<CoverageState, string> = {
  live: "text-[var(--color-success)]",
  stale: "text-[var(--color-warning)] font-semibold",
  none: "text-[var(--color-text-muted)]",
};
const withGaps = coverage.filter((row) => row.gaps.length > 0).length;
---
{coverage.length > 0 && (
  <DashboardCard id="protection-coverage">
    <h2 class="card-title">Protection coverage</h2>
    <p class="card-subtitle mb-3">
      What each space is watched for, from the sensors on its devices.
      {withGaps === 0 ? " No gaps found." : ` ${withGaps} of ${coverage.length} spaces have a gap.`}
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="sr-only">Monitoring coverage by space</caption>
        <thead>
          <tr class="text-left text-xs text-[var(--color-text-muted)]">
            <th scope="col" class="py-1 pr-3 font-medium">Space</th>
            {risks.map((risk) => (
              <th scope="col" class="py-1 px-2 font-medium text-center">{COVERAGE_RISK_LABELS[risk]}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {coverage.map((row) => (
            <tr class="border-t border-[var(--color-border)] align-top">
              <th scope="row" class="py-2 pr-3 text-left font-medium">
                {row.space}
                <span class="block text-xs font-normal text-[var(--color-text-muted)]">
                  {row.deviceCount} device{row.deviceCount === 1 ? "" : "s"}
                </span>
                {row.gaps.map((gap) => (
                  <span class="block text-xs font-normal text-[var(--color-text-muted)]">○ {gap}</span>
                ))}
              </th>
              {risks.map((risk) => (
                <td class:list={["py-2 px-2 text-center", stateTone[row.risks[risk]]]}>
                  <span aria-hidden="true">{stateText[row.risks[risk]]}</span>
                  <span class="sr-only">{COVERAGE_RISK_LABELS[risk]}: {stateLabel[row.risks[risk]]}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 mb-0 text-xs text-[var(--color-text-muted)]">
      ✓ reporting · ! sensor exists but hasn't reported recently · — not monitored. Spaces come from each device's
      space setting.
    </p>
  </DashboardCard>
)}
