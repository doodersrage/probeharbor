---
import { firmwareUpdateAvailable, LATEST_FIRMWARE_VERSION } from "../../lib/firmwareVersion";
import type { DeviceWithSensors } from "../../lib/devices";
import { deviceHref } from "../../lib/deviceList";
import type { UserHousehold } from "../../lib/households";
import type { Entitlements } from "../../lib/entitlements";
import { formatRelativeAge, type RelativeAge } from "../../lib/relativeTime";
import { fmt, getLocale, plural } from "../../i18n";
import { deviceSetupPushMessages } from "../../i18n/messages/app/deviceSetup/push";
import PushInlineRename from "../PushInlineRename";
import RevealIngestKeyButton from "../RevealIngestKeyButton";

/**
 * "Push from ESP / Pico / MCU" tab panel: create/rename/rotate/delete push
 * devices, inline sensor rename, and manual JSON-key mapping. Extracted
 * from dashboard/temperature.astro -- same markup and behavior, just
 * relocated since the parent page had grown past 1,200 lines.
 */
interface Props {
  activeTab: "pull" | "push" | "thermostat";
  entitlements: Entitlements;
  ingestKeyVaultLive: boolean;
  pushDevices: DeviceWithSensors[];
  canEdit: boolean;
  atDeviceLimit: boolean;
  redirectTo: string;
  devices: DeviceWithSensors[];
  showRenameBatch: boolean;
  focusDevice: string;
  ingestKey: string | null;
  transferTargets: UserHousehold[];
}

const {
  activeTab,
  entitlements,
  ingestKeyVaultLive,
  pushDevices,
  canEdit,
  atDeviceLimit,
  redirectTo,
  devices,
  showRenameBatch,
  focusDevice,
  ingestKey,
  transferTargets,
} = Astro.props;

const locale = getLocale(Astro);
const t = deviceSetupPushMessages(locale);
const kindLabels = t.kindLabels;
const NEVER_SEEN = "never seen";

function freshnessText(age: RelativeAge): string {
  const label = age.label;
  if (age.stale) return fmt(t.freshness.offline, { age: label });
  if (age.lagging) return fmt(t.freshness.lagging, { age: label });
  return fmt(t.freshness.updated, { age: label });
}

/** Spaces already in use first, then the common ones (translated), de-duplicated. */
function spaceSuggestions(list: DeviceWithSensors[]): string[] {
  const used = list.map((d) => d.space?.trim()).filter((s): s is string => Boolean(s));
  const seenKeys = new Set<string>();
  const out: string[] = [];
  for (const space of [...used, ...t.commonSpaces]) {
    const key = space.toLowerCase();
    if (seenKeys.has(key)) continue;
    seenKeys.add(key);
    out.push(space);
  }
  return out;
}

function deviceHasRecoverableKey(meta: unknown): boolean {
  if (!meta || typeof meta !== "object" || Array.isArray(meta)) return false;
  return typeof (meta as Record<string, unknown>).ingest_key_enc === "string";
}

function sensorNeedsRename(label: string): boolean {
  return /^Probe \d+$/.test(label.trim());
}
// Day-to-day management lives on each device's page; here we only show the
// devices still being set up (or the one just created / linked to).
const setupDevices = pushDevices.filter(
  (device) => device.id === focusDevice || !device.last_seen_at || (showRenameBatch && device.sensors.length > 0),
);
const otherCount = pushDevices.length - setupDevices.length;
const spaces = spaceSuggestions(devices);
---
    <section
      class:list={["card", (activeTab !== "push" || (canEdit && pushDevices.length === 0 && devices.length === 0)) && "hidden"]}
      id="push-devices"
    >
      <h2 class="card-title">{t.title}</h2>
      <p
        class="card-subtitle"
        set:html={fmt(t.subtitleHtml, { max: entitlements.maxDevices, tier: entitlements.tier })}
      />

      {!ingestKeyVaultLive && pushDevices.length > 0 && canEdit && (
        <p class="alert-warning mb-4" role="status" set:html={t.vaultOffHtml} />
      )}

      {atDeviceLimit ? (
        <div class="alert-warning mb-4">
          <p class="m-0" set:html={t.atLimitHtml} />
        </div>
      ) : canEdit && devices.length > 0 ? (
        <form
          action="/api/devices"
          method="post"
          class="device-create-form"
          id="device-create-form"
          data-i18n={JSON.stringify(t.client)}
        >
          <input type="hidden" name="action" value="create_push" />
          <input type="hidden" name="redirect" value={redirectTo} />
          <div class="form-field mb-0">
            <label class="form-label" for="create-name">{t.name}</label>
            <input class="form-input" id="create-name" name="name" required maxlength="80" placeholder={t.namePlaceholder} />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="create-space">{t.space}</label>
            <input
              class="form-input"
              id="create-space"
              name="space"
              maxlength="60"
              list="create-space-suggestions"
              placeholder={t.spacePlaceholder}
            />
          </div>
          <button class="btn-primary" type="submit">{t.createDevice}</button>
          <div class="device-create-chips" aria-label={t.commonSpacesLabel}>
            {spaces.slice(0, 6).map((space) => (
              <button type="button" class="btn-ghost btn-sm" data-space-chip={space}>{space}</button>
            ))}
          </div>
          <datalist id="create-space-suggestions">
            {spaces.map((space) => <option value={space} />)}
          </datalist>
        </form>
        <script>
          // Tap a common space to fill it in, and suggest a name if none is typed yet.
          import { fmt, readI18n } from "../../i18n/client";
          import en from "../../i18n/messages/app/deviceSetup/push/en";
          const form = document.getElementById("device-create-form");
          const text = readI18n(form, en.client);
          const nameInput = form?.querySelector('input[name="name"]');
          const spaceInput = form?.querySelector('input[name="space"]');
          form?.querySelectorAll<HTMLButtonElement>("[data-space-chip]").forEach((chip) => {
            chip.addEventListener("click", () => {
              const space = chip.dataset.spaceChip ?? "";
              if (spaceInput instanceof HTMLInputElement) spaceInput.value = space;
              if (nameInput instanceof HTMLInputElement && !nameInput.value.trim()) nameInput.value = fmt(text.suggestedName, { space });
            });
          });
        </script>
      ) : canEdit && devices.length === 0 ? (
        <p class="text-sm text-[var(--color-text-muted)] mb-0" set:html={t.firstRunHtml} />
      ) : (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">{t.viewOnly}</p>
      )}

      {otherCount > 0 && (
        <p
          class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]"
          set:html={plural(t.otherDevicesHtml, otherCount, locale)}
        />
      )}

      {setupDevices.length > 0 && (
        <ul class="mt-6 space-y-6">
          {setupDevices.map((device) => {
            const seen = formatRelativeAge(device.last_seen_at, NEVER_SEEN, locale);
            const tempRenameSensors = device.sensors
              .filter((sensor) => sensor.kind === "temperature")
              .map((sensor) => ({
                id: sensor.id,
                key: sensor.key,
                label: sensor.label,
                kind: sensor.kind,
              }));
            const showInlineRename =
              canEdit &&
              tempRenameSensors.length > 0 &&
              showRenameBatch;
            const highlightRename =
              focusDevice === device.id ||
              (showRenameBatch && tempRenameSensors.some((sensor) => sensorNeedsRename(sensor.label)));
            const showRevealKey =
              canEdit &&
              ingestKeyVaultLive &&
              deviceHasRecoverableKey(device.meta) &&
              !(ingestKey && focusDevice === device.id);
            const showRenameHint =
              canEdit &&
              !showInlineRename &&
              tempRenameSensors.some((sensor) => sensorNeedsRename(sensor.label));
            // Collapsed to one line unless it's the only device, needs setup, or was linked to.
            const startOpen =
              setupDevices.length === 1 ||
              focusDevice === device.id ||
              seen.label === NEVER_SEEN ||
              highlightRename;
            return (
            <li
              class:list={[
                "list-none rounded-xl border border-[var(--color-border)] p-4",
                focusDevice === device.id && "ring-2 ring-[var(--color-accent)]",
              ]}
              id={`device-${device.id}`}
              data-device-card={device.id}
            >
              <details class="device-row" open={startOpen}>
              <summary class="device-row-summary">
                <div>
                  <strong>{device.name}</strong>
                  {device.space && <span class="device-row-space">{device.space}</span>}
                  <p class="m-0 text-sm text-[var(--color-text-muted)]">
                    {fmt(t.keyPrefix, { prefix: device.ingest_key_prefix ?? "" })}
                    {" · "}
                    <span class={seen.lagging ? "text-[var(--color-warning)]" : ""} title={seen.absolute ?? undefined}>
                      {seen.label === NEVER_SEEN
                        ? t.neverSeen
                        : freshnessText(seen)}
                    </span>
                    {typeof device.meta?.firmware_version === "string" && (
                      <>
                        {" · "}{fmt(t.firmware, { version: device.meta.firmware_version })}
                        {firmwareUpdateAvailable(device.meta.firmware_version) && (
                          <>
                            {" · "}
                            <a class="text-link" href="/flash">{fmt(t.updateTo, { version: LATEST_FIRMWARE_VERSION })}</a>
                          </>
                        )}
                      </>
                    )}
                  </p>
                  {showRenameHint && (
                    <p class="m-0 mt-1 text-sm text-[var(--color-text-muted)]">
                      {t.labelsFine}{" "}
                      <a class="text-link" href={`${redirectTo}?rename_sensors=1&focus_device=${device.id}`}>
                        {t.renameLater}
                      </a>
                    </p>
                  )}
                  {seen.label === NEVER_SEEN && (
                    <p class="m-0 mt-1 text-sm text-[var(--color-text-muted)]">
                      {device.sensors.length === 0
                        ? t.noPostsYet
                        : (
                          <>
                            {t.waitingKeys}{" "}
                            <code class="text-xs">
                              {device.sensors.map((s) => s.key).join(", ")}
                            </code>
                            .{" "}
                            <a class="text-link" href="#verify-ingest-step">{t.seeChecklist}</a>
                          </>
                        )}
                    </p>
                  )}
                </div>
                <span class="device-row-toggle" aria-hidden="true">{t.manage}</span>
              </summary>
              <div class="device-row-body">
                <p class="mt-0 mb-3 text-sm">
                  <a class="text-link" href={deviceHref(device.id)}>{t.openDevice}</a>
                </p>
                <div class="flex flex-wrap gap-2">
                  <form method="POST" class="flex flex-wrap items-end gap-2" data-device-rename-form>
                    <input type="hidden" name="action" value="rename" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <div class="form-field mb-0">
                      <label class="form-label" for={`rename-${device.id}`}>{t.name}</label>
                      <input
                        class="form-input"
                        id={`rename-${device.id}`}
                        name="name"
                        value={device.name}
                        required
                      />
                    </div>
                    <button class="btn-secondary" type="submit">{t.rename}</button>
                    <p class="m-0 text-sm text-[var(--color-success)] hidden" data-device-status></p>
                    <p class="m-0 text-sm text-[var(--color-danger)] hidden" data-device-error></p>
                  </form>
                  <form method="POST" class="flex flex-wrap items-end gap-2" data-device-space-form>
                    <input type="hidden" name="action" value="set_space" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <div class="form-field mb-0">
                      <label class="form-label" for={`space-${device.id}`}>{t.space}</label>
                      <input
                        class="form-input"
                        id={`space-${device.id}`}
                        name="space"
                        value={device.space ?? ""}
                        placeholder={t.spaceExamplePlaceholder}
                        list="space-suggestions"
                      />
                    </div>
                    <button class="btn-secondary" type="submit">{t.saveSpace}</button>
                    <p class="m-0 text-sm text-[var(--color-success)] hidden" data-device-status></p>
                    <p class="m-0 text-sm text-[var(--color-danger)] hidden" data-device-error></p>
                  </form>
                  <form action="/api/devices" method="post" onsubmit={`return confirm(${JSON.stringify(t.rotateConfirm)});`}>
                    <input type="hidden" name="action" value="rotate_key" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-secondary" type="submit">{t.rotateKey}</button>
                  </form>
                  {showRevealKey && (
                    <RevealIngestKeyButton client:visible deviceId={device.id} deviceName={device.name} text={t.revealKey} />
                  )}
                  {canEdit && transferTargets.length > 0 && (
                    <form action="/api/devices" method="post" class="flex flex-wrap gap-2 items-end">
                      <input type="hidden" name="action" value="transfer" />
                      <input type="hidden" name="device_id" value={device.id} />
                      <input type="hidden" name="redirect" value={redirectTo} />
                      <div class="form-field mb-0">
                        <label class="form-label" for={`transfer-${device.id}`}>{t.moveTo}</label>
                        <select class="form-input" id={`transfer-${device.id}`} name="target_household_id" required>
                          {transferTargets.map((h) => (
                            <option value={h.household_id}>{h.name ?? h.household_id}</option>
                          ))}
                        </select>
                      </div>
                      <button class="btn-secondary" type="submit">{t.transferDevice}</button>
                    </form>
                  )}
                  {canEdit && (
                  <form action="/api/devices" method="post" onsubmit={`return confirm(${JSON.stringify(t.deleteConfirm)});`}>
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-ghost" type="submit">{t.delete}</button>
                  </form>
                  )}
                </div>

              {showInlineRename && (
                <PushInlineRename
                  client:visible
                  deviceId={device.id}
                  deviceName={device.name}
                  sensors={tempRenameSensors}
                  highlight={highlightRename}
                  text={t.inlineRename}
                />
              )}

              {device.sensors.length === 0 ? (
                <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]">
                  {t.noSensorsYet}
                </p>
              ) : (
                <p class="mt-4 mb-0 text-sm">
                  {fmt(t.sensorsList, { list: device.sensors.map((sensor) => sensor.label).join(", ") })}{" "}
                  <a class="text-link" href={`${deviceHref(device.id)}#sensors`}>{t.editSensors}</a>
                </p>
              )}
              </div>
              </details>
            </li>
            );
          })}
        </ul>
      )}

      {pushDevices.length > 0 && (
        <details class="mt-6 space-y-4 border-t border-[var(--color-border)] pt-4" id="add-sensor">
          <summary class="cursor-pointer text-base font-semibold">{t.advancedSummary}</summary>
          <div class="mt-4 space-y-4">
          <div>
            <p class="card-subtitle mb-0 mt-1">
              {t.advancedHint}
            </p>
          </div>

          <form action="/api/devices" method="post" class="sensor-quick-pair rounded-lg border border-[var(--color-border)] p-4" data-sensor-pair-form>
            <input type="hidden" name="action" value="add_sensor_pair" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <p class="m-0 mb-3 text-sm font-medium">{t.quickPairTitle}</p>
            <p class="card-subtitle mt-0 mb-3" set:html={t.quickPairHintHtml} />
            <div class="sensor-map-primary">
              <div class="form-field mb-0">
                <label class="form-label" for="pair-device">{t.device}</label>
                <select class="form-input" id="pair-device" name="device_id">
                  {pushDevices.map((d) => (
                    <option value={d.id} selected={focusDevice === d.id}>{d.name}</option>
                  ))}
                </select>
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="pair-key">{t.jsonKey}</label>
                <input class="form-input font-mono" id="pair-key" name="key" required placeholder="0" />
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="pair-label">{t.nameOnHome}</label>
                <input class="form-input" id="pair-label" name="label" placeholder={t.pairLabelDefault} value={t.pairLabelDefault} />
              </div>
              <div class="sensor-map-actions">
                <button class="btn-primary" type="submit">{t.addPair}</button>
              </div>
            </div>
          </form>

          <form action="/api/devices" method="post" class="space-y-3" data-sensor-add-form>
            <p class="m-0 text-sm font-medium">{t.orAddOne}</p>
            <input type="hidden" name="action" value="add_sensor" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <div class="sensor-map-primary">
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-device">{t.device}</label>
                <select class="form-input" id="sensor-device" name="device_id">
                  {pushDevices.map((d) => (
                    <option value={d.id} selected={focusDevice === d.id}>{d.name}</option>
                  ))}
                </select>
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-key">{t.jsonKey}</label>
                <input class="form-input font-mono" id="sensor-key" name="key" required placeholder="door1" />
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-label">{t.nameOnHome}</label>
                <input class="form-input" id="sensor-label" name="label" required placeholder={t.sensorLabelPlaceholder} />
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-kind">{t.type}</label>
                <select class="form-input" id="sensor-kind" name="kind">
                  {Object.entries(kindLabels).map(([value, label]) => (
                    <option value={value}>{label}</option>
                  ))}
                </select>
              </div>
              <div class="sensor-map-actions">
                <button class="btn-secondary" type="submit">{t.addSensor}</button>
              </div>
            </div>
          </form>
          </div>
        </details>
      )}
    </section>

<style>
  .device-create-form {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .device-create-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  @media (min-width: 768px) {
    .device-create-form {
      grid-template-columns: minmax(12rem, 1.2fr) minmax(10rem, 1fr) auto;
      align-items: end;
    }
    .device-create-chips {
      grid-column: 1 / -1;
    }
  }
</style>
