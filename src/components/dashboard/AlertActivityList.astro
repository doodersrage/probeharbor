---
import { formatRelativeAge } from "../../lib/relativeTime";
import {
  FALSE_ALARM_TIPS,
  FLOOD_FALSE_ALARM_TIPS,
  formatAlertWhyMeta,
  raiseThresholdBand,
  localizeFalseAlarmTip,
  type FalseAlarmHint,
} from "../../lib/falseAlarmHints";
import { alertDeliveryState } from "../../lib/alertDeliveryState";
import { formatAlertDeliveryState, type AlertDeliveryLabel } from "../../lib/alertDeliveryLabel";
import { isUnhandledAlertEvent, type AlertEventRow } from "../../lib/alertEvents";
import AlertAckActions from "./AlertAckActions.astro";
import { groupAlertEvents } from "../../lib/alertEventGroups";
import { formatAlertKind } from "../../lib/alertKindLabels";
import { fmt, getLocale, plural } from "../../i18n";
import { alertsMessages } from "../../i18n/messages/app/alerts";

interface Props {
  events: AlertEventRow[];
  canEdit: boolean;
  hasTenantRelay: boolean;
  hasOutboundWebhook: boolean;
  canUseOutboundWebhook: boolean;
  /** The °C display preference: "Why" temperatures and the raise-threshold step. */
  useCelsius?: boolean;
}

const {
  events,
  canEdit,
  hasTenantRelay,
  hasOutboundWebhook,
  canUseOutboundWebhook,
  useCelsius = false,
} = Astro.props;

const locale = getLocale(Astro);
const t = alertsMessages(locale).list;
const td = alertsMessages(locale).deliveryState;
const raiseThresholdText = fmt(t.raiseThreshold, { band: raiseThresholdBand(locale, useCelsius) });

// Runs of look-alike alerts show the newest row plus "Show N more like this".
const items = groupAlertEvents(events).flatMap((group, groupIndex) => {
  const groupId = `alert-group-${groupIndex}`;
  const oldest = group.rest[group.rest.length - 1];
  return [
    {
      event: group.lead,
      groupId,
      folded: false,
      moreCount: group.rest.length,
      oldestLabel: oldest ? formatRelativeAge(oldest.created_at, undefined, locale).label : "",
    },
    ...group.rest.map((event) => ({ event, groupId, folded: true, moreCount: 0, oldestLabel: "" })),
  ];
});

/** Who closed it: a person ("Handled") or the system once the condition cleared. */
function handledLabel(event: AlertEventRow): string {
  if (event.meta?.autoResolved === "recovered") return t.recovered;
  if (event.meta?.autoResolved === "expired") return t.expired;
  return t.handled;
}

/** "Accepted by email", "Held (quiet hours)", "Failed: email, SMS", … with a next step. */
function deliveryFor(event: AlertEventRow): AlertDeliveryLabel {
  return formatAlertDeliveryState(alertDeliveryState(event), locale);
}

function tipForEvent(event: AlertEventRow): FalseAlarmHint | null {
  const tipId = event.meta?.suggestedTipId;
  if (!tipId) return null;
  const tip = [...FALSE_ALARM_TIPS, ...FLOOD_FALSE_ALARM_TIPS].find((hint) => hint.id === tipId);
  return tip ? localizeFalseAlarmTip(tip, locale) : null;
}
---

{events.length === 0 ? (
  <p class="mb-0 text-sm text-[var(--color-text-muted)]">
    {t.empty}
  </p>
) : (
  <>
    <div class="alert-activity-mobile space-y-3">
      {items.map(({ event, groupId, folded, moreCount, oldestLabel }) => {
        const age = formatRelativeAge(event.created_at, undefined, locale);
        const why = formatAlertWhyMeta(event.meta ?? {}, locale, useCelsius);
        const tip = tipForEvent(event);
        const state = alertDeliveryState(event).state;
        const delivery = deliveryFor(event);
        return (
          <>
          <article
            class="rounded-lg border border-[var(--color-border)] p-3 text-sm"
            data-alert-group-member={folded ? groupId : undefined}
            hidden={folded}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <strong>{event.title}</strong>
              <span class="text-xs text-[var(--color-text-muted)]">{age.label}</span>
            </div>
            <p class="m-0 mt-1 text-xs text-[var(--color-text-muted)]">
              {formatAlertKind(event.kind, locale)}
              {" · "}
              <span
                class:list={["alert-delivery", delivery.tone === "warn" && "is-warn"]}
                data-delivery-state={state}
                title={delivery.title ?? undefined}
              >
                {delivery.label}
              </span>
              {delivery.extra && <> · {delivery.extra}</>}
              {delivery.fix && canEdit && (
                <> · <a class="text-link" href={delivery.fix.href}>{delivery.fix.label}</a></>
              )}
            </p>
            {why && (
              <details class="mt-2">
                <summary class="cursor-pointer text-link text-xs">{t.why}</summary>
                <p class="mt-1 mb-0 text-xs text-[var(--color-text-muted)] whitespace-pre-wrap">
                  {why}
                </p>
              </details>
            )}
            {tip && (
              <p class="mt-2 mb-0 text-xs">
                {fmt(t.suggested, { tip: tip.title })}{" "}
                {tip.href && (
                  <a class="text-link" href={tip.href}>{tip.hrefLabel ?? t.open}</a>
                )}
              </p>
            )}
            {event.meta?.feedback === "false_alarm" && canEdit && (
              <div class="mt-2 flex flex-wrap gap-2">
                <form action="/api/user/alert-events/ack" method="post">
                  <input type="hidden" name="event_id" value={event.id} />
                  <input type="hidden" name="action" value="raise_threshold" />
                  <input type="hidden" name="redirect" value="/dashboard/alerts" />
                  <button type="submit" class="btn-secondary btn-sm">
                    {raiseThresholdText}
                  </button>
                </form>
                <a class="btn-ghost btn-sm" href="/dashboard/devices">
                  {t.checkPlacement}
                </a>
              </div>
            )}
            <div class="mt-3">
              {event.acknowledged_at ? (
                <span class="text-xs text-[var(--color-text-muted)]">{handledLabel(event)}</span>
              ) : canEdit && isUnhandledAlertEvent(event) ? (
                <AlertAckActions
                  eventId={event.id}
                  hasTenantRelay={hasTenantRelay}
                  canPingWebhook={hasOutboundWebhook && canUseOutboundWebhook}
                  useCelsius={useCelsius}
                />
              ) : (
                <span class="text-xs text-[var(--color-text-muted)]">—</span>
              )}
            </div>
          </article>
          {moreCount > 0 && (
            <button type="button" class="btn-ghost btn-sm" data-alert-group-toggle={groupId} data-hide-label={plural(t.hideSimilar, moreCount, locale)} aria-expanded="false">
              {plural(t.showMore, moreCount, locale, { oldest: oldestLabel })}
            </button>
          )}
          </>
        );
      })}
    </div>

    <div class="alert-activity-desktop overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr class="text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-3">{t.columns.when}</th>
            <th scope="col" class="py-2 pr-3">{t.columns.kind}</th>
            <th scope="col" class="py-2 pr-3">{t.columns.title}</th>
            <th scope="col" class="py-2 pr-3">{t.columns.why}</th>
            <th scope="col" class="py-2 pr-3">{td.column}</th>
            <th scope="col" class="py-2">{t.columns.ack}</th>
          </tr>
        </thead>
        <tbody>
          {items.map(({ event, groupId, folded, moreCount, oldestLabel }) => {
            const age = formatRelativeAge(event.created_at, undefined, locale);
            const why = formatAlertWhyMeta(event.meta ?? {}, locale, useCelsius);
            const tip = tipForEvent(event);
            const state = alertDeliveryState(event).state;
            const delivery = deliveryFor(event);
            return (
              <>
              <tr
                class="border-t border-[var(--color-border)] align-top"
                data-alert-group-member={folded ? groupId : undefined}
                hidden={folded}
              >
                <td class="py-2 pr-3 whitespace-nowrap">{age.label}</td>
                <td class="py-2 pr-3">{formatAlertKind(event.kind, locale)}</td>
                <td class="py-2 pr-3">{event.title}</td>
                <td class="py-2 pr-3 max-w-xs">
                  {why ? (
                    <details>
                      <summary class="cursor-pointer text-link text-xs">{t.why}</summary>
                      <p class="mt-1 mb-0 text-xs text-[var(--color-text-muted)] whitespace-pre-wrap">
                        {why}
                      </p>
                    </details>
                  ) : (
                    <span class="text-[var(--color-text-muted)]">—</span>
                  )}
                  {tip && (
                    <p class="mt-2 mb-0 text-xs">
                      {fmt(t.suggestedFix, { tip: tip.title })}{" "}
                      {tip.href ? (
                        <a class="text-link" href={tip.href}>{tip.hrefLabel ?? t.open}</a>
                      ) : null}
                    </p>
                  )}
                  {event.meta?.feedback === "false_alarm" && canEdit && (
                    <form action="/api/user/alert-events/ack" method="post" class="mt-2">
                      <input type="hidden" name="event_id" value={event.id} />
                      <input type="hidden" name="action" value="raise_threshold" />
                      <input type="hidden" name="redirect" value="/dashboard/alerts" />
                      <button type="submit" class="btn-ghost text-xs">
                        {raiseThresholdText}
                      </button>
                    </form>
                  )}
                </td>
                <td class="py-2 pr-3">
                  <span
                    class:list={["alert-delivery", delivery.tone === "warn" && "is-warn"]}
                    data-delivery-state={state}
                    title={delivery.title ?? undefined}
                  >
                    {delivery.label}
                  </span>
                  {delivery.extra && (
                    <span class="block text-xs text-[var(--color-text-muted)]">{delivery.extra}</span>
                  )}
                  {delivery.fix && canEdit && (
                    <a class="block text-link text-xs" href={delivery.fix.href}>{delivery.fix.label}</a>
                  )}
                </td>
                <td class="py-2">
                  {event.acknowledged_at ? (
                    <span class="text-[var(--color-text-muted)]">{handledLabel(event)}</span>
                  ) : canEdit && isUnhandledAlertEvent(event) ? (
                    <AlertAckActions
                      eventId={event.id}
                      hasTenantRelay={hasTenantRelay}
                      canPingWebhook={hasOutboundWebhook && canUseOutboundWebhook}
                      useCelsius={useCelsius}
                      compact
                    />
                  ) : (
                    "—"
                  )}
                </td>
              </tr>
              {moreCount > 0 && (
                <tr>
                  <td colspan="6" class="pb-2">
                    <button type="button" class="btn-ghost btn-sm" data-alert-group-toggle={groupId} data-hide-label={plural(t.hideSimilar, moreCount, locale)} aria-expanded="false">
                      {plural(t.showMore, moreCount, locale, { oldest: oldestLabel })}
                    </button>
                  </td>
                </tr>
              )}
              </>
            );
          })}
        </tbody>
      </table>
    </div>
  </>
)}

<script>
  // Expand or fold a run of look-alike alerts (mobile cards and desktop rows share group ids).
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>("[data-alert-group-toggle]");
    if (!button) return;
    const groupId = button.dataset.alertGroupToggle;
    const container = button.closest(".alert-activity-mobile, .alert-activity-desktop");
    if (!groupId || !container) return;
    const open = button.getAttribute("aria-expanded") !== "true";
    container.querySelectorAll<HTMLElement>(`[data-alert-group-member="${groupId}"]`).forEach((el) => {
      el.hidden = !open;
    });
    button.setAttribute("aria-expanded", String(open));
    const count = button.textContent?.match(/\d+/)?.[0] ?? "";
    button.dataset.label ??= button.textContent ?? "";
    button.textContent = open ? (button.dataset.hideLabel ?? `Hide ${count} similar`) : button.dataset.label;
  });
</script>

<style>
  .alert-delivery.is-warn {
    color: var(--color-warning-text);
    font-weight: 600;
  }

  .alert-activity-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .alert-activity-mobile {
      display: none;
    }

    .alert-activity-desktop {
      display: block;
    }
  }
</style>
