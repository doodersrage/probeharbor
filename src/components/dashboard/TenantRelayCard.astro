---
import DashboardCard from "./DashboardCard.astro";
import type { TenantNotifySettings } from "../../lib/tenantRelay";
import { getLocale } from "../../i18n";
import { settingsMessages } from "../../i18n/messages/app/settings";

interface Props {
  canEdit: boolean;
  settings: TenantNotifySettings;
  householdId: string;
}

const { canEdit, settings, householdId } = Astro.props;
const t = settingsMessages(getLocale(Astro)).tenant;
---
{canEdit && (
  <DashboardCard id="tenant-relay">
    <h2 class="card-title">{t.heading}</h2>
    <p class="card-subtitle mb-4">
      {t.subtitle}
    </p>
    <form action="/api/household/tenant-notify" method="post" class="config-row-grid mb-0">
      <input type="hidden" name="household_id" value={householdId} />
      <input type="hidden" name="redirect" value="/dashboard/settings" />
      <div class="form-field mb-0">
        <label class="form-label" for="tenant-name">{t.nameLabel}</label>
        <input class="form-input" id="tenant-name" name="tenant_name" value={settings.name ?? ""} placeholder={t.namePlaceholder} />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="tenant-email">{t.emailLabel}</label>
        <input class="form-input" id="tenant-email" name="tenant_email" type="email" value={settings.email ?? ""} placeholder={t.emailPlaceholder} />
      </div>
      <div class="form-field mb-0 flex items-end">
        <button class="btn-primary" type="submit">{t.submit}</button>
      </div>
    </form>
  </DashboardCard>
)}
