---
import type { DeviceWithSensors } from "../../lib/devices";
import { fmt, getLocale } from "../../i18n";
import { devicesListMessages } from "../../i18n/messages/app/devices/list";

/**
 * "Select several": enable, disable, set space, or delete push devices in
 * one go. Pull feeds are managed in Pull feeds settings, so they're left out.
 */
interface Props {
  pushDevices: DeviceWithSensors[];
  redirectTo: string;
  spaces: string[];
}

const { pushDevices, redirectTo, spaces } = Astro.props;
const t = devicesListMessages(getLocale(Astro)).bulk;
// Devices that haven't reported in 30+ days.
const SILENT_MS = 30 * 24 * 60 * 60 * 1000;
const silentIds = pushDevices
  .filter((device) => {
    const last = Date.parse(device.last_seen_at ?? "") || 0;
    return last > 0 && Date.now() - last > SILENT_MS;
  })
  .map((device) => device.id);
---
{pushDevices.length > 1 && (
  <details class="device-bulk" id="device-bulk">
    <summary class="cursor-pointer text-sm font-semibold">{t.summary}</summary>
    <form
      action="/api/devices"
      method="post"
      class="mt-3"
      id="bulk-devices-form"
      data-i18n={JSON.stringify({ confirmDelete: t.confirmDelete })}
    >
      <input type="hidden" name="action" value="bulk" />
      <input type="hidden" name="redirect" value={redirectTo} />
      <div class="flex flex-wrap items-end gap-3 mb-3">
        <label class="text-sm">
          {t.doThis}
          <select name="bulk_op" class="form-input block mt-1" id="bulk-op-select">
            <option value="set_space">{t.ops.set_space}</option>
            <option value="enable">{t.ops.enable}</option>
            <option value="disable">{t.ops.disable}</option>
            <option value="delete">{t.ops.delete}</option>
          </select>
        </label>
        <label class="text-sm" id="bulk-space-field">
          {t.space}
          <input type="text" name="space" class="form-input block mt-1" placeholder={t.spacePlaceholder} list="bulk-space-suggestions" />
        </label>
        <datalist id="bulk-space-suggestions">
          {spaces.map((space) => <option value={space} />)}
        </datalist>
        <button type="submit" class="btn-secondary" id="bulk-apply-btn">{t.apply}</button>
      </div>
      <div class="flex flex-wrap gap-2 mb-2">
        <button type="button" class="btn-ghost btn-sm" id="bulk-select-all">{t.selectAll}</button>
        <button type="button" class="btn-ghost btn-sm" id="bulk-select-unplaced">{t.selectUnplaced}</button>
        {silentIds.length > 0 && (
          <button type="button" class="btn-ghost btn-sm" id="bulk-select-silent" data-ids={silentIds.join(",")}>
            {fmt(t.selectSilent, { count: silentIds.length })}
          </button>
        )}
      </div>
      <div class="bulk-devices-checks">
        {pushDevices.map((device) => (
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="ids" value={device.id} class="bulk-device-id" data-unplaced={device.space?.trim() ? "0" : "1"} />
            <span>
              {device.name}
              <span class="text-[var(--color-text-muted)]">
                {device.space ? ` · ${device.space}` : ` · ${t.noSpace}`}
                {!device.enabled && ` · ${t.disabled}`}
              </span>
            </span>
          </label>
        ))}
      </div>
    </form>
  </details>
)}

<script>
  import { fmt, pageIntlLocale, readI18n } from "../../i18n/client";
  import en from "../../i18n/messages/app/devices/list/en";

  const form = document.getElementById("bulk-devices-form");
  const opSelect = document.getElementById("bulk-op-select");
  const spaceField = document.getElementById("bulk-space-field");
  const boxes = () => Array.from(form?.querySelectorAll(".bulk-device-id") ?? []).filter((el) => el instanceof HTMLInputElement);
  const syncSpaceField = () => {
    if (opSelect instanceof HTMLSelectElement && spaceField) spaceField.hidden = opSelect.value !== "set_space";
  };
  opSelect?.addEventListener("change", syncSpaceField);
  syncSpaceField();
  document.getElementById("bulk-select-all")?.addEventListener("click", () => {
    for (const box of boxes()) box.checked = true;
  });
  document.getElementById("bulk-select-unplaced")?.addEventListener("click", () => {
    for (const box of boxes()) box.checked = box.dataset.unplaced === "1";
    if (opSelect instanceof HTMLSelectElement) opSelect.value = "set_space";
    syncSpaceField();
  });
  // Old test boards pile up: tick the ones that haven't reported in 30 days, then Delete.
  document.getElementById("bulk-select-silent")?.addEventListener("click", (event) => {
    const ids = new Set(((event.currentTarget as HTMLElement).dataset.ids ?? "").split(","));
    for (const box of boxes()) box.checked = ids.has(box.value);
    if (opSelect instanceof HTMLSelectElement) opSelect.value = "delete";
    syncSpaceField();
  });
  form?.addEventListener("submit", (event) => {
    if (!(opSelect instanceof HTMLSelectElement) || opSelect.value !== "delete") return;
    const checked = boxes().filter((box) => box.checked).length;
    const forms = readI18n(form, { confirmDelete: en.bulk.confirmDelete }).confirmDelete as Record<string, string | undefined>;
    const category = new Intl.PluralRules(pageIntlLocale()).select(checked);
    const message = fmt(forms[category] ?? forms.other ?? en.bulk.confirmDelete.other, { count: checked });
    if (checked > 0 && !confirm(message)) {
      event.preventDefault();
    }
  });
</script>
