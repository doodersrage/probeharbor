---
import DashboardCard from "./DashboardCard.astro";

interface Props {
  quietUntil: string | null;
  quietActive: boolean;
  forceSimpleNote?: boolean;
  growthTipsDismissed?: boolean;
  onboardingDismissed?: boolean;
}

const {
  quietUntil,
  quietActive,
  forceSimpleNote = false,
  growthTipsDismissed = false,
  onboardingDismissed = false,
} = Astro.props;
---

<DashboardCard>
  <h2 class="card-title">Overview tips &amp; checklist</h2>
  <p class="card-subtitle mb-4">
    Choose what Overview suggests. Problems (stale probes, low battery, unhandled alerts) always show.
    To pin numbers, tap ★ on a card under Overview → At a glance.
  </p>

  {forceSimpleNote && (
    <p class="alert-warning" role="status">
      Viewers and alert-only members stay on Simple overview (Insights is hidden).
    </p>
  )}

  <div class="space-y-4">
    <div>
      <h3 class="text-sm font-semibold mb-2">Recommendations</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        Hides non-critical overview recommendations for 7 days. Low battery, stale
        sensors, and unacked alerts still appear. This is separate from
        <a class="text-link" href="/dashboard/alerts?tab=settings#alert-section-quiet">alert quiet hours</a>
        (which pause overnight delivery).
      </p>
      {quietActive && quietUntil ? (
        <form action="/api/user/dashboard-quiet" method="post" class="flex flex-wrap gap-2 items-center">
          <input type="hidden" name="redirect" value="/dashboard/settings" />
          <input type="hidden" name="action" value="clear" />
          <span class="text-sm">
            Recommendations hidden until {new Date(quietUntil).toLocaleString()}
          </span>
          <button type="submit" class="btn-secondary btn-sm">Show recommendations</button>
        </form>
      ) : (
        <form action="/api/user/dashboard-quiet" method="post">
          <input type="hidden" name="redirect" value="/dashboard/settings" />
          <input type="hidden" name="action" value="quiet_7d" />
          <button type="submit" class="btn-secondary btn-sm">Hide recommendations for 7 days</button>
        </form>
      )}
    </div>

    <div>
      <h3 class="text-sm font-semibold mb-2">Companion app tips</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        Nest, PWA, Android, and Bay Buddy on Overview Tips. Also auto-hides 14 days after signup once you are live.
      </p>
      <form action="/api/user/dashboard-growth-tips" method="post">
        <input type="hidden" name="redirect" value="/dashboard/settings" />
        <input type="hidden" name="action" value={growthTipsDismissed ? "reset" : "dismiss"} />
        <button type="submit" class="btn-secondary btn-sm">
          {growthTipsDismissed ? "Show companion tips on Overview" : "Hide companion tips"}
        </button>
      </form>
    </div>

    <div>
      <h3 class="text-sm font-semibold mb-2">Getting started checklist</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        {onboardingDismissed
          ? "Hidden on Overview."
          : "Shows on Overview until setup is complete."}
      </p>
      <form action="/api/user/onboarding" method="post">
        <input type="hidden" name="action" value={onboardingDismissed ? "reset" : "dismiss"} />
        <input type="hidden" name="redirect" value="/dashboard/settings" />
        <button type="submit" class="btn-secondary btn-sm">
          {onboardingDismissed ? "Show checklist on Overview" : "Hide checklist on Overview"}
        </button>
      </form>
    </div>

    <div>
      <h3 class="text-sm font-semibold mb-2">Keyboard shortcuts</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-0">
        Press <kbd>?</kbd> on any dashboard page for the cheat sheet. Navigation:
        <kbd>g</kbd> then <kbd>o</kbd>/<kbd>v</kbd>/<kbd>d</kbd>/<kbd>a</kbd>/<kbd>h</kbd>/<kbd>f</kbd>/<kbd>l</kbd>/<kbd>n</kbd>/<kbd>p</kbd>.
      </p>
    </div>
  </div>
</DashboardCard>

<style>
  kbd {
    font-size: 0.75rem;
    border: 1px solid var(--color-border);
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
  }
</style>
