---
import DashboardCard from "./DashboardCard.astro";
import { fmt, formatDateTime, getLocale } from "../../i18n";
import { settingsMessages } from "../../i18n/messages/app/settings";

interface Props {
  quietUntil: string | null;
  quietActive: boolean;
  forceSimpleNote?: boolean;
  growthTipsDismissed?: boolean;
  onboardingDismissed?: boolean;
}

const {
  quietUntil,
  quietActive,
  forceSimpleNote = false,
  growthTipsDismissed = false,
  onboardingDismissed = false,
} = Astro.props;
const locale = getLocale(Astro);
const t = settingsMessages(locale).comfort;
// Same fields as Date#toLocaleString(), in the page language.
const quietUntilLabel = quietUntil
  ? formatDateTime(quietUntil, locale, {
      year: "numeric",
      month: "numeric",
      day: "numeric",
      hour: "numeric",
      minute: "numeric",
      second: "numeric",
    })
  : "";
---

<DashboardCard>
  <h2 class="card-title">{t.heading}</h2>
  <p class="card-subtitle mb-4">
    {t.subtitle}
  </p>

  {forceSimpleNote && (
    <p class="alert-warning" role="status">
      {t.forceSimpleNote}
    </p>
  )}

  <div class="space-y-4">
    <div>
      <h3 class="text-sm font-semibold mb-2">{t.recommendationsHeading}</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-2" set:html={t.recommendationsBodyHtml} />
      {quietActive && quietUntil ? (
        <form action="/api/user/dashboard-quiet" method="post" class="flex flex-wrap gap-2 items-center">
          <input type="hidden" name="redirect" value="/dashboard/settings" />
          <input type="hidden" name="action" value="clear" />
          <span class="text-sm">
            {fmt(t.hiddenUntil, { time: quietUntilLabel })}
          </span>
          <button type="submit" class="btn-secondary btn-sm">{t.showRecommendations}</button>
        </form>
      ) : (
        <form action="/api/user/dashboard-quiet" method="post">
          <input type="hidden" name="redirect" value="/dashboard/settings" />
          <input type="hidden" name="action" value="quiet_7d" />
          <button type="submit" class="btn-secondary btn-sm">{t.hideRecommendations}</button>
        </form>
      )}
    </div>

    <div>
      <h3 class="text-sm font-semibold mb-2">{t.tipsHeading}</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        {t.tipsBody}
      </p>
      <form action="/api/user/dashboard-growth-tips" method="post">
        <input type="hidden" name="redirect" value="/dashboard/settings" />
        <input type="hidden" name="action" value={growthTipsDismissed ? "reset" : "dismiss"} />
        <button type="submit" class="btn-secondary btn-sm">
          {growthTipsDismissed ? t.showTips : t.hideTips}
        </button>
      </form>
    </div>

    <div>
      <h3 class="text-sm font-semibold mb-2">{t.checklistHeading}</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        {onboardingDismissed ? t.checklistHidden : t.checklistShown}
      </p>
      <form action="/api/user/onboarding" method="post">
        <input type="hidden" name="action" value={onboardingDismissed ? "reset" : "dismiss"} />
        <input type="hidden" name="redirect" value="/dashboard/settings" />
        <button type="submit" class="btn-secondary btn-sm">
          {onboardingDismissed ? t.showChecklist : t.hideChecklist}
        </button>
      </form>
    </div>

    <div>
      <h3 class="text-sm font-semibold mb-2">{t.shortcutsHeading}</h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-0" set:html={t.shortcutsBodyHtml} />
    </div>
  </div>
</DashboardCard>

<style>
  /* kbd comes from set:html, so it carries no scoped attribute. */
  p :global(kbd) {
    font-size: 0.75rem;
    border: 1px solid var(--color-border);
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
  }
</style>
