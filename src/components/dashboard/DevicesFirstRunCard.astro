---
/**
 * Empty Devices → Setup: ask what the person already has and give each answer
 * one button. Sensors in Home Assistant / ESPHome / MQTT get a device plus a
 * snippet with the real key; no hardware gets the demo feed right away.
 */
import DemoPullQuickStart from "../DemoPullQuickStart";
import { getExampleFeedUrl } from "../../lib/exampleFeed";
import { SETUP_VIA_DEVICE_NAMES, type SetupVia } from "../../lib/firstDevicePaths";
import { withQuery } from "../../lib/siteUrl";
import { getLocale } from "../../i18n";
import { devicesSetupMessages } from "../../i18n/messages/app/devices/setup";
import { deviceSetupPullMessages } from "../../i18n/messages/app/deviceSetup/pull";

interface Props {
  canEdit: boolean;
  atDeviceLimit: boolean;
  redirectTo: string;
  nestEntitled: boolean;
}

const { canEdit, atDeviceLimit, redirectTo, nestEntitled } = Astro.props;
const locale = getLocale(Astro);
const t = devicesSetupMessages(locale).firstRun;
const demoText = deviceSetupPullMessages(locale).demo;
const exampleFeedUrl = getExampleFeedUrl(Astro.site);
const canCreate = canEdit && !atDeviceLimit;
const createFor = (via: SetupVia) => ({
  redirect: withQuery(redirectTo, { via }),
  name: SETUP_VIA_DEVICE_NAMES[via],
});
---
<section class="card devices-first-run" id="devices-first-run" aria-labelledby="devices-first-run-title">
  <h2 class="card-title" id="devices-first-run-title">{t.title}</h2>
  <p class="card-subtitle mb-4">
    {t.subtitle}
  </p>

  {!canEdit && (
    <p class="mb-4 text-sm text-[var(--color-text-muted)]">{t.viewOnly}</p>
  )}
  {canEdit && atDeviceLimit && (
    <p class="mb-4 text-sm">
      {t.limitReached} <a class="text-link" href="/dashboard/plans">{t.limitUpgrade}</a>
    </p>
  )}

  <div class="devices-path-grid" role="list">
    <div class="devices-path" role="listitem" id="first-run-have-sensors">
      <h3 class="devices-path-title">{t.haveSensors.title}</h3>
      <p class="devices-path-copy">
        {t.haveSensors.copy}
      </p>
      {canCreate && (
        <div class="flex flex-wrap gap-2">
          {(["ha", "esphome", "mqtt"] as const).map((via, i) => {
            const target = createFor(via);
            return (
              <form action="/api/devices" method="post">
                <input type="hidden" name="action" value="create_push" />
                <input type="hidden" name="redirect" value={target.redirect} />
                <input type="hidden" name="name" value={target.name} />
                <button class={i === 0 ? "btn-primary" : "btn-secondary"} type="submit">
                  {via === "ha" ? "Home Assistant" : via === "esphome" ? "ESPHome" : "MQTT / Node-RED"}
                </button>
              </form>
            );
          })}
        </div>
      )}
    </div>

    <div class="devices-path" role="listitem" id="first-run-have-board">
      <h3 class="devices-path-title">{t.haveBoard.title}</h3>
      <p class="devices-path-copy">
        {t.haveBoard.copy}
      </p>
      {canCreate && (
        <form action="/api/devices" method="post">
          <input type="hidden" name="action" value="create_push" />
          <input type="hidden" name="redirect" value={createFor("esp").redirect} />
          <input type="hidden" name="name" value={createFor("esp").name} />
          <button class="btn-primary" type="submit">{t.haveBoard.create}</button>
        </form>
      )}
      <details class="devices-other-boards mt-2">
        <summary class="devices-other-summary">{t.haveBoard.otherBoards}</summary>
        <div class="flex flex-wrap gap-2 mt-2">
          <a class="btn-ghost inline-flex" href="/flash">{t.haveBoard.browserFlasher}</a>
          <a class="btn-ghost inline-flex" href="/about/esp32-web-flash">{t.haveBoard.espOptions}</a>
          <a class="btn-ghost inline-flex" href="/about/pico-w-ingest">Pico W</a>
          <a class="btn-ghost inline-flex" href="/about/stm32-zephyr-ingest">STM32 Zephyr</a>
          <a class="btn-ghost inline-flex" href="/about/teensy41-ingest">Teensy 4.1</a>
          <a class="btn-ghost inline-flex" href="/about/cellular-ingest">{t.haveBoard.cellular}</a>
        </div>
      </details>
    </div>

    <div class="devices-path" role="listitem" id="first-run-no-hardware">
      <h3 class="devices-path-title">{t.noHardware.title}</h3>
      <p class="devices-path-copy">
        {t.noHardware.copy}
      </p>
      {canCreate && (
        <DemoPullQuickStart client:visible exampleFeedUrl={exampleFeedUrl} redirectTo="/dashboard" text={demoText} buttonLabel={demoText.buttonFirstRun} />
      )}
      <p class="mt-2 mb-0 text-sm">
        <a class="text-link" href="/about/esp32-freeze-kit">{t.noHardware.kitParts}</a>
      </p>
    </div>
  </div>

  <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
    {t.also} <a class="text-link" href="/dashboard/devices?view=setup&tab=pull">{t.jsonFeed}</a>
    {" · "}
    <a class="text-link" href="/dashboard/devices?view=setup&tab=thermostat#thermostat-connect">
      Nest / Ecobee{nestEntitled ? "" : " (Pro)"}
    </a>
    {" · "}
    <a class="text-link" href="/leak-puck">{t.leakPucks}</a>
    {" · "}
    <a class="text-link" href="/docs/api">{t.httpApi}</a>
  </p>
</section>

<style>
  .devices-path-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .devices-path-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .devices-path {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 88%, var(--color-accent) 12%);
  }

  .devices-path-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
  }

  .devices-path-copy {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .devices-other-summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--color-text-muted);
  }
</style>
