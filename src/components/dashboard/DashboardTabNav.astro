---
interface TabItem {
  id: string;
  label: string;
  href: string;
}

interface Props {
  tabs: TabItem[];
  activeId: string;
  ariaLabel: string;
}

const { tabs, activeId, ariaLabel } = Astro.props;
---
<nav class="dashboard-tab-nav" aria-label={ariaLabel}>
  {tabs.map((tab) => (
    <a
      class:list={["dashboard-tab-nav-link", tab.id === activeId && "is-active"]}
      href={tab.href}
      aria-current={tab.id === activeId ? "page" : undefined}
    >
      {tab.label}
    </a>
  ))}
</nav>

<script>
  // On phones the tab row scrolls sideways: keep the current tab visible.
  document.querySelectorAll<HTMLElement>(".dashboard-tab-nav .dashboard-tab-nav-link.is-active").forEach((tab) => {
    const nav = tab.parentElement;
    if (nav && nav.scrollWidth > nav.clientWidth) {
      nav.scrollLeft = tab.offsetLeft - (nav.clientWidth - tab.offsetWidth) / 2;
    }
  });
</script>
