---
import BatteryDeclineCard from "./BatteryDeclineCard.astro";
import DoorsCard from "./DoorsCard.astro";
import EnergyOverviewCard from "./EnergyOverviewCard.astro";
import AirQualityCard from "./AirQualityCard.astro";
import InsightCalloutCard from "./InsightCalloutCard.astro";
import RssiOverviewCard from "./RssiOverviewCard.astro";
import { getLocale } from "../../i18n";
import { overviewInsightsMessages } from "../../i18n/messages/app/overviewInsights";
import type {
  AirQualityOverview,
  BatteryOverviewRow,
  DoorTempSummary,
  EnergyOverview,
  RssiOverviewRow,
} from "../../lib/overviewExtras";

interface Callout {
  title: string;
  detail: string;
  tone?: string;
}

interface Props {
  doorTempSummary: DoorTempSummary | null;
  powerTempSummary: Callout | null;
  motionSummary: Callout | null;
  householdId: string | null;
  batteryOverview: BatteryOverviewRow[];
  rssiOverview: RssiOverviewRow[];
  airQualityOverview: AirQualityOverview;
  energyOverview: EnergyOverview | null;
  coolingRateFPerHour: number | null;
}

const {
  doorTempSummary,
  powerTempSummary,
  motionSummary,
  householdId,
  batteryOverview,
  rssiOverview,
  airQualityOverview,
  energyOverview,
  coolingRateFPerHour,
} = Astro.props;

const t = overviewInsightsMessages(getLocale(Astro)).extras;

function calloutTone(tone?: string): "warning" | "info" {
  return tone === "warning" ? "warning" : "info";
}
---

<details class="card">
  <summary class="dashboard-recommendations-summary">{t.summary}</summary>
  <div class="dashboard-recommendations-body space-y-4">
    <DoorsCard summary={doorTempSummary} householdId={householdId} />
    {powerTempSummary && (
      <InsightCalloutCard
        title={t.powerTitle}
        subtitle={t.powerSubtitle}
        headline={powerTempSummary.title}
        detail={powerTempSummary.detail}
        tone={calloutTone(powerTempSummary.tone)}
        href="/dashboard/devices?view=ops"
        hrefLabel={t.openDevices}
      />
    )}
    {motionSummary && (
      <InsightCalloutCard
        title={t.motionTitle}
        subtitle={t.motionSubtitle}
        headline={motionSummary.title}
        detail={motionSummary.detail}
        tone={calloutTone(motionSummary.tone)}
      />
    )}
    <BatteryDeclineCard rows={batteryOverview} />
    <RssiOverviewCard rows={rssiOverview} />
    <AirQualityCard overview={airQualityOverview} />
    {energyOverview && (
      <EnergyOverviewCard
        energy={energyOverview}
        coolingRateFPerHour={coolingRateFPerHour}
      />
    )}
  </div>
</details>
