---
import { fmt, getLocale } from "../../i18n";
import { overviewInsightsMessages } from "../../i18n/messages/app/overviewInsights";

interface Props {
  canEdit: boolean;
  unackedCount: number;
  snoozeUntil: string | null;
  spaceCheckedAt: string | null;
  householdId?: string | null;
  deviceSpaces?: string[];
  /** Inside the Overview status card: no card chrome or heading of its own. */
  embedded?: boolean;
}

const {
  canEdit,
  unackedCount,
  snoozeUntil,
  spaceCheckedAt,
  householdId = null,
  deviceSpaces = [],
  embedded = false,
} = Astro.props;
const snoozeActive =
  snoozeUntil != null && Number.isFinite(Date.parse(snoozeUntil))
    ? Date.parse(snoozeUntil) > Date.now()
    : false;
const spaces = deviceSpaces.filter(Boolean);
const t = overviewInsightsMessages(getLocale(Astro)).quickActions;
const c = t.client;
const snoozeLabel = (hours: number) =>
  hours === 1 ? c.snooze1h : hours === 4 ? c.snooze4h : c.snooze24h;
---

{canEdit && (
  <section
    class:list={[!embedded && "card", "overview-quick-actions"]}
    aria-labelledby="overview-quick-actions-title"
    data-overview-quick-actions
    data-unacked={String(unackedCount)}
    data-snooze-active={snoozeActive ? "1" : "0"}
    data-snooze-until={snoozeUntil ?? ""}
    data-qa-calm={!snoozeActive && unackedCount === 0 ? "1" : "0"}
    data-i18n={JSON.stringify(c)}
  >
    {unackedCount === 0 && !snoozeActive ? (
      <details class="overview-quick-actions-details" data-qa-details>
        <summary class="overview-quick-actions-summary" id="overview-quick-actions-title">
          {t.actions}
          <span class="text-[var(--color-text-muted)] font-normal">{t.calmSummary}</span>
        </summary>
        <div class="overview-quick-actions-body mt-3">
          <p class="alert-success mt-0 mb-3 hidden" data-qa-status role="status"></p>
          <p class="alert-warning mt-0 mb-3 hidden" data-qa-error role="alert"></p>
          <div class="overview-quick-actions-row" data-qa-row>
            <div data-qa-ack-slot class="inline-flex flex-wrap items-center gap-2">
              <a class="btn-ghost btn-sm" href="/dashboard/alerts" data-qa-alerts-clear>{c.alertsClear}</a>
            </div>
            <div data-qa-snooze-slot class="inline-flex flex-wrap items-center gap-1">
              <span class="text-sm text-[var(--color-text-muted)]">{t.snooze}</span>
              {[1, 4, 24].map((hours) => (
                <button
                  type="button"
                  class="btn-secondary btn-sm"
                  id={hours === 24 ? "overview-snooze-action" : undefined}
                  data-qa-snooze="snooze"
                  data-qa-hours={String(hours)}
                >
                  {fmt(t.hoursShort, { hours })}
                </button>
              ))}
            </div>
            <div class="inline-flex flex-wrap items-center gap-2">
              {householdId && (
                <input type="hidden" data-qa-household value={householdId} />
              )}
              {spaces.length > 0 && (
                <select class="form-input text-sm py-1" data-qa-space aria-label={t.spaceChecked}>
                  <option value="">{t.wholeProperty}</option>
                  {spaces.map((space) => (
                    <option value={space}>{space}</option>
                  ))}
                </select>
              )}
              <button type="button" class="btn-ghost btn-sm" id="overview-checked-space" data-qa-checked>
                {t.checkedSpace}
              </button>
            </div>
            <span
              class="overview-checked-status text-sm text-[var(--color-text-muted)]"
              id="overview-checked-status"
              data-checked-at={spaceCheckedAt ?? ""}
              data-overview-field="spaceCheckedAt"
              hidden={!spaceCheckedAt}
            ></span>
          </div>
        </div>
      </details>
    ) : (
      <>
        {embedded ? (
          <h3 class="sr-only" id="overview-quick-actions-title">{t.title}</h3>
        ) : (
          <div class="overview-quick-actions-head">
            <h2 class="card-title mb-0" id="overview-quick-actions-title">{t.title}</h2>
            <p class="card-subtitle mb-0">
              {t.subtitle}
            </p>
          </div>
        )}
        <p class="alert-success mt-0 mb-3 hidden" data-qa-status role="status"></p>
        <p class="alert-warning mt-0 mb-3 hidden" data-qa-error role="alert"></p>
        <div class="overview-quick-actions-row" data-qa-row>
          <div data-qa-ack-slot class="inline-flex flex-wrap items-center gap-2">
            {unackedCount > 0 ? (
              <button type="button" class="btn-secondary btn-sm" data-qa-action="ack_latest">{c.ackLatest}</button>
            ) : (
              <a class="btn-ghost btn-sm" href="/dashboard/alerts" data-qa-alerts-clear>{c.alertsClear}</a>
            )}
          </div>

          <div data-qa-snooze-slot class="inline-flex">
            {snoozeActive ? (
              <button type="button" class="btn-ghost btn-sm" id="overview-snooze-action" data-qa-snooze="clear_snooze">
                {c.clearSnooze}
              </button>
            ) : (
              <details class="qa-menu">
                <summary class="btn-ghost btn-sm">{c.snoozeMenu}</summary>
                <div class="qa-menu-pop">
                  {[1, 4, 24].map((hours) => (
                    <button
                      type="button"
                      class="btn-ghost btn-sm"
                      id={hours === 24 ? "overview-snooze-action" : undefined}
                      data-qa-snooze="snooze"
                      data-qa-hours={String(hours)}
                    >
                      {snoozeLabel(hours)}
                    </button>
                  ))}
                </div>
              </details>
            )}
          </div>

          <details class="qa-menu">
            <summary class="btn-ghost btn-sm">{t.more}</summary>
            <div class="qa-menu-pop">
              <div data-qa-ackall-slot>
                {unackedCount > 1 && (
                  <button
                    type="button"
                    class="btn-ghost btn-sm"
                    data-qa-action="ack_all"
                    data-qa-confirm={fmt(c.confirmAll, { count: unackedCount })}
                  >
                    {c.handleAll} {" "}<span data-overview-field="unackedCount">{unackedCount}</span>
                  </button>
                )}
              </div>
              {householdId && <input type="hidden" data-qa-household value={householdId} />}
              {spaces.length > 0 && (
                <select class="form-input text-sm py-1" data-qa-space aria-label={t.spaceChecked}>
                  <option value="">{t.wholeProperty}</option>
                  {spaces.map((space) => (
                    <option value={space}>{space}</option>
                  ))}
                </select>
              )}
              <button type="button" class="btn-ghost btn-sm" id="overview-checked-space" data-qa-checked>
                {t.checkedSpace}
              </button>
            </div>
          </details>
          <span
            class="overview-checked-status text-sm text-[var(--color-text-muted)]"
            id="overview-checked-status"
            data-checked-at={spaceCheckedAt ?? ""}
            data-overview-field="spaceCheckedAt"
            hidden={!spaceCheckedAt}
          ></span>
        </div>
      </>
    )}
  </section>
)}

<script>
  import { fmt, readI18n } from "../../i18n/client";
  import en from "../../i18n/messages/app/overviewInsights/en";

  const root = document.querySelector("[data-overview-quick-actions]");
  const text = readI18n(root, en.quickActions.client);
  const statusEl = root?.querySelector<HTMLElement>("[data-qa-status]");
  const errorEl = root?.querySelector<HTMLElement>("[data-qa-error]");
  const checkedStatus = document.getElementById("overview-checked-status");

  function showStatus(message: string) {
    if (statusEl) {
      statusEl.textContent = message;
      statusEl.classList.remove("hidden");
    }
    errorEl?.classList.add("hidden");
  }

  function showError(message: string) {
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }
    statusEl?.classList.add("hidden");
  }

  function renderChecked() {
    if (!checkedStatus) return;
    const raw = checkedStatus.getAttribute("data-checked-at") || "";
    if (!raw) {
      checkedStatus.hidden = true;
      checkedStatus.textContent = "";
      return;
    }
    const ts = Date.parse(raw);
    if (!Number.isFinite(ts)) {
      checkedStatus.hidden = true;
      return;
    }
    const mins = Math.max(0, Math.round((Date.now() - ts) / 60000));
    checkedStatus.hidden = false;
    checkedStatus.textContent =
      mins < 1
        ? text.checkedJustNow
        : mins < 60
          ? fmt(text.checkedMinutesAgo, { count: mins })
          : fmt(text.checkedHoursAgo, { count: Math.round(mins / 60) });
  }

  async function postJson(url: string, body: Record<string, unknown>) {
    const res = await fetch(url, {
      method: "POST",
      credentials: "same-origin",
      headers: {
        Accept: "application/json",
        "Content-Type": "application/json",
      },
      body: JSON.stringify(body),
    });
    const data = (await res.json().catch(() => ({}))) as {
      ok?: boolean;
      error?: string;
      message?: string;
      checked_at?: string;
      count?: number;
    };
    if (!res.ok) {
      throw new Error(data.error || text.requestFailed);
    }
    return data;
  }

  async function handleQuickAction(btn: HTMLButtonElement) {
    const ack = btn.getAttribute("data-qa-action");
    const snooze = btn.getAttribute("data-qa-snooze");
    const checked = btn.hasAttribute("data-qa-checked");
    if (!ack && !snooze && !checked) return;

    if (ack === "ack_all") {
      const confirmMsg = btn.getAttribute("data-qa-confirm");
      if (confirmMsg && !window.confirm(confirmMsg)) return;
    }

    btn.disabled = true;
    try {
      if (ack) {
        const data = await postJson("/api/user/alert-events/ack", { action: ack });
        showStatus(data.message ?? (ack === "ack_all" ? text.alertsHandled : text.alertAcknowledged));
        window.dispatchEvent(new CustomEvent("overview:soft-refresh"));
      } else if (snooze) {
        const hours = Number(btn.getAttribute("data-qa-hours") || "24");
        const data = await postJson("/api/user/alert-snooze", {
          action: snooze,
          hours,
        });
        showStatus(data.message ?? text.snoozeUpdated);
        window.dispatchEvent(new CustomEvent("overview:soft-refresh"));
      } else if (checked) {
        const household =
          root?.querySelector<HTMLInputElement>("[data-qa-household]")?.value ?? "";
        const space =
          (root?.querySelector("[data-qa-space]") as HTMLSelectElement | null)?.value ?? "";
        const data = await postJson("/api/user/space-checked", {
          household_id: household || undefined,
          space: space || undefined,
        });
        if (data.checked_at) {
          checkedStatus?.setAttribute("data-checked-at", data.checked_at);
          renderChecked();
        }
        showStatus(text.markedChecked);
      }
    } catch (error) {
      showError(error instanceof Error ? error.message : text.actionFailed);
    } finally {
      btn.disabled = false;
    }
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    // Close any open menu unless the click was inside it (the space picker needs to stay open).
    document.querySelectorAll<HTMLDetailsElement>("details.qa-menu[open]").forEach((menu) => {
      if (!menu.contains(target) || target.closest("button")) menu.open = false;
    });
    const btn = target.closest("button[data-qa-action], button[data-qa-snooze], button[data-qa-checked]");
    if (!(btn instanceof HTMLButtonElement) || btn.disabled) return;
    void handleQuickAction(btn);
  });

  renderChecked();
</script>

<style>
  .overview-quick-actions-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .overview-quick-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .overview-quick-actions-summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  .overview-quick-actions-summary::-webkit-details-marker {
    display: none;
  }

</style>

<style is:global>
  /* Global: the Overview soft refresh rebuilds these menus from HTML strings. */
  /* Small dropdowns so the status card shows one primary action, not six. */
  .qa-menu {
    position: relative;
  }
  .qa-menu > summary {
    list-style: none;
    cursor: pointer;
  }
  .qa-menu > summary::-webkit-details-marker {
    display: none;
  }
  .qa-menu-pop {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.25rem);
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    min-width: 11rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface, #0f1f2c);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .qa-menu-pop > button,
  .qa-menu-pop [data-qa-ackall-slot] > button {
    justify-content: flex-start;
    text-align: left;
    white-space: nowrap;
    width: 100%;
  }
</style>
