---
import { getLocale } from "../../i18n";
import { overviewNudgesMessages } from "../../i18n/messages/app/overview/nudges";

interface Props {
  show?: boolean;
  canEdit?: boolean;
}

const { show = true, canEdit = true } = Astro.props;

if (!show || !canEdit) {
  return null;
}
const t = overviewNudgesMessages(getLocale(Astro));
const tt = t.testAlert;
---
<aside class="card alert-setup-nudge" data-nudge-key="test_alert_nudge" role="note">
  <div class="alert-setup-nudge-body">
    <p class="alert-setup-nudge-title">{tt.title}</p>
    <p class="alert-setup-nudge-text">
      {tt.body}
    </p>
  </div>
  <div class="alert-setup-nudge-actions">
    <a class="btn-primary" href="/dashboard/alerts?tab=settings#send-test-alert">{tt.send}</a>
    <a class="btn-secondary" href="/dashboard/alerts?tab=settings">{t.openAlerts}</a>
    <button type="button" class="btn-ghost" data-dismiss="test_alert_nudge">
      {t.dismiss}
    </button>
  </div>
</aside>
