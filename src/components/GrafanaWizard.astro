---
import DashboardCard from "./dashboard/DashboardCard.astro";
import { fmt, getLocale } from "../i18n";
import { shareMessages } from "../i18n/messages/app/share";

interface Props {
  siteUrl: string;
  apiKeyPrefix?: string | null;
  /** Fresh API key from create flow: used only for a local scrape snippet. */
  apiKey?: string | null;
}

const { siteUrl, apiKeyPrefix = null, apiKey = null } = Astro.props;
const t = shareMessages(getLocale(Astro)).grafana;
const metricsUrl = `${siteUrl}/api/v1/metrics`;
const dashboardJsonUrl = `${siteUrl}/grafana/probeharbor-dashboard.json`;
const host = siteUrl.replace(/^https?:\/\//, "");
const scrapeSnippet = `# prometheus.yml
scrape_configs:
  - job_name: probeharbor
    metrics_path: /api/v1/metrics
    scheme: ${siteUrl.startsWith("https") ? "https" : "http"}
    static_configs:
      - targets: ["${host}"]
    authorization:
      type: Bearer
      credentials: ${apiKey ?? "<your-api-key>"}`;
---
<DashboardCard>
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-4" set:html={t.introHtml} />
  <ol class="text-sm space-y-3 mb-4 list-decimal pl-5">
    <li>
      {fmt(t.step1, { prefix: apiKeyPrefix ? `${apiKeyPrefix}…` : t.prefixPending })}
    </li>
    <li>
      {t.step2Lead}
      <code class="text-xs break-all">{metricsUrl}</code>
      <Fragment set:html={t.step2TailHtml} />
    </li>
    <li>
      {t.step3Lead}
      <a class="text-link" href="/grafana/probeharbor-dashboard.json" download>
        probeharbor-dashboard.json
      </a>
      {t.step3Tail}
    </li>
    <li>
      {t.step4}
    </li>
  </ol>
  <div class="mb-4">
    <p class="form-label mb-1">{t.snippetLabel}</p>
    <pre class="text-xs overflow-x-auto mb-0"><code>{scrapeSnippet}</code></pre>
  </div>
  <p class="mb-0 text-sm text-[var(--color-text-muted)]">
    {t.jsonUrlLabel}
    <code class="text-xs break-all">{dashboardJsonUrl}</code>
  </p>
</DashboardCard>
