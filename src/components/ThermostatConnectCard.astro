---
import { THERMOSTAT_CARD_PATH } from "../lib/thermostatReturn";
import DashboardCard from "./dashboard/DashboardCard.astro";
import UpgradeNudge from "./UpgradeNudge.astro";
import type { PlanTier } from "../lib/entitlements";
import type { ThermostatProvider } from "../lib/thermostatConnections";
import type { ThermostatSnapshot, ThermostatFetchError } from "../lib/thermostatCorrelation";
import { fmt, getLocale } from "../i18n";
import { deviceSetupThermostatMessages } from "../i18n/messages/app/deviceSetup/thermostat";

interface Props {
  entitled: boolean;
  tier: PlanTier;
  canManage: boolean;
  /** Providers with OAuth env vars set on this deployment. */
  availableProviders: ThermostatProvider[];
  connections: Array<{
    provider: ThermostatProvider;
    snapshot: ThermostatSnapshot | null;
    fetchError?: ThermostatFetchError;
    fetchHint?: string;
  }>;
}

const { entitled, tier, canManage, availableProviders, connections } = Astro.props;
const t = deviceSetupThermostatMessages(getLocale(Astro)).thermostat;
const KNOWN_ERRORS = ["state_mismatch", "denied", "not_configured", "exchange_failed", "save_failed"] as const;
type KnownError = (typeof KNOWN_ERRORS)[number];
const isKnownError = (code: string): code is KnownError => (KNOWN_ERRORS as readonly string[]).includes(code);

const PROVIDER_LABEL: Record<ThermostatProvider, string> = {
  nest: "Nest",
  ecobee: "Ecobee",
};

const ALL_PROVIDERS: ThermostatProvider[] = ["ecobee", "nest"];

/** Show configured providers, plus any already-connected ones (so disconnect stays available). */
const visibleProviders = ALL_PROVIDERS.filter(
  (provider) =>
    availableProviders.includes(provider) ||
    connections.some((c) => c.provider === provider),
);

const connectedThermostat = entitled
  ? Astro.url.searchParams.get("thermostat_connected")
  : null;
const disconnectedThermostat = entitled
  ? Astro.url.searchParams.get("thermostat_disconnected")
  : null;
const thermostatError = entitled ? Astro.url.searchParams.get("thermostat_error") : null;

function connectionFor(provider: ThermostatProvider) {
  return connections.find((c) => c.provider === provider) ?? null;
}

function formatMode(mode: string | null): string | null {
  if (!mode) return null;
  return t.modes[mode.toLowerCase()] ?? mode.charAt(0).toUpperCase() + mode.slice(1).toLowerCase();
}

const showCard = entitled
  ? visibleProviders.length > 0
  : availableProviders.length > 0;
---
{showCard && (
  entitled ? (
    <DashboardCard id="thermostat-integration">
      <h2 class="card-title">{t.title}</h2>
      <p class="card-subtitle mb-4">{t.intro}</p>
      {connectedThermostat && (
        <p class="alert-success text-sm mb-4" role="status">
          {fmt(t.connected, { provider: PROVIDER_LABEL[connectedThermostat as ThermostatProvider] ?? connectedThermostat })}
        </p>
      )}
      {disconnectedThermostat && (
        <p class="text-sm text-[var(--color-text-muted)] mb-4" role="status">
          {fmt(t.disconnected, {
            provider: PROVIDER_LABEL[disconnectedThermostat as ThermostatProvider] ?? disconnectedThermostat,
          })}
        </p>
      )}
      {thermostatError && (
        <p class="alert-warning text-sm mb-4" role="alert">
          {isKnownError(thermostatError) && t.errors[thermostatError]}
          {thermostatError === "sdm_api_disabled" && (
            <>
              <Fragment set:html={t.sdmDisabledHtml} />{" "}
              <a
                class="text-link"
                href="https://console.cloud.google.com/apis/library/smartdevicemanagement.googleapis.com"
                target="_blank"
                rel="noreferrer"
              >{t.enableSdm}</a>
            </>
          )}
          {!isKnownError(thermostatError) && thermostatError !== "sdm_api_disabled" && t.errors.generic}
        </p>
      )}
      <div class="space-y-4">
        {visibleProviders.map((provider) => {
          const connection = connectionFor(provider);
          const snapshot = connection?.snapshot ?? null;
          const fetchHint = connection?.fetchHint;
          const canConnect = availableProviders.includes(provider);
          return (
            <div class="flex items-center justify-between gap-4 rounded-lg border border-[var(--color-border)] p-3">
              <div>
                <p class="mb-0 font-medium">{PROVIDER_LABEL[provider]}</p>
                {connection ? (
                  snapshot ? (
                    <p class="mb-0 text-sm text-[var(--color-text-muted)]">
                      {snapshot.ambientTempF != null
                        ? `${snapshot.ambientTempF.toFixed(0)}°F`
                        : t.readingUnavailable}
                      {snapshot.heatSetpointF != null && fmt(t.setTo, { temp: `${snapshot.heatSetpointF.toFixed(0)}°F` })}
                      {formatMode(snapshot.hvacMode) && `, ${formatMode(snapshot.hvacMode)}`}
                    </p>
                  ) : (
                    <p class="mb-0 text-sm text-[var(--color-text-muted)]">
                      {fetchHint ?? t.noLiveReading}
                    </p>
                  )
                ) : (
                  <p class="mb-0 text-sm text-[var(--color-text-muted)]">{t.notConnected}</p>
                )}
                {provider === "ecobee" && !canConnect && !connection && (
                  <p class="mb-0 mt-2 text-xs text-[var(--color-text-muted)]" set:html={t.ecobeeClosedHtml} />
                )}
              </div>
              {canManage ? (
                connection ? (
                  <form action={`/api/integrations/${provider}/disconnect`} method="post">
                    <input type="hidden" name="redirect" value={THERMOSTAT_CARD_PATH} />
                    <button type="submit" class="btn-secondary">{t.disconnect}</button>
                  </form>
                ) : canConnect ? (
                  <a class="btn-secondary" href={`/api/integrations/${provider}/connect`}>{t.connect}</a>
                ) : (
                  <span class="text-xs text-[var(--color-text-muted)]">{t.unavailable}</span>
                )
              ) : (
                connection ? null : (
                  <span class="text-xs text-[var(--color-text-muted)]">{t.ownerOnly}</span>
                )
              )}
            </div>
          );
        })}
      </div>
    </DashboardCard>
  ) : (
    <UpgradeNudge feature="thermostat_integration" tier={tier} />
  )
)}
