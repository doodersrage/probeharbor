---
import DashboardCard from "./dashboard/DashboardCard.astro";
import type { TimeToFreezeProjection } from "../lib/spaceThermalModel";
import type { FreezeEstimateChange } from "../lib/freezeEstimateChange";
import { fmt, formatNumber, getLocale } from "../i18n";
import { overviewCardsMessages } from "../i18n/messages/app/overviewCards";
import { localizePath } from "../i18n/locales";

interface Props {
  projection: TimeToFreezeProjection;
  /** How the estimate moved since an hour or more ago, if it moved meaningfully. */
  change?: FreezeEstimateChange | null;
  freezeThresholdF: number;
  useCelsius?: boolean;
}

const { projection, change = null, freezeThresholdF, useCelsius = false } = Astro.props;
const locale = getLocale(Astro);
const t = overviewCardsMessages(locale).timeToFreezeCard;
const fixed = (value: number, digits: number) =>
  formatNumber(value, locale, { minimumFractionDigits: digits, maximumFractionDigits: digits, useGrouping: false });
const thresholdLabel = useCelsius
  ? `${fixed(((freezeThresholdF - 32) * 5) / 9, 0)}°C`
  : `${locale === "en" ? String(freezeThresholdF) : formatNumber(freezeThresholdF, locale)}°F`;
const subtitle = fmt(t.subtitle[projection.source] ?? t.subtitle.none, { threshold: thresholdLabel });
const confidenceLabel = t.confidence[projection.confidence] ?? t.confidence.low;
const clock =
  projection.hours === 0
    ? fmt(t.atNow, { threshold: thresholdLabel })
    : projection.hitsAtLabel
      ? fmt(t.hitsAround, { threshold: thresholdLabel, time: projection.hitsAtLabel })
      : null;
const freezeWindow = projection.window ?? null;
const windowLine = !freezeWindow
  ? null
  : projection.hours != null
    ? freezeWindow.latestLabel
      ? fmt(t.window, { from: freezeWindow.earliestLabel, to: freezeWindow.latestLabel })
      : fmt(t.windowEarliest, { from: freezeWindow.earliestLabel })
    : null;
const reasons = projection.reasons ?? [];
---
<DashboardCard id="time-to-freeze">
  <h2 class="card-title">{t.title}</h2>
  <p class="card-subtitle mb-3">
    {subtitle}
  </p>
  {clock ? (
    <p class="time-to-freeze-clock mb-2">{clock}</p>
  ) : null}
  {windowLine ? <p class="mb-2 text-sm font-medium">{windowLine}</p> : null}
  <p class="mb-0 text-sm">{projection.message}</p>
  {change ? (
    <div class="time-to-freeze-change mt-2 text-sm" role="note">
      <p class="m-0 font-medium">{change.headline}</p>
      <ul class="m-0 mt-1 pl-5 list-disc text-[var(--color-text-muted)]">
        {change.reasons.map((reason) => <li>{reason}</li>)}
      </ul>
    </div>
  ) : null}
  <details class="mt-2 text-sm">
    <summary class="cursor-pointer text-link">{t.basedOn}</summary>
    {reasons.length > 0 ? (
      <ul class="mt-1 mb-0 list-disc pl-5 text-[var(--color-text-muted)]">
        {reasons.map((reason) => <li>{reason}</li>)}
      </ul>
    ) : null}
    <p class="mt-1 mb-0 text-xs text-[var(--color-text-muted)]">
      {t.estimateNote}
    </p>
    <p class="mt-1 mb-0 text-xs text-[var(--color-text-muted)]">{t.confidenceHelp}</p>
    <p class="mt-1 mb-0 text-xs">
      <a class="text-link" href={localizePath("/about/time-to-freeze", locale)}>{t.learnMore}</a>
    </p>
  </details>
  <p class="mt-2 mb-0 text-xs text-[var(--color-text-muted)]">
    {confidenceLabel}
    {projection.rateFPerHour != null && projection.rateFPerHour < -0.05
      ? ` · ${fmt(t.cooling, { rate: fixed(Math.abs(projection.rateFPerHour), 1) })}`
      : ""}
    {projection.params
      ? ` · ${fmt(t.offset, { offset: `${projection.params.offsetF >= 0 ? "+" : ""}${fixed(projection.params.offsetF, 0)}` })}`
      : ""}
  </p>
</DashboardCard>

<style>
  .time-to-freeze-change {
    border-left: 2px solid var(--color-accent);
    padding-left: 0.6rem;
  }
  .time-to-freeze-clock {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
</style>
