---
import { getLocale } from "../i18n";
import { shellMessages } from "../i18n/messages/app/shell";

const t = shellMessages(getLocale(Astro)).pwa;
---
<section
  class="card home-guides home-pwa"
  id="use-on-phone"
  aria-labelledby="pwa-title"
  data-i18n={JSON.stringify(t.client)}
>
  <div class="home-guides-copy">
    <p class="text-sm text-[var(--color-text-muted)] mb-1">{t.eyebrow}</p>
    <h2 class="card-title" id="pwa-title">{t.title}</h2>
    <p class="card-subtitle mb-3">
      {t.body}
    </p>
    <ol class="home-pwa-steps">
      <li>{t.step1}</li>
      <li set:html={t.step2Html} />
      <li>{t.step3}</li>
    </ol>
    <p class="home-pwa-status mb-0 mt-3 text-sm text-[var(--color-text-muted)]" id="home-pwa-status"></p>
  </div>
  <div class="home-guides-actions">
    <button type="button" class="btn-primary" id="home-pwa-install-btn" hidden>
      {t.installApp}
    </button>
    <a class="btn-primary" id="home-pwa-guide" href="/about/install-pwa">{t.guide}</a>
    <a class="btn-secondary" href="/android">{t.android}</a>
  </div>
</section>

<script is:inline>
  (() => {
    const btn = document.getElementById("home-pwa-install-btn");
    const guide = document.getElementById("home-pwa-guide");
    const status = document.getElementById("home-pwa-status");
    let deferredPrompt = null;
    let text = {
      installStarted: "Install started.",
      installDismissed: "Install dismissed: the step-by-step guide still works.",
      installed: "App installed.",
    };
    try {
      const raw = document.getElementById("use-on-phone")?.dataset.i18n;
      if (raw) text = { ...text, ...JSON.parse(raw) };
    } catch {}

    window.addEventListener("beforeinstallprompt", (event) => {
      event.preventDefault();
      deferredPrompt = event;
      if (btn) btn.hidden = false;
      if (guide) guide.className = "btn-secondary";
    });

    btn?.addEventListener("click", async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const choice = await deferredPrompt.userChoice;
      if (status) {
        status.textContent =
          choice.outcome === "accepted"
            ? text.installStarted
            : text.installDismissed;
      }
      deferredPrompt = null;
      if (btn) btn.hidden = true;
    });

    window.addEventListener("appinstalled", () => {
      if (status) status.textContent = text.installed;
      if (btn) btn.hidden = true;
    });
  })();
</script>
