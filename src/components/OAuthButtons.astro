---
import { getLocale } from "../i18n";
import { authSigninMessages } from "../i18n/messages/app/auth/signin";

interface Props {
  action?: string;
  next?: string;
  ref?: string;
  /** When true, OAuth is the primary path and email comes after. */
  primary?: boolean;
}

const {
  action = "/api/auth/signin",
  next = "",
  ref = "",
  primary = false,
} = Astro.props;
const safeNext = next.startsWith("/") && !next.startsWith("//") ? next : "";
const safeRef = ref.trim().toLowerCase();

const t = authSigninMessages(getLocale(Astro)).oauth;
const providers = [
  { id: "google", label: t.google },
  { id: "github", label: t.github },
  { id: "discord", label: t.discord },
];
---

<div class:list={["oauth-buttons", primary && "oauth-buttons--primary"]}>
  {!primary && (
    <p class="oauth-divider"><span>{t.orContinueWith}</span></p>
  )}
  <div class="flex flex-col gap-2">
    {providers.map(({ id, label }) => (
      <form action={action} method="post">
        <input type="hidden" name="provider" value={id} />
        {safeNext && <input type="hidden" name="next" value={safeNext} />}
        {safeRef && <input type="hidden" name="ref" value={safeRef} />}
        <button
          class:list={[primary ? "btn-primary" : "btn-secondary", "w-full"]}
          type="submit"
        >
          {label}
        </button>
      </form>
    ))}
  </div>
  {primary && (
    <p class="oauth-divider"><span>{t.orUseEmail}</span></p>
  )}
</div>

<style>
  .oauth-buttons:not(.oauth-buttons--primary) {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .oauth-buttons--primary {
    margin-bottom: 1.25rem;
    padding-bottom: 0.25rem;
  }

  .oauth-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .oauth-buttons--primary .oauth-divider {
    margin: 1rem 0 0.75rem;
  }

  .oauth-divider::before,
  .oauth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .oauth-divider span {
    white-space: nowrap;
  }
</style>
