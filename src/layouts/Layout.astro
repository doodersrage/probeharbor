---
import { Image, Font } from 'astro:assets';
import '../styles/global.css'
const currentYear = new Date().getFullYear();
import logo from '../assets/gtm.svg';
import logoLight from '../assets/gtm-light.svg';
import { getAuthFromCookies } from "../lib/auth";
import { resolveTheme } from "../lib/userPreferences";
import SchemaMarkup from "../components/SchemaMarkup.astro";
import {
  getDefaultDescription,
  getSiteSchemas,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { BRAND_NAME } from "../lib/brand";
import BrandMark from "../components/BrandMark.astro";
import RenameNotice from "../components/RenameNotice.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import AhrefsAnalytics from "../components/AhrefsAnalytics.astro";
import AnalyticsDisclosure from "../components/AnalyticsDisclosure.astro";
import { shouldLoadGoogleAnalytics } from "../lib/analytics";
import {
  absoluteOgImageUrl,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_TYPE,
  OG_IMAGE_WIDTH,
  resolveOgImagePath,
} from "../lib/ogMeta";
import { getLocale, LOCALE_META, LOCALES, localizePath } from "../i18n";
import { getAlternatePaths, isLocalizablePath } from "../i18n/routes";
import { layoutMessages } from "../i18n/messages/layout";
import { brandMessages } from "../i18n/messages/brand";
import { resolveLocalizedOgImageAlt } from "../i18n/messages/ogAlt";

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Absolute URL or site-relative path; defaults from pathname. */
  ogImage?: string;
  /** Override auto alt text for the share image. */
  ogImageAlt?: string;
  skipAuth?: boolean;
  /**
   * true emits noindex,nofollow (error pages, private-ish surfaces); "follow"
   * keeps a page out of the index while still letting crawlers follow its links.
   */
  noindex?: boolean | "follow";
  /** Optional Referrer-Policy meta (e.g. no-referrer for token handoff pages). */
  referrerPolicy?: string;
  /** Include SoftwareApplication JSON-LD (home / product pages). */
  softwareApplication?: boolean;
  /** CSS selectors for SpeakableSpecification on the WebPage schema. */
  speakableSelectors?: string[];
  /** Open Graph type — article for stories/guides. */
  ogType?: "website" | "article";
  /** Article OG fields (ISO dates / section). */
  ogPublishedTime?: string;
  ogModifiedTime?: string;
  ogSection?: string;
}

const {
  title,
  description,
  schema,
  ogImage,
  ogImageAlt,
  skipAuth = false,
  noindex = false,
  referrerPolicy,
  softwareApplication = false,
  speakableSelectors,
  ogType = "website",
  ogPublishedTime,
  ogModifiedTime,
  ogSection,
} = Astro.props;
// Search results cut titles around 60 characters. Long question-style titles
// keep their wording and drop the brand suffix instead of losing the end.
const MAX_TITLE_WITH_BRAND = 62;
const brandedTitle = title ? `${title} · ${BRAND_NAME}` : BRAND_NAME;
const pageTitle = title && brandedTitle.length > MAX_TITLE_WITH_BRAND ? title : brandedTitle;
const locale = getLocale(Astro);
const localeMeta = LOCALE_META[locale];
const t = layoutMessages(locale);
const brand = brandMessages(locale);
const metaDescription =
  description ?? (locale === "en" ? getDefaultDescription() : brand.description);
const siteUrl = resolveSiteUrl(Astro.site);
// Middleware strips the locale prefix, so this is always the English path.
const currentPath = Astro.url.pathname;
const pageUrl = resolvePageUrl(siteUrl, localizePath(currentPath, locale));
const alternates = getAlternatePaths(currentPath);
const languageLinks = isLocalizablePath(currentPath)
  ? LOCALES.map((l) => ({ locale: l, href: localizePath(currentPath, l), label: LOCALE_META[l].label }))
  : LOCALES.map((l) => ({ locale: l, href: localizePath("/", l), label: LOCALE_META[l].label }));
const resolvedOgPath = ogImage ?? resolveOgImagePath(currentPath);
const ogImageUrl = absoluteOgImageUrl(siteUrl, resolvedOgPath);
const resolvedOgAlt = ogImageAlt ?? resolveLocalizedOgImageAlt(currentPath, locale);

const { user } = skipAuth
  ? { user: null }
  : await getAuthFromCookies(Astro.cookies);

const themeCookie = Astro.cookies.get("theme")?.value;
const userTheme = (user?.user_metadata as Record<string, unknown> | undefined)?.theme;
const themePref =
  themeCookie === "light" || themeCookie === "system" || themeCookie === "dark"
    ? themeCookie
    : userTheme === "light" || userTheme === "system"
      ? userTheme
      : "dark";
const resolvedTheme = resolveTheme(themePref);

const extraSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const schemas = getSiteSchemas({
  siteUrl,
  pageUrl,
  pageName: pageTitle,
  pageDescription: metaDescription,
  extraSchemas,
  includeSoftwareApplication: softwareApplication,
  speakableCssSelectors: speakableSelectors,
  inLanguage: localeMeta.intl,
});

const navItems = [
  { href: "/pricing", label: t.nav.pricing, match: (path: string) => path.startsWith("/pricing") },
  { href: "/compare", label: t.nav.compare, match: (path: string) => path.startsWith("/compare") },
  {
    href: "/property-management",
    label: t.nav.landlords,
    match: (path: string) => path.startsWith("/property-management"),
  },
  {
    href: "/guides",
    label: t.nav.guides,
    match: (path: string) =>
      path === "/guides" || path.startsWith("/guides/") || path === "/about" || path.startsWith("/about/"),
  },
  { href: "/contact", label: t.nav.contact, match: (path: string) => path.startsWith("/contact") },
];
const isDashboard = currentPath.startsWith("/dashboard");
const loadAnalytics = shouldLoadGoogleAnalytics(currentPath, {
  search: Astro.url.searchParams,
});
const loadTurnstile =
  currentPath.startsWith("/contact") ||
  currentPath.startsWith("/signin") ||
  currentPath.startsWith("/register") ||
  currentPath.startsWith("/forgot-password") ||
  currentPath.startsWith("/pipe-freeze-forecast");
const registerServiceWorker =
  currentPath.startsWith("/dashboard") || currentPath.startsWith("/signin");
---
<!doctype html>
<html lang={localeMeta.htmlLang} data-theme={resolvedTheme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={metaDescription} />
		{noindex && <meta name="robots" content={noindex === "follow" ? "noindex, follow" : "noindex, nofollow"} />}
		{referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content={resolvedTheme === "light" ? "#f3f8fb" : "#07111a"} />
		<link rel="canonical" href={pageUrl} />
		{!noindex && alternates.map((alt) => (
			<link rel="alternate" hreflang={LOCALE_META[alt.locale].hreflang} href={resolvePageUrl(siteUrl, alt.path)} />
		))}
		{!noindex && alternates.length > 0 && (
			<link rel="alternate" hreflang="x-default" href={resolvePageUrl(siteUrl, currentPath)} />
		)}
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
		<title>{pageTitle}</title>
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={BRAND_NAME} />
		<meta property="og:locale" content={localeMeta.ogLocale} />
		{alternates.filter((alt) => alt.locale !== locale).map((alt) => (
			<meta property="og:locale:alternate" content={LOCALE_META[alt.locale].ogLocale} />
		))}
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content={OG_IMAGE_TYPE} />
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
		<meta property="og:image:alt" content={resolvedOgAlt} />
		{ogType === "article" && ogPublishedTime && (
			<meta property="article:published_time" content={ogPublishedTime} />
		)}
		{ogType === "article" && ogModifiedTime && (
			<meta property="article:modified_time" content={ogModifiedTime} />
		)}
		{ogType === "article" && ogSection && (
			<meta property="article:section" content={ogSection} />
		)}
		{ogType === "article" && (
			<meta property="article:author" content={BRAND_NAME} />
		)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={resolvedOgAlt} />
		<meta name="twitter:url" content={pageUrl} />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
		<SchemaMarkup schemas={schemas} />
		{loadAnalytics && (
			<>
				<GoogleAnalytics
					pageTitle={pageTitle}
					pageUrl={pageUrl}
					hostname={Astro.url.hostname}
				/>
				<AhrefsAnalytics />
			</>
		)}
	</head>
	<body class:list={[isDashboard && "is-dashboard"]}>
		<a class="skip-link" href="#main-content">{t.skipToContent}</a>
		{!Astro.url.pathname.startsWith("/embed/") && <RenameNotice />}
		<div class="flex min-h-screen flex-col">
			{!isDashboard && (
			<header class="site-header">
				<div class="site-header-inner">
					<a href="/" class="site-logo-link">
						<Image src={logo} height={44} width={223} alt="ProbeHarbor" class="site-logo logo-on-dark" />
						<Image src={logoLight} height={44} width={223} alt="ProbeHarbor" class="site-logo logo-on-light" />
					</a>
					<button
						type="button"
						class="site-nav-toggle btn-ghost lg:hidden"
						aria-expanded="false"
						aria-controls="site-nav"
						id="site-nav-toggle"
					>
						{t.menu}
					</button>
					<nav id="site-nav" class="site-nav" aria-label="Main">
						<div class="site-nav-primary">
							{navItems.map(({ href, label, match }) => (
								<a
									href={href}
									class:list={["nav-link", match(currentPath) && "nav-link-active"]}
								>
									{label}
								</a>
							))}
						</div>
						<div class="site-nav-actions">
							{user ? (
								<>
									<a
										href="/dashboard"
										class:list={[
											"nav-link",
											(currentPath === "/dashboard" ||
												currentPath.startsWith("/dashboard/")) &&
												"nav-link-active",
										]}
									>
										{t.nav.dashboard}
									</a>
									<a href="/api/auth/signout" class="nav-link">{t.nav.signOut}</a>
								</>
							) : (
								<>
									<a
										href="/signin"
										class:list={[
											"nav-link",
											currentPath === "/signin" && "nav-link-active",
										]}
									>
										{t.nav.signIn}
									</a>
									<a href="/register?next=/dashboard/devices" class="nav-cta">{t.nav.startFree}</a>
								</>
							)}
						</div>
					</nav>
				</div>
			</header>
			)}
			<main id="main-content" class="flex-grow">
				<slot />
			</main>
			{!isDashboard && (
				<footer class="site-footer">
					<div class="site-footer-inner">
						<div class="site-footer-grid">
							<div>
								<p class="site-footer-brand"><BrandMark mark /></p>
								<p class="site-footer-copy">
									{brand.tagline} {t.footer.blurb}
								</p>
								<p class="site-footer-copy site-footer-hosting">
									{t.footer.hosting}
									{" "}
									<a href="/system-status">{t.footer.systemStatus}</a>
								</p>
							</div>
							<div>
								<p class="site-footer-heading">{t.footer.product}</p>
								<ul class="site-footer-links">
									<li><a href="/pricing">{t.footer.links.pricing}</a></li>
									<li><a href="/compare">{t.footer.links.compare}</a></li>
									<li><a href="/demo">{t.footer.links.demo}</a></li>
									<li><a href="/claims-pack">{t.footer.links.claimsPack}</a></li>
									<li><a href="/property-management">{t.footer.links.propertyManagement}</a></li>
									<li><a href="/apps">{t.footer.links.apps}</a></li>
									<li><a href="/accessories">{t.footer.links.accessories}</a></li>
									<li><a href="/integrations">{t.footer.links.integrations}</a></li>
								</ul>
							</div>
							<div>
								<p class="site-footer-heading">{t.footer.learn}</p>
								<ul class="site-footer-links">
									<li><a href="/guides">{t.footer.links.guides}</a></li>
									<li><a href="/about">{t.footer.links.allArticles}</a></li>
									<li><a href="/freeze-season">{t.footer.links.freezeSeason}</a></li>
									<li><a href="/freeze-map">{t.footer.links.freezeMap}</a></li>
									<li><a href="/docs/api">{t.footer.links.httpApi}</a></li>
									<li><a href="/answers">{t.footer.links.answers}</a></li>
									<li><a href="/pipe-freeze-forecast">{t.footer.links.freezeForecast}</a></li>
									<li><a href="/freeze-time-calculator">{t.footer.links.freezeCalculator}</a></li>
									<li><a href="/stories">{t.footer.links.scenarios}</a></li>
									<li><a href="/about/probe-demo">{t.footer.links.probeDemo}</a></li>
									<li><a href="/share-kit">{t.footer.links.shareKit}</a></li>
									<li>
										<a
											href="https://github.com/doodersrage/probeharbor"
											target="_blank"
											rel="noreferrer"
										>GitHub</a>
									</li>
									<li>
										<a
											href="https://probeharbor.dev/developers/"
											target="_blank"
											rel="noreferrer"
										>{t.footer.links.extendedDocs}</a>
									</li>
								</ul>
							</div>
							<div>
								<p class="site-footer-heading">{t.footer.account}</p>
								<ul class="site-footer-links">
									{user ? (
										<>
											<li><a href="/dashboard">{t.footer.links.dashboard}</a></li>
											<li><a href="/dashboard/settings">{t.footer.links.settings}</a></li>
											<li><a href="/api/auth/signout">{t.footer.links.signOut}</a></li>
										</>
									) : (
										<>
											<li><a href="/signin">{t.footer.links.signIn}</a></li>
											<li><a href="/register?next=/dashboard/devices">{t.footer.links.createAccount}</a></li>
										</>
									)}
									<li><a href="/contact">{t.footer.links.contact}</a></li>
									<li><a href="/privacy">{t.footer.links.privacy}</a></li>
									<li><a href="/terms">{t.footer.links.terms}</a></li>
								</ul>
							</div>
						</div>
						<nav class="site-footer-languages" aria-label={t.footer.language}>
							<span class="site-footer-heading">{t.footer.language}</span>
							<ul>
								{languageLinks.map((link) => (
									<li>
										<a
											href={link.href}
											hreflang={LOCALE_META[link.locale].hreflang}
											lang={LOCALE_META[link.locale].htmlLang}
											data-locale-switch
											aria-current={link.locale === locale ? "true" : undefined}
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
							{locale !== "en" && <p class="site-footer-copy">{t.footer.englishOnlyNote}</p>}
						</nav>
						<p class="site-footer-legal">
							{t.footer.copyright(currentYear)}
							{" · "}
							<a href="/privacy">{t.footer.links.privacy}</a>
							{" · "}
							<a href="/terms">{t.footer.links.terms}</a>
						</p>
					</div>
				</footer>
			)}
		</div>
		{loadTurnstile && (
			<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
		)}
		<AnalyticsDisclosure show={loadAnalytics} />
		<script src="/nudge-dismiss.js" defer is:inline />
		<script is:inline define:vars={{ registerServiceWorker, uiText: { menu: t.menu, close: t.close, copy: t.copy, copied: t.copied, copyFailed: t.copyFailed } }}>
			(() => {
				const toggle = document.getElementById("site-nav-toggle");
				const nav = document.getElementById("site-nav");
				if (!toggle || !nav) return;

				const setOpen = (open) => {
					nav.classList.toggle("site-nav-open", open);
					toggle.setAttribute("aria-expanded", open ? "true" : "false");
					toggle.textContent = open ? uiText.close : uiText.menu;
				};

				toggle.addEventListener("click", (event) => {
					event.stopPropagation();
					setOpen(!nav.classList.contains("site-nav-open"));
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape") setOpen(false);
				});

				document.addEventListener("click", (event) => {
					const target = event.target;
					if (!(target instanceof Node)) return;
					if (!nav.contains(target) && !toggle.contains(target)) {
						setOpen(false);
					}
				});

				nav.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => setOpen(false));
				});
			})();

			document.addEventListener("click", async (event) => {
				const target = event.target;
				if (!(target instanceof HTMLElement)) return;
				const btn = target.closest("[data-copy]");
				if (!(btn instanceof HTMLElement)) return;
				const text = btn.getAttribute("data-copy");
				if (!text) return;
				const label = btn.getAttribute("data-copy-label") || uiText.copy;
				try {
					await navigator.clipboard.writeText(text);
					btn.textContent = uiText.copied;
					setTimeout(() => {
						btn.textContent = label;
					}, 1500);
				} catch {
					btn.textContent = uiText.copyFailed;
					setTimeout(() => {
						btn.textContent = label;
					}, 1500);
				}
			});

			if (registerServiceWorker && "serviceWorker" in navigator) {
				window.addEventListener("load", () => {
					navigator.serviceWorker.register("/sw.js?v=6").catch(() => {});
				});
			}
		</script>
	</body>
</html>
