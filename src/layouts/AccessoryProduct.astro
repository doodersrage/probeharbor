---
/**
 * Shared chrome for ProbeHarbor hardware accessory product pages.
 */
import Layout from "./Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import type { AccessoryId } from "../lib/accessories";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import type { MarketingFaqKey } from "../lib/marketingFaqs";
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";
import { getLocale } from "../i18n";
import { accessoriesMessages } from "../i18n/messages/accessories";
import {
  getLocalizedAccessoriesExcluding,
  getLocalizedAccessory,
} from "../i18n/content/accessories";
import {
  getLocalizedMarketingFaqs,
  getLocalizedMarketingFaqSchema,
} from "../i18n/content/marketingFaqs";

interface Props {
  accessoryId: AccessoryId;
  faqKey: MarketingFaqKey;
  title: string;
  description: string;
  kicker?: string;
  faqTitle?: string;
  faqLede?: string;
}

const locale = getLocale(Astro);
const t = accessoriesMessages(locale).common;

const {
  accessoryId,
  faqKey,
  title,
  description,
  kicker = t.defaultKicker,
  faqTitle = t.faqTitle(title),
  faqLede = t.faqLede,
} = Astro.props;

const siteUrl = resolveSiteUrl(Astro.site);
const accessory = getLocalizedAccessory(accessoryId, locale);
const pageUrl = resolvePageUrl(siteUrl, accessory.path);
const faqs = getLocalizedMarketingFaqs(faqKey, locale);
const related = getLocalizedAccessoriesExcluding(accessoryId, locale);

const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: t.breadcrumbHome, path: "/" },
    { name: t.breadcrumbAccessories, path: "/accessories" },
    { name: title, path: accessory.path },
  ]),
  getLocalizedMarketingFaqSchema(pageUrl, faqKey, locale),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader kicker={kicker} title={title} lede={description}>
      <slot name="actions" slot="actions" />
    </PageHeader>

    <slot />

    <AffiliateDisclosure class="mb-0 text-sm text-[var(--color-text-muted)]" />

    <section class="card">
      <h2 class="card-title">{t.relatedTitle}</h2>
      <ul class="text-sm space-y-2 mb-0">
        {
          related.map((item) => (
            <li>
              <a class="text-link" href={item.path}>
                {item.name}
              </a>
              {" — "}
              {item.tagline}
            </li>
          ))
        }
      </ul>
      <p class="mt-3 mb-0 text-sm">
        <a class="text-link" href="/accessories">{t.allAccessories}</a>
        {" · "}
        <a class="text-link" href="/claim-puck">{t.claimPuck}</a>
        {" · "}
        <a class="text-link" href="/about/esp32-freeze-kit">{t.esp32FreezeKit}</a>
      </p>
    </section>

    <FaqSection title={faqTitle} faqs={faqs} lede={faqLede} />
  </div>
</Layout>
